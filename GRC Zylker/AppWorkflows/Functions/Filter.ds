string Styles_Creator.Filter()
{

                 	style_text = ".zc-pb-tile-container .zc-pb-tile-card .zcs-filter { height: auto; } .zcs-filter .zc-form-fullheight { vertical-align: top; } .zcs-filter .zc-form-fullheight .form-outer-wrapper { border-width: 0px; } .zcs-filter .zc-form-fullheight .form-outer-wrapper form.form-table { width: 100%; overflow: initial; } .zcs-filter .form-overlay { background-color: transparent; } .zcs-filter .zc-form-fullheight .form-outer-wrapper .zc-mobile-scroll-ctr { padding: 0px; } .zcs-filter .zc-form-fullheight .form-outer-wrapper .formContainer { padding: 16px 20px; } .zcs-filter .zc-form-fullheight .form-outer-wrapper .zc-footer-wrapper { display: none; } .zcs-filter .formContainer .zc-form-scroll-wrapper { margin-top: 0px; padding: 0px; } .zcs-filter .formContainer .zc-form-scroll-wrapper .column-block { width: 100%; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; } .zcs-filter .formContainer .zc-form-scroll-wrapper .column-block>div:first-child, .zcs-filter .formContainer .zc-form-scroll-wrapper .column-block>div:last-child { display: none; } .zcs-filter .formContainer .formColumn.first-column, .zcs-filter .formContainer .formColumn.second-column { float: none; width: auto; min-width: auto; } .zcs-filter .formContainer .formColumn.first-column { position: relative; } .zcs-filter .formContainer .formColumn.second-column { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 20px; } .zcs-filter form .formContainer .formColumn .form-group { margin-bottom: 0px; } .zcs-filter form .formContainer .formColumn.second-column .form-group { display: inline-block; vertical-align: top; } .zcs-filter .form-outer-wrapper form .formContainer .formColumn .form-group .form-control, .zcs-filter .form-outer-wrapper form .formContainer .formColumn .form-group .select2-container .select2-choice { height: 36px; min-height: 36px; } .zcs-filter .form-outer-wrapper form .formContainer .formColumn:hover .form-group .form-control { border-color: var(--zcs_brand_color); box-shadow: 0px 0px 0px 0.5px var(--zcs_brand_color); } /* Placeholder */ .zcs-filter .zc-form-fullheight .form-outer-wrapper .formContainer .formColumn .form-group label { padding: 0px 3px; top: -2px; } .zcs-filter .zc-form-fullheight .form-outer-wrapper .formContainer .formColumn .form-group.zc-label-float label { opacity: 0; } .zcs-filter .form-group.zc-Search_Key-group label { transform: translate3d(10px, 10px, 0) scale(1); transition: transform cubic-bezier(.25, .8, .25, 1) .75s; } .zcs-filter .form-group label .zc-label-text { font-size: 0px; opacity: 0; } .zcs-filter .first-column .form-group label .zc-label-text { opacity: 1; user-select: none; } .zcs-filter .first-column .form-group label .zc-label-text:after { content: 'Search...'; font-size: 14px; line-height: 20px; margin-left: 18px; color: var(--zcs-placeholder-color); } .zcs-filter .form-group.zc-Search_Key-group .form-field { position: relative; } .zcs-filter .form-group.zc-Search_Key-group .form-field:before { content: '\ed38'; font: normal normal normal 14px/20px 'ZC Live Outline'; color: var(--zcs-placeholder-color); display: inline-block; vertical-align: top; user-select: none; position: absolute; top: 8px; left: 12px; } .zcs-filter .form-group.zc-Search_Key-group .form-field input { padding: 12px 30px; } .zcs-filter .form-group .form-field .select2-container .select2-chosen { padding-top: 0px; line-height: 34px !important; } .zcs-filter .select2-container .select2-choice abbr:before { vertical-align: top; line-height: 16px; position: initial; } .zcs-filter .select2-container .select2-choice abbr { right: 39px; } .zcs-filter .form-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { display: inline-block; vertical-align: top; color: var(--zcs-placeholder-color); } /* Decision box(Search - cancel icon) */ .zcs-filter .form-group.zc-decisionbox-field-group { width: auto; height: 36px; position: absolute; right: 7px; top: 0px; z-index: 1; margin: