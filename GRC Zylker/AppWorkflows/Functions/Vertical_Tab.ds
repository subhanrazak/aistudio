string Styles.Vertical_Tab()
{

                 	style_txt = ".zcs-vertical-tabhead { width: 250px; border-right: 1px solid var(--zcs_tertiary_border_color); } .zcs-vertical-tabbody { width: calc(100% - 250px); } .zcs-vertical-tabitem { list-style-type: none; } .zcs-vertical-tabinput, .zcs-mobile-vertical-tabinput { display: none; } .zcs-vertical-tablink { text-decoration: none; } .zcs-vertical-tabicon { width: 16px; height: 16px; } .zcs-vertical-tabsublist { display: none; background-color: var(--zcs_component_hover_color); animation-duration: .25s; animation-name: animation-fade-up; } .zcs-vertical-tab-arrow { rotate: 270deg; } .zcs-vertical-tabitem .zcs-vertical-tabinput:checked~.zcs-vertical-tablabel .zcs-vertical-tab-arrow { rotate: 0deg; } .zcs-vertical-tabitem .zcs-vertical-tabinput:checked~.zcs-vertical-tabsublist { display: flex; } /* Hover state */ .zcs-vertical-tablink:hover { color: var(--zcs_brand_color); } .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink, .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink:hover { background-color: #feefee;font-weight: 600;color: #FB2C36;border-radius: 10px; } /* Mobile View */  .zcs-mobile-vertical-tablabel { display: none; top: 24px; left: 20px; z-index: 4; } .zcs-mobile-vertical-tabinput:checked~.zcs-mobile-vertical-tablabel { top: 22px; left: auto; right: calc(20% + 20px); } .zcs-mobile-vertical-tabinput:checked~.zcs-mobile-vertical-tablabel i:before { content: '\ed2b' !important; font-family: 'ZC Live Outline'; color: var(--zcs_primary_text_color); } .zcs-vertical-tabpanel-dark>.zcs-mobile-vertical-tabinput:checked~.zcs-mobile-vertical-tablabel i:before { color: var(--zcs-white-color); } .zcs-mobile-vertical-tab-freezelayer { width: 100%; height: 100%; position: absolute; background-color: rgba(0, 0, 0, 0.55); display: none; z-index: 3; } @media (max-width: 768px) { .zcs-mobile-vertical-tabheader, .zcs-mobile-vertical-tablabel { display: flex; } .zcs-vertical-tabhead { display: none; } .zcs-vertical-tabbody {} .zcs-vertical-tabpanel .zcs-mobile-vertical-tabinput:checked~.zcs-vertical-tabhead { width: 80%; height: 100%; display: flex; border-width: 0px; background-color: var(--zcs-white-color); position: absolute; top: 0px; left: 0px; z-index: 3; } .zcs-vertical-tabpanel-dark.zcs-vertical-tabpanel .zcs-mobile-vertical-tabinput:checked~.zcs-vertical-tabhead { background-color: #12132b; } .zcs-vertical-tabpanel .zcs-mobile-vertical-tabinput:checked~.zcs-mobile-vertical-tab-freezelayer { display: flex; } } /* Type 1 */ .zcs-vertical-tabpanel-dark>.zcs-vertical-tabhead { background-color: #12132b; } .zcs-vertical-tabpanel-dark>.zcs-vertical-tabhead .zcs-vertical-tablink { color: #C5C9DE; } .zcs-vertical-tabpanel-dark>.zcs-vertical-tabhead .zcs-vertical-tabsublist { background-color: transparent; } /* Hover state */ .zcs-vertical-tabpanel-dark>.zcs-vertical-tabhead .zcs-vertical-tablink:hover { background-color: #1E1F41; color: var(--zcs-white-color); } .zcs-vertical-tabpanel-dark>.zcs-vertical-tabhead .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink, .zcs-vertical-tabpanel-dark>.zcs-vertical-tabhead .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink:hover { background-color: #1E1F41; } .zcs-vertical-tabpanel-dark>.zcs-vertical-tabhead .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink:before, .zcs-vertical-tabpanel-minimal>.zcs-vertical-tabhead .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink:before { content: ''; display: inline-block; vertical-align: top; width: 3px; height: 24px; background-color: var(--zcs_brand_color); border-radius: 2px; position: absolute; left: 0px; } /* Type 2 */ .zcs-vertical-tabpanel-minimal>.zcs-vertical-tabhead { border-left: 1px solid var(--zcs_tertiary_border_color); border-right-width: 0px; } .zcs-vertical-tabpanel-minimal>.zcs-vertical-tabhead .zcs-vertical-tabsublist { display: flex; background-color: transparent; } .zcs-vertical-tabpanel-minimal>.zcs-vertical-tabhead .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink, .zcs-vertical-tabpanel-minimal>.zcs-vertical-tabhead .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink:hover { background-color: transparent; color: var(--zcs_brand_color); } /* RTL */ .zc-rtl-wrapper .zcs-vertical-tabhead { border-right-width: 0px; border-left: 1px solid var(--zcs_tertiary_border_color); } .zc-rtl-wrapper .zcs-vertical-tabpanel .zcs-mobile-vertical-tabinput:checked~.zcs-vertical-tabhead { left: auto; right: 0px; } .zc-rtl-wrapper .zcs-vertical-tab-arrow { rotate: 90deg; } .zc-rtl-wrapper .zcs-mobile-vertical-tablabel { left: auto; right: 20px; } .zc-rtl-wrapper .zcs-vertical-tabbody .zcs-mobile-vertical-tabheader { padding-right: 50px; padding-left: 20px; } .zc-rtl-wrapper .zcs-mobile-vertical-tabinput:checked~.zcs-mobile-vertical-tablabel { right: auto; left: calc(20% + 20px); } /* Type 1 */ .zc-rtl-wrapper .zcs-vertical-tabpanel-dark>.zcs-vertical-tabhead .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink:before, .zc-rtl-wrapper .zcs-vertical-tabpanel-minimal>.zcs-vertical-tabhead .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink:before { left: auto; right: 0px; } /* Type 2 */ .zc-rtl-wrapper .zcs-vertical-tabpanel-minimal>.zcs-vertical-tabhead { border-left-width: 0px; border-right: 1px solid var(--zcs_tertiary_border_color); } .zc-rtl-wrapper .zcs-vertical-tabpanel-minimal>.zcs-vertical-tabhead .zcs-vertical-tabsublist .zcs-vertical-tablink { padding: 10px 32px 10px 12px; }";
                 	return style_txt;
                 
}