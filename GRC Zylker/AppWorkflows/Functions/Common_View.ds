string Styles_Page.Common_View()
{

                 	style_text = '.zcs-page-container { background-color: var(--zcs-page-bg-color); } @media (max-width: 768px) { .zcs-commonview.zcs-page-container, .zcs-commonview .zcs-page-container-inner { height: auto; } .zcs-commonview .zcs-page-container-inner { padding: 16px 20px; gap: 12px; } .zcs-commonview .zcs-page-header .zcs-button { width: 36px; min-width: 36px; } .zcs-commonview .zcs-page-header .zcs-button .zcs-button-text { display: none; } .zcs-commonview .zcs-panel-wrapper ul { gap: 12px; } }';
                 	return style_text;
                 
}