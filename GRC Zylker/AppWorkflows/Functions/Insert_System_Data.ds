void Insert_System_Data()
{

                 	idSetup = insert into ID_Setup
                 	[
                 		Objective_ID="Obj"
                 		Strategy_ID="Str"
                 		Process_ID="Pro"
                 		Risk_ID="Risk"
                 		Control_ID="Con"
                 		Assessment_ID="Ass"
                 		Department_ID="Dep"
                 		Organization_ID="Org"
                 		User_ID="User"
                 		Incident_ID="INC"
                 		Action_Plan_ID="ACT"
                 		Added_User=zoho.loginuser
                 	];
                 
}