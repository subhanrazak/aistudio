string Styles.Table()
{

                 	style_txt = ' :root { --zcs-thead-color: #FAFBFF; --zcs-tr-h-color: #F9FAFE; --zcs-tgroup-color: #F1F2F8; --zcs-tgroup-h-color: #F1F2F8; --zcs-zebra-head-color: #F1F2F8; --zcs-zebra-odd-color: var(--zcs-white-color); --zcs-zebra-even-color: #F9FAFE; --zcs-zebra-h-color: #F1F2F8; } .zcs-table-wrapper {  background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead { top: 0px; } .zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color);white-space: nowrap; } .zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; } .zcs-vertical-table-wrapper.zcs-table-wrapper table tbody tr td.zcs-table-th { background-color: var(--zcs-thead-color); white-space: nowrap; border-right: 1px solid var(--zcs_tertiary_border_color); } .zcs-table-wrapper table tbody tr td { border-bottom: 1px solid var(--zcs_tertiary_border_color); }.zcs-table-wrapper table tbody tr:first-child {border-top: 1px solid var(--zcs-thead-color);}.zcs-table-wrapper table tbody tr:first-child:hover {border-top: 1px solid var(--zcs_tertiary_border_color);}  .zcs-table-wrapper table tbody tr.zcs-tgroup td { border-top: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-tgroup-color); } .zcs-table-wrapper.zcs-without-border-table, .zcs-table-wrapper.zcs-without-border-table * { border-width: 0px; box-shadow: none; } .zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); } .zcs-table-wrapper table tbody tr:first-child:hover td { border-color: var(--zcs_tertiary_border_color); } .zcs-table-wrapper table tbody tr.zcs-tgroup:hover td { background-color: var(--zcs-tgroup-h-color); } .zcs-vertical-table-wrapper.zcs-table-wrapper table tbody tr:hover td, .zcs-without-border-table.zcs-table-wrapper table tbody tr:hover td, .zcs-table-wrapper table tbody tr.zcs-tnodata:hover td { background-color: transparent; } .zcs-vertical-table-wrapper.zcs-table-wrapper table tbody tr:first-child:hover td { border-top-color: transparent; } .zcs-vertical-table-wrapper.zcs-table-wrapper table tbody tr:hover td.zcs-table-th { background-color: var(--zcs-thead-color); } .zcs-table-wrapper table thead tr th.zcs-green, .zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; } .zcs-table-wrapper table thead tr th.zcs-red, .zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; } .zcs-table-wrapper table thead tr th.zcs-yellow, .zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; } .zcs-table-wrapper table thead tr th.zcs-d_green, .zcs-table-wrapper table tbody tr td.zcs-d_green, .zcs-table-wrapper table tbody tr td .zcs-d_green { color: #007943; } .zcs-table-wrapper table thead tr th.zcs-blue, .zcs-table-wrapper table tbody tr td.zcs-blue, .zcs-table-wrapper table tbody tr td .zcs-blue { color: #09598e; } .zcs-table-wrapper table thead tr th.zcs-l_blue, .zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color: #1094c5; } .zcs-table-wrapper table thead tr th.zcs-d_blue, .zcs-table-wrapper table tbody tr td.zcs-d_blue, .zcs-table-wrapper table tbody tr td .zcs-d_blue { color: #1328cd; } /* Custom Buttons */ .zcs-table-wrapper table tbody tr td .zcs-custom-btn, .zcs-table-wrapper table tbody tr td .zcs-custom-btn-disable { display: inline-block; vertical-align: top; border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); transition: all 0.2s linear; } .zcs-table-wrapper table tbody tr td .zcs-custom-btn-disable { opacity: 0.3; } .zcs-table-wrapper table tbody tr td .zcs-custom-btn:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); } .zcs-table-wrapper table tbody tr td .zcs-custom-btn-disable:hover { border-color: var(--zcs_tertiary_border_color); color: #666d79; } /* Custom Action Icons */ .zcs-table-wrapper table tbody tr td .zcs-approve-icon { color: #179e6c; } .zcs-table-wrapper table tbody tr td .zcs-reject-icon { color: #fe455d; } .zcs-table-wrapper table tbody tr td .zcs-custom-action-icon i:before { transition: all 0.2s ease; } .zcs-table-wrapper table tbody tr td .zcs-custom-action-icon:hover i:before { font-family: "ZC Live Solid"; } .zcs-table-wrapper table tbody tr td .zcs-approve-icon:hover i:before { content: "\ed3d"; } .zcs-table-wrapper table tbody tr td .zcs-reject-icon:hover i:before { content: "\ed48"; } /* Zebra Table */ .zcs-table-wrapper.zcs-zebra-table table thead tr th { background-color: var(--zcs-zebra-head-color); } .zcs-table-wrapper.zcs-zebra-table table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; } .zcs-table-wrapper.zcs-zebra-table table tbody tr:nth-child(odd) td { background-color: var(--zcs-zebra-odd-color); } .zcs-table-wrapper.zcs-zebra-table table tbody tr:nth-child(even) td { background-color: var(--zcs-zebra-even-color); } .zcs-table-wrapper.zcs-zebra-table table tbody tr:hover td { background-color: var(--zcs-zebra-h-color); }';
                 	return style_txt;
                 
}