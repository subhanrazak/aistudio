string Page_Filter.Committee_Page(map params)
{

                 	parm = "";
                 	pageURL = "#Page:Board_Page";
                 	parm = parm + if(params.get("Committee_Type") != null,"&Committee_Type=" + params.get("Committee_Type"),"");
                 	parm = parm + if(params.get("Search_Key") != "" && params.get("Search_Key") != null,"&Search_Key=" + params.get("Search_Key"),"");
                 	returnURL = pageURL + "?tab=committee" + parm;
                 	return returnURL;
                 
}