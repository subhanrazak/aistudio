string Styles.Horizontal_Tab()
{

                 	style_text = '.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 1px solid transparent; letter-spacing: 0.1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabcount { min-width: 20px; background-color: var(--zcs-page-bg-color); } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs_brand_color); } .zcs-horizontal-tabitem:hover .zcs-horizontal-tabcount, .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tabcount { background-color: var(--zcs_component_hover_color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs_brand_color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs_brand_color); } .zcs-horizontal-tabbody { overflow: auto; }';
                 	return style_text;
                 
}