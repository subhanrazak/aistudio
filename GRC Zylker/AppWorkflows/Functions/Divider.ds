string Styles.Divider()
{

                 	style_str = ".zcs-divider-horizontal { border-top: 1px solid #e7e7ee; } .zcs-divider-horizontal.zcs-divider-dashed { border-top-style: dashed; } .zcs-divider-horizontal.zcs-divider-dotted { border-top-style: dotted; } .zcs-divider-vertical { border-left: 1px solid #e7e7ee; } .zcs-divider-vertical.zcs-divider-dashed { border-left-style: dashed; } .zcs-divider-vertical.zcs-divider-dotted { border-left-style: dotted; } .zcs-divider-card-text { border: 1px solid #e7e7ee; }";
                 	return style_str;
                 
}