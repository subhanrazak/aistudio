map Content.translation()
{

                 	app_language = thisapp.localization.language();
                 	mp = Map();
                 	if(app_language == "English")
                 	{
                 		mp.put(thisapp.languages.english());
                 		mp.put(thisapp.languages.governanceenglish());
                 	}
                 	else if(app_language == "Arabic")
                 	{
                 		mp.put(thisapp.languages.arabic());
                 		mp.put(thisapp.languages.governancearabic());
                 	}
                 	return mp;
                 
}