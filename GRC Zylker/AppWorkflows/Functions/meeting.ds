string Styles_Page.Meeting()
{

                 	style_text = ".zcs-meeting-wrap { padding: 20px; } .zcs-meeting-header { padding: 0px; align-items: center; margin-bottom: 20px; } .zcs-meeting-title { font-size: 20px; } .zcs-meeting-subtitle { font-size: 15px; } .zcs-meeting-action { width: auto; min-width: 5rem; min-height: 36px; box-sizing: border-box; border-radius: 6px; gap: 8px; font-size: 14px; } .zcs-meeting-action svg { width: 18px; height: 18px; } .zcs-meeting-stat-card, .zcs-occ-stat-card { padding: 12px 16px; background: #FFF; min-height: 20px; align-items: center; } .zcs-meeting-stat-label { font-size: 14px; } .zcs-meeting-stat-value { font-size: 24px; } .zcs-meeting-stat-grid { margin-bottom: 20px; } .zcs-meeting-list { background: #FFF; padding: 0px 24px; } .zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .form-outer-wrapper { box-shadow: none; border-radius: 0px; } .zcs-meeting-card { padding: 16px; } .zcs-meeting-date-month { font-size: 10px; font-weight: 600; letter-spacing: 0.01px; color: #62748E; } .zcs-meeting-date-day { font-size: 24px; color: #0F172B; } .zcs-mm-wrap, .zcs-occ-wrap { padding: 20px; } .zc_live_adminbar .zc-container-wrapper { height: 100%; } .zc-container-wrapper.zc-row.zc-row-nowrap {} .zcs-mm-header-card, .zcs-occ-header-card { padding: 16px; } .zcs-mm-meta-value, .zcs-occ-meta-value { font-size: 16px; margin-bottom: 4px; } .zcs-mm-meta-label, .zcs-occ-meta-label { font-size: 14px; } .zcs-mm-title, .zcs-occ-title { font-weight: 500; margin-bottom: 10px; } .zcs-mm-edit-btn, .zcs-mm-occurring-btn, .zcs-tab-new-btn { width: auto; min-width: 5rem; min-height: 36px; box-sizing: border-box; border-radius: 6px; gap: 8px; font-size: 14px; } .zcs-mm-committee-tag { font-size: 13px; } .zcs-mm-header-top, .zcs-occ-header-top { margin-bottom: 4px; } .zcs-mm-divider, .zcs-occ-divider { margin-bottom: 12px; } .zcs-mm-stat-name, .zcs-occ-stat-name { margin-top: 10px; } .zcs-horizontal-tabhead { padding: 0px 20px; } .zcs-agenda-head { margin: 20px 20px; } .zcs-agenda-head h4 { font-weight: 600; font-family: 'Lato'; } .divEmbedContainer:not(.zcs-filter) { padding: 0px 20px; } .zcs-tab-action-header { margin: 20px; box-shadow: none; border: 1px solid #ECF0F7; } .zcs-mom-list { margin: 20px; } .zcs-mom-card { border: 1px solid #ECF0F7; } .zcs-tab-action-header h4 { font-family: 'Lato'; } .zcs-mom-meta-icon { width: 16px; height: 16px; } .zcs-horizontal-tabhead ~ .divEmbedContainer:not(.zcs-filter) { margin-top: 20px; } .zcs-col-6.zcs-col-md-12.zcs-p-10.zcs-box-border { padding: 0px 10px; } .zcs-row.zcs-gap-row-20 { padding: 20px 10px; } .zcs-att-card. .zcs-att-row { border-color: #ECF0F7; } .zcs-att-row { padding: 8px 16px; } .zcs-att-avatar { width: 36px; height: 36px; } .zcs-occ-date-badge { gap: 0px; } .zcs-occ-occurrence-sub { font-size: 13px; margin-top: 4px; } .zcs-occ-occurrence-title { font-size: 15px; } .zcs-occ-table td { font-size: 14px; } .zcs-occ-table th { font-size: 14px; } .zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .form-outer-wrapper { border-radius: 12px 12px 0px 0px; border: 1px solid #E9EEF8; border-bottom: 0px; } .zcs-meeting-list { border-radius: 0px 0px 12px 12px; border: 1px solid #E9EEF8; border-top: 0px; }";
                 	popup_style = ".zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter.zc-form-container .popupConentContainer .form-outer-wrapper, .zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter .popupConentContainer .zc-form-fullheight .form-outer-wrapper .zc-subform-header-container-parent+.row { height: 100%; } .zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter .popupConentContainer .form-outer-wrapper .form-table .zc-footer-wrapper { background-color: #F8F9FC; } .zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter .popupConentContainer .form-outer-wrapper .form-table .zc-footer-wrapper .zc-form-footer .formbutton { text-align: right; }";
                 	common_style = ".inner .page_content_wrapper { height: 100%; } .zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment { padding: 0px; } .zc-pb-embed-placeholder-content { background-color: #f5f6fa; overflow: auto; line-height: 1.35; }";
                 	style_text = common_style + style_text + popup_style;
                 	// 	style_text ="";
                 	return style_text;
                 
}