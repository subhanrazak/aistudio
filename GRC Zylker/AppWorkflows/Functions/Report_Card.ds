string Styles_Creator.Report_Card()
{

                 	style_text = '.zcs-report { height: 100% !important; overflow: auto; } .zcs-report .view-outer-wrapper, .zcs-report .zc-reporttype-list, .zcs-report .list-view-inner { border-radius: 0px 0px 12px 12px; } .zcs-report .reportfullwidth { height: 100% !important; border-width: 1px 0px 0px; border-radius: 0px 0px 12px 12px; padding: 0px; box-sizing: border-box; } .zcs-report .view-outer-wrapper .view-header-reportlist { height: 0px; background-color: var(--zcs-white-color); } .zcs-report .view-outer-wrapper .view-header-reportlist.zc-show-new-menu { position: absolute; top: -60px; left: 0px; right: 0px; height: 51px; z-index: 1; transition: 0.3s linear all; } .zcs-report .zc-reporttype-list .list-view-inner { min-height: 150px; border-width: 0px; } /* .zcs-report .zc-reporttype-list .list-view-inner .handsontable .wtHolder .wtHider .htCore thead th { border-top-width: 0px !important; } */';
                 	return style_text;
                 
}