string Styles.Rich_Text()
{

                 	style_txt = ".zc-ems-rt-clearfix { display: inline-block; vertical-align: top; } .zc-ems-rt-flt-left { float: left; } .zc-ems-rt .zc-ems-rt-img-wrapper { width: 40px; height: 40px; border-radius: 50%; padding: 5px 10px 5px 0px; box-sizing: border-box; } .zc-ems-rt .zc-ems-rt-img-wrapper img { width: 100%; height: 100%; object-fit: contain; border-radius: 50%; } .zc-ems-rt-primary-text {font-size: 14px; line-height: 1.5; font-weight: 500; letter-spacing: 0.1px; color: #131635; display: block; } .zc-ems-rt-secondary-text { font-size: 13px; line-height: 1.5; font-weight: 400; letter-spacing: 0.1px; color: #666D79; display: block; }";
                 	rtl_txt = ".zc-rtl-wrapper .zc-ems-rt-flt-left { float: right; } .zc-rtl-wrapper .zc-ems-rt-img-wrapper { padding: 5px 0px 5px 10px; }";
                 	style_txt = " <style> " + style_txt + rtl_txt + " </style> ";
                 	return style_txt;
                 
}