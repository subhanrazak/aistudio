string Styles_Page.Board_Page()
{

                 	style_text = ".zcs-board-overview { padding: 20px; } .zcs-board-header { align-items: center; } .zcs-btn-outline, .zcs-btn-primary { width: auto; min-width: 5rem; min-height: 36px; box-sizing: border-box; border-radius: 6px; gap: 8px; font-size: 14px; } .zcs-board-header p { font-size: 15px; } .zcs-board-identity { box-shadow: none; border: 1px solid #ECF0F7; border-bottom: 0px; } .zcs-board-identity h3 { font-size: 15px; font-weight: 500; margin-bottom: 6px; } .zcs-board-identity p { font-size: 13px; } .zcs-board-identity-left>div:nth-child(1) { background-color: #FFEBEB !important; } .zcs-board-meta-item { gap: 6px; border-right-width: 0px; margin-right: 0px; padding-right: 40px; } .zcs-board-meta-item label { font-size: 14px; } .zcs-board-meta-item span.zcs-meta-val { font-weight: 500; } .zcs-board-meta { border: 1px solid #ECF0F7; } .zcs-stat-info label { font-size: 14px; } .zcs-stat-card { padding: 12px 16px; } .zcs-stat-info h3 { font-size: 24px; } .zcs-stats-grid { margin-bottom: 0px; } .zcs-ov-container { padding: 20px; } .zcs-ov-card { border: 1px solid #ECF0F7; box-shadow: none; } .zcs-ov-card h4 { font-size: 18px; margin-bottom: 6px; } .zcs-ov-card>p { font-size: 14px; } .zcs-tier-tab { border-bottom-width: 1px; margin-bottom: -1px; font-size: 14px; font-weight: 500; } .zcs-member-group-label { font-size: 15px; font-weight: 500; margin-bottom: 12px; } .zcs-member-chip { border: 1px solid #E5E5E7; background-color: transparent; padding: 8px 10px; box-sizing: border-box; border-radius: 20px; } .zcs-member-grid { display: flex; gap: 16px; } .zcs-member-avatar { width: 22px; height: 22px; background-color: #FFE4E5; color: #FB2C36; font-weight: 400; } .zcs-member-name { font-size: 14px; color: #000; } .zcs-table th { background-color: #F8F8F8; font-size: 14px; line-height: 1.25; font-weight: 500; color: #000; } .zcs-table td { border-bottom: 1px solid #EEF3FB; font-size: 14px; line-height: 1.25; color: #62748E; } .zcs-badge-scheduled { font-size: 13px; text-wrap: nowrap; padding: 4px 8px; } .zcs-compliance-item { padding: 8px; border: 1px solid #EFEEF8; background-color: #FAFBFF; gap: 6px; } .zcs-compliance-ring-svg circle { stroke-width: 3px; cx: 18px; cy: 18px; r: 13px; } .zcs-compliance-ring-svg circle:nth-child(2) {stroke: #FB2C36;} .zcs-compliance-pct { font-weight: 500; } .zcs-compliance-title { margin-bottom: 4px; color: #000; } .zcs-compliance-sub { color: #62748E; } .zcs-committee-card { padding: 0px; border: 1px solid #E2E9F2; box-shadow: none; } .zcs-committee-card-header { padding: 10px; margin-bottom: 0px; } .zcs-committee-icon { background-color: #FFECEC; } .zcs-committee-title { font-weight: 500; margin-bottom: 6px; font-family: 'Lato'; } .zcs-committee-desc { font-size: 13px; font-family: 'Lato'; } .zcs-committee-meta { margin-top: 0px; padding: 10px; } .zcs-committee-meta-item { font-size: 13px; } .zcs-committee-grid { padding: 20px 10px; } .zcs-horizontal-tabhead { padding: 0px 20px; } .zcs-report.zcs-col-common.divEmbedContainer { height: 380px !important; padding: 20px; } .zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .view-outer-wrapper .reportfullwidth { border-width: 1px; border-radius: var(--content_card_radius); }";
                 	common_style = ".inner .page_content_wrapper { height: 100%; } .zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment { padding: 0px; } .zc-pb-embed-placeholder-content { background-color: #f5f6fa; overflow: auto; line-height: 1.35; }";
                 	popup_style = ".zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter.zc-form-container .popupConentContainer .form-outer-wrapper, .zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter .popupConentContainer .zc-form-fullheight .form-outer-wrapper .zc-subform-header-container-parent+.row { height: 100%; } .zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter .popupConentContainer .form-outer-wrapper .form-table .zc-footer-wrapper { background-color: #F8F9FC; } .zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter .popupConentContainer .form-outer-wrapper .form-table .zc-footer-wrapper .zc-form-footer .formbutton { text-align: right; }";
                 	to_be_remove = ".zcs-filter.divEmbedContainer { display: none; }";
                 	style_text = common_style + style_text + popup_style + to_be_remove;
                 	// 	style_text ="";
                 	return style_text;
                 
}