string Log.Log_Translation(string form_name, int recid, string action_type, int user_id, string Title)
{

                 	app_language = thisapp.localization.language();
                 	getUser = User[ID == user_id];
                 	typeStr = "";
                 	if(app_language == "English")
                 	{
                 		if(form_name == "Objective")
                 		{
                 			typeStr = "objective";
                 		}
                 		else if(form_name == "Risk_Entry")
                 		{
                 			typeStr = "risk";
                 		}
                 		else if(form_name == "Assessment_Plan")
                 		{
                 			typeStr = "plan";
                 		}
                 		else if(form_name == "Incident_Register")
                 		{
                 			typeStr = "incident";
                 		}
                 		if(action_type == "Create")
                 		{
                 			if(form_name == "Assessment_Plan")
                 			{
                 				returnStr = "New Plan Created";
                 			}
                 			else
                 			{
                 				returnStr = Title + " " + typeStr + " added by " + getUser.Employee_ID + " - " + getUser.Name;
                 			}
                 		}
                 		else if(action_type == "Update")
                 		{
                 			if(form_name == "Assessment_Plan")
                 			{
                 				returnStr = "Plan Updated";
                 			}
                 			else
                 			{
                 				returnStr = Title + " " + typeStr + " updated by " + getUser.Employee_ID + " - " + getUser.Name;
                 			}
                 		}
                 		else if(action_type == "Delete")
                 		{
                 			if(form_name == "Assessment_Plan")
                 			{
                 				returnStr = "Plan Deleted";
                 			}
                 			else
                 			{
                 				returnStr = Title + " " + typeStr + " deleted by " + getUser.Employee_ID + " - " + getUser.Name;
                 			}
                 		}
                 	}
                 	else if(app_language == "Arabic")
                 	{
                 		if(form_name == "Objective")
                 		{
                 			typeStr = "الهدف";
                 		}
                 		else if(form_name == "Risk_Entry")
                 		{
                 			typeStr = "المخاطر";
                 		}
                 		else if(form_name == "Assessment_Plan")
                 		{
                 			typeStr = "الخطة";
                 		}
                 		if(action_type == "Create")
                 		{
                 			if(form_name == "Assessment_Plan")
                 			{
                 				returnStr = "تم إنشاء خطة جديدة";
                 			}
                 			else
                 			{
                 				returnStr = "تمت إضافة " + typeStr + " " + Title + " بواسطة " + getUser.Employee_ID + " - " + getUser.Name;
                 			}
                 		}
                 		else if(action_type == "Update")
                 		{
                 			if(form_name == "Assessment_Plan")
                 			{
                 				returnStr = "تم تحديث الخطة";
                 			}
                 			else
                 			{
                 				returnStr = "تم تحديث " + typeStr + " " + Title + " بواسطة " + getUser.Employee_ID + " - " + getUser.Name;
                 			}
                 		}
                 		else if(action_type == "Delete")
                 		{
                 			if(form_name == "Assessment_Plan")
                 			{
                 				returnStr = "تم حذف الخطة";
                 			}
                 			else
                 			{
                 				returnStr = "تم حذف " + typeStr + " " + Title + " بواسطة " + getUser.Employee_ID + " - " + getUser.Name;
                 			}
                 		}
                 	}
                 	return returnStr;
                 
}