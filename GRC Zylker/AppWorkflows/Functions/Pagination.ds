string Styles.Pagination()
{

                 	style_txt = '.zcs-pagination-item { list-style-type: none; } .zcs-pagination-value, .zcs-pagination-action, .zcs-pagination-value-text { min-width: 32px; height: 32px; } .zcs-pagination-with-border .zcs-pagination-value, .zcs-pagination-with-border .zcs-pagination-action { border: 1px solid var(--zcs_tertiary_border_color); } .zcs-pagination-action { background-color: #F5F7FB; } .zcs-pagination-value:hover, .zcs-pagination-action:hover, .zcs-pagination-item.zcs-pagination-item-active .zcs-pagination-value { background-color: var(--zcs_component_hover_color); color: var(--zcs_brand_color); } .zcs-pagination-with-border .zcs-pagination-value:hover, .zcs-pagination-with-border .zcs-pagination-action:hover, .zcs-pagination-with-border .zcs-pagination-item.zcs-pagination-item-active .zcs-pagination-value { border-color: var(--zcs_brand_color); } /* RTL styles start here */ .zc-rtl-wrapper .zcs-pagination-icon { rotate: 180deg; }';
                 	return style_txt;
                 
}