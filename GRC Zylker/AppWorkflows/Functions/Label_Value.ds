string Styles.Label_Value()
{

                 	style_str = ".zcs-labelvalue-wrapper.zcs-labelvalue-with-bg { background-color: #F9FAFE; } .zcs-labelvalue-wrapper.zcs-labelvalue-with-divider ul li:not(:last-child)::after { content: ''; width: 1px; height: 21px; display: inline-block; vertical-align: top; background-color: #EBECF0; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow { color: #a06309; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color: #179e6c; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-orange { color: #FF7E52; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color: #FE455D; }";
                 	return style_str;
                 
}