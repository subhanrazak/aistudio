string Styles.Panel()
{

                 	style_text = '.zcs-panel-wrapper ul li { list-style-type: none; } .zcs-panel { border: 1px solid var(--zcs_tertiary_border_color); box-shadow: 0px 2px 8px 0px #F2F2F6; background-color: var(--zcs-white-color); } .zcs-panel-icon-wrapper { width: 40px; height: 40px; } .zcs-panel-icon { width: 24px; height: 24px; line-height: 24px; } .zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper { background-color: #E4FCF3; color: #179E6C; } .zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper { background-color: #FCF4E6; color: #B8770D; } .zcs-panel.zcs-panel-red .zcs-panel-icon-wrapper { background-color: #FDE3E6; color: #FE455D; } .zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper { background-color: #EAF2FF; color: #1652BB; } .zcs-panel.zcs-panel-l_blue .zcs-panel-icon-wrapper { background-color: #E8EFFF; color: #2A6FFC; } .zcs-panel.zcs-panel-violet .zcs-panel-icon-wrapper { background-color: #f6f6fb; color: #5c66ff; } .zcs-panel.zcs-panel-blue .zcs-panel-icon-wrapper { background-color: #f2f9ff; color: #2a8bcc; } .zcs-panel.zcs-panel-orange .zcs-panel-icon-wrapper { background-color: #fdf5f3; color: #ff8b11; } .zcs-panel.zcs-panel-grey .zcs-panel-icon-wrapper { background-color: #f5f8fa; color: #092441; } .zcs-panel-wrapper .zcs-overlay { top: 0px; left: 0px; } ';
                 	return style_text;
                 
}