string Styles_Page.Committee_Detailview()
{

                 	style_text = ".zcs-cd-wrap { font-family: 'Lato'; } .zcs-cd-header { align-items: center; } .zcs-cd-edit { width: auto; min-width: 5rem; min-height: 36px; box-sizing: border-box; border-radius: 6px; gap: 8px; font-size: 14px; } .zcs-cd-header p { font-size: 15px; } .zcs-cd-card { box-shadow: none; border: 1px solid #ECF0F7; } .zcs-cd-identity h3 { font-size: 15px; font-weight: 500; margin-bottom: 6px; } .zcs-cd-identity p { font-size: 13px; } .zcs-cd-purpose-label { font-size: 14px; } p.zcs-cd-mandate { font-size: 14px; line-height: 1.3; color: #000; } .zcs-cd-meta-item { gap: 6px; border-right-width: 0px; margin-right: 0px; padding-right: 40px; } span.zcs-cd-meta-val { font-weight: 400; } span.zcs-cd-meta-label { font-size: 14px; } .zcs-cd-badge { font-size: 12px; text-wrap: nowrap; padding: 4px 8px; } .zcs-cd-stat-card { padding: 12px 16px; } .zcs-cd-stat-info label { font-size: 14px; } .zcs-cd-stat-info h3 { font-size: 24px; } .zcs-cd-section { border: 1px solid #ECF0F7; box-shadow: none; } .zcs-cd-section-h { font-size: 18px; } .zcs-cd-meeting-card { padding: 16px; } .zcs-cd-meeting-date {} .zcs-cd-meeting-date-m { color: #62748E; } .zcs-cd-meeting-top>div:nth-child(1) { display: flex; flex-direction: column; gap: 4px; } .zcs-cd-meeting-desc, .zcs-cd-meeting-chip { font-size: 12px; } .zcs-cd-meeting-desc { margin-bottom: 0px; } .zcs-cd-row .zcs-cd-meta-label { font-size: 14px; } .zcs-cd-row .zcs-cd-meta-val a { font-size: 14px !important; } .zcs-cd-sub-h { font-size: 16px; } .zcs-cd-wrap .zcs-report.zcs-col-common.divEmbedContainer { padding: 0px; }";
                 	return style_text;
                 
}