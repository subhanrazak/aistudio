string Page_Filter.Meeting_Page(map parm_map)
{

                 	baseURL = "#Page:Meeting_Page?zc_Header=false";
                 	mSeries = parm_map.get("Meeting_Series") + "";
                 	mFor = parm_map.get("Meeting_For") + "";
                 	mPriority = parm_map.get("Meeting_Priority") + "";
                 	mStatus = parm_map.get("Meeting_Status") + "";
                 	searchKey = parm_map.get("Search_Key") + "";
                 	if(mSeries != "" && mSeries != "null")
                 	{
                 		baseURL = baseURL + "&Meeting_Series=" + mSeries;
                 	}
                 	if(mFor != "" && mFor != "null")
                 	{
                 		baseURL = baseURL + "&Meeting_For=" + mFor;
                 	}
                 	if(mPriority != "" && mPriority != "null")
                 	{
                 		baseURL = baseURL + "&Meeting_Priority=" + mPriority;
                 	}
                 	if(mStatus != "" && mStatus != "null")
                 	{
                 		baseURL = baseURL + "&Meeting_Status=" + mStatus;
                 	}
                 	if(searchKey != "" && searchKey != "null")
                 	{
                 		baseURL = baseURL + "&Search_Key=" + searchKey;
                 	}
                 	return baseURL;
                 
}