string Styles.App_CSS()
{

                 	common_style = "a { text-decoration: none; } .zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; }";
                 	style_text = thisapp.Styles.Color_Codes() + thisapp.Styles.Grid() + thisapp.Styles_Creator.Element_Styles() + common_style + thisapp.Styles_Creator.LL_Spinner();
                 	return style_text;
                 
}