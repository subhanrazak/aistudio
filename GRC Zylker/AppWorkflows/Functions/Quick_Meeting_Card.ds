string Styles.Quick_Meeting_Card()
{

                 	c = "";
                 	c = c + ".zcs-qmc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }";
                 	c = c + ".zcs-qmc-card-link { text-decoration: none; color: inherit; display: block; }";
                 	c = c + ".zcs-qmc-card { display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: 14px; padding: 14px 16px; border-radius: 14px; border: 1px solid #dfe6f1; background: #fff; box-shadow: 0 4px 12px rgba(40, 54, 85, 0.03); transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease; font-family: Inter, sans-serif; }";
                 	c = c + ".zcs-qmc-card:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(40, 54, 85, 0.08); border-color: #d6deeb; }";
                 	c = c + ".zcs-qmc-date { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; min-height: 92px; border-radius: 10px; background: #f4f7fb; text-align: center; }";
                 	c = c + ".zcs-qmc-date-m { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #70839e; }";
                 	c = c + ".zcs-qmc-date-d { font-size: 26px; line-height: 1; font-weight: 700; color: #26344b; }";
                 	c = c + ".zcs-qmc-main { min-width: 0; }";
                 	c = c + ".zcs-qmc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }";
                 	c = c + ".zcs-qmc-top-left { min-width: 0; flex: 1; }";
                 	c = c + ".zcs-qmc-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }";
                 	c = c + ".zcs-qmc-tag { display: inline-flex; align-items: center; padding: 3px 8px; border-radius: 6px; background: #eef2f6; color: #8796aa; font-size: 9px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }";
                 	c = c + ".zcs-qmc-name { margin: 2px 0 0; font-size: 14px; line-height: 1.35; font-weight: 700; color: #26344b; }";
                 	c = c + ".zcs-qmc-note { margin: 5px 0 0; font-size: 12px; color: #8794a7; display: flex; align-items: center; gap: 6px; }";
                 	c = c + ".zcs-qmc-note svg { width: 13px; height: 13px; flex-shrink: 0; color: #e8453c; }";
                 	c = c + ".zcs-qmc-desc { margin: 4px 0 0; font-size: 12px; color: #8794a7; line-height: 1.45; }";
                 	c = c + ".zcs-qmc-status { display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; white-space: nowrap; flex-shrink: 0; }";
                 	c = c + ".zcs-qmc-status svg { width: 13px; height: 13px; flex-shrink: 0; }";
                 	c = c + ".zcs-qmc-status-success { background: #e8fbef; color: #2a9a5f; }";
                 	c = c + ".zcs-qmc-status-warning { background: #fff3e3; color: #c98318; }";
                 	c = c + ".zcs-qmc-status-info { background: #ede9ff; color: #7d63ec; }";
                 	c = c + ".zcs-qmc-status-danger { background: #fde8e8; color: #c44545; }";
                 	c = c + ".zcs-qmc-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; padding-top: 10px; border-top: 1px solid #f3f4f6; flex-wrap: wrap; }";
                 	c = c + ".zcs-qmc-meta-group { display: flex; align-items: center; gap: 18px; min-width: 0; flex-wrap: wrap; }";
                 	c = c + ".zcs-qmc-meta-item { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: #68788f; min-width: 0; }";
                 	c = c + ".zcs-qmc-meta-item svg { width: 14px; height: 14px; color: #e8453c; flex-shrink: 0; }";
                 	c = c + ".zcs-qmc-meta-avatar { width: 18px; height: 18px; border-radius: 50%; background: #fff0f0; color: #e8453c; font-size: 10px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }";
                 	c = c + ".zcs-qmc-attendance { white-space: nowrap; }";
                 	c = c + ".zcs-qmc-empty { padding: 28px; text-align: center; color: #9ca3af; font-size: 13px; grid-column: 1 / -1; }";
                 	c = c + "@media (max-width: 768px) { .zcs-qmc-grid { grid-template-columns: 1fr; } }";
                 	return c;
                 
}