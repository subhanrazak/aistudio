string Components.Add_Record(string display_name, string page_link_name, string form_linkname, string form_params)
{

                 	dom_txt = '<div class="zcs-page-container zcs-form-page zcs-test-form zcs-wh-full"><div class="zcs-page-container-inner zcs-wh-full zcs-p-30 zcs-box-border"><div class="zcs-card zcs-wh-full zcs-flex zcs-direction-column"><div class="zcs-page-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-20 zcs-box-border"><h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">' + display_name + ' </h5><a class="zcs-close-icon" href="' + page_link_name + '"/></div><div class="zcs-page-content zcs-col-common"><div zc_MobileView="inline" class="zcs-form" elName="zc-component" formLinkName="' + form_linkname + '" params="' + form_params + '"/></div></div></div></div>';
                 	style_txt = "<style>.zcs-page-container{background-color:var(--zcs-page-bg-color);}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e8e8ef;border-radius:12px;}.zcs-form-page .zcs-page-header{border-bottom:1px solid #e8e8ef;}.zcs-form-page .zcs-page-content{border-radius:0 0 12px 12px;overflow:auto;}.zcs-form-page .zcs-page-header .zcs-close-icon{width:18px;height:18px;display:inline-block;vertical-align:top;overflow:hidden;cursor:pointer; position:relative;margin:2px 0;}.zcs-form-page .zcs-page-header .zcs-close-icon:before,.zcs-form-page .zcs-page-header .zcs-close-icon:after{content:'';background-color:#8E8E8E; position:absolute;width:99%;height:2px;top:50%;left:0;border-radius:1px;}.zcs-form-page .zcs-page-header .zcs-close-icon:before{transform:rotate(45deg);}.zcs-form-page .zcs-page-header .zcs-close-icon:after{transform:rotate(-45deg);}.zcs-form-page .zcs-page-header .zcs-close-icon:hover:before,.zcs-form-page .zcs-page-header .zcs-close-icon:hover:after{background-color:#f00;}.zcs-form-page .zcs-form .zc-form-fullheight,.zcs-form-page .zcs-form .row,.zcs-form-page .zcs-form .form-outer-wrapper form.form-table{width:100%;height:100%;}.zcs-form-page .zcs-form .zc-form-fullheight .form-outer-wrapper{height:100%!important;border-width:0;}.zcs-form-page .zcs-form .form-outer-wrapper form.form-table{display:flex;flex-direction:column;}.zcs-form-page .zcs-form .form-outer-wrapper .zc-mobile-scroll-ctr{display:flex;flex-direction:column;height:100%;padding:0;}.zcs-form-page .zcs-form form .zc-form-scroll-wrapper{padding:0;}.zcs-page-container.zcs-form-page .zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer{flex:1;padding:20px 30px;box-sizing:border-box;overflow:auto;}.zcs-form-page .zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton{display:flex;align-items:center;padding:20px 30px;box-sizing:border-box;}@media (max-width:768px){.zcs-form-page .zcs-page-container-inner{padding:16px;}.zcs-form-page .zcs-page-header-text{font-size:16px;}.zc-mobile .zcs-form-page .zcs-page-header,.zc-mobile .zcs-page-container.zcs-form-page .zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer,.zc-mobile .zcs-form-page .zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton{padding:16px 20px;}body:not(.zc-mobile) .zcs-form-page .zcs-card{background-color:transparent;border-color:transparent;}body:not(.zc-mobile) .zcs-form-page .zcs-page-header{padding:0 0 20px;}}</style>";
                 	component_code = style_txt + dom_txt;
                 	return component_code;
                 
}