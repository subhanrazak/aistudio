bool permission.app_access(string component)
{

                 	profile_for_user = thisapp.permissions.profileForUser(zoho.loginuserid);
                 	if(profile_for_user in {"Administrator","Developer"})
                 	{
                 		return true;
                 	}
                 	else
                 	{
                 		returnVal = false;
                 		if(component == "risk_Management_Library")
                 		{
                 			if(profile_for_user in {"Action Owner"})
                 			{
                 				returnVal = false;
                 			}
                 			else
                 			{
                 				returnVal = true;
                 			}
                 		}
                 		else if(component == "risk_Management_Library_Button" || component == "risk_register_add_Button" || component == "software_licences")
                 		{
                 			if(profile_for_user in {"ERM Admin","System Admin","Risk Manager"})
                 			{
                 				returnVal = true;
                 			}
                 			else
                 			{
                 				returnVal = false;
                 			}
                 		}
                 		else if(component == "contol_Library_Button")
                 		{
                 			if(profile_for_user in {"ERM Admin","System Admin","Risk Manager","Control Owner"})
                 			{
                 				returnVal = true;
                 			}
                 			else
                 			{
                 				returnVal = false;
                 			}
                 		}
                 		else if(component == "risk_register_edit_Button")
                 		{
                 			if(profile_for_user in {"ERM Admin","Risk Manager","Risk Owner"})
                 			{
                 				returnVal = true;
                 			}
                 			else
                 			{
                 				returnVal = false;
                 			}
                 		}
                 		else if(component == "assessment_plan" || component == "risk_assessment")
                 		{
                 			if(profile_for_user in {"ERM Admin","Risk Manager"})
                 			{
                 				returnVal = true;
                 			}
                 			else
                 			{
                 				returnVal = false;
                 			}
                 		}
                 		else if(component == "incident_management")
                 		{
                 			if(profile_for_user in {"Risk Manager"})
                 			{
                 				returnVal = true;
                 			}
                 			else
                 			{
                 				returnVal = false;
                 			}
                 		}
                 		else if(component == "risk_assessment_edit")
                 		{
                 			if(profile_for_user in {"ERM Admin","Risk Manager","Risk Owner","Control Owner"})
                 			{
                 				returnVal = true;
                 			}
                 			else
                 			{
                 				returnVal = false;
                 			}
                 		}
                 		else if(component == "org_structure" || component == "resource")
                 		{
                 			if(profile_for_user in {"ERM Admin","System Admin"})
                 			{
                 				returnVal = true;
                 			}
                 			else
                 			{
                 				returnVal = false;
                 			}
                 		}
                 		else if(component == "settings")
                 		{
                 			if(profile_for_user in {"ERM Admin","System Admin","CRO"})
                 			{
                 				returnVal = true;
                 			}
                 			else
                 			{
                 				returnVal = false;
                 			}
                 		}
                 		return returnVal;
                 	}
                 
}