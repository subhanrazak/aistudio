string Get_ID(string id_for, int rec_id)
{

                 	if(id_for == "Objective")
                 	{
                 		sampleID = ID_Setup[Objective_ID != "" && Objective_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Objective_ID,"Obj");
                 		last_Req_ID = Objective[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Strategy")
                 	{
                 		sampleID = ID_Setup[Strategy_ID != "" && Strategy_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Strategy_ID,"Str");
                 		last_Req_ID = Strategy[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Process")
                 	{
                 		sampleID = ID_Setup[Process_ID != "" && Process_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Process_ID,"Pro");
                 		last_Req_ID = Process[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Risk")
                 	{
                 		sampleID = ID_Setup[Risk_ID != "" && Risk_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Risk_ID,"Risk");
                 		last_Req_ID = Risk_Entry[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Control")
                 	{
                 		sampleID = ID_Setup[Control_ID != "" && Control_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Control_ID,"Con");
                 		last_Req_ID = Control[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Assessment")
                 	{
                 		sampleID = ID_Setup[Assessment_ID != "" && Assessment_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Assessment_ID,"Ass");
                 		last_Req_ID = Risk_Assessment[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Department")
                 	{
                 		sampleID = ID_Setup[Department_ID != "" && Department_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Department_ID,"Dep");
                 		last_Req_ID = Department[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Organization")
                 	{
                 		sampleID = ID_Setup[Organization_ID != "" && Organization_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Organization_ID,"Org");
                 		last_Req_ID = Organization[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "User")
                 	{
                 		sampleID = ID_Setup[User_ID != "" && User_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.User_ID,"User");
                 		last_Req_ID = User[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Incident")
                 	{
                 		sampleID = ID_Setup[Incident_ID != "" && Incident_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Incident_ID,"INC");
                 		last_Req_ID = Incident_Register[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "KPI")
                 	{
                 		sampleID = ID_Setup[KPI_ID != "" && KPI_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.KPI_ID,"KPI");
                 		last_Req_ID = KPI[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Action_Plan")
                 	{
                 		sampleID = ID_Setup[Action_Plan_ID != "" && Action_Plan_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Action_Plan_ID,"ACT");
                 		last_Req_ID = Action_Plan[ID == rec_id].S_No;
                 	}
                 	else if(id_for == "Regulation")
                 	{
                 		sampleID = ID_Setup[Regulation_ID != "" && Regulation_ID != null];
                 		last_ID_Prefix = if(sampleID.count() != 0,sampleID.Regulation_ID,"REG");
                 		last_Req_ID = Add_Regulation[ID == rec_id].S_No;
                 	}
                 	return last_ID_Prefix + "-" + last_Req_ID;
                 
}