string Page_Filter.Risk_Assessment_Risk(map params)
{

                 	parm = "";
                 	pageURL = "#Page:Risk_Assessment_Report_Page";
                 	pageURL = pageURL + "?zc_Header=false&zc_AddRec=false&zc_ColMenu=false&zc_Footer=false&&page_action=risk&assessment_id=" + params.get("rec_ID");
                 	parm = parm + if(params.get("Status") != "" && params.get("Status") != null,"&Status=" + params.get("Status"),"");
                 	parm = parm + if(params.get("Department") != null,"&Department=" + params.get("Department"),"");
                 	parm = parm + if(params.get("Search_Key") != "" && params.get("Search_Key") != null,"&Search=" + params.get("Search_Key"),"");
                 	returnURL = pageURL + parm + "&zc_LoadIn=embed-embedDiv";
                 	return returnURL;
                 
}