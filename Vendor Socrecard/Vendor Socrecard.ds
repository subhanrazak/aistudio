			Risk_Assessments_On_Load as "Prepare Risk Assessment"
			{
			    type = form
			    form = Risk_Assessments
			    record event = on add or edit
			    description = "Sets assessor and protects calculated risk fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Assessor_Email == null || input.Assessor_Email == "")
			                {
			                    input.Assessor_Email = zoho.loginuser;
			                }
			                if(input.Assessment_Status == null || input.Assessment_Status == "")
			                {
			                    input.Assessment_Status = "Draft";
			                }
			                disable Weighted_Risk_Score;
			                disable Risk_Tier;
			                disable Risk_Status;
			            )
			        }
			    }
			}

			Risk_Assessments_On_Success as "Update Vendor From Risk Assessment"
			{
			    type = form
			    form = Risk_Assessments
			    record event = on add or edit
			    description = "Updates vendor risk summary and lifecycle stage."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                totalRisk = input.Weighted_Risk_Score;
			                if(totalRisk == null)
			                {
			                    totalRisk = (input.Financial_Risk_Score + input.Compliance_Risk_Score + input.Operational_Risk_Score + input.Cyber_Risk_Score) / 4;
			                }
			                vendorRec = Vendors[ID == input.Vendor];
			                if(vendorRec.count() > 0)
			                {
			                    vendorRec.Latest_Risk_Tier = input.Risk_Tier;
			                    vendorRec.Latest_Risk_Status = input.Risk_Status;
			                    if(input.Risk_Status == "Acceptable" && vendorRec.Stage == "Evaluated")
			                    {
			                        vendorRec.Stage = "Risk Assessed";
			                        vendorRec.Vendor_Status = "Pending Review";
			                    }
			                    vendorRec.Lifecycle_Notes = ifnull(vendorRec.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Risk score " + totalRisk + " (" + input.Risk_Tier + ") recorded by " + zoho.loginuser;
			                }
			            )
			        }
			    }
			}

			Risk_Assessments_On_Validate as "Validate Risk Assessment"
			{
			    type = form
			    form = Risk_Assessments
			    record event = on add or edit
			    description = "Validates risk scores and derives weighted risk result from configuration where available."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                scores = {input.Financial_Risk_Score,input.Compliance_Risk_Score,input.Operational_Risk_Score,input.Cyber_Risk_Score};
			                for each score in scores
			                {
			                    if(score == null)
			                    {
			                        alert "All risk scores are required.";
			                        cancel submit;
			                    }
			                    if(score < 0 || score > 100)
			                    {
			                        alert "Each risk score must be between 0 and 100.";
			                        cancel submit;
			                    }
			                }
			                financialWeight = 25.0;
			                complianceWeight = 25.0;
			                operationalWeight = 25.0;
			                cyberWeight = 25.0;
			                configuredTotal = 0.0;
			                weights = Weightages[Process_Area == "Risk Assessment" && Active == true];
			                for each weightRec in weights
			                {
			                    criteriaRec = Criteria[ID == weightRec.Criteria];
			                    if(criteriaRec.count() > 0)
			                    {
			                        if(criteriaRec.Criteria_Code == "Financial_Risk")
			                        {
			                            financialWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Compliance_Risk")
			                        {
			                            complianceWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Operational_Risk")
			                        {
			                            operationalWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Cyber_Risk")
			                        {
			                            cyberWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                    }
			                }
			                if(configuredTotal <= 0)
			                {
			                    configuredTotal = 100.0;
			                }
			                totalRisk = ((input.Financial_Risk_Score * financialWeight) + (input.Compliance_Risk_Score * complianceWeight) + (input.Operational_Risk_Score * operationalWeight) + (input.Cyber_Risk_Score * cyberWeight)) / configuredTotal;
			                input.Weighted_Risk_Score = totalRisk;
			                scaleMatched = false;
			                scales = Rating_Scales[Process_Area == "Risk Assessment" && Active == true];
			                for each scaleRec in scales
			                {
			                    if(totalRisk >= scaleRec.Min_Value && totalRisk <= scaleRec.Max_Value)
			                    {
			                        if(scaleRec.Result_Status == "Low" || scaleRec.Result_Status == "Medium" || scaleRec.Result_Status == "High" || scaleRec.Result_Status == "Critical")
			                        {
			                            input.Risk_Tier = scaleRec.Result_Status;
			                        }
			                        if(scaleRec.Acceptable == true)
			                        {
			                            input.Risk_Status = "Acceptable";
			                        }
			                        else
			                        {
			                            input.Risk_Status = "Unacceptable";
			                        }
			                        scaleMatched = true;
			                    }
			                }
			                if(scaleMatched == false || input.Risk_Tier == null || input.Risk_Tier == "")
			                {
			                    if(totalRisk < 30)
			                    {
			                        input.Risk_Tier = "Low";
			                        input.Risk_Status = "Acceptable";
			                    }
			                    else if(totalRisk < 60)
			                    {
			                        input.Risk_Tier = "Medium";
			                        input.Risk_Status = "Acceptable";
			                    }
			                    else if(totalRisk < 80)
			                    {
			                        input.Risk_Tier = "High";
			                        input.Risk_Status = "Unacceptable";
			                    }
			                    else
			                    {
			                        input.Risk_Tier = "Critical";
			                        input.Risk_Status = "Unacceptable";
			                    }
			                }
			                if(input.Assessment_Status == null || input.Assessment_Status == "" || input.Assessment_Status == "Draft")
			                {
			                    input.Assessment_Status = "Completed";
			                }
			                if((input.Risk_Tier == "High" || input.Risk_Tier == "Critical") && (input.Mitigation_Plan == null || input.Mitigation_Plan == ""))
			                {
			                    alert "Mitigation Plan is required for High or Critical risk.";
			                    cancel submit;
			                }
			                vendorRec = Vendors[ID == input.Vendor];
			                if(vendorRec.count() == 0)
			                {
			                    alert "Select a valid vendor before submitting the risk assessment.";
			                    cancel submit;
			                }
			                if(vendorRec.Stage == "Registered")
			                {
			                    alert "Vendor must reach the Evaluated stage before risk assessment.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Vendor_Contacts_On_Success as "Update Vendor Primary Contact"
			{
			    type = form
			    form = Vendor_Contacts
			    record event = on add or edit
			    description = "Updates the vendor summary from the active primary contact."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Primary_Contact == true && input.Active == true)
			                {
			                    update Vendors[ID == input.Vendor]
			                    [
			                        Contact_Person = input.Contact_Name
			                        Contact_Email = input.Email
			                        Contact_Phone = input.Phone
			                    ];
			                }
			            )
			        }
			    }
			}

			Vendor_Contacts_On_Validate as "Validate Contact"
			{
			    type = form
			    form = Vendor_Contacts
			    record event = on add or edit
			    description = "Prevents more than one active primary contact for a vendor."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Primary_Contact == true && input.Active == true)
			                {
			                    duplicatePrimary = Vendor_Contacts[Vendor == input.Vendor && Primary_Contact == true && Active == true && ID != input.ID];
			                    if(duplicatePrimary.count() > 0)
			                    {
			                        alert "This vendor already has an active primary contact.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Vendor_Documents_On_Load as "Prepare Document Verification"
			{
			    type = form
			    form = Vendor_Documents
			    record event = on add or edit
			    description = "Defaults verifier details when a verified document opens without them."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Verification_Status == "Verified")
			                {
			                    if(input.Verified_By == null || input.Verified_By == "")
			                    {
			                        input.Verified_By = zoho.loginuser;
			                    }
			                    if(input.Verified_On == null)
			                    {
			                        input.Verified_On = zoho.currentdate;
			                    }
			                }
			            )
			        }
			    }
			}

			Vendor_Documents_On_Success as "Record Document Lifecycle Note"
			{
			    type = form
			    form = Vendor_Documents
			    record event = on add or edit
			    description = "Appends a vendor lifecycle note when a document is verified or rejected."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Verification_Status == "Verified" || input.Verification_Status == "Rejected")
			                {
			                    vendorRec = Vendors[ID == input.Vendor];
			                    if(vendorRec.count() > 0)
			                    {
			                        noteLine = zoho.currentdate.toString() + " - Document " + input.Document_Name + " marked " + input.Verification_Status + " by " + zoho.loginuser;
			                        vendorRec.Lifecycle_Notes = ifnull(vendorRec.Lifecycle_Notes,"") + "\n" + noteLine;
			                    }
			                }
			            )
			        }
			    }
			}

			Vendor_Documents_On_Validate as "Validate Document"
			{
			    type = form
			    form = Vendor_Documents
			    record event = on add or edit
			    description = "Validates document dates and verification requirements."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Issue_Date != null && input.Expiry_Date != null && input.Expiry_Date < input.Issue_Date)
			                {
			                    alert "Expiry Date cannot be earlier than Issue Date.";
			                    cancel submit;
			                }
			                if(input.Verification_Status == null || input.Verification_Status == "")
			                {
			                    input.Verification_Status = "Pending";
			                }
			                if(input.Expiry_Date != null && input.Expiry_Date < zoho.currentdate && input.Verification_Status != "Rejected")
			                {
			                    input.Verification_Status = "Expired";
			                }
			                if(input.Verification_Status == "Verified")
			                {
			                    if(input.Document_File == null)
			                    {
			                        alert "Document File is required before a document can be verified.";
			                        cancel submit;
			                    }
			                    if(input.Verified_By == null || input.Verified_By == "")
			                    {
			                        input.Verified_By = zoho.loginuser;
			                    }
			                    if(input.Verified_On == null)
			                    {
			                        input.Verified_On = zoho.currentdate;
			                    }
			                }
			            )
			        }
			    }
			}

			Vendor_Evaluations_On_Load as "Prepare Evaluation Form"
			{
			    type = form
			    form = Vendor_Evaluations
			    record event = on add or edit
			    description = "Sets evaluator and protects calculated evaluation fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Evaluator_Email == null || input.Evaluator_Email == "")
			                {
			                    input.Evaluator_Email = zoho.loginuser;
			                }
			                if(input.Evaluation_Status == null || input.Evaluation_Status == "")
			                {
			                    input.Evaluation_Status = "Draft";
			                }
			                disable Evaluation_Result;
			                disable Weighted_Overall_Rating;
			            )
			        }
			    }
			}

			Vendor_Evaluations_On_Success as "Update Vendor From Evaluation"
			{
			    type = form
			    form = Vendor_Evaluations
			    record event = on add or edit
			    description = "Updates the vendor score summary after evaluation."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                evaluationScore = input.Weighted_Overall_Rating;
			                if(evaluationScore == null)
			                {
			                    evaluationScore = (input.Product_Service_Fit_Rating + input.Quality_Capability_Rating + input.Commercial_Rating + input.Compliance_Rating) / 4;
			                }
			                vendorRec = Vendors[ID == input.Vendor];
			                if(vendorRec.count() > 0)
			                {
			                    vendorRec.Current_Evaluation_Rating = evaluationScore;
			                    vendorRec.Evaluation_Result = input.Evaluation_Result;
			                    if(evaluationScore >= 3 && input.Evaluation_Result == "Acceptable" && vendorRec.Stage == "Registered")
			                    {
			                        vendorRec.Stage = "Evaluated";
			                        vendorRec.Vendor_Status = "Pending Review";
			                    }
			                    vendorRec.Lifecycle_Notes = ifnull(vendorRec.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Evaluation score " + evaluationScore + " recorded by " + zoho.loginuser;
			                }
			            )
			        }
			    }
			}

			Vendor_Evaluations_On_Validate as "Validate Evaluation"
			{
			    type = form
			    form = Vendor_Evaluations
			    record event = on add or edit
			    description = "Validates ratings and derives weighted evaluation result from configuration where available."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Evaluation_End_Date < input.Evaluation_Start_Date)
			                {
			                    alert "Evaluation End Date must be on or after Evaluation Start Date.";
			                    cancel submit;
			                }
			                ratings = {input.Product_Service_Fit_Rating,input.Quality_Capability_Rating,input.Commercial_Rating,input.Compliance_Rating};
			                for each rating in ratings
			                {
			                    if(rating == null || rating < 1 || rating > 5)
			                    {
			                        alert "Each evaluation rating must be between 1 and 5.";
			                        cancel submit;
			                    }
			                }
			                productWeight = 25.0;
			                qualityWeight = 25.0;
			                commercialWeight = 25.0;
			                complianceWeight = 25.0;
			                configuredTotal = 0.0;
			                weights = Weightages[Process_Area == "Evaluation" && Active == true];
			                for each weightRec in weights
			                {
			                    criteriaRec = Criteria[ID == weightRec.Criteria];
			                    if(criteriaRec.count() > 0)
			                    {
			                        if(criteriaRec.Criteria_Code == "Product_Service_Fit")
			                        {
			                            productWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Quality_Capability")
			                        {
			                            qualityWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Commercial")
			                        {
			                            commercialWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Compliance")
			                        {
			                            complianceWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                    }
			                }
			                if(configuredTotal <= 0)
			                {
			                    configuredTotal = 100.0;
			                }
			                weightedScore = ((input.Product_Service_Fit_Rating * productWeight) + (input.Quality_Capability_Rating * qualityWeight) + (input.Commercial_Rating * commercialWeight) + (input.Compliance_Rating * complianceWeight)) / configuredTotal;
			                input.Weighted_Overall_Rating = weightedScore;
			                scaleMatched = false;
			                scales = Rating_Scales[Process_Area == "Evaluation" && Active == true];
			                for each scaleRec in scales
			                {
			                    if(weightedScore >= scaleRec.Min_Value && weightedScore <= scaleRec.Max_Value)
			                    {
			                        input.Evaluation_Result = scaleRec.Result_Status;
			                        scaleMatched = true;
			                    }
			                }
			                if(scaleMatched == false)
			                {
			                    if(weightedScore >= 3)
			                    {
			                        input.Evaluation_Result = "Acceptable";
			                    }
			                    else if(weightedScore >= 2)
			                    {
			                        input.Evaluation_Result = "Needs Improvement";
			                    }
			                    else
			                    {
			                        input.Evaluation_Result = "Rejected";
			                    }
			                }
			                if(input.Evaluation_Status == null || input.Evaluation_Status == "")
			                {
			                    input.Evaluation_Status = "Completed";
			                }
			                if(input.Evaluation_Status == "Draft")
			                {
			                    input.Evaluation_Status = "Completed";
			                }
			                if((input.Evaluation_Result == "Needs Improvement" || input.Evaluation_Result == "Rejected") && (input.Recommendation_Notes == null || input.Recommendation_Notes == ""))
			                {
			                    alert "Recommendation is required when an evaluation is not acceptable.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Activate_After_Onboarding_On_User_Input as "Toggle Activation Date"
			{
			    type = form
			    form = Vendor_Onboarding
			    record event = on add or edit
			    description = "Shows Active From only when immediate activation is requested."
			
			    on user input of Activate_After_Onboarding
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Activate_After_Onboarding == true)
			                {
			                    show Active_From;
			                    enable Active_From;
			                    if(input.Active_From == null)
			                    {
			                        input.Active_From = zoho.currentdate;
			                    }
			                }
			                else
			                {
			                    input.Active_From = null;
			                    hide Active_From;
			                }
			            )
			        }
			    }
			}

			Vendor_Onboarding_On_Load as "Prepare Onboarding Form"
			{
			    type = form
			    form = Vendor_Onboarding
			    record event = on add or edit
			    description = "Sets manager and dynamic activation fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Onboarding_Manager_Email == null || input.Onboarding_Manager_Email == "")
			                {
			                    input.Onboarding_Manager_Email = zoho.loginuser;
			                }
			                if(input.Onboarding_Result == null || input.Onboarding_Result == "")
			                {
			                    input.Onboarding_Result = "Pending";
			                }
			                disable Baseline_Score;
			                disable Calculated_Onboarding_Score;
			                disable Onboarding_Result;
			                if(input.Activate_After_Onboarding == true)
			                {
			                    show Active_From;
			                    enable Active_From;
			                }
			                else
			                {
			                    hide Active_From;
			                }
			            )
			        }
			    }
			}

			Vendor_Onboarding_On_Success as "Update Vendor From Onboarding"
			{
			    type = form
			    form = Vendor_Onboarding
			    record event = on add or edit
			    description = "Stores baseline score and activates qualified vendors."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                finalScore = input.Calculated_Onboarding_Score;
			                if(finalScore == null)
			                {
			                    finalScore = input.Onboarding_Score;
			                }
			                vendorRec = Vendors[ID == input.Vendor];
			                if(vendorRec.count() > 0)
			                {
			                    vendorRec.Onboarding_Baseline_Score = finalScore;
			                    if(input.Onboarding_Status == "Completed" && input.Onboarding_Result == "Qualified")
			                    {
			                        vendorRec.Qualification_Status = "Qualified";
			                        vendorRec.Vendor_Status = "Approved";
			                        if(vendorRec.Stage == "Risk Assessed")
			                        {
			                            vendorRec.Stage = "Onboarded";
			                        }
			                    }
			                    if(input.Activate_After_Onboarding == true && input.Active_From != null && input.Onboarding_Result == "Qualified")
			                    {
			                        vendorRec.Active_From = input.Active_From;
			                        vendorRec.Stage = "Active";
			                        vendorRec.Vendor_Status = "Approved";
			                    }
			                    vendorRec.Lifecycle_Notes = ifnull(vendorRec.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Onboarding score " + finalScore + " (" + input.Onboarding_Result + ") recorded by " + zoho.loginuser;
			                }
			            )
			        }
			    }
			}

			Vendor_Onboarding_On_Validate as "Validate Onboarding"
			{
			    type = form
			    form = Vendor_Onboarding
			    record event = on add or edit
			    description = "Validates onboarding checklist, configurable score, and activation readiness."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                vendorRec = Vendors[ID == input.Vendor];
			                if(vendorRec.count() == 0)
			                {
			                    alert "Select a valid vendor before submitting onboarding.";
			                    cancel submit;
			                }
			                if(vendorRec.Stage != "Risk Assessed" && vendorRec.Stage != "Onboarded" && vendorRec.Stage != "Active" && vendorRec.Stage != "Performance Reviewed")
			                {
			                    alert "Vendor must reach Risk Assessed before onboarding.";
			                    cancel submit;
			                }
			                if(vendorRec.Latest_Risk_Status != "Acceptable" || vendorRec.Current_Evaluation_Rating < 3)
			                {
			                    alert "Vendor evaluation and risk must be acceptable before onboarding.";
			                    cancel submit;
			                }
			                if(input.Onboarding_Score != null && (input.Onboarding_Score < 0 || input.Onboarding_Score > 100))
			                {
			                    alert "Onboarding Score must be between 0 and 100.";
			                    cancel submit;
			                }
			                contractWeight = 25.0;
			                complianceWeight = 25.0;
			                bankWeight = 25.0;
			                trainingWeight = 25.0;
			                configuredTotal = 0.0;
			                weights = Weightages[Process_Area == "Onboarding" && Active == true];
			                for each weightRec in weights
			                {
			                    criteriaRec = Criteria[ID == weightRec.Criteria];
			                    if(criteriaRec.count() > 0)
			                    {
			                        if(criteriaRec.Criteria_Code == "Contract_Signed")
			                        {
			                            contractWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Compliance_Documents_Verified")
			                        {
			                            complianceWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Bank_Details_Verified")
			                        {
			                            bankWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Training_Completed")
			                        {
			                            trainingWeight = weightRec.Weight_Percent;
			                            configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                        }
			                    }
			                }
			                if(configuredTotal <= 0)
			                {
			                    configuredTotal = 100.0;
			                }
			                earnedScore = 0.0;
			                if(input.Contract_Signed == true)
			                {
			                    earnedScore = earnedScore + contractWeight;
			                }
			                if(input.Compliance_Documents_Verified == true)
			                {
			                    earnedScore = earnedScore + complianceWeight;
			                }
			                if(input.Bank_Details_Verified == true)
			                {
			                    earnedScore = earnedScore + bankWeight;
			                }
			                if(input.Training_Completed == true)
			                {
			                    earnedScore = earnedScore + trainingWeight;
			                }
			                calculatedScore = (earnedScore * 100.0) / configuredTotal;
			                input.Calculated_Onboarding_Score = calculatedScore;
			                if(input.Onboarding_Score == null)
			                {
			                    input.Onboarding_Score = calculatedScore;
			                }
			                finalScore = calculatedScore;
			                scaleMatched = false;
			                scales = Rating_Scales[Process_Area == "Onboarding" && Active == true];
			                for each scaleRec in scales
			                {
			                    if(finalScore >= scaleRec.Min_Value && finalScore <= scaleRec.Max_Value)
			                    {
			                        if(scaleRec.Acceptable == true)
			                        {
			                            input.Onboarding_Result = "Qualified";
			                        }
			                        else if(scaleRec.Result_Status == "Blocked")
			                        {
			                            input.Onboarding_Result = "Blocked";
			                        }
			                        else
			                        {
			                            input.Onboarding_Result = "Unqualified";
			                        }
			                        scaleMatched = true;
			                    }
			                }
			                if(scaleMatched == false)
			                {
			                    if(finalScore >= 70)
			                    {
			                        input.Onboarding_Result = "Qualified";
			                    }
			                    else
			                    {
			                        input.Onboarding_Result = "Unqualified";
			                    }
			                }
			                if(input.Onboarding_Status == "Completed")
			                {
			                    if(input.Contract_Signed != true || input.Compliance_Documents_Verified != true || input.Bank_Details_Verified != true || input.Training_Completed != true)
			                    {
			                        alert "All onboarding checklist items must be complete before marking onboarding Completed.";
			                        cancel submit;
			                    }
			                    if(input.Onboarding_Result != "Qualified")
			                    {
			                        alert "Onboarding must be qualified before marking it Completed.";
			                        cancel submit;
			                    }
			                }
			                if(input.Activate_After_Onboarding == true && input.Active_From == null)
			                {
			                    alert "Active From is required when Activate After Onboarding is selected.";
			                    cancel submit;
			                }
			                if(input.Onboarding_Result == "Qualified")
			                {
			                    input.Baseline_Score = finalScore;
			                }
			            )
			        }
			    }
			}

			Issue_Count_On_User_Input as "Recalculate Performance From Issues"
			{
			    type = form
			    form = Vendor_Performance_Metrics
			    record event = on add or edit
			    description = "Recalculates monthly score while entering issue count."
			
			    on user input of Issue_Count
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.On_Time_Delivery_Percent != null && input.Quality_Acceptance_Percent != null && input.SLA_Compliance_Percent != null && input.Service_Response_Score != null && input.Return_Defect_Rate_Percent != null && input.Issue_Count != null)
			                {
			                    score = (input.On_Time_Delivery_Percent * 0.30) + (input.Quality_Acceptance_Percent * 0.30) + (input.SLA_Compliance_Percent * 0.20) + (input.Service_Response_Score * 0.20) - (input.Return_Defect_Rate_Percent * 0.30) - (input.Issue_Count * 1.00);
			                    configuredScore = 0.0;
			                    configuredWeight = 0.0;
			                    configuredCriteria = 0;
			                    performanceWeights = Weightages[Process_Area == "Performance Review" && Active == true];
			                    for each weightRec in performanceWeights
			                    {
			                        criteriaRec = Criteria[ID == weightRec.Criteria && Active == true];
			                        if(criteriaRec.count() > 0)
			                        {
			                            rawValue = 0.0;
			                            hasRawValue = false;
			                            if(criteriaRec.Criteria_Code == "On_Time_Delivery")
			                            {
			                                rawValue = input.On_Time_Delivery_Percent.toDecimal();
			                                hasRawValue = true;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Quality_Acceptance")
			                            {
			                                rawValue = input.Quality_Acceptance_Percent.toDecimal();
			                                hasRawValue = true;
			                            }
			                            else if(criteriaRec.Criteria_Code == "SLA_Compliance")
			                            {
			                                rawValue = input.SLA_Compliance_Percent.toDecimal();
			                                hasRawValue = true;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Service_Response")
			                            {
			                                rawValue = input.Service_Response_Score.toDecimal();
			                                hasRawValue = true;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Return_Defect_Rate")
			                            {
			                                rawValue = input.Return_Defect_Rate_Percent.toDecimal();
			                                hasRawValue = true;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Issue_Count")
			                            {
			                                rawValue = input.Issue_Count.toDecimal();
			                                hasRawValue = true;
			                            }
			                            if(hasRawValue == true)
			                            {
			                                normalizedValue = rawValue;
			                                if(criteriaRec.Score_Direction == "Lower is Better")
			                                {
			                                    if(criteriaRec.Criteria_Code == "Issue_Count")
			                                    {
			                                        normalizedValue = 100.0 - (rawValue * 10.0);
			                                    }
			                                    else
			                                    {
			                                        normalizedValue = 100.0 - rawValue;
			                                    }
			                                }
			                                if(normalizedValue < 0)
			                                {
			                                    normalizedValue = 0;
			                                }
			                                if(normalizedValue > 100)
			                                {
			                                    normalizedValue = 100;
			                                }
			                                configuredScore = configuredScore + (normalizedValue * weightRec.Weight_Percent);
			                                configuredWeight = configuredWeight + weightRec.Weight_Percent;
			                                configuredCriteria = configuredCriteria + 1;
			                            }
			                        }
			                    }
			                    if(configuredCriteria >= 6 && configuredWeight > 0)
			                    {
			                        score = configuredScore / configuredWeight;
			                        input.Configured_Score_Used = true;
			                        input.Score_Notes = "Performance score calculated from complete active Performance Review criteria and weightages.";
			                    }
			                    else
			                    {
			                        input.Configured_Score_Used = false;
			                        input.Score_Notes = "Performance score calculated using default fallback formula because performance configuration is incomplete.";
			                    }
			                    if(score < 0)
			                    {
			                        score = 0;
			                    }
			                    if(score > 100)
			                    {
			                        score = 100;
			                    }
			                    input.Performance_Score = score;
			                    bandMatched = false;
			                    performanceScales = Rating_Scales[Process_Area == "Performance Review" && Active == true];
			                    for each scaleRec in performanceScales
			                    {
			                        if(score >= scaleRec.Min_Value && score <= scaleRec.Max_Value && !bandMatched)
			                        {
			                            input.Performance_Band = scaleRec.Result_Status;
			                            bandMatched = true;
			                        }
			                    }
			                    if(!bandMatched)
			                    {
			                        if(score >= 90)
			                        {
			                            input.Performance_Band = "Excellent";
			                        }
			                        else if(score >= 70)
			                        {
			                            input.Performance_Band = "Good";
			                        }
			                        else if(score >= 50)
			                        {
			                            input.Performance_Band = "Watchlist";
			                        }
			                        else
			                        {
			                            input.Performance_Band = "Poor";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

