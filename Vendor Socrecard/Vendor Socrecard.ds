		        Linked_Vendor
		        Contact_Email
		    )
		    filters
		    (
		        Registration_Status
		        Vendor_Category
		        Vendor_Type
		        Registration_Date
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Registration_Status ascending
		    )
		    sort by
		    (
		        Registration_Date descending
		    )
		}

		list Converted_Registrations
		{
		    displayName = "Converted Registrations"
		    show all rows from Vendor_Registration [Registration_Status == "Converted"]
		    (
		        Registration_ID
		        Registration_Date
		        Vendor_Name
		        Linked_Vendor
		        Contact_Name
		        Contact_Email
		    )
		    filters
		    (
		        Registration_Date
		    )
		    sort by
		    (
		        Registration_Date descending
		    )
		}

		list Pending_Registrations
		{
		    displayName = "Pending Registrations"
		    show all rows from Vendor_Registration [Registration_Status == "Submitted" || Registration_Status == "Draft"]
		    (
		        Registration_ID
		        Registration_Date
		        Vendor_Name
		        Vendor_Category
		        Registration_Status
		        Contact_Name
		        Contact_Email
		    )
		    filters
		    (
		        Registration_Status
		        Vendor_Category
		    )
		    sort by
		    (
		        Registration_Date descending
		    )
		}

		list Active_Vendors
		{
		    displayName = "Active Vendors"
		    show all rows from Vendors [Stage == "Active" || Stage == "Performance Reviewed"]
		    (
		        Vendor_ID
		        Vendor_Name
		        Vendor_Category
		        Vendor_Category_Config
		        Primary_Product_Service_Category
		        Vendor_Status
		        Active_From
		        Onboarding_Baseline_Score
		        Latest_Performance_Score
		        Last_Review_Month
		        Latest_Risk_Tier
		    )
		    filters
		    (
		        Vendor_Category
		        Vendor_Category_Config
		        Primary_Product_Service_Category
		        Vendor_Status
		        Latest_Risk_Tier
		        Last_Review_Month
		    )
		    sort by
		    (
		        Latest_Performance_Score descending
		    )
		}

		default list All_Vendors
		{
		    displayName = "All Vendors"
		    show all rows from Vendors
		    (
		        Vendor_ID
		        Vendor_Name
		        Vendor_Category
		        Vendor_Category_Config
		        Vendor_Type
		        Primary_Product_Service_Category
		        Registration_Date
		        Stage
		        Vendor_Status
		        Qualification_Status
		        Current_Evaluation_Rating
		        Latest_Risk_Tier
		        Onboarding_Baseline_Score
		        Latest_Performance_Score
		        Last_Review_Month
		    )
		    filters
		    (
		        Vendor_Category
		        Vendor_Category_Config
		        Vendor_Type
		        Primary_Product_Service_Category
		        Stage
		        Vendor_Status
		        Qualification_Status
		        Latest_Risk_Tier
		        "Qualified Vendors" : (Qualification_Status == "Qualified")
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Stage ascending
		    )
		    sort by
		    (
		        Vendor_Name ascending
		    )
		}

		list My_Vendor_Profile
		{
		    displayName = "My Vendor Profile"
		    show all rows from Vendors [Contact_Email == zoho.loginuser]
		    (
		        Vendor_Name
		        Vendor_Category
		        Vendor_Category_Config
		        Vendor_Type
		        Primary_Product_Service_Category
		        Contact_Person
		        Contact_Email
		        Contact_Phone
		        Vendor_Address
		        Stage
		        Vendor_Status
		        Qualification_Status
		    )
		    sort by
		    (
		        Vendor_Name ascending
		    )
		}

		kanban Vendor_Lifecycle_Board
		{
		    displayName = "Vendor Lifecycle Board"
		    show all rows from Vendors
		    (
		        Vendor_ID
		        Vendor_Name
		        Vendor_Category
		        Vendor_Category_Config
		        Primary_Product_Service_Category
		        Stage
		        Vendor_Status
		        Qualification_Status
		        Current_Evaluation_Rating
		        Latest_Risk_Tier
		        Latest_Performance_Score
		    )
		    filters
		    (
		        Vendor_Category
		        Vendor_Category_Config
		        Primary_Product_Service_Category
		        Stage
		        Vendor_Status
		        Qualification_Status
		        Latest_Risk_Tier
		    )
		    sort by
		    (
		        Vendor_Name ascending
		    )
		    options
		    (
		        display field = Stage
		        filter type = manual
		        sort order = ascending
		        record count = enable
		    )
		}

		list Active_Weightages
		{
		    displayName = "Active Weightages"
		    show all rows from Weightages [Active == true]
		    (
		        Process_Area
		        Criteria
		        Weight_Percent
		        Effective_From
		        Effective_To
		    )
		    filters
		    (
		        Process_Area
		    )
		    sort by
		    (
		        Process_Area ascending
		        Criteria ascending
		    )
		}

		default list All_Weightages
		{
		    displayName = "All Weightages"
		    show all rows from Weightages
		    (
		        Weightage_ID
		        Process_Area
		        Criteria
		        Weight_Percent
		        Effective_From
		        Effective_To
		        Active
		    )
		    filters
		    (
		        Process_Area
		        Criteria
		        Active
		        Effective_From
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Process_Area ascending
		    )
		    sort by
		    (
		        Process_Area ascending
		        Criteria ascending
		    )
		}
	}

	pages
	{
		page Vendor_Scorecard_Dashboard
		{
					displayname = "Vendor Scorecard Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Dashboard_Header'>\n\t<pr width='fill' height='auto'>\n\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t<pc>\n\t\t\t\t\t<image marginRight='12px' color='#FFFFFF' bgColor='#2A70E7' width='52px' height='52px' type='icon' value='business-chart-bar-33' size='28px' cornerRadius='26px' iconType='outline' />\n\t\t\t\t</pc>\n\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<text color='#12132B' size='24px' bold='true' type='Text' value='Vendor Scorecard Dashboard'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<text marginTop='4px' color='#5F6199' size='14px' type='Text' value='Native KPI, lifecycle, risk, performance, registration, and document oversight for procurement and vendor management teams.'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t</pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='33%'>\n\t\t\t\t<panel elementName='KPI_Total_Vendors'>\n\t<pr width='fill' height='fill'>\n\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='center' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t<pc>\n\t\t\t\t\t<image marginRight='7px' color='#FFFFFF' bgColor='#2A70E7' width='52px' height='52px' type='icon' value='users-single-03' size='28px' cornerRadius='26px' iconType='outline' />\n\t\t\t\t</pc>\n\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<text color='#5F6199' size='14px' type='Text' value='Total Vendors'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<button text='View All Vendors' action='OpenReport' componentLinkName='All_Vendors' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' />\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t</pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='33%'>\n\t\t\t\t<panel elementName='KPI_Active_Vendors'>\n\t<pr width='fill' height='fill'>\n\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='center' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t<pc>\n\t\t\t\t\t<image marginRight='7px' color='#FFFFFF' bgColor='#16AD78' width='52px' height='52px' type='icon' value='ui-1-check-circle-08' size='28px' cornerRadius='26px' iconType='outline' />\n\t\t\t\t</pc>\n\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<text color='#5F6199' size='14px' type='Text' value='Active Vendors'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<button text='View Active Vendors' action='OpenReport' componentLinkName='Active_Vendors' appLinkName='thisapp' target='same-window' bgColor='#16AD78' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' />\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t</pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='34%'>\n\t\t\t\t<panel elementName='KPI_Pending_Registrations'>\n\t<pr width='fill' height='fill'>\n\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='center' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t<pc>\n\t\t\t\t\t<image marginRight='7px' color='#FFFFFF' bgColor='#F37D16' width='52px' height='52px' type='icon' value='ui-2-time' size='28px' cornerRadius='26px' iconType='outline' />\n\t\t\t\t</pc>\n\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t<pr>\n\t\t\t\t\