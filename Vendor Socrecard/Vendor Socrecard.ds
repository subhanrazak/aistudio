			Vendor_Performance_Metrics_On_Load as "Prepare Performance Metrics"
			{
			    type = form
			    form = Vendor_Performance_Metrics
			    record event = on add or edit
			    description = "Sets reviewer, defaults review status, and protects calculated performance fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Reviewer_Email == null || input.Reviewer_Email == "")
			                {
			                    input.Reviewer_Email = zoho.loginuser;
			                }
			                if(input.Review_Status == null || input.Review_Status == "")
			                {
			                    input.Review_Status = "Draft";
			                }
			                disable Performance_Score;
			                disable Performance_Band;
			                disable Configured_Score_Used;
			            )
			        }
			    }
			}

			Vendor_Performance_Metrics_On_Success as "Update Vendor From Performance"
			{
			    type = form
			    form = Vendor_Performance_Metrics
			    record event = on add or edit
			    description = "Updates vendor latest performance score and lifecycle status."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                score = input.Performance_Score;
			                if(score == null)
			                {
			                    score = (input.On_Time_Delivery_Percent * 0.30) + (input.Quality_Acceptance_Percent * 0.30) + (input.SLA_Compliance_Percent * 0.20) + (input.Service_Response_Score * 0.20) - (input.Return_Defect_Rate_Percent * 0.30) - (input.Issue_Count * 1.00);
			                    if(score < 0)
			                    {
			                        score = 0;
			                    }
			                    if(score > 100)
			                    {
			                        score = 100;
			                    }
			                    input.Performance_Score = score;
			                }
			                if(input.Performance_Band == null || input.Performance_Band == "")
			                {
			                    if(score >= 90)
			                    {
			                        input.Performance_Band = "Excellent";
			                    }
			                    else if(score >= 70)
			                    {
			                        input.Performance_Band = "Good";
			                    }
			                    else if(score >= 50)
			                    {
			                        input.Performance_Band = "Watchlist";
			                    }
			                    else
			                    {
			                        input.Performance_Band = "Poor";
			                    }
			                }
			                watchlistScore = 70.0;
			                performanceScales = Rating_Scales[Process_Area == "Performance Review" && Active == true];
			                for each scaleRec in performanceScales
			                {
			                    if(scaleRec.Result_Status == "Watchlist" && scaleRec.Max_Value != null)
			                    {
			                        watchlistScore = scaleRec.Max_Value;
			                    }
			                }
			                vendorRec = Vendors[ID == input.Vendor];
			                if(vendorRec.count() > 0)
			                {
			                    vendorRec.Latest_Performance_Score = score;
			                    vendorRec.Last_Review_Month = input.Review_Month;
			                    if(vendorRec.Stage == "Active")
			                    {
			                        vendorRec.Stage = "Performance Reviewed";
			                    }
			                    if(score < watchlistScore || input.Performance_Band == "Watchlist" || input.Performance_Band == "Poor")
			                    {
			                        vendorRec.Qualification_Status = "Watchlist";
			                    }
			                    else
			                    {
			                        vendorRec.Qualification_Status = "Qualified";
			                    }
			                    vendorRec.Lifecycle_Notes = ifnull(vendorRec.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Monthly performance score " + score + " (" + input.Performance_Band + ") recorded by " + zoho.loginuser;
			                }
			            )
			        }
			    }
			}

			Vendor_Performance_Metrics_On_Validate as "Validate Performance Metrics"
			{
			    type = form
			    form = Vendor_Performance_Metrics
			    record event = on add or edit
			    description = "Validates active vendor metrics, prevents duplicate monthly reviews, and calculates configurable performance scoring."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                vendorRec = Vendors[ID == input.Vendor];
			                if(vendorRec.count() == 0)
			                {
			                    alert "Select a valid active vendor before submitting performance metrics.";
			                    cancel submit;
			                }
			                if(vendorRec.Stage != "Active" && vendorRec.Stage != "Performance Reviewed")
			                {
			                    alert "Performance metrics can be recorded only for Active or Performance Reviewed vendors.";
			                    cancel submit;
			                }
			                percentScores = {input.On_Time_Delivery_Percent,input.Quality_Acceptance_Percent,input.Return_Defect_Rate_Percent,input.SLA_Compliance_Percent,input.Service_Response_Score};
			                for each pct in percentScores
			                {
			                    if(pct == null || pct < 0 || pct > 100)
			                    {
			                        alert "All percentage and service score fields must be between 0 and 100.";
			                        cancel submit;
			                    }
			                }
			                if(input.Order_Count == null || input.Order_Count < 0 || input.Issue_Count == null || input.Issue_Count < 0)
			                {
			                    alert "Order Count and Issue Count must be non-negative.";
			                    cancel submit;
			                }
			                if(input.Review_Month == null)
			                {
			                    alert "Review Month is required.";
			                    cancel submit;
			                }
			                periodStart = input.Review_Month.toStartOfMonth();
			                nextPeriodStart = periodStart.addMonth(1);
			                duplicateMetrics = Vendor_Performance_Metrics[Vendor == input.Vendor && Review_Month >= periodStart && Review_Month < nextPeriodStart && ID != input.ID];
			                if(duplicateMetrics.count() > 0)
			                {
			                    alert "A performance metrics record already exists for this vendor and review month.";
			                    cancel submit;
			                }
			                score = (input.On_Time_Delivery_Percent * 0.30) + (input.Quality_Acceptance_Percent * 0.30) + (input.SLA_Compliance_Percent * 0.20) + (input.Service_Response_Score * 0.20) - (input.Return_Defect_Rate_Percent * 0.30) - (input.Issue_Count * 1.00);
			                configuredScore = 0.0;
			                configuredWeight = 0.0;
			                configuredCriteria = 0;
			                performanceWeights = Weightages[Process_Area == "Performance Review" && Active == true];
			                for each weightRec in performanceWeights
			                {
			                    criteriaRec = Criteria[ID == weightRec.Criteria && Active == true];
			                    if(criteriaRec.count() > 0)
			                    {
			                        rawValue = 0.0;
			                        hasRawValue = false;
			                        if(criteriaRec.Criteria_Code == "On_Time_Delivery")
			                        {
			                            rawValue = input.On_Time_Delivery_Percent.toDecimal();
			                            hasRawValue = true;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Quality_Acceptance")
			                        {
			                            rawValue = input.Quality_Acceptance_Percent.toDecimal();
			                            hasRawValue = true;
			                        }
			                        else if(criteriaRec.Criteria_Code == "SLA_Compliance")
			                        {
			                            rawValue = input.SLA_Compliance_Percent.toDecimal();
			                            hasRawValue = true;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Service_Response")
			                        {
			                            rawValue = input.Service_Response_Score.toDecimal();
			                            hasRawValue = true;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Return_Defect_Rate")
			                        {
			                            rawValue = input.Return_Defect_Rate_Percent.toDecimal();
			                            hasRawValue = true;
			                        }
			                        else if(criteriaRec.Criteria_Code == "Issue_Count")
			                        {
			                            rawValue = input.Issue_Count.toDecimal();
			                            hasRawValue = true;
			                        }
			                        if(hasRawValue == true)
			                        {
			                            normalizedValue = rawValue;
			                            if(criteriaRec.Score_Direction == "Lower is Better")
			                            {
			                                if(criteriaRec.Criteria_Code == "Issue_Count")
			                                {
			                                    normalizedValue = 100.0 - (rawValue * 10.0);
			                                }
			                                else
			                                {
			                                    normalizedValue = 100.0 - rawValue;
			                                }
			                            }
			                            if(normalizedValue < 0)
			                            {
			                                normalizedValue = 0;
			                            }
			                            if(normalizedValue > 100)
			                            {
			                                normalizedValue = 100;
			                            }
			                            configuredScore = configuredScore + (normalizedValue * weightRec.Weight_Percent);
			                            configuredWeight = configuredWeight + weightRec.Weight_Percent;
			                            configuredCriteria = configuredCriteria + 1;
			                        }
			                    }
			                }
			                if(configuredCriteria >= 6 && configuredWeight > 0)
			                {
			                    score = configuredScore / configuredWeight;
			                    input.Configured_Score_Used = true;
			                    input.Score_Notes = "Performance score calculated from complete active Performance Review criteria and weightages.";
			                }
			                else
			                {
			                    input.Configured_Score_Used = false;
			                    input.Score_Notes = "Performance score calculated using default fallback formula because performance configuration is incomplete.";
			                }
			                if(score < 0)
			                {
			                    score = 0;
			                }
			                if(score > 100)
			                {
			                    score = 100;
			                }
			                input.Performance_Score = score;
			                bandMatched = false;
			                performanceScales = Rating_Scales[Process_Area == "Performance Review" && Active == true];
			                for each scaleRec in performanceScales
			                {
			                    if(score >= scaleRec.Min_Value && score <= scaleRec.Max_Value && !bandMatched)
			                    {
			                        input.Performance_Band = scaleRec.Result_Status;
			                        bandMatched = true;
			                    }
			                }
			                if(!bandMatched)
			                {
			                    if(score >= 90)
			                    {
			                        input.Performance_Band = "Excellent";
			                    }
			                    else if(score >= 70)
			                    {
			                        input.Performance_Band = "Good";
			                    }
			                    else if(score >= 50)
			                    {
			                        input.Performance_Band = "Watchlist";
			                    }
			                    else
			                    {
			                        input.Performance_Band = "Poor";
			                    }
			                }
			                if(input.Review_Status == null || input.Review_Status == "" || input.Review_Status == "Draft")
			                {
			                    input.Review_Status = "Completed";
			                }
			            )
			        }
			    }
			}

			Vendor_Registration_On_Success as "Convert Registration"
			{
			    type = form
			    form = Vendor_Registration
			    record event = on add or edit
			    description = "Creates or updates vendor and primary contact records when a registration is accepted."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Registration_Status == "Accepted" || input.Registration_Status == "Converted")
			                {
			                    vendorId = input.Linked_Vendor;
			                    if(vendorId == null)
			                    {
			                        vendorId = insert into Vendors
			                        [
			                            Vendor_Name = input.Vendor_Name
			                            Vendor_Category_Config = input.Vendor_Category
			                            Primary_Product_Service_Category = input.Primary_Product_Service_Category
			                            Vendor_Type = input.Vendor_Type
			                            Registration_Date = input.Registration_Date
			                            Stage = "Registered"
			                            Qualification_Status = "Pending"
			                            Vendor_Status = "Pending Review"
			                            Contact_Person = input.Contact_Name
			                            Contact_Email = input.Contact_Email
			                            Contact_Phone = input.Contact_Phone
			                            Vendor_Address = input.Vendor_Address
			                            Tax_ID = input.Tax_ID
			                            Business_Registration_Number = input.Business_Registration_Number
			                            Registration_Document = input.Registration_Document
			                            Compliance_Document = input.Compliance_Document
			                            Lifecycle_Notes = zoho.currentdate.toString() + " - Vendor created from registration " + input.Registration_ID
			                        ];
			                        input.Linked_Vendor = vendorId;
			                    }
			                    else
			                    {
			                        vendorRec = Vendors[ID == vendorId];
			                        if(vendorRec.count() > 0)
			                        {
			                            vendorRec.Vendor_Name = input.Vendor_Name;
			                            vendorRec.Vendor_Category_Config = input.Vendor_Category;
			                            vendorRec.Primary_Product_Service_Category = input.Primary_Product_Service_Category;
			                            vendorRec.Vendor_Type = input.Vendor_Type;
			                            vendorRec.Contact_Person = input.Contact_Name;
			                            vendorRec.Contact_Email = input.Contact_Email;
			                            vendorRec.Contact_Phone = input.Contact_Phone;
			                            vendorRec.Vendor_Address = input.Vendor_Address;
			                            vendorRec.Tax_ID = input.Tax_ID;
			                            vendorRec.Business_Registration_Number = input.Business_Registration_Number;
			                            vendorRec.Vendor_Status = "Pending Review";
			                            vendorRec.Lifecycle_Notes = ifnull(vendorRec.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Vendor updated from registration " + input.Registration_ID;
			                        }
			                    }
			                    if(input.Contact_Email != null && input.Contact_Email != "")
			                    {
			                        existingContact = Vendor_Contacts[Vendor == vendorId && Email == input.Contact_Email];
			                        if(existingContact.count() > 0)
			                        {
			                            existingContact.Contact_Name = input.Contact_Name;
			                            existingContact.Contact_Role = "Primary";
			                            existingContact.Phone = input.Contact_Phone;
			                            existingContact.Primary_Contact = true;
			                            existingContact.Active = true;
			                        }
			                        else
			                        {
			                            insert into Vendor_Contacts
			                            [
			                                Vendor = vendorId
			                                Contact_Name = input.Contact_Name
			                                Contact_Role = "Primary"
			                                Email = input.Contact_Email
			                                Phone = input.Contact_Phone
			                                Primary_Contact = true
			                                Active = true
			                            ];
			                        }
			                    }
			                    if(input.Registration_Document != null || input.Compliance_Document != null)
			                    {
			                        vendorForNote = Vendors[ID == vendorId];
			                        if(vendorForNote.count() > 0)
			                        {
			                            vendorForNote.Lifecycle_Notes = ifnull(vendorForNote.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Initial registration documents retained on registration record " + input.Registration_ID;
			                        }
			                    }
			                    input.Registration_Status = "Converted";
			                }
			            )
			        }
			    }
			}

			Vendor_Registration_On_Validate as "Validate Registration"
			{
			    type = form
			    form = Vendor_Registration
			    record event = on add or edit
			    description = "Validates registration readiness and prevents obvious duplicates."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Registration_Status == null || input.Registration_Status == "")
			                {
			                    input.Registration_Status = "Draft";
			                }
			                if(input.Vendor_Name == null || input.Vendor_Name == "")
			                {
			                    alert "Vendor Name is required.";
			                    cancel submit;
			                }
			                if(input.Registration_Status == "Submitted" || input.Registration_Status == "Accepted" || input.Registration_Status == "Converted")
			                {
			                    if(input.Contact_Email == null || input.Contact_Email == "")
			                    {
			                        alert "Contact Email is required before submitting or accepting registration.";
			                        cancel submit;
			                    }
			                }
			                if(input.Registration_Status == "Accepted" || input.Registration_Status == "Converted")
			                {
			                    if(input.Vendor_Type == null || input.Vendor_Type == "")
			                    {
			                        alert "Vendor Type is required before conversion.";
			                        cancel submit;
			                    }
			                }
			                duplicateVendor = Vendors[Vendor_Name == input.Vendor_Name && ID != input.Linked_Vendor];
			                if(duplicateVendor.count() > 0 && input.Linked_Vendor == null)
			                {
			                    if(input.Tax_ID != null && input.Tax_ID != "" && duplicateVendor.Tax_ID == input.Tax_ID)
			                    {
			                        alert "A vendor with this name and Tax ID already exists.";
			                        cancel submit;
			                    }
			                    if(input.Business_Registration_Number != null && input.Business_Registration_Number != "" && duplicateVendor.Business_Registration_Number == input.Business_Registration_Number)
			                    {
			                        alert "A vendor with this name and business registration number already exists.";
			                        cancel submit;
			                    }
			                }
			                duplicateRegistration = Vendor_Registration[Vendor_Name == input.Vendor_Name && Registration_Status != "Rejected" && ID != input.ID];
			                if(input.Registration_Status != "Rejected" && duplicateRegistration.count() > 0 && input.Linked_Vendor == null)
			                {
			                    alert "Another active registration already exists for this vendor name.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Vendors_On_Success as "Record Vendor Lifecycle Notes"
			{
			    type = form
			    form = Vendors
			    record event = on add or edit
			    description = "Maintains master defaults and lifecycle note trail."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Stage == null || input.Stage == "")
			                {
			                    input.Stage = "Registered";
			                }
			                if(input.Qualification_Status == null || input.Qualification_Status == "")
			                {
			                    input.Qualification_Status = "Pending";
			                }
			                if(input.Vendor_Status == null || input.Vendor_Status == "")
			                {
			                    input.Vendor_Status = "Draft";
			                }
			                if(input.Stage == "Registered" && input.Vendor_Status == "Draft" && input.Contact_Email != null)
			                {
			                    input.Vendor_Status = "Pending Review";
			                }
			                noteLine = zoho.currentdate.toString() + " - " + zoho.loginuser + " saved vendor at stage " + input.Stage;
			                if(input.Lifecycle_Notes == null || input.Lifecycle_Notes == "")
			                {
			                    input.Lifecycle_Notes = noteLine;
			                }
			                else
			                {
			                    input.Lifecycle_Notes = input.Lifecycle_Notes + "\n" + noteLine;
			                }
			            )
			        }
			    }
			}

			Vendors_On_Validate as "Validate Vendor Lifecycle"
			{
			    type = form
			    form = Vendors
			    record event = on add or edit
			    description = "Validates vendor master defaults and lifecycle consistency before saving."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Vendor_Name == null || input.Vendor_Name == "")
			                {
			                    alert "Vendor Name is required.";
			                    cancel submit;
			                }
			                if(input.Stage == null || input.Stage == "")
			                {
			                    input.Stage = "Registered";
			                }
			                if(input.Qualification_Status == null || input.Qualification_Status == "")
			                {
			                    input.Qualification_Status = "Pending";
			                }
			                if(input.Vendor_Status == null || input.Vendor_Status == "")
			                {
			                    input.Vendor_Status = "Draft";
			                }
			                if(input.Stage == "Evaluated" || input.Stage == "Risk Assessed" || input.Stage == "Onboarded" || input.Stage == "Active" || input.Stage == "Performance Reviewed")
			                {
			                    if(input.Current_Evaluation_Rating == null || input.Current_Evaluation_Rating < 3 || input.Evaluation_Result != "Acceptable")
			                    {
			                        alert "Vendor cannot move beyond Registered until an acceptable evaluation is recorded.";
			                        cancel submit;
			                    }
			                }
			                if(input.Stage == "Risk Assessed" || input.Stage == "Onboarded" || input.Stage == "Active" || input.Stage == "Performance Reviewed")
			                {
			                    if(input.Latest_Risk_Status != "Acceptable" || (input.Latest_Risk_Tier != "Low" && input.Latest_Risk_Tier != "Medium"))
			                    {
			                        alert "Vendor cannot move beyond Evaluated until risk is acceptable.";
			                        cancel submit;
			                    }
			                }
			                if(input.Stage == "Onboarded" || input.Stage == "Active" || input.Stage == "Performance Reviewed")
			                {
			                    if(input.Onboarding_Baseline_Score == null || input.Onboarding_Baseline_Score < 70)
			                    {
			                        alert "Vendor cannot move beyond Risk Assessed until onboarding reaches the required baseline score.";
			                        cancel submit;
			                    }
			                }
			                if(input.Stage == "Active" || input.Stage == "Performance Reviewed")
			                {
			                    if(input.Active_From == null)
			                    {
			                        alert "Active From is required before activating a vendor.";
			                        cancel submit;
			                    }
			                }
			                if(input.Stage == "Performance Reviewed" && input.Latest_Performance_Score == null)
			                {
			                    alert "Latest Performance Score is required before marking performance reviewed.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Weightages_On_Validate as "Validate Weightage"
			{
			    type = form
			    form = Weightages
			    record event = on add or edit
			    description = "Validates weight percentage and active process total."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Weight_Percent == null || input.Weight_Percent <= 0 || input.Weight_Percent > 100)
			                {
			                    alert "Weight % must be greater than 0 and not more than 100.";
			                    cancel submit;
			                }
			                if(input.Effective_From == null)
			                {
			                    input.Effective_From = zoho.currentdate;
			                }
			                if(input.Effective_To != null && input.Effective_To < input.Effective_From)
			                {
			                    alert "Effective To must be greater than or equal to Effective From.";
			                    cancel submit;
			                }
			                if(input.Active == true)
			                {
			                    activeWeights = Weightages[Process_Area == input.Process_Area && Active == true && ID != input.ID];
			                    totalWeight = input.Weight_Percent;
			                    for each weightRec in activeWeights
			                    {
			                        includeWeight = false;
			                        if(input.Effective_To == null && weightRec.Effective_To == null)
			                        {
			                            includeWeight = true;
			                        }
			                        else if(input.Effective_To == null && weightRec.Effective_To != null && weightRec.Effective_To >= input.Effective_From)
			                        {
			                            includeWeight = true;
			                        }
			                        else if(input.Effective_To != null && weightRec.Effective_To == null && weightRec.Effective_From <= input.Effective_To)
			                        {
			                            includeWeight = true;
			                        }
			                        else if(input.Effective_To != null && weightRec.Effective_To != null && weightRec.Effective_From <= input.Effective_To && weightRec.Effective_To >= input.Effective_From)
			                        {
			                            includeWeight = true;
			                        }
			                        if(includeWeight == true)
			                        {
			                            totalWeight = totalWeight + ifnull(weightRec.Weight_Percent,0);
			                        }
			                    }
			                    if(totalWeight > 100)
			                    {
			                        alert "Total active weightages for this process area and effective period cannot exceed 100%.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}
		}

		blueprint
		{
			Vendor_Lifecycle as "Vendor Lifecycle"
			{
			    type = blueprint
			    form = Vendors
			
			    start
			    {
			        start stage = "Registered"
			    }
			
			    stages
			    {
			        "Registered" { }
			        "Evaluated" { }
			        "Risk Assessed" { }
			        "Onboarded" { }
			        "Active" { }
			        "Performance Reviewed" { }
			    }
			
			    transitions
			    {
			        Complete_Evaluation as "Complete Evaluation"
			        {
			            type = normal
			            from stage = "Registered"
			            to stage = "Evaluated"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Vendor_Evaluation_Specialist","Procurement_Manager"}
			                )
			                transition criteria = (Current_Evaluation_Rating >= 3 && Evaluation_Result == "Acceptable")
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    input.Vendor_Status = "Pending Review";
			                    input.Qualification_Status = "Pending";
			                    input.Lifecycle_Notes = ifnull(input.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Evaluation completed by " + zoho.loginuser;
			                    )
			                }
			            }
			        }
			
			        Complete_Risk_Assessment as "Complete Risk Assessment"
			        {
			            type = normal
			            from stage = "Evaluated"
			            to stage = "Risk Assessed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Vendor_Evaluation_Specialist","Procurement_Manager"}
			                )
			                transition criteria = (Latest_Risk_Status == "Acceptable" && (Latest_Risk_Tier == "Low" || Latest_Risk_Tier == "Medium"))
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    input.Vendor_Status = "Pending Review";
			                    input.Lifecycle_Notes = ifnull(input.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Risk assessment accepted by " + zoho.loginuser;
			                    )
			                }
			            }
			        }
			
			        Complete_Onboarding as "Complete Onboarding"
			        {
			            type = normal
			            from stage = "Risk Assessed"
			            to stage = "Onboarded"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Vendor_Manager","Procurement_Manager"}
			                )
			                transition criteria = (Onboarding_Baseline_Score >= 70)
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    input.Vendor_Status = "Approved";
			                    input.Qualification_Status = "Qualified";
			                    input.Lifecycle_Notes = ifnull(input.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Onboarding completed by " + zoho.loginuser;
			                    )
			                }
			            }
			        }
			
			        Activate_Vendor as "Activate Vendor"
			        {
			            type = normal
			            from stage = "Onboarded"
			            to stage = "Active"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Vendor_Manager","Procurement_Manager"}
			                )
			                transition criteria = (Active_From is not null)
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    input.Vendor_Status = "Approved";
			                    input.Lifecycle_Notes = ifnull(input.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Vendor activated by " + zoho.loginuser;
			                    )
			                }
			            }
			        }
			
			        Record_Performance_Review as "Record Performance Review"
			        {
			            type = normal
			            from stage = "Active"
			            to stage = "Performance Reviewed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Procurement_Manager","Vendor_Manager"}
			                )
			                transition criteria = (Latest_Performance_Score is not null)
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    if(input.Latest_Performance_Score < 70)
			                    {
			                        input.Qualification_Status = "Watchlist";
			                        input.Vendor_Status = "Pending Review";
			                    }
			                    else
			                    {
			                        input.Qualification_Status = "Qualified";
			                        input.Vendor_Status = "Approved";
			                    }
			                    input.Lifecycle_Notes = ifnull(input.Lifecycle_Notes,"") + "\n" + zoho.currentdate.toString() + " - Performance reviewed by " + zoho.loginuser;
			                    )
			                }
			            }
			        }
			    }
			}
		}
	}

