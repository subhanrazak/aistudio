Align='center' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t<pc>\n\t\t\t\t\t<image marginRight='7px' color='#FFFFFF' bgColor='#EA4335' width='52px' height='52px' type='icon' value='ui-2-time' size='28px' cornerRadius='26px' iconType='outline' />\n\t\t\t\t</pc>\n\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<text color='#5F6199' size='14px' type='Text' value='High/Critical Risk Vendors'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<button text='View High Risk' action='OpenReport' componentLinkName='High_Risk_Vendors' appLinkName='thisapp' target='same-window' bgColor='#EA4335' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' />\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t</pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='34%'>\n\t\t\t\t<panel elementName='KPI_Pending_Onboarding'>\n\t<pr width='fill' height='fill'>\n\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='center' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t<pc>\n\t\t\t\t\t<image marginRight='7px' color='#FFFFFF' bgColor='#00A3BF' width='52px' height='52px' type='icon' value='ui-1-calendar-grid-58' size='28px' cornerRadius='26px' iconType='outline' />\n\t\t\t\t</pc>\n\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<text color='#5F6199' size='14px' type='Text' value='Pending Onboarding'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t<button text='View Onboarding' action='OpenReport' componentLinkName='Onboarding_Pending' appLinkName='thisapp' target='same-window' bgColor='#00A3BF' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' />\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t</pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<panel elementName='Lifecycle_Distribution_Chart'>\n\t<pr width='fill' height='auto'>\n\t\t<pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Lifecycle Distribution'> </text></pc></pr>\n\t\t\t<pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Open lifecycle reports to review vendors by stage and manage movement through the lifecycle.'> </text></pc></pr>\n\t\t\t<pr>\n\t\t\t\t<pc paddingTop='12px' width='50%' hAlign='left'><button text='All Vendors' action='OpenReport' componentLinkName='All_Vendors' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='50%' hAlign='left'><button text='Lifecycle Board' action='OpenReport' componentLinkName='Vendor_Lifecycle_Board' appLinkName='thisapp' target='same-window' bgColor='#5F6199' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<panel elementName='Risk_Tier_Distribution_Chart'>\n\t<pr width='fill' height='auto'>\n\t\t<pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Risk Tier Distribution'> </text></pc></pr>\n\t\t\t<pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Open risk assessment reports for tier review, mitigation follow-up, and acceptable-risk checks.'> </text></pc></pr>\n\t\t\t<pr>\n\t\t\t\t<pc paddingTop='12px' width='33%' hAlign='left'><button text='All Risks' action='OpenReport' componentLinkName='All_Risk_Assessments' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='33%' hAlign='left'><button text='High Risk' action='OpenReport' componentLinkName='High_Risk_Vendors' appLinkName='thisapp' target='same-window' bgColor='#EA4335' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='34%' hAlign='left'><button text='Acceptable' action='OpenReport' componentLinkName='Acceptable_Risk_Assessments' appLinkName='thisapp' target='same-window' bgColor='#16AD78' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<panel elementName='Performance_Band_Chart'>\n\t<pr width='fill' height='auto'>\n\t\t<pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Performance Band Distribution'> </text></pc></pr>\n\t\t\t<pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Open performance scorecards, history, and watchlist reports for monthly vendor review.'> </text></pc></pr>\n\t\t\t<pr>\n\t\t\t\t<pc paddingTop='12px' width='33%' hAlign='left'><button text='Scorecards' action='OpenReport' componentLinkName='Monthly_Performance_Scorecards' appLinkName='thisapp' target='same-window' bgColor='#8A3DFB' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='33%' hAlign='left'><button text='History' action='OpenReport' componentLinkName='Vendor_Performance_History' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='34%' hAlign='left'><button text='Watchlist' action='OpenReport' componentLinkName='Performance_Watchlist' appLinkName='thisapp' target='same-window' bgColor='#EA4335' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<panel elementName='Registration_Status_Chart'>\n\t<pr width='fill' height='auto'>\n\t\t<pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Registration Status Distribution'> </text></pc></pr>\n\t\t\t<pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Open registration queues and conversion history for supplier intake follow-up.'> </text></pc></pr>\n\t\t\t<pr>\n\t\t\t\t<pc paddingTop='12px' width='33%' hAlign='left'><button text='Pending' action='OpenReport' componentLinkName='Pending_Registrations' appLinkName='thisapp' target='same-window' bgColor='#F37D16' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='33%' hAlign='left'><button text='All' action='OpenReport' componentLinkName='All_Registrations' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='34%' hAlign='left'><button text='Converted' action='OpenReport' componentLinkName='Converted_Registrations' appLinkName='thisapp' target='same-window' bgColor='#16AD78' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<panel elementName='Average_Performance_Gauge'>\n\t<pr width='fill' height='auto'>\n\t\t<pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Average Performance Gauge'> </text></pc></pr>\n\t\t\t<pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Use the scorecard reports to review latest monthly performance scores and identify watchlist vendors.'> </text></pc></pr>\n\t\t\t<pr>\n\t\t\t\t<pc paddingTop='12px' width='50%' hAlign='left'><button text='Scorecards' action='OpenReport' componentLinkName='Monthly_Performance_Scorecards' appLinkName='thisapp' target='same-window' bgColor='#16AD78' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='50%' hAlign='left'><button text='Watchlist' action='OpenReport' componentLinkName='Performance_Watchlist' appLinkName='thisapp' target='same-window' bgColor='#EA4335' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<panel elementName='Risk_Count_Board_Panel'>\n\t<pr width='fill' height='auto'>\n\t\t<pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Risk Tier Counts'> </text></pc></pr>\n\t\t\t<pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Open risk reports to monitor low, medium, high, and critical vendor risk tiers.'> </text></pc></pr>\n\t\t\t<pr>\n\t\t\t\t<pc paddingTop='12px' width='33%' hAlign='left'><button text='All Risks' action='OpenReport' componentLinkName='All_Risk_Assessments' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='33%' hAlign='left'><button text='High/Critical' action='OpenReport' componentLinkName='High_Risk_Vendors' appLinkName='thisapp' target='same-window' bgColor='#EA4335' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t\t<pc paddingTop='12px' width='34%' hAlign='left'><button text='Acceptable' action='OpenReport' componentLinkName='Acceptable_Risk_Assessments' appLinkName='thisapp' target='same-window' bgColor='#16AD78' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Vendor_Lifecycle_Board_Access'>\n\t<pr width='fill' height='auto'>\n\t\t<pc padding='14px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>\n\t\t\t<pr width='fill' height='auto'>\n\t\t\t\t<pc width='70%' hAlign='left' vAlign='middle'>\n\t\t\t\t\t<text color='#12132B' size='16px' bold='true' type='Text' value='Vendor Lifecycle Board'> </text>\n\t\t\t\t\t<text marginLeft='8px' color='#5F6199' size='13px' type='Text' value='Open the full Kanban lifecycle view for vendor stage management.'> </text>\n\t\t\t\t</pc>\n\t\t\t\t<pc width='30%' hAlign='right' vAlign='middle'>\n\t\t\t\t\t<button text='Open Lifecycle Board' action='OpenReport' componentLinkName='Vendor_Lifecycle_Board' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='14px' cornerRadius='8px' paddingTop='10px' paddingLeft='16px' paddingRight='16px' paddingBottom='10px' />\n\t\t\t\t</pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Embedded_Performance_Watchlist'>\n\t<pr width='fill' height='auto'><pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'><pr><pc width='70%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Performance Watchlist'> </text><text marginLeft='8px' color='#5F6199' size='13px' type='Text' value='Open vendors below the target performance score for action planning.'> </text></pc><pc width='30%' hAlign='right'><button text='Open Watchlist' action='OpenReport' componentLinkName='Performance_Watchlist' appLinkName='thisapp' target='same-window' bgColor='#EA4335' color='#FFFFFF' size='14px' cornerRadius='8px' paddingTop='10px' paddingLeft='16px' paddingRight='16px' paddingBottom='10px' /></pc></pr></pc></pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Embedded_Pending_Registrations'>\n\t<pr width='fill' height='auto'><pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'><pr><pc width='70%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Pending Registrations'> </text><text marginLeft='8px' color='#5F6199' size='13px' type='Text' value='Open draft and submitted vendor registrations awaiting review.'> </text></pc><pc width='30%' hAlign='right'><button text='Open Pending' action='OpenReport' componentLinkName='Pending_Registrations' appLinkName='thisapp' target='same-window' bgColor='#F37D16' color='#FFFFFF' size='14px' cornerRadius='8px' paddingTop='10px' paddingLeft='16px' paddingRight='16px' paddingBottom='10px' /></pc></pr></pc></pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Embedded_Pending_Document_Verification'>\n\t<pr width='fill' height='auto'><pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'><pr><pc width='70%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Pending Document Verification'> </text><text marginLeft='8px' color='#5F6199' size='13px' type='Text' value='Open uploaded vendor documents that still need verification.'> </text></pc><pc width='30%' hAlign='right'><button text='Open Documents' action='OpenReport' componentLinkName='Pending_Document_Verification' appLinkName='thisapp' target='same-window' bgColor='#00A3BF' color='#FFFFFF' size='14px' cornerRadius='8px' paddingTop='10px' paddingLeft='16px' paddingRight='16px' paddingBottom='10px' /></pc></pr></pc></pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Embedded_Expiring_Documents'>\n\t<pr width='fill' height='auto'><pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'><pr><pc width='70%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Expiring Documents'> </text><text marginLeft='8px' color='#5F6199' size='13px' type='Text' value='Open document records with expiry dates for renewal follow-up.'> </text></pc><pc width='30%' hAlign='right'><button text='Open Expiring' action='OpenReport' componentLinkName='Expiring_Documents' appLinkName='thisapp' target='same-window' bgColor='#5F6199' color='#FFFFFF' size='14px' cornerRadius='8px' paddingTop='10px' paddingLeft='16px' paddingRight='16px' paddingBottom='10px' /></pc></pr></pc></pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			App_Users_On_Validate as "Validate User"
			{
			    type = form
			    form = App_Users
			    record event = on add or edit
			    description = "Validates active user email uniqueness."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.User_Email == null || input.User_Email == "")
			                {
			                    alert "User Email is required.";
			                    cancel submit;
			                }
			                input.User_Email = input.User_Email.trim().toLowerCase();
			                duplicateUser = App_Users[User_Email == input.User_Email && Active == true && ID != input.ID];
			                if(input.Active == true && duplicateUser.count() > 0)
			                {
			                    alert "An active user with this email already exists.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Categories_On_Validate as "Validate Category"
			{
			    type = form
			    form = Categories
			    record event = on add or edit
			    description = "Validates category name and active code uniqueness."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Category_Name == null || input.Category_Name == "")
			                {
			                    alert "Category Name is required.";
			                    cancel submit;
			                }
			                if(input.Category_Code != null && input.Category_Code != "")
			                {
			                    input.Category_Code = input.Category_Code.trim().toUpperCase();
			                    duplicateCode = Categories[Category_Type == input.Category_Type && Category_Code == input.Category_Code && Active == true && ID != input.ID];
			                    if(input.Active == true && duplicateCode.count() > 0)
			                    {
			                        alert "An active category with this code already exists for the selected category type.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Criteria_On_Validate as "Validate Criteria"
			{
			    type = form
			    form = Criteria
			    record event = on add or edit
			    description = "Validates criteria score range and active code uniqueness."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Max_Score == null || input.Min_Score == null || input.Max_Score <= input.Min_Score)
			                {
			                    alert "Max Score must be greater than Min Score.";
			                    cancel submit;
			                }
			                if(input.Criteria_Code != null && input.Criteria_Code != "")
			                {
			                    input.Criteria_Code = input.Criteria_Code.trim().toUpperCase();
			                    duplicateCriteria = Criteria[Process_Area == input.Process_Area && Criteria_Code == input.Criteria_Code && Active == true && ID != input.ID];
			                    if(input.Active == true && duplicateCriteria.count() > 0)
			                    {
			                        alert "An active criteria record with this code already exists for the selected process area.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Products_Services_On_Validate as "Validate Product / Service"
			{
			    type = form
			    form = Products_Services
			    record event = on add or edit
			    description = "Blocks duplicate active offering names for the same vendor."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Offering_Name == null || input.Offering_Name == "")
			                {
			                    alert "Product / Service Name is required.";
			                    cancel submit;
			                }
			                duplicateOffering = Products_Services[Vendor == input.Vendor && Offering_Name == input.Offering_Name && Active == true && ID != input.ID];
			                if(input.Active == true && duplicateOffering.count() > 0)
			                {
			                    alert "An active product / service with this name already exists for this vendor.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Rating_Scales_On_Validate as "Validate Rating Scale"
			{
			    type = form
			    form = Rating_Scales
			    record event = on add or edit
			    description = "Validates rating scale ranges and overlap."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Min_Value == null || input.Max_Value == null || input.Max_Value <= input.Min_Value)
			                {
			                    alert "Max Value must be greater than Min Value.";
			                    cancel submit;
			                }
			                if(input.Scale_Code != null && input.Scale_Code != "")
			                {
			                    input.Scale_Code = input.Scale_Code.trim().toUpperCase();
			                }
			                if(input.Active == true)
			                {
			                    overlappingScales = Rating_Scales[Process_Area == input.Process_Area && Active == true && Min_Value < input.Max_Value && Max_Value > input.Min_Value && ID != input.ID];
			                    if(overlappingScales.count() > 0)
			                    {
			                        alert "An active rating scale range already overlaps this process area and value range.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Compliance_Risk_Score_On_User_Input as "Recalculate Risk From Compliance Score"
			{
			    type = form
			    form = Risk_Assessments
			    record event = on add or edit
			    description = "Recalculates weighted risk tier and status while entering compliance risk."
			
			    on user input of Compliance_Risk_Score
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Financial_Risk_Score != null && input.Compliance_Risk_Score != null && input.Operational_Risk_Score != null && input.Cyber_Risk_Score != null)
			                {
			                    financialWeight = 25.0;
			                    complianceWeight = 25.0;
			                    operationalWeight = 25.0;
			                    cyberWeight = 25.0;
			                    configuredTotal = 0.0;
			                    weights = Weightages[Process_Area == "Risk Assessment" && Active == true];
			                    for each weightRec in weights
			                    {
			                        criteriaRec = Criteria[ID == weightRec.Criteria];
			                        if(criteriaRec.count() > 0)
			                        {
			                            if(criteriaRec.Criteria_Code == "Financial_Risk")
			                            {
			                                financialWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Compliance_Risk")
			                            {
			                                complianceWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Operational_Risk")
			                            {
			                                operationalWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Cyber_Risk")
			                            {
			                                cyberWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                        }
			                    }
			                    if(configuredTotal <= 0)
			                    {
			                        configuredTotal = 100.0;
			                    }
			                    totalRisk = ((input.Financial_Risk_Score * financialWeight) + (input.Compliance_Risk_Score * complianceWeight) + (input.Operational_Risk_Score * operationalWeight) + (input.Cyber_Risk_Score * cyberWeight)) / configuredTotal;
			                    input.Weighted_Risk_Score = totalRisk;
			                    scaleMatched = false;
			                    scales = Rating_Scales[Process_Area == "Risk Assessment" && Active == true];
			                    for each scaleRec in scales
			                    {
			                        if(totalRisk >= scaleRec.Min_Value && totalRisk <= scaleRec.Max_Value)
			                        {
			                            if(scaleRec.Result_Status == "Low" || scaleRec.Result_Status == "Medium" || scaleRec.Result_Status == "High" || scaleRec.Result_Status == "Critical")
			                            {
			                                input.Risk_Tier = scaleRec.Result_Status;
			                            }
			                            if(scaleRec.Acceptable == true)
			                            {
			                                input.Risk_Status = "Acceptable";
			                            }
			                            else
			                            {
			                                input.Risk_Status = "Unacceptable";
			                            }
			                            scaleMatched = true;
			                        }
			                    }
			                    if(scaleMatched == false || input.Risk_Tier == null || input.Risk_Tier == "")
			                    {
			                        if(totalRisk < 30)
			                        {
			                            input.Risk_Tier = "Low";
			                            input.Risk_Status = "Acceptable";
			                        }
			                        else if(totalRisk < 60)
			                        {
			                            input.Risk_Tier = "Medium";
			                            input.Risk_Status = "Acceptable";
			                        }
			                        else if(totalRisk < 80)
			                        {
			                            input.Risk_Tier = "High";
			                            input.Risk_Status = "Unacceptable";
			                        }
			                        else
			                        {
			                            input.Risk_Tier = "Critical";
			                            input.Risk_Status = "Unacceptable";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Cyber_Risk_Score_On_User_Input as "Recalculate Risk From Cyber Score"
			{
			    type = form
			    form = Risk_Assessments
			    record event = on add or edit
			    description = "Recalculates weighted risk tier and status while entering cyber risk."
			
			    on user input of Cyber_Risk_Score
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Financial_Risk_Score != null && input.Compliance_Risk_Score != null && input.Operational_Risk_Score != null && input.Cyber_Risk_Score != null)
			                {
			                    financialWeight = 25.0;
			                    complianceWeight = 25.0;
			                    operationalWeight = 25.0;
			                    cyberWeight = 25.0;
			                    configuredTotal = 0.0;
			                    weights = Weightages[Process_Area == "Risk Assessment" && Active == true];
			                    for each weightRec in weights
			                    {
			                        criteriaRec = Criteria[ID == weightRec.Criteria];
			                        if(criteriaRec.count() > 0)
			                        {
			                            if(criteriaRec.Criteria_Code == "Financial_Risk")
			                            {
			                                financialWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Compliance_Risk")
			                            {
			                                complianceWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Operational_Risk")
			                            {
			                                operationalWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Cyber_Risk")
			                            {
			                                cyberWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                        }
			                    }
			                    if(configuredTotal <= 0)
			                    {
			                        configuredTotal = 100.0;
			                    }
			                    totalRisk = ((input.Financial_Risk_Score * financialWeight) + (input.Compliance_Risk_Score * complianceWeight) + (input.Operational_Risk_Score * operationalWeight) + (input.Cyber_Risk_Score * cyberWeight)) / configuredTotal;
			                    input.Weighted_Risk_Score = totalRisk;
			                    scaleMatched = false;
			                    scales = Rating_Scales[Process_Area == "Risk Assessment" && Active == true];
			                    for each scaleRec in scales
			                    {
			                        if(totalRisk >= scaleRec.Min_Value && totalRisk <= scaleRec.Max_Value)
			                        {
			                            if(scaleRec.Result_Status == "Low" || scaleRec.Result_Status == "Medium" || scaleRec.Result_Status == "High" || scaleRec.Result_Status == "Critical")
			                            {
			                                input.Risk_Tier = scaleRec.Result_Status;
			                            }
			                            if(scaleRec.Acceptable == true)
			                            {
			                                input.Risk_Status = "Acceptable";
			                            }
			                            else
			                            {
			                                input.Risk_Status = "Unacceptable";
			                            }
			                            scaleMatched = true;
			                        }
			                    }
			                    if(scaleMatched == false || input.Risk_Tier == null || input.Risk_Tier == "")
			                    {
			                        if(totalRisk < 30)
			                        {
			                            input.Risk_Tier = "Low";
			                            input.Risk_Status = "Acceptable";
			                        }
			                        else if(totalRisk < 60)
			                        {
			                            input.Risk_Tier = "Medium";
			                            input.Risk_Status = "Acceptable";
			                        }
			                        else if(totalRisk < 80)
			                        {
			                            input.Risk_Tier = "High";
			                            input.Risk_Status = "Unacceptable";
			                        }
			                        else
			                        {
			                            input.Risk_Tier = "Critical";
			                            input.Risk_Status = "Unacceptable";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Financial_Risk_Score_On_User_Input as "Recalculate Risk From Financial Score"
			{
			    type = form
			    form = Risk_Assessments
			    record event = on add or edit
			    description = "Recalculates weighted risk tier and status while entering financial risk."
			
			    on user input of Financial_Risk_Score
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Financial_Risk_Score != null && input.Compliance_Risk_Score != null && input.Operational_Risk_Score != null && input.Cyber_Risk_Score != null)
			                {
			                    financialWeight = 25.0;
			                    complianceWeight = 25.0;
			                    operationalWeight = 25.0;
			                    cyberWeight = 25.0;
			                    configuredTotal = 0.0;
			                    weights = Weightages[Process_Area == "Risk Assessment" && Active == true];
			                    for each weightRec in weights
			                    {
			                        criteriaRec = Criteria[ID == weightRec.Criteria];
			                        if(criteriaRec.count() > 0)
			                        {
			                            if(criteriaRec.Criteria_Code == "Financial_Risk")
			                            {
			                                financialWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Compliance_Risk")
			                            {
			                                complianceWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Operational_Risk")
			                            {
			                                operationalWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                            else if(criteriaRec.Criteria_Code == "Cyber_Risk")
			                            {
			                                cyberWeight = weightRec.Weight_Percent;
			                                configuredTotal = configuredTotal + weightRec.Weight_Percent;
			                            }
			                        }
			                    }
			                    if(configuredTotal <= 0)
			                    {
			                        configuredTotal = 100.0;
			                    }
			                    totalRisk = ((input.Financial_Risk_Score * financialWeight) + (input.Compliance_Risk_Score * complianceWeight) + (input.Operational_Risk_Score * operationalWeight) + (input.Cyber_Risk_Score * cyberWeight)) / configuredTotal;
			                    input.Weighted_Risk_Score = totalRisk;
			                    scaleMatched = false;
			                    scales = Rating_Scales[Process_Area == "Risk Assessment" && Active == true];
			                    for each scaleRec in scales
			                    {
			                        if(totalRisk >= scaleRec.Min_Value && totalRisk <= scaleRec.Max_Value)
			                        {
			                            if(scaleRec.Result_Status == "Low" || scaleRec.Result_Status == "Medium" || scaleRec.Result_Status == "High" || scaleRec.Result_Status == "Critical")
			                            {
			                                input.Risk_Tier = scaleRec.Result_Status;
			                            }
			                            if(scaleRec.Acceptable == true)
			                            {
			                                input.Risk_Status = "Acceptable";
			                            }
			                            else
			                            {
			                                input.Risk_Status = "Unacceptable";
			                            }
			                            scaleMatched = true;
			                        }
			                    }
			                    if(scaleMatched == false || input.Risk_Tier == null || input.Risk_Tier == "")
			                    {
			                        if(totalRisk < 30)
			                        {
			                            input.Risk_Tier = "Low";
			                            input.Risk_Status = "Acceptable";
			                        }
			                        else if(totalRisk < 60)
			                        {
			                            input.Risk_Tier = "Medium";
			                            input.Risk_Status = "Acceptable";
			                        }
			                        else if(totalRisk < 80)
			                        {
			                            input.Risk_Tier = "High";
			                            input.Risk_Status = "Unacceptable";
			                        }
			                        else
			                        {
			                            input.Risk_Tier = "Critical";
			                            input.Risk_Status = "Unacceptable";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

