application "Vendor-Socrecard"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form App_Users
		{
		    displayname = "Users"
		    success message = "User saved successfully."
		    User_Details
		    (
		        type = section
		        displayname = "User Details"
		        row = 1
		        column = 0
		    )
		    User_ID
		    (
		        type = autonumber
		        displayname = "User ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have User_Name
		    (
		        type = text
		        displayname = "User Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique User_Email
		    (
		        type = email
		        displayname = "User Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    User_Role
		    (
		        type = picklist
		        displayname = "User Role"
		        values = {"Procurement Executive","Vendor Evaluation Specialist","Vendor Manager","Procurement Manager","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Department
		    (
		        type = picklist
		        displayname = "Department"
		        values = Categories[Category_Type == "User Department" && Active == true].ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Categories
		{
		    displayname = "Categories"
		    success message = "Category saved successfully."
		    Category_Details
		    (
		        type = section
		        displayname = "Category Details"
		        row = 1
		        column = 0
		    )
		    Category_ID
		    (
		        type = autonumber
		        displayname = "Category ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Category_Name
		    (
		        type = text
		        displayname = "Category Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Category_Type
		    (
		        type = picklist
		        displayname = "Category Type"
		        values = {"Vendor Category","Product / Service Category","Evaluation Category","Risk Category","Document Type","User Department","Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Category_Code
		    (
		        type = text
		        displayname = "Category Code"
		        maxchar = 50
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Criteria
		{
		    displayname = "Criteria"
		    success message = "Criteria saved successfully."
		    Criteria_Details
		    (
		        type = section
		        displayname = "Criteria Details"
		        row = 1
		        column = 0
		    )
		    Criteria_ID
		    (
		        type = autonumber
		        displayname = "Criteria ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Criteria_Name
		    (
		        type = text
		        displayname = "Criteria Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Process_Area
		    (
		        type = picklist
		        displayname = "Process Area"
		        values = {"Evaluation","Risk Assessment","Onboarding","Performance Review"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Category
		    (
		        type = picklist
		        displayname = "Category"
		        values = Categories[Active == true].ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Criteria_Code
		    (
		        type = text
		        displayname = "Criteria Code"
		        maxchar = 80
		        row = 1
		        column = 2
		        width = medium
		    )
		    Score_Direction
		    (
		        type = picklist
		        displayname = "Score Direction"
		        values = {"Higher is Better","Lower is Better","Boolean Completion","Informational"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Min_Score
		    (
		        type = decimal
		        displayname = "Min Score"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Max_Score
		    (
		        type = decimal
		        displayname = "Max Score"
		        decimalplace = 2
		        initial value = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Products_Services
		{
		    displayname = "Products & Services"
		    success message = "Product / service saved successfully."
		    Offering_Details
		    (
		        type = section
		        displayname = "Offering Details"
		        row = 1
		        column = 0
		    )
		    Offering_ID
		    (
		        type = autonumber
		        displayname = "Offering ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Offering_Name
		    (
		        type = text
		        displayname = "Product / Service Name"
		        maxchar = 200
		        row = 1
		        column = 2
		        width = medium
		    )
		    Offering_Type
		    (
		        type = picklist
		        displayname = "Offering Type"
		        values = {"Product","Service","Product and Service"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Category
		    (
		        type = picklist
		        displayname = "Category"
		        values = Categories[Category_Type == "Product / Service Category" && Active == true].ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Criticality
		    (
		        type = picklist
		        displayname = "Criticality"
		        values = {"Low","Medium","High","Critical"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Rating_Scales
		{
		    displayname = "Rating Scales"
		    success message = "Rating scale saved successfully."
		    Scale_Details
		    (
		        type = section
		        displayname = "Scale Details"
		        row = 1
		        column = 0
		    )
		    Rating_Scale_ID
		    (
		        type = autonumber
		        displayname = "Rating Scale ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Process_Area
		    (
		        type = picklist
		        displayname = "Process Area"
		        values = {"Evaluation","Risk Assessment","Onboarding","Performance Review"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Scale_Label
		    (
		        type = text
		        displayname = "Scale Label"
		        maxchar = 100
		        row = 1
		        column = 2
		        width = medium
		    )
		    Scale_Code
		    (
		        type = text
		        displayname = "Scale Code"
		        maxchar = 80
		        row = 1
		        column = 1
		        width = medium
		    )
		    Min_Value
		    (
		        type = decimal
		        displayname = "Min Value"
		        decimalplace = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		    Max_Value
		    (
		        type = decimal
		        displayname = "Max Value"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Result_Status
		    (
		        type = picklist
		        displayname = "Result Status"
		        values = {"Acceptable","Needs Improvement","Rejected","Low","Medium","High","Critical","Completed","Blocked","Excellent","Good","Watchlist","Poor","Qualified","Unqualified"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Acceptable
		    (
		        type = checkbox
		        displayname = "Acceptable"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Color_Code
		    (
		        type = text
		        displayname = "Color Code"
		        maxchar = 20
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Risk_Assessments
		{
		    displayname = "Risk Assessment"
		    success message = "Risk assessment saved successfully."
		    Assessment_Details
		    (
		        type = section
		        displayname = "Assessment Details"
		        row = 1
		        column = 0
		    )
		    Risk_Assessment_ID
		    (
		        type = autonumber
		        displayname = "Risk Assessment ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Risk_Category
		    (
		        type = picklist
		        displayname = "Risk Category"
		        values = Categories[Category_Type == "Risk Category" && Active == true].ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Assessment_Date
		    (
		        type = date
		        displayname = "Assessment Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Assessment_Status
		    (
		        type = picklist
		        displayname = "Assessment Status"
		        values = {"Draft","Completed","Returned","Cancelled"}
		        initial value = "Draft"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Assessor_Email
		    (
		        type = email
		        displayname = "Assessor Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Risk_Scores
		    (
		        type = section
		        displayname = "Risk Scores"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Financial_Risk_Score
		    (
		        type = decimal
		        displayname = "Financial Risk Score"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Compliance_Risk_Score
		    (
		        type = decimal
		        displayname = "Compliance Risk Score"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Operational_Risk_Score
		    (
		        type = decimal
		        displayname = "Operational Risk Score"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Cyber_Risk_Score
		    (
		        type = decimal
		        displayname = "Cyber Risk Score"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Overall_Risk_Score
		    (
		        type = formula
		        displayname = "Overall Risk Score"
		        value = (Financial_Risk_Score + Compliance_Risk_Score + Operational_Risk_Score + Cyber_Risk_Score) / 4
		        visibility = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Weighted_Risk_Score
		    (
		        type = decimal
		        displayname = "Weighted Risk Score"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Risk_Tier
		    (
		        type = picklist
		        displayname = "Risk Tier"
		        values = {"Low","Medium","High","Critical"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Risk_Status
		    (
		        type = picklist
		        displayname = "Risk Status"
		        values = {"Acceptable","Unacceptable"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    Mitigation
		    (
		        type = section
		        displayname = "Mitigation"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Mitigation_Plan
		    (
		        type = textarea
		        displayname = "Mitigation Plan"
		        height = 120px
		        row = 3
		        column = 1
		        width = medium
		    )
		    Assessment_Notes
		    (
		        type = textarea
		        displayname = "Assessment Notes"
		        height = 120px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Risk_Document
		    (
		        type = upload file
		        displayname = "Risk Document"
		        file count = 1
		        browse = local_drive, google_docs, zoho_docs
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Vendor_Contacts
		{
		    displayname = "Contacts"
		    success message = "Contact saved successfully."
		    Contact_Details
		    (
		        type = section
