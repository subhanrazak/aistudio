		        row = 1
		        column = 0
		    )
		    Contact_ID
		    (
		        type = autonumber
		        displayname = "Contact ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Contact_Name
		    (
		        type = text
		        displayname = "Contact Name"
		        maxchar = 150
		        row = 1
		        column = 2
		        width = medium
		    )
		    Contact_Role
		    (
		        type = picklist
		        displayname = "Contact Role"
		        values = {"Primary","Commercial","Technical","Compliance","Finance","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Email
		    (
		        type = email
		        displayname = "Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Primary_Contact
		    (
		        type = checkbox
		        displayname = "Primary Contact"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Vendor_Documents
		{
		    displayname = "Documents"
		    success message = "Document saved successfully."
		    Document_Details
		    (
		        type = section
		        displayname = "Document Details"
		        row = 1
