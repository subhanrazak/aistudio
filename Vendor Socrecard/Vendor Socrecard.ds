		            type = latitude
		            displayname = "Latitude"
		            visibility = false
		        )
		        longitude
		        (
		            type = longitude
		            displayname = "Longitude"
		            visibility = false
		        )
		        row = 2
		        column = 2
		        width = medium
		    )
		    Documents_Compliance
		    (
		        type = section
		        displayname = "Identity Documents"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Tax_ID
		    (
		        type = text
		        displayname = "Tax ID"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Business_Registration_Number
		    (
		        type = text
		        displayname = "Business Registration Number"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Registration_Document
		    (
		        type = upload file
		        displayname = "Registration Document"
		        file count = 1
		        browse = local_drive, google_docs, zoho_docs
		        row = 3
		        column = 1
		        width = medium
		    )
		    Compliance_Document
		    (
		        type = upload file
		        displayname = "Compliance Document"
		        file count = 1
		        browse = local_drive, google_docs, zoho_docs
		        row = 3
		        column = 2
		        width = medium
		    )
		    Score_Summary
		    (
		        type = section
		        displayname = "Score Summary"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    Current_Evaluation_Rating
		    (
		        type = decimal
		        displayname = "Current Evaluation Rating"
		        decimalplace = 2
		        row = 4
		        column = 1
		        width = medium
		    )
		    Evaluation_Result
		    (
		        type = picklist
		        displayname = "Evaluation Result"
		        values = {"Not Evaluated","Acceptable","Needs Improvement","Rejected"}
		        initial value = "Not Evaluated"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Latest_Risk_Tier
		    (
		        type = picklist
		        displayname = "Latest Risk Tier"
		        values = {"Not Assessed","Low","Medium","High","Critical"}
		        initial value = "Not Assessed"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Latest_Risk_Status
		    (
		        type = picklist
		        displayname = "Latest Risk Status"
		        values = {"Not Assessed","Acceptable","Unacceptable"}
		        initial value = "Not Assessed"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Onboarding_Baseline_Score
		    (
		        type = decimal
		        displayname = "Onboarding Baseline Score"
		        decimalplace = 2
		        row = 4
		        column = 1
		        width = medium
		    )
		    Active_From
		    (
		        type = date
		        displayname = "Active From"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Latest_Performance_Score
		    (
		        type = decimal
		        displayname = "Latest Performance Score"
		        decimalplace = 2
		        row = 4
		        column = 1
		        width = medium
		    )
		    Last_Review_Month
		    (
		        type = date
		        displayname = "Last Review Month"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Lifecycle_Notes
		    (
		        type = textarea
		        displayname = "Lifecycle Notes"
		        height = 120px
		        row = 4
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		    blueprint components
		    {
		        stages = {"Registered","Evaluated","Risk Assessed","Onboarded","Active","Performance Reviewed"}
		    }
		}

		form Weightages
		{
		    displayname = "Weightages"
		    success message = "Weightage saved successfully."
		    Weightage_Details
		    (
		        type = section
		        displayname = "Weightage Details"
		        row = 1
		        column = 0
		    )
		    Weightage_ID
		    (
		        type = autonumber
		        displayname = "Weightage ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Process_Area
		    (
		        type = picklist
		        displayname = "Process Area"
		        values = {"Evaluation","Risk Assessment","Onboarding","Performance Review"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Criteria
		    (
		        type = picklist
		        displayname = "Criteria"
		        values = Criteria[Active == true].ID
		        displayformat = [Criteria_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Weight_Percent
		    (
		        type = decimal
		        displayname = "Weight %"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Effective_From
		    (
		        type = date
		        displayname = "Effective From"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Effective_To
		    (
		        type = date
		        displayname = "Effective To"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		list Active_Users
		{
		    displayName = "Active Users"
		    show all rows from App_Users [Active == true]
		    (
		        User_Name
		        User_Email
		        User_Role
		        Department
		        Phone
		    )
		    filters
		    (
		        User_Role
		        Department
		    )
		    sort by
		    (
		        User_Name ascending
		    )
		}

		default list All_Users
		{
		    displayName = "All Users"
		    show all rows from App_Users
		    (
		        User_ID
		        User_Name
		        User_Email
		        User_Role
		        Department
		        Phone
		        Active
		    )
		    filters
		    (
		        User_Role
		        Department
		        Active
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        User_Role ascending
		    )
		    sort by
		    (
		        User_Name ascending
		    )
		}

