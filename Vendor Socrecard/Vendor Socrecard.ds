	menu
	{
	    space Vendor_Scorecard
	    {
	        displayname = "Vendor Scorecard"
	        icon = "business-chart"
	
	        section Dashboards
	        {
	            displayname = "Dashboards"
	            icon = "business-chart-bar-33"
	
	            page Vendor_Scorecard_Dashboard
	            {
	                icon = "business-chart"
	            }
	        }
	
	        section Configuration
	        {
	            displayname = "Configuration"
	            icon = "files-settings-99"
	
	            form Categories
	            {
	                icon = "files-folder-settings-97"
	            }
	            report All_Categories
	            {
	                icon = "files-folder-14"
	            }
	            report Active_Categories
	            {
	                icon = "files-folder-check"
	            }
	            form Criteria
	            {
	                icon = "business-goal-65"
	            }
	            report All_Criteria
	            {
	                icon = "business-notes"
	            }
	            report Active_Criteria
	            {
	                icon = "business-goal-64"
	            }
	            form Weightages
	            {
	                icon = "business-percentage-38"
	            }
	            report All_Weightages
	            {
	                icon = "business-chart-bar-32"
	            }
	            report Active_Weightages
	            {
	                icon = "business-percentage-39"
	            }
	            form Rating_Scales
	            {
	                icon = "business-scale"
	            }
	            report All_Rating_Scales
	            {
	                icon = "business-chart-pie-35"
	            }
	            report Active_Rating_Scales
	            {
	                icon = "business-chart-pie-36"
	            }
	        }
	
	        section Masters
	        {
	            displayname = "Masters"
	            icon = "business-contacts"
	
	            form App_Users
	            {
	                icon = "users-multiple-11"
	            }
	            report All_Users
	            {
	                icon = "users-multiple-19"
	            }
	            report Active_Users
	            {
	                icon = "users-badge-13"
	            }
	            form Vendors
	            {
	                icon = "business-handshake"
	            }
	            report All_Vendors
	            {
	                icon = "business-business-contact-88"
	            }
	            report Vendor_Lifecycle_Board
	            {
	                icon = "business-hierarchy-54"
	            }
	            report Active_Vendors
	            {
	                icon = "business-badge"
	            }
	            report My_Vendor_Profile
	            {
	                icon = "users-circle-10"
	            }
	            form Vendor_Contacts
	            {
	                icon = "business-business-contact-85"
	            }
	            report All_Contacts
	            {
	                icon = "business-business-contact-87"
	            }
	            report Primary_Contacts
	            {
	                icon = "users-single-body"
	            }
	            form Products_Services
	            {
	                icon = "business-stock"
	            }
	            report All_Products_Services
	            {
	                icon = "files-box"
	            }
	            report Active_Products_Services
	            {
	                icon = "files-archive-check"
	            }
	            form Vendor_Documents
	            {
	                icon = "files-upload"
	            }
	            report All_Documents
	            {
	                icon = "files-folder-14"
	            }
	            report Expiring_Documents
	            {
	                icon = "files-time"
	            }
	            report Pending_Document_Verification
	            {
	                icon = "files-exclamation"
	            }
	        }
	
	        section Transactions
	        {
	            displayname = "Transactions"
	            icon = "business-progress"
	
	            form Vendor_Registration
	            {
	                icon = "business-sign"
	            }
	            report All_Registrations
	            {
	                icon = "business-agenda"
	            }
	            report Pending_Registrations
	            {
	                icon = "business-progress"
	            }
	            report Converted_Registrations
	            {
	                icon = "business-badge"
	            }
	            form Vendor_Evaluations
	            {
	                icon = "business-award-48"
	            }
	            report All_Evaluations
	            {
	                icon = "business-board-30"
	            }
	            report Acceptable_Evaluations
	            {
	                icon = "business-award-49"
	            }
	            report Evaluation_By_Criteria
	            {
	                icon = "business-chart-bar-32"
	            }
	            form Risk_Assessments
	            {
	                icon = "business-safe"
	            }
	            report All_Risk_Assessments
	            {
	                icon = "business-scale"
	            }
	            report High_Risk_Vendors
