	            report Performance_Watchlist
	            {
	                icon = "business-pin"
	            }
	            report Vendor_Performance_History
	            {
	                icon = "business-chart-bar-33"
	            }
	            report Completed_Performance_Reviews
	            {
	                icon = "business-award-74"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	
	    font = "lato"
	
	    color options
	    {
	        color = "11"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	
	    custom css
	    {
	        content = ".zc-app-header { letter-spacing: 0.01em; } .zc-menu-item { font-weight: 500; }"
	    }
	}
	}
