list Performance_Watchlist
{
    displayName = "Performance Watchlist"
    show all rows from Vendor_Performance_Metrics [Performance_Score < 70]
    (
        Metrics_ID
        Vendor
        Review_Month
        Review_Status
        Performance_Score
        Performance_Band
        Return_Defect_Rate_Percent
        Issue_Count
        Review_Comments
        Reviewer_Email
    )
    filters
    (
        Vendor
        Review_Month
        Review_Status
        Performance_Band
    )
    sort by
    (
        Performance_Score ascending
    )
}
