list Completed_Performance_Reviews
{
    displayName = "Completed Performance Reviews"
    show all rows from Vendor_Performance_Metrics [Review_Status == "Completed"]
    (
        Metrics_ID
        Vendor
        Review_Month
        Performance_Score
        Performance_Band
        Reviewer_Email
    )
    filters
    (
        Vendor
        Review_Month
        Performance_Band
    )
    sort by
    (
        Review_Month descending
    )
}
