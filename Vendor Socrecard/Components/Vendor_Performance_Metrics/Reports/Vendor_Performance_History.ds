list Vendor_Performance_History
{
    displayName = "Vendor Performance History"
    show all rows from Vendor_Performance_Metrics
    (
        Vendor
        Review_Month
        Review_Status
        Order_Count
        Total_Order_Value
        On_Time_Delivery_Percent
        Quality_Acceptance_Percent
        Return_Defect_Rate_Percent
        SLA_Compliance_Percent
        Service_Response_Score
        Issue_Count
        Performance_Score
        Performance_Band
    )
    filters
    (
        Vendor
        Review_Month
        Review_Status
        Performance_Band
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Vendor ascending
    )
    sort by
    (
        Review_Month descending
    )
}
