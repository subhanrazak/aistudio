default list Monthly_Performance_Scorecards
{
    displayName = "Monthly Performance Scorecards"
    show all rows from Vendor_Performance_Metrics
    (
        Metrics_ID
        Vendor
        Review_Month
        Review_Status
        Order_Count
        Total_Order_Value
        On_Time_Delivery_Percent
        Quality_Acceptance_Percent
        Return_Defect_Rate_Percent
        SLA_Compliance_Percent
        Service_Response_Score
        Issue_Count
        Performance_Score
        Performance_Band
        Configured_Score_Used
        Reviewer_Email
    )
    filters
    (
        Vendor
        Review_Month
        Review_Status
        Performance_Band
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Performance_Band ascending
    )
    sort by
    (
        Review_Month descending
        Performance_Score descending
    )
}
