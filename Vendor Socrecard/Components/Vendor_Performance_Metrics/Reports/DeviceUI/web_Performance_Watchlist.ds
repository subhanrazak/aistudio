report Performance_Watchlist
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Metrics_ID
                    Vendor
                    Review_Month
                    Review_Status
                    Performance_Score
                    Performance_Band
                    Return_Defect_Rate_Percent
                    Issue_Count
                    Review_Comments
                    Reviewer_Email
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Metrics_ID
                    Vendor
                    Review_Month
                    Review_Status
                    Performance_Score
                    Performance_Band
                    Return_Defect_Rate_Percent
                    Issue_Count
                    Review_Comments
                    Reviewer_Email
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
