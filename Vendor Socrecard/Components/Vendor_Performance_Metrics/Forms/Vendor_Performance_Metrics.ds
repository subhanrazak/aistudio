form Vendor_Performance_Metrics
{
    displayname = "Performance Review"
    success message = "Vendor performance review saved successfully."
    Review_Period
    (
        type = section
        displayname = "Review Period"
        row = 1
        column = 0
    )
    Metrics_ID
    (
        type = autonumber
        displayname = "Metrics ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors[Stage == "Active" || Stage == "Performance Reviewed"].ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Review_Month
    (
        type = date
        displayname = "Review Month"
        row = 1
        column = 2
        width = medium
    )
    Review_Status
    (
        type = picklist
        displayname = "Review Status"
        values = {"Draft","Completed","Returned","Cancelled"}
        initial value = "Draft"
        row = 1
        column = 1
        width = medium
    )
    Reviewer_Email
    (
        type = email
        displayname = "Reviewer Email"
        row = 1
        column = 2
        width = medium
    )
    Aggregate_Order_Metrics
    (
        type = section
        displayname = "Aggregate Order Metrics"
        visibility = true
        row = 2
        column = 1
    )
    Order_Count
    (
        type = number
        displayname = "Order Count"
        row = 2
        column = 1
        width = medium
    )
    Total_Order_Value
    (
        type = decimal
        displayname = "Total Order Value"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    On_Time_Delivery_Percent
    (
        type = decimal
        displayname = "On-Time Delivery %"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Quality_Acceptance_Percent
    (
        type = decimal
        displayname = "Quality Acceptance %"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Return_Defect_Rate_Percent
    (
        type = decimal
        displayname = "Return / Defect Rate %"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Service_Metrics
    (
        type = section
        displayname = "Service Metrics"
        visibility = true
        row = 3
        column = 1
    )
    SLA_Compliance_Percent
    (
        type = decimal
        displayname = "SLA Compliance %"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    Service_Response_Score
    (
        type = decimal
        displayname = "Service Response Score"
        decimalplace = 2
        row = 3
        column = 2
        width = medium
    )
    Issue_Count
    (
        type = number
        displayname = "Issue Count"
        row = 3
        column = 1
        width = medium
    )
    Performance_Score
    (
        type = decimal
        displayname = "Performance Score"
        decimalplace = 2
        row = 3
        column = 2
        width = medium
    )
    Performance_Band
    (
        type = picklist
        displayname = "Performance Band"
        values = {"Excellent","Good","Watchlist","Poor"}
        row = 3
        column = 1
        width = medium
    )
    Configured_Score_Used
    (
        type = checkbox
        displayname = "Configured Score Used"
        initial value = false
        row = 3
        column = 2
        width = medium
    )
    Review_Comments
    (
        type = textarea
        displayname = "Review Comments"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    Score_Notes
    (
        type = textarea
        displayname = "Score Notes"
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
