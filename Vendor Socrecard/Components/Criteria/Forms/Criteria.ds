form Criteria
{
    displayname = "Criteria"
    success message = "Criteria saved successfully."
    Criteria_Details
    (
        type = section
        displayname = "Criteria Details"
        row = 1
        column = 0
    )
    Criteria_ID
    (
        type = autonumber
        displayname = "Criteria ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Criteria_Name
    (
        type = text
        displayname = "Criteria Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Process_Area
    (
        type = picklist
        displayname = "Process Area"
        values = {"Evaluation","Risk Assessment","Onboarding","Performance Review"}
        row = 1
        column = 2
        width = medium
    )
    Category
    (
        type = picklist
        displayname = "Category"
        values = Categories[Active == true].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Criteria_Code
    (
        type = text
        displayname = "Criteria Code"
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    Score_Direction
    (
        type = picklist
        displayname = "Score Direction"
        values = {"Higher is Better","Lower is Better","Boolean Completion","Informational"}
        row = 1
        column = 1
        width = medium
    )
    Min_Score
    (
        type = decimal
        displayname = "Min Score"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Max_Score
    (
        type = decimal
        displayname = "Max Score"
        decimalplace = 2
        initial value = 100
        row = 1
        column = 1
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
