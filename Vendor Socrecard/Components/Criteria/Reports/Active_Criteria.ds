list Active_Criteria
{
    displayName = "Active Criteria"
    show all rows from Criteria [Active == true]
    (
        Criteria_ID
        Criteria_Name
        Process_Area
        Criteria_Code
        Score_Direction
        Min_Score
        Max_Score
    )
    filters
    (
        Process_Area
    )
    sort by
    (
        Criteria_Name ascending
    )
}
