default list All_Criteria
{
    displayName = "All Criteria"
    show all rows from Criteria
    (
        Criteria_ID
        Criteria_Name
        Process_Area
        Category
        Criteria_Code
        Score_Direction
        Min_Score
        Max_Score
        Active
    )
    filters
    (
        Process_Area
        Category
        Active
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Process_Area ascending
    )
    sort by
    (
        Process_Area ascending
        Criteria_Name ascending
    )
}
