list Acceptable_Evaluations
{
    displayName = "Acceptable Evaluations"
    show all rows from Vendor_Evaluations [Evaluation_Result == "Acceptable"]
    (
        Evaluation_ID
        Vendor
        Evaluation_End_Date
        Overall_Rating
        Weighted_Overall_Rating
        Recommendation_Notes
        Evaluator_Email
    )
    filters
    (
        Vendor
        Evaluation_End_Date
    )
    sort by
    (
        Weighted_Overall_Rating descending
    )
}
