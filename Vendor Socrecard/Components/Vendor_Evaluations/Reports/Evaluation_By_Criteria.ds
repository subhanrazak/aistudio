list Evaluation_By_Criteria
{
    displayName = "Evaluation By Criteria"
    show all rows from Vendor_Evaluations
    (
        Vendor
        Evaluation_Category
        Evaluation_End_Date
        Product_Service_Fit_Rating
        Quality_Capability_Rating
        Commercial_Rating
        Compliance_Rating
        Weighted_Overall_Rating
        Evaluation_Result
    )
    filters
    (
        Vendor
        Evaluation_Category
        Evaluation_End_Date
    )
    sort by
    (
        Evaluation_End_Date descending
    )
}
