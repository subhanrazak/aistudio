default list All_Evaluations
{
    displayName = "All Evaluations"
    show all rows from Vendor_Evaluations
    (
        Evaluation_ID
        Vendor
        Evaluation_Category
        Evaluation_Start_Date
        Evaluation_End_Date
        Evaluation_Status
        Product_Service_Fit_Rating
        Quality_Capability_Rating
        Commercial_Rating
        Compliance_Rating
        Overall_Rating
        Weighted_Overall_Rating
        Evaluation_Result
        Evaluator_Email
    )
    filters
    (
        Vendor
        Evaluation_Category
        Evaluation_Status
        Evaluation_Result
        Evaluation_End_Date
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Evaluation_Result ascending
    )
    sort by
    (
        Evaluation_End_Date descending
    )
}
