default list All_Registrations
{
    displayName = "All Registrations"
    show all rows from Vendor_Registration
    (
        Registration_ID
        Registration_Date
        Vendor_Name
        Vendor_Category
        Vendor_Type
        Primary_Product_Service_Category
        Registration_Status
        Linked_Vendor
        Contact_Email
    )
    filters
    (
        Registration_Status
        Vendor_Category
        Vendor_Type
        Registration_Date
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Registration_Status ascending
    )
    sort by
    (
        Registration_Date descending
    )
}
