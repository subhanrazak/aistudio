list Pending_Registrations
{
    displayName = "Pending Registrations"
    show all rows from Vendor_Registration [Registration_Status == "Submitted" || Registration_Status == "Draft"]
    (
        Registration_ID
        Registration_Date
        Vendor_Name
        Vendor_Category
        Registration_Status
        Contact_Name
        Contact_Email
    )
    filters
    (
        Registration_Status
        Vendor_Category
    )
    sort by
    (
        Registration_Date descending
    )
}
