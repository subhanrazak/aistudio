report Converted_Registrations
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Registration_ID
                    Registration_Date
                    Vendor_Name
                    Linked_Vendor
                    Contact_Name
                    Contact_Email
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Registration_ID
                    Registration_Date
                    Vendor_Name
                    Linked_Vendor
                    Contact_Name
                    Contact_Email
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
