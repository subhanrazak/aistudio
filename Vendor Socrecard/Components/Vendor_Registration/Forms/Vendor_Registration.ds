form Vendor_Registration
{
    displayname = "Registration"
    success message = "Registration saved successfully."
    Registration_Details
    (
        type = section
        displayname = "Registration Details"
        row = 1
        column = 0
    )
    Registration_ID
    (
        type = autonumber
        displayname = "Registration ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    Registration_Date
    (
        type = date
        displayname = "Registration Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Registration_Status
    (
        type = picklist
        displayname = "Registration Status"
        values = {"Draft","Submitted","Accepted","Rejected","Converted"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    Linked_Vendor
    (
        type = picklist
        displayname = "Linked Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Vendor_Name
    (
        type = text
        displayname = "Vendor Name"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    Vendor_Category
    (
        type = picklist
        displayname = "Vendor Category"
        values = Categories[Category_Type == "Vendor Category" && Active == true].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Vendor_Type
    (
        type = picklist
        displayname = "Vendor Type"
        values = {"Local","National","International"}
        row = 1
        column = 2
        width = medium
    )
    Primary_Product_Service_Category
    (
        type = picklist
        displayname = "Primary Product / Service Category"
        values = Categories[Category_Type == "Product / Service Category" && Active == true].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Tax_ID
    (
        type = text
        displayname = "Tax ID"
        row = 1
        column = 2
        width = medium
    )
    Business_Registration_Number
    (
        type = text
        displayname = "Business Registration Number"
        row = 1
        column = 1
        width = medium
    )
    Primary_Contact
    (
        type = section
        displayname = "Primary Contact"
        visibility = true
        row = 2
        column = 1
    )
    Contact_Name
    (
        type = text
        displayname = "Contact Name"
        maxchar = 150
        row = 2
        column = 1
        width = medium
    )
    Contact_Email
    (
        type = email
        displayname = "Contact Email"
        personal data = true
        row = 2
        column = 2
        width = medium
    )
    Contact_Phone
    (
        type = phonenumber
        displayname = "Contact Phone"
        row = 2
        column = 1
        width = medium
    )
    Vendor_Address
    (
        type = address
        displayname = "Vendor Address"
        capture_coordinates = false
        adjust_using_map = false
        address_line_1
        (
            type = address_line_1
            displayname = "Street Address"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City"
        )
        state_province
        (
            type = state_province
            displayname = "State / Province"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Postal Code"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
        row = 2
        column = 2
        width = medium
    )
    Initial_Documents
    (
        type = section
        displayname = "Initial Documents"
        visibility = true
        row = 3
        column = 1
    )
    Registration_Document
    (
        type = upload file
        displayname = "Registration Document"
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 3
        column = 1
        width = medium
    )
    Compliance_Document
    (
        type = upload file
        displayname = "Compliance Document"
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 3
        column = 2
        width = medium
    )
    Registration_Notes
    (
        type = textarea
        displayname = "Registration Notes"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
