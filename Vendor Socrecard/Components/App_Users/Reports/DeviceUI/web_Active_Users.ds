report Active_Users
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    User_Name
                    User_Email
                    User_Role
                    Department
                    Phone
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    User_Name
                    User_Email
                    User_Role
                    Department
                    Phone
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
