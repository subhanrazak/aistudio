default list All_Users
{
    displayName = "All Users"
    show all rows from App_Users
    (
        User_ID
        User_Name
        User_Email
        User_Role
        Department
        Phone
        Active
    )
    filters
    (
        User_Role
        Department
        Active
    )
    group by
    (
        properties
        (
            display record count = true
        )
        User_Role ascending
    )
    sort by
    (
        User_Name ascending
    )
}
