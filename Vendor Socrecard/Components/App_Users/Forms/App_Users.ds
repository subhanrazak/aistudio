form App_Users
{
    displayname = "Users"
    success message = "User saved successfully."
    User_Details
    (
        type = section
        displayname = "User Details"
        row = 1
        column = 0
    )
    User_ID
    (
        type = autonumber
        displayname = "User ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have User_Name
    (
        type = text
        displayname = "User Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have unique User_Email
    (
        type = email
        displayname = "User Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    User_Role
    (
        type = picklist
        displayname = "User Role"
        values = {"Procurement Executive","Vendor Evaluation Specialist","Vendor Manager","Procurement Manager","Other"}
        row = 1
        column = 1
        width = medium
    )
    Department
    (
        type = picklist
        displayname = "Department"
        values = Categories[Category_Type == "User Department" && Active == true].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
