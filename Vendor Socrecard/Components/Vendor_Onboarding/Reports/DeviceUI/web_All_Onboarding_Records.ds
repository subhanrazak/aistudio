report All_Onboarding_Records
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Onboarding_ID
                    Vendor
                    Onboarding_Category
                    Onboarding_Date
                    Contract_Signed
                    Compliance_Documents_Verified
                    Bank_Details_Verified
                    Training_Completed
                    Onboarding_Score
                    Calculated_Onboarding_Score
                    Baseline_Score
                    Onboarding_Status
                    Onboarding_Result
                    Activate_After_Onboarding
                    Active_From
                    Onboarding_Manager_Email
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Onboarding_ID
                    Vendor
                    Onboarding_Category
                    Onboarding_Date
                    Contract_Signed
                    Compliance_Documents_Verified
                    Bank_Details_Verified
                    Training_Completed
                    Onboarding_Score
                    Calculated_Onboarding_Score
                    Baseline_Score
                    Onboarding_Status
                    Onboarding_Result
                    Activate_After_Onboarding
                    Active_From
                    Onboarding_Manager_Email
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
