list Onboarding_Pending
{
    displayName = "Onboarding Pending"
    show all rows from Vendor_Onboarding [Onboarding_Status != "Completed"]
    (
        Onboarding_ID
        Vendor
        Onboarding_Category
        Onboarding_Date
        Contract_Signed
        Compliance_Documents_Verified
        Bank_Details_Verified
        Training_Completed
        Calculated_Onboarding_Score
        Onboarding_Status
        Onboarding_Result
        Onboarding_Notes
        Onboarding_Manager_Email
    )
    filters
    (
        Vendor
        Onboarding_Category
        Onboarding_Status
        Onboarding_Result
        Onboarding_Date
    )
    sort by
    (
        Onboarding_Date descending
    )
}
