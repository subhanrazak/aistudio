list Completed_Onboarding
{
    displayName = "Completed Onboarding"
    show all rows from Vendor_Onboarding [Onboarding_Status == "Completed"]
    (
        Onboarding_ID
        Vendor
        Onboarding_Date
        Onboarding_Score
        Baseline_Score
        Onboarding_Result
        Active_From
        Onboarding_Manager_Email
    )
    filters
    (
        Vendor
        Onboarding_Date
    )
    sort by
    (
        Onboarding_Date descending
    )
}
