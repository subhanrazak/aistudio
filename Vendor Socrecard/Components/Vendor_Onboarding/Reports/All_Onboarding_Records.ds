default list All_Onboarding_Records
{
    displayName = "All Onboarding Records"
    show all rows from Vendor_Onboarding
    (
        Onboarding_ID
        Vendor
        Onboarding_Category
        Onboarding_Date
        Contract_Signed
        Compliance_Documents_Verified
        Bank_Details_Verified
        Training_Completed
        Onboarding_Score
        Calculated_Onboarding_Score
        Baseline_Score
        Onboarding_Status
        Onboarding_Result
        Activate_After_Onboarding
        Active_From
        Onboarding_Manager_Email
    )
    filters
    (
        Vendor
        Onboarding_Category
        Onboarding_Date
        Onboarding_Status
        Onboarding_Result
        Activate_After_Onboarding
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Onboarding_Status ascending
    )
    sort by
    (
        Onboarding_Date descending
    )
}
