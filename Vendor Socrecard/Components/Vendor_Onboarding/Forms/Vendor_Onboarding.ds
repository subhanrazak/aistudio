form Vendor_Onboarding
{
    displayname = "Onboarding"
    success message = "Vendor onboarding saved successfully."
    Onboarding_Details
    (
        type = section
        displayname = "Onboarding Details"
        row = 1
        column = 0
    )
    Onboarding_ID
    (
        type = autonumber
        displayname = "Onboarding ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Onboarding_Category
    (
        type = picklist
        displayname = "Onboarding Category"
        values = Categories[Category_Type == "Product / Service Category" && Active == true].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Onboarding_Date
    (
        type = date
        displayname = "Onboarding Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Onboarding_Manager_Email
    (
        type = email
        displayname = "Onboarding Manager Email"
        row = 1
        column = 2
        width = medium
    )
    Checklist
    (
        type = section
        displayname = "Checklist"
        visibility = true
        row = 2
        column = 1
    )
    Contract_Signed
    (
        type = checkbox
        displayname = "Contract Signed"
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    Compliance_Documents_Verified
    (
        type = checkbox
        displayname = "Compliance Documents Verified"
        initial value = false
        row = 2
        column = 2
        width = medium
    )
    Bank_Details_Verified
    (
        type = checkbox
        displayname = "Bank Details Verified"
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    Training_Completed
    (
        type = checkbox
        displayname = "Training Completed"
        initial value = false
        row = 2
        column = 2
        width = medium
    )
    must have Onboarding_Score
    (
        type = decimal
        displayname = "Onboarding Score"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Calculated_Onboarding_Score
    (
        type = decimal
        displayname = "Calculated Onboarding Score"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Baseline_Score
    (
        type = decimal
        displayname = "Baseline Score"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Onboarding_Status
    (
        type = picklist
        displayname = "Onboarding Status"
        values = {"Pending","Completed","Blocked"}
        initial value = "Pending"
        row = 2
        column = 2
        width = medium
    )
    Onboarding_Result
    (
        type = picklist
        displayname = "Onboarding Result"
        values = {"Qualified","Unqualified","Blocked","Pending"}
        initial value = "Pending"
        row = 2
        column = 1
        width = medium
    )
    Activation
    (
        type = section
        displayname = "Activation"
        visibility = true
        row = 3
        column = 1
    )
    Activate_After_Onboarding
    (
        type = checkbox
        displayname = "Activate After Onboarding"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    Active_From
    (
        type = date
        displayname = "Active From"
        row = 3
        column = 2
        width = medium
    )
    Onboarding_Notes
    (
        type = textarea
        displayname = "Onboarding Notes"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
