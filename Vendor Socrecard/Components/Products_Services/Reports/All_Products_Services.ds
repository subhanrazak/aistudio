default list All_Products_Services
{
    displayName = "All Products & Services"
    show all rows from Products_Services
    (
        Offering_ID
        Vendor
        Offering_Name
        Offering_Type
        Category
        Criticality
        Active
    )
    filters
    (
        Vendor
        Offering_Type
        Category
        Criticality
        Active
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Category ascending
    )
    sort by
    (
        Offering_Name ascending
    )
}
