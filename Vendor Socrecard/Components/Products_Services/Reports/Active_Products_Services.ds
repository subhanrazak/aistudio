list Active_Products_Services
{
    displayName = "Active Products & Services"
    show all rows from Products_Services [Active == true]
    (
        Vendor
        Offering_Name
        Offering_Type
        Category
        Criticality
    )
    filters
    (
        Vendor
        Category
        Criticality
    )
    sort by
    (
        Vendor ascending
        Offering_Name ascending
    )
}
