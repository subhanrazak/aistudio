form Products_Services
{
    displayname = "Products & Services"
    success message = "Product / service saved successfully."
    Offering_Details
    (
        type = section
        displayname = "Offering Details"
        row = 1
        column = 0
    )
    Offering_ID
    (
        type = autonumber
        displayname = "Offering ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Offering_Name
    (
        type = text
        displayname = "Product / Service Name"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    Offering_Type
    (
        type = picklist
        displayname = "Offering Type"
        values = {"Product","Service","Product and Service"}
        row = 1
        column = 1
        width = medium
    )
    Category
    (
        type = picklist
        displayname = "Category"
        values = Categories[Category_Type == "Product / Service Category" && Active == true].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Criticality
    (
        type = picklist
        displayname = "Criticality"
        values = {"Low","Medium","High","Critical"}
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
