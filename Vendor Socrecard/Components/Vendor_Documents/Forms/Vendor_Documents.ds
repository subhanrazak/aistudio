form Vendor_Documents
{
    displayname = "Documents"
    success message = "Document saved successfully."
    Document_Details
    (
        type = section
        displayname = "Document Details"
        row = 1
        column = 0
    )
    Document_ID
    (
        type = autonumber
        displayname = "Document ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Document_Type
    (
        type = picklist
        displayname = "Document Type"
        values = Categories[Category_Type == "Document Type" && Active == true].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Document_Name
    (
        type = text
        displayname = "Document Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )
    Document_File
    (
        type = upload file
        displayname = "Document File"
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 1
        column = 2
        width = medium
    )
    Issue_Date
    (
        type = date
        displayname = "Issue Date"
        row = 1
        column = 1
        width = medium
    )
    Expiry_Date
    (
        type = date
        displayname = "Expiry Date"
        row = 1
        column = 2
        width = medium
    )
    Verification_Status
    (
        type = picklist
        displayname = "Verification Status"
        values = {"Pending","Verified","Rejected","Expired"}
        initial value = "Pending"
        row = 1
        column = 1
        width = medium
    )
    Verified_By
    (
        type = email
        displayname = "Verified By"
        row = 1
        column = 2
        width = medium
    )
    Verified_On
    (
        type = date
        displayname = "Verified On"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
