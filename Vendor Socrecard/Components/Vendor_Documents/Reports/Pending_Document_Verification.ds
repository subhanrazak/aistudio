list Pending_Document_Verification
{
    displayName = "Pending Document Verification"
    show all rows from Vendor_Documents [Verification_Status == "Pending"]
    (
        Document_ID
        Vendor
        Document_Type
        Document_Name
        Document_File
        Issue_Date
        Expiry_Date
    )
    filters
    (
        Vendor
        Document_Type
    )
    sort by
    (
        Document_ID descending
    )
}
