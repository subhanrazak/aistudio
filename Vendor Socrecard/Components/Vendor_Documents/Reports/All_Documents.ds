default list All_Documents
{
    displayName = "All Documents"
    show all rows from Vendor_Documents
    (
        Document_ID
        Vendor
        Document_Type
        Document_Name
        Issue_Date
        Expiry_Date
        Verification_Status
        Verified_By
        Verified_On
    )
    filters
    (
        Vendor
        Document_Type
        Verification_Status
        Expiry_Date
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Verification_Status ascending
    )
    sort by
    (
        Expiry_Date ascending
    )
}
