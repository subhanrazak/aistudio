default list All_Contacts
{
    displayName = "All Contacts"
    show all rows from Vendor_Contacts
    (
        Contact_ID
        Vendor
        Contact_Name
        Contact_Role
        Email
        Phone
        Primary_Contact
        Active
    )
    filters
    (
        Vendor
        Contact_Role
        Primary_Contact
        Active
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Vendor ascending
    )
    sort by
    (
        Contact_Name ascending
    )
}
