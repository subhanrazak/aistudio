form Categories
{
    displayname = "Categories"
    success message = "Category saved successfully."
    Category_Details
    (
        type = section
        displayname = "Category Details"
        row = 1
        column = 0
    )
    Category_ID
    (
        type = autonumber
        displayname = "Category ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have unique Category_Name
    (
        type = text
        displayname = "Category Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Category_Type
    (
        type = picklist
        displayname = "Category Type"
        values = {"Vendor Category","Product / Service Category","Evaluation Category","Risk Category","Document Type","User Department","Other"}
        row = 1
        column = 2
        width = medium
    )
    Category_Code
    (
        type = text
        displayname = "Category Code"
        maxchar = 50
        row = 1
        column = 1
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
