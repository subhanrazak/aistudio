default list All_Categories
{
    displayName = "All Categories"
    show all rows from Categories
    (
        Category_ID
        Category_Name
        Category_Type
        Category_Code
        Active
        Description
    )
    filters
    (
        Category_Type
        Active
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Category_Type ascending
    )
    sort by
    (
        Category_Type ascending
        Category_Name ascending
    )
}
