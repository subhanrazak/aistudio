list Active_Rating_Scales
{
    displayName = "Active Rating Scales"
    show all rows from Rating_Scales [Active == true]
    (
        Process_Area
        Scale_Label
        Min_Value
        Max_Value
        Result_Status
        Acceptable
        Color_Code
    )
    filters
    (
        Process_Area
    )
    sort by
    (
        Process_Area ascending
        Min_Value ascending
    )
}
