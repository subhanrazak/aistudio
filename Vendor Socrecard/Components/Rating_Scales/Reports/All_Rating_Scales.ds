default list All_Rating_Scales
{
    displayName = "All Rating Scales"
    show all rows from Rating_Scales
    (
        Rating_Scale_ID
        Process_Area
        Scale_Label
        Scale_Code
        Min_Value
        Max_Value
        Result_Status
        Acceptable
        Active
    )
    filters
    (
        Process_Area
        Result_Status
        Acceptable
        Active
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Process_Area ascending
    )
    sort by
    (
        Process_Area ascending
        Min_Value ascending
    )
}
