        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Rating_Scale_ID
                    Process_Area
                    Scale_Label
                    Scale_Code
                    Min_Value
                    Max_Value
                    Result_Status
                    Acceptable
                    Active
                )
            )
        )
        menu
