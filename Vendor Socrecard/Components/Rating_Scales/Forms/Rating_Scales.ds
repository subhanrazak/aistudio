form Rating_Scales
{
    displayname = "Rating Scales"
    success message = "Rating scale saved successfully."
    Scale_Details
    (
        type = section
        displayname = "Scale Details"
        row = 1
        column = 0
    )
    Rating_Scale_ID
    (
        type = autonumber
        displayname = "Rating Scale ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Process_Area
    (
        type = picklist
        displayname = "Process Area"
        values = {"Evaluation","Risk Assessment","Onboarding","Performance Review"}
        row = 1
        column = 1
        width = medium
    )
    must have Scale_Label
    (
        type = text
        displayname = "Scale Label"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    Scale_Code
    (
        type = text
        displayname = "Scale Code"
        maxchar = 80
        row = 1
        column = 1
        width = medium
    )
    Min_Value
    (
        type = decimal
        displayname = "Min Value"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Max_Value
    (
        type = decimal
        displayname = "Max Value"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Result_Status
    (
        type = picklist
        displayname = "Result Status"
        values = {"Acceptable","Needs Improvement","Rejected","Low","Medium","High","Critical","Completed","Blocked","Excellent","Good","Watchlist","Poor","Qualified","Unqualified"}
        row = 1
        column = 2
        width = medium
    )
    Acceptable
    (
        type = checkbox
        displayname = "Acceptable"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Color_Code
    (
        type = text
        displayname = "Color Code"
        maxchar = 20
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
