default list All_Weightages
{
    displayName = "All Weightages"
    show all rows from Weightages
    (
        Weightage_ID
        Process_Area
        Criteria
        Weight_Percent
        Effective_From
        Effective_To
        Active
    )
    filters
    (
        Process_Area
        Criteria
        Active
        Effective_From
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Process_Area ascending
    )
    sort by
    (
        Process_Area ascending
        Criteria ascending
    )
}
