form Weightages
{
    displayname = "Weightages"
    success message = "Weightage saved successfully."
    Weightage_Details
    (
        type = section
        displayname = "Weightage Details"
        row = 1
        column = 0
    )
    Weightage_ID
    (
        type = autonumber
        displayname = "Weightage ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Process_Area
    (
        type = picklist
        displayname = "Process Area"
        values = {"Evaluation","Risk Assessment","Onboarding","Performance Review"}
        row = 1
        column = 1
        width = medium
    )
    must have Criteria
    (
        type = picklist
        displayname = "Criteria"
        values = Criteria[Active == true].ID
        displayformat = [Criteria_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Weight_Percent
    (
        type = decimal
        displayname = "Weight %"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Effective_From
    (
        type = date
        displayname = "Effective From"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Effective_To
    (
        type = date
        displayname = "Effective To"
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
