list Acceptable_Risk_Assessments
{
    displayName = "Acceptable Risk Assessments"
    show all rows from Risk_Assessments [Risk_Status == "Acceptable"]
    (
        Risk_Assessment_ID
        Vendor
        Assessment_Date
        Weighted_Risk_Score
        Risk_Tier
        Risk_Status
        Assessor_Email
    )
    filters
    (
        Vendor
        Risk_Tier
        Assessment_Date
    )
    sort by
    (
        Assessment_Date descending
    )
}
