list High_Risk_Vendors
{
    displayName = "High Risk Vendors"
    show all rows from Risk_Assessments [Risk_Tier == "High" || Risk_Tier == "Critical"]
    (
        Risk_Assessment_ID
        Vendor
        Assessment_Date
        Overall_Risk_Score
        Weighted_Risk_Score
        Risk_Tier
        Risk_Status
        Mitigation_Plan
        Assessor_Email
    )
    filters
    (
        Vendor
        Risk_Tier
        Assessment_Date
    )
    sort by
    (
        Weighted_Risk_Score descending
    )
}
