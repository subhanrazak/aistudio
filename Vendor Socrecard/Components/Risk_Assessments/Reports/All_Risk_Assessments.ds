default list All_Risk_Assessments
{
    displayName = "All Risk Assessments"
    show all rows from Risk_Assessments
    (
        Risk_Assessment_ID
        Vendor
        Risk_Category
        Assessment_Date
        Assessment_Status
        Financial_Risk_Score
        Compliance_Risk_Score
        Operational_Risk_Score
        Cyber_Risk_Score
        Overall_Risk_Score
        Weighted_Risk_Score
        Risk_Tier
        Risk_Status
        Assessor_Email
    )
    filters
    (
        Vendor
        Risk_Category
        Assessment_Status
        Assessment_Date
        Risk_Tier
        Risk_Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Risk_Tier ascending
    )
    sort by
    (
        Assessment_Date descending
    )
}
