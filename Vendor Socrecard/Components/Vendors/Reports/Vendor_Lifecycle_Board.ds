kanban Vendor_Lifecycle_Board
{
    displayName = "Vendor Lifecycle Board"
    show all rows from Vendors
    (
        Vendor_ID
        Vendor_Name
        Vendor_Category
        Vendor_Category_Config
        Primary_Product_Service_Category
        Stage
        Vendor_Status
        Qualification_Status
        Current_Evaluation_Rating
        Latest_Risk_Tier
        Latest_Performance_Score
    )
    filters
    (
        Vendor_Category
        Vendor_Category_Config
        Primary_Product_Service_Category
        Stage
        Vendor_Status
        Qualification_Status
        Latest_Risk_Tier
    )
    sort by
    (
        Vendor_Name ascending
    )
    options
    (
        display field = Stage
        filter type = manual
        sort order = ascending
        record count = enable
    )
}
