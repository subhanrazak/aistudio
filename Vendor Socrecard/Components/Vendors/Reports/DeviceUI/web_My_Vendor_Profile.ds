report My_Vendor_Profile
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Vendor_Name
                    Vendor_Category
                    Vendor_Category_Config
                    Vendor_Type
                    Primary_Product_Service_Category
                    Contact_Person
                    Contact_Email
                    Contact_Phone
                    Vendor_Address
                    Stage
                    Vendor_Status
                    Qualification_Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate )
            record ( Edit  Duplicate )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Vendor_Name
                    Vendor_Category
                    Vendor_Category_Config
                    Vendor_Type
                    Primary_Product_Service_Category
                    Contact_Person
                    Contact_Email
                    Contact_Phone
                    Vendor_Address
                    Stage
                    Vendor_Status
                    Qualification_Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate )
        )
    )
}
