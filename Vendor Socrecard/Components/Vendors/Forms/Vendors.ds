form Vendors
{
    displayname = "Vendors"
    success message = "Vendor saved successfully."
    record owner = Added_User
    Vendor_Registration
    (
        type = section
        displayname = "Vendor Registration"
        row = 1
        column = 0
    )
    Vendor_ID
    (
        type = autonumber
        displayname = "Vendor ID"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have unique Vendor_Name
    (
        type = text
        displayname = "Vendor Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )
    must have Vendor_Category
    (
        type = picklist
        displayname = "Vendor Category"
        values = {"Goods","Services","Technology","Logistics","Consulting","Other"}
        row = 1
        column = 2
        width = medium
    )
    Vendor_Category_Config
    (
        type = picklist
        displayname = "Configured Vendor Category"
        values = Categories[Category_Type == "Vendor Category" && Active == true].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Primary_Product_Service_Category
    (
        type = picklist
        displayname = "Primary Product / Service Category"
        values = Categories[Category_Type == "Product / Service Category" && Active == true].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Vendor_Type
    (
        type = picklist
        displayname = "Vendor Type"
        values = {"Local","National","International"}
        row = 1
        column = 1
        width = medium
    )
    Registration_Date
    (
        type = date
        displayname = "Registration Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Vendor_Status
    (
        type = picklist
        displayname = "Vendor Status"
        values = {"Draft","Pending Review","Approved","Suspended","Inactive"}
        initial value = "Draft"
        row = 1
        column = 1
        width = medium
    )
    must have Stage
    (
        type = picklist
        displayname = "Stage"
        values = {"Registered","Evaluated","Risk Assessed","Onboarded","Active","Performance Reviewed"}
        initial value = "Registered"
        row = 1
        column = 2
        width = medium
    )
    Qualification_Status
    (
        type = picklist
        displayname = "Qualification Status"
        values = {"Pending","Qualified","Rejected","On Hold","Watchlist"}
        initial value = "Pending"
        row = 1
        column = 1
        width = medium
    )
    Contact_Details
    (
        type = section
        displayname = "Primary Contact Summary"
        visibility = true
        row = 2
        column = 1
    )
    Contact_Person
    (
        type = text
        displayname = "Contact Person"
        row = 2
        column = 1
        width = medium
    )
    Contact_Email
    (
        type = email
        displayname = "Contact Email"
        personal data = true
        row = 2
        column = 2
        width = medium
    )
    Contact_Phone
    (
        type = phonenumber
        displayname = "Contact Phone"
        row = 2
        column = 1
        width = medium
    )
    Vendor_Address
    (
        type = address
        displayname = "Vendor Address"
        capture_coordinates = false
        adjust_using_map = false
        address_line_1
        (
            type = address_line_1
            displayname = "Street Address"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City"
        )
        state_province
        (
            type = state_province
            displayname = "State / Province"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Postal Code"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
        row = 2
        column = 2
        width = medium
    )
    Documents_Compliance
    (
        type = section
        displayname = "Identity Documents"
        visibility = true
        row = 3
        column = 1
    )
    Tax_ID
    (
        type = text
        displayname = "Tax ID"
        row = 3
        column = 1
        width = medium
    )
    Business_Registration_Number
    (
        type = text
        displayname = "Business Registration Number"
        row = 3
        column = 2
        width = medium
    )
    Registration_Document
    (
        type = upload file
        displayname = "Registration Document"
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 3
        column = 1
        width = medium
    )
    Compliance_Document
    (
        type = upload file
        displayname = "Compliance Document"
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 3
        column = 2
        width = medium
    )
    Score_Summary
    (
        type = section
        displayname = "Score Summary"
        visibility = true
        row = 4
        column = 1
    )
    Current_Evaluation_Rating
    (
        type = decimal
        displayname = "Current Evaluation Rating"
        decimalplace = 2
        row = 4
        column = 1
        width = medium
    )
    Evaluation_Result
    (
        type = picklist
        displayname = "Evaluation Result"
        values = {"Not Evaluated","Acceptable","Needs Improvement","Rejected"}
        initial value = "Not Evaluated"
        row = 4
        column = 2
        width = medium
    )
    Latest_Risk_Tier
    (
        type = picklist
        displayname = "Latest Risk Tier"
        values = {"Not Assessed","Low","Medium","High","Critical"}
        initial value = "Not Assessed"
        row = 4
        column = 1
        width = medium
    )
    Latest_Risk_Status
    (
        type = picklist
        displayname = "Latest Risk Status"
        values = {"Not Assessed","Acceptable","Unacceptable"}
        initial value = "Not Assessed"
        row = 4
        column = 2
        width = medium
    )
    Onboarding_Baseline_Score
    (
        type = decimal
        displayname = "Onboarding Baseline Score"
        decimalplace = 2
        row = 4
        column = 1
        width = medium
    )
    Active_From
    (
        type = date
        displayname = "Active From"
        row = 4
        column = 2
        width = medium
    )
    Latest_Performance_Score
    (
        type = decimal
        displayname = "Latest Performance Score"
        decimalplace = 2
        row = 4
        column = 1
        width = medium
    )
    Last_Review_Month
    (
        type = date
        displayname = "Last Review Month"
        row = 4
        column = 2
        width = medium
    )
    Lifecycle_Notes
    (
        type = textarea
        displayname = "Lifecycle Notes"
        height = 120px
        row = 4
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
    blueprint components
    {
        stages = {"Registered","Evaluated","Risk Assessed","Onboarded","Active","Performance Reviewed"}
    }
}
