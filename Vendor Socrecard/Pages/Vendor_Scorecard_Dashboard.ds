<page linkname = "Vendor_Scorecard_Dashboard" displayname = "Vendor Scorecard Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <file name:Dashboard_Header.ds/>
      </column>
    </row>
    <row>
      <column width='33%'>
        <file name:KPI_Total_Vendors.ds/>
      </column>
      <column width='33%'>
        <file name:KPI_Active_Vendors.ds/>
      </column>
      <column width='34%'>
        <file name:KPI_Pending_Registrations.ds/>
      </column>
    </row>
    <row>
      <column width='33%'>
        <file name:KPI_Average_Performance_Score.ds/>
      </column>
      <column width='33%'>
        <file name:KPI_High_Critical_Risk.ds/>
      </column>
      <column width='34%'>
        <file name:KPI_Pending_Onboarding.ds/>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Lifecycle_Distribution_Chart.ds/>
      </column>
      <column width='50%'>
        <file name:Risk_Tier_Distribution_Chart.ds/>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Performance_Band_Chart.ds/>
      </column>
      <column width='50%'>
        <file name:Registration_Status_Chart.ds/>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Average_Performance_Gauge.ds/>
      </column>
      <column width='50%'>
        <file name:Risk_Count_Board.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Vendor_Lifecycle_Board_Access.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Embedded_Performance_Watchlist.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Embedded_Pending_Registrations.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Embedded_Pending_Document_Verification.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Embedded_Expiring_Documents.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>