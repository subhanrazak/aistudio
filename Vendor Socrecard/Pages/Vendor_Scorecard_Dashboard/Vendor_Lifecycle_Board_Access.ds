<panel elementName='Vendor_Lifecycle_Board_Access'>
  <pr width='fill' height='auto'>
    <pc padding='14px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>
      <pr width='fill' height='auto'>
        <pc width='70%' hAlign='left' vAlign='middle'>
          <text color='#12132B' size='16px' bold='true' type='Text' value='Vendor Lifecycle Board'> </text>
          <text marginLeft='8px' color='#5F6199' size='13px' type='Text' value='Open the full Kanban lifecycle view for vendor stage management.'> </text>
        </pc>
        <pc width='30%' hAlign='right' vAlign='middle'>
          <button text='Open Lifecycle Board' action='OpenReport' componentLinkName='Vendor_Lifecycle_Board' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='14px' cornerRadius='8px' paddingTop='10px' paddingLeft='16px' paddingRight='16px' paddingBottom='10px' />
        </pc>
      </pr>
    </pc>
  </pr>
</panel>
