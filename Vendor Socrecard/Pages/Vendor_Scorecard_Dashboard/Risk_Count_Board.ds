<panel elementName='Risk_Count_Board_Panel'>
  <pr width='fill' height='auto'>
    <pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>
      <pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Risk Tier Counts'> </text></pc></pr>
      <pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Open risk reports to monitor low, medium, high, and critical vendor risk tiers.'> </text></pc></pr>
      <pr>
        <pc paddingTop='12px' width='33%' hAlign='left'><button text='All Risks' action='OpenReport' componentLinkName='All_Risk_Assessments' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
        <pc paddingTop='12px' width='33%' hAlign='left'><button text='High/Critical' action='OpenReport' componentLinkName='High_Risk_Vendors' appLinkName='thisapp' target='same-window' bgColor='#EA4335' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
        <pc paddingTop='12px' width='34%' hAlign='left'><button text='Acceptable' action='OpenReport' componentLinkName='Acceptable_Risk_Assessments' appLinkName='thisapp' target='same-window' bgColor='#16AD78' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
      </pr>
    </pc>
  </pr>
</panel>