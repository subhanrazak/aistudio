<panel elementName='Performance_Band_Chart'>
  <pr width='fill' height='auto'>
    <pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>
      <pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Performance Band Distribution'> </text></pc></pr>
      <pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Open performance scorecards, history, and watchlist reports for monthly vendor review.'> </text></pc></pr>
      <pr>
        <pc paddingTop='12px' width='33%' hAlign='left'><button text='Scorecards' action='OpenReport' componentLinkName='Monthly_Performance_Scorecards' appLinkName='thisapp' target='same-window' bgColor='#8A3DFB' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
        <pc paddingTop='12px' width='33%' hAlign='left'><button text='History' action='OpenReport' componentLinkName='Vendor_Performance_History' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
        <pc paddingTop='12px' width='34%' hAlign='left'><button text='Watchlist' action='OpenReport' componentLinkName='Performance_Watchlist' appLinkName='thisapp' target='same-window' bgColor='#EA4335' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
      </pr>
    </pc>
  </pr>
</panel>