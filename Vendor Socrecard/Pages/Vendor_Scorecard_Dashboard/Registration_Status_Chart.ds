<panel elementName='Registration_Status_Chart'>
  <pr width='fill' height='auto'>
    <pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>
      <pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Registration Status Distribution'> </text></pc></pr>
      <pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Open registration queues and conversion history for supplier intake follow-up.'> </text></pc></pr>
      <pr>
        <pc paddingTop='12px' width='33%' hAlign='left'><button text='Pending' action='OpenReport' componentLinkName='Pending_Registrations' appLinkName='thisapp' target='same-window' bgColor='#F37D16' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
        <pc paddingTop='12px' width='33%' hAlign='left'><button text='All' action='OpenReport' componentLinkName='All_Registrations' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
        <pc paddingTop='12px' width='34%' hAlign='left'><button text='Converted' action='OpenReport' componentLinkName='Converted_Registrations' appLinkName='thisapp' target='same-window' bgColor='#16AD78' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
      </pr>
    </pc>
  </pr>
</panel>