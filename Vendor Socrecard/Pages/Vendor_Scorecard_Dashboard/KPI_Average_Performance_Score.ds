<panel elementName='KPI_Average_Performance_Score'>
  <pr width='fill' height='fill'>
    <pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='center' vAlign='middle' cornerRadius='12px'>
      <pr width='auto' height='auto'>
        <pc>
          <image marginRight='7px' color='#FFFFFF' bgColor='#8A3DFB' width='52px' height='52px' type='icon' value='business-chart-bar-33' size='28px' cornerRadius='26px' iconType='outline' />
        </pc>
        <pc padding='5px' hAlign='left'>
          <pr>
            <pc hAlign='left'>
              <text color='#5F6199' size='14px' type='Text' value='Average Latest Performance Score'> </text>
            </pc>
          </pr>
          <pr>
            <pc hAlign='left'>
              <button text='View Scorecards' action='OpenReport' componentLinkName='Monthly_Performance_Scorecards' appLinkName='thisapp' target='same-window' bgColor='#8A3DFB' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' />
            </pc>
          </pr>
        </pc>
      </pr>
    </pc>
  </pr>
</panel>
