<panel elementName='Dashboard_Header'>
  <pr width='fill' height='auto'>
    <pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>
      <pr width='auto' height='auto'>
        <pc>
          <image marginRight='12px' color='#FFFFFF' bgColor='#2A70E7' width='52px' height='52px' type='icon' value='business-chart-bar-33' size='28px' cornerRadius='26px' iconType='outline' />
        </pc>
        <pc padding='5px' hAlign='left'>
          <pr>
            <pc hAlign='left'>
              <text color='#12132B' size='24px' bold='true' type='Text' value='Vendor Scorecard Dashboard'> </text>
            </pc>
          </pr>
          <pr>
            <pc hAlign='left'>
              <text marginTop='4px' color='#5F6199' size='14px' type='Text' value='Native KPI, lifecycle, risk, performance, registration, and document oversight for procurement and vendor management teams.'> </text>
            </pc>
          </pr>
        </pc>
      </pr>
    </pc>
  </pr>
</panel>
