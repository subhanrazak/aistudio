<panel elementName='Lifecycle_Distribution_Chart'>
  <pr width='fill' height='auto'>
    <pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px'>
      <pr><pc width='100%' hAlign='left'><text color='#12132B' size='16px' bold='true' type='Text' value='Lifecycle Distribution'> </text></pc></pr>
      <pr><pc width='100%' hAlign='left'><text marginTop='4px' color='#5F6199' size='13px' type='Text' value='Open lifecycle reports to review vendors by stage and manage movement through the lifecycle.'> </text></pc></pr>
      <pr>
        <pc paddingTop='12px' width='50%' hAlign='left'><button text='All Vendors' action='OpenReport' componentLinkName='All_Vendors' appLinkName='thisapp' target='same-window' bgColor='#2A70E7' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
        <pc paddingTop='12px' width='50%' hAlign='left'><button text='Lifecycle Board' action='OpenReport' componentLinkName='Vendor_Lifecycle_Board' appLinkName='thisapp' target='same-window' bgColor='#5F6199' color='#FFFFFF' size='13px' cornerRadius='8px' paddingTop='9px' paddingLeft='14px' paddingRight='14px' paddingBottom='9px' /></pc>
      </pr>
    </pc>
  </pr>
</panel>