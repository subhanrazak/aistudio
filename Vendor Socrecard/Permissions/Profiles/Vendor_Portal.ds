"Vendor_Portal"
{
    name        = "Vendor_Portal"
    type        = customer_portal
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "External vendor portal access for updating permitted registration, vendor, contact, product/service, and document details only."

    ModulePermissions
    {
        Vendors
        {
            enabled          = Create,Tab,View,Edit,Search
            allFieldsVisible = false
            ReportPermissions
            {
                My_Vendor_Profile={"View"}
            }
            FieldPermissions
            {
                Vendor_ID{visibility:true,readonly:true}
                Vendor_Name{visibility:true,readonly:false}
                Vendor_Category{visibility:true,readonly:false}
                Vendor_Category_Config{visibility:true,readonly:false}
                Vendor_Type{visibility:true,readonly:false}
                Primary_Product_Service_Category{visibility:true,readonly:false}
                Vendor_Status{visibility:true,readonly:true}
                Registration_Date{visibility:true,readonly:true}
                Stage{visibility:true,readonly:true}
                Qualification_Status{visibility:true,readonly:true}
                Contact_Person{visibility:true,readonly:false}
                Contact_Email{visibility:true,readonly:false}
                Contact_Phone{visibility:true,readonly:false}
                Vendor_Address{visibility:true,readonly:false}
                Tax_ID{visibility:true,readonly:false}
                Business_Registration_Number{visibility:true,readonly:false}
                Registration_Document{visibility:true,readonly:false}
                Compliance_Document{visibility:true,readonly:false}
                Current_Evaluation_Rating{visibility:false}
                Evaluation_Result{visibility:false}
                Latest_Risk_Tier{visibility:false}
                Latest_Risk_Status{visibility:false}
                Onboarding_Baseline_Score{visibility:false}
                Active_From{visibility:false}
                Latest_Performance_Score{visibility:false}
                Last_Review_Month{visibility:false}
                Lifecycle_Notes{visibility:false}
            }
        }
        Vendor_Contacts
        {
            enabled          = Create,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Primary_Contacts={"View"}
            }
        }
        Products_Services
        {
            enabled          = Create,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Active_Products_Services={"View"}
            }
        }
        Vendor_Documents
        {
            enabled          = Create,Tab,View,Edit,Search
            allFieldsVisible = false
            ReportPermissions
            {
                All_Documents={"View"}
                Expiring_Documents={"View"}
            }
            FieldPermissions
            {
                Document_ID{visibility:true,readonly:true}
                Vendor{visibility:true,readonly:false}
                Document_Type{visibility:true,readonly:false}
                Document_Name{visibility:true,readonly:false}
                Document_File{visibility:true,readonly:false}
                Issue_Date{visibility:true,readonly:false}
                Expiry_Date{visibility:true,readonly:false}
                Verification_Status{visibility:true,readonly:true}
                Verified_By{visibility:false}
                Verified_On{visibility:false}
                Notes{visibility:true,readonly:false}
            }
        }
        Vendor_Registration
        {
            enabled          = Create,Tab,View,Edit,Search
            allFieldsVisible = false
            ReportPermissions
            {
                Pending_Registrations={"View"}
            }
            FieldPermissions
            {
                Registration_ID{visibility:true,readonly:true}
                Registration_Date{visibility:true,readonly:true}
                Registration_Status{visibility:true,readonly:true}
                Linked_Vendor{visibility:true,readonly:true}
                Vendor_Name{visibility:true,readonly:false}
                Vendor_Category{visibility:true,readonly:false}
                Vendor_Type{visibility:true,readonly:false}
                Primary_Product_Service_Category{visibility:true,readonly:false}
                Tax_ID{visibility:true,readonly:false}
                Business_Registration_Number{visibility:true,readonly:false}
                Contact_Name{visibility:true,readonly:false}
                Contact_Email{visibility:true,readonly:false}
                Contact_Phone{visibility:true,readonly:false}
                Vendor_Address{visibility:true,readonly:false}
                Registration_Document{visibility:true,readonly:false}
                Compliance_Document{visibility:true,readonly:false}
                Registration_Notes{visibility:true,readonly:false}
            }
        }
    }
}
