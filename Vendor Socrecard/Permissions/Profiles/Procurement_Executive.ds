"Procurement_Executive"
{
    name        = "Procurement_Executive"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Registers vendors, maintains vendor master details, uploads documents, and views lifecycle progress."

    ModulePermissions
    {
        Categories
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Categories={"View"}
                Active_Categories={"View"}
            }
        }
        Criteria
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Criteria={"View"}
                Active_Criteria={"View"}
            }
        }
        Weightages
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Weightages={"View"}
                Active_Weightages={"View"}
            }
        }
        Rating_Scales
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Rating_Scales={"View"}
                Active_Rating_Scales={"View"}
            }
        }
        App_Users
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Active_Users={"View"}
            }
        }
        Vendors
        {
            enabled          = Create,Viewall,Modifyall,Import,Tab,View,Edit,Search
            allFieldsVisible = false
            ReportPermissions
            {
                All_Vendors={"View"}
                Vendor_Lifecycle_Board={"View"}
                Active_Vendors={"View"}
                My_Vendor_Profile={"View"}
            }
            FieldPermissions
            {
                Vendor_ID{visibility:true,readonly:true}
                Vendor_Name{visibility:true,readonly:false}
                Vendor_Category{visibility:true,readonly:false}
                Vendor_Category_Config{visibility:true,readonly:false}
                Vendor_Type{visibility:true,readonly:false}
                Primary_Product_Service_Category{visibility:true,readonly:false}
                Vendor_Status{visibility:true,readonly:false}
                Registration_Date{visibility:true,readonly:false}
                Stage{visibility:true,readonly:true}
                Qualification_Status{visibility:true,readonly:true}
                Contact_Person{visibility:true,readonly:false}
                Contact_Email{visibility:true,readonly:false}
                Contact_Phone{visibility:true,readonly:false}
                Vendor_Address{visibility:true,readonly:false}
                Tax_ID{visibility:true,readonly:false}
                Business_Registration_Number{visibility:true,readonly:false}
                Registration_Document{visibility:true,readonly:false}
                Compliance_Document{visibility:true,readonly:false}
                Current_Evaluation_Rating{visibility:true,readonly:true}
                Evaluation_Result{visibility:true,readonly:true}
                Latest_Risk_Tier{visibility:true,readonly:true}
                Latest_Risk_Status{visibility:true,readonly:true}
                Onboarding_Baseline_Score{visibility:true,readonly:true}
                Active_From{visibility:true,readonly:true}
                Latest_Performance_Score{visibility:true,readonly:true}
                Last_Review_Month{visibility:true,readonly:true}
                Lifecycle_Notes{visibility:true,readonly:true}
            }
        }
        Vendor_Contacts
        {
            enabled          = Create,Viewall,Modifyall,Import,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Contacts={"View"}
                Primary_Contacts={"View"}
            }
        }
        Products_Services
        {
            enabled          = Create,Viewall,Modifyall,Import,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Products_Services={"View"}
                Active_Products_Services={"View"}
            }
        }
        Vendor_Documents
        {
            enabled          = Create,Viewall,Modifyall,Import,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Documents={"View"}
                Expiring_Documents={"View"}
                Pending_Document_Verification={"View"}
            }
        }
        Vendor_Registration
        {
            enabled          = Create,Viewall,Modifyall,Import,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Registrations={"View"}
                Pending_Registrations={"View"}
                Converted_Registrations={"View"}
            }
        }
        Vendor_Evaluations
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Evaluations={"View"}
                Acceptable_Evaluations={"View"}
                Evaluation_By_Criteria={"View"}
            }
        }
        Risk_Assessments
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Risk_Assessments={"View"}
                High_Risk_Vendors={"View"}
                Acceptable_Risk_Assessments={"View"}
            }
        }
        Vendor_Onboarding
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Onboarding_Records={"View"}
                Onboarding_Pending={"View"}
