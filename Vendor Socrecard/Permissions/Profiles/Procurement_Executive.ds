        }
        Vendor_Performance_Metrics
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Monthly_Performance_Scorecards={"View"}
                Performance_Watchlist={"View"}
                Vendor_Performance_History={"View"}
                Completed_Performance_Reviews={"View"}
            }
        }
        Vendor_Scorecard_Dashboard
        {
            enabled = tab
        }
    }
}
