float Calculate_Renewal_Fee(int licenseId, string penaltyStage)
{

                 	renewalAmount = 0.0;
                 	stage = ifnull(penaltyStage,"None");
                 	licenseRows = Licenses[ID == licenseId];
                 	if(licenseRows.count() > 0 && licenseRows.License_Type != null)
                 	{
                 		typeRows = License_Types[ID == licenseRows.License_Type];
                 		if(typeRows.count() > 0)
                 		{
                 			if(stage == "50%")
                 			{
                 				renewalAmount = ifnull(typeRows.Renewal_50_REN50,0.0);
                 			}
                 			else if(stage == "100%")
                 			{
                 				renewalAmount = ifnull(typeRows.Renewal_100_REN100,0.0);
                 			}
                 			else
                 			{
                 				renewalAmount = ifnull(typeRows.Renewal_Fee_REN,0.0);
                 			}
                 		}
                 	}
                 	return renewalAmount;
                 
}