string Determine_Required_Documents(string ownershipStructure, string retailOrNonRetail, string licenseCode)
{

                 	docs = List();
                 	structure = ifnull(ownershipStructure,"");
                 	retailFlag = ifnull(retailOrNonRetail,"");
                 	code = ifnull(licenseCode,"");
                 	docs.add("ABC-140NEW Certificate re Chapter 15 Tied-House Restrictions");
                 	docs.add("ABC-208-A Individual Personal Affidavit");
                 	docs.add("ABC-208-B Individual Financial Affidavit");
                 	docs.add("ABC-211-SIG Application Signature Sheet");
                 	docs.add("ABC-217 Application Questionnaire");
                 	if(retailFlag != "Non-Retail")
                 	{
                 		docs.add("ABC-247 Statement re Residences");
                 		docs.add("ABC-251 Statement re Consideration Points");
                 		docs.add("ABC-258 Planned Operations Retail");
                 	}
                 	if(retailFlag != "Non-Retail" || code == "17/20")
                 	{
                 		docs.add("ABC-253 Supplemental Diagram");
                 	}
                 	docs.add("ABC-255 Zoning Affidavit");
                 	docs.add("ABC-257 Licensed Premises Diagram/Planned Operation");
                 	if(retailFlag == "Non-Retail" && code == "75" || code == "85")
                 	{
                 		docs.add("ABC-259 Planned Operations Non-Retail");
                 	}
                 	docs.add("State-issued identification for signing applicant(s)");
                 	docs.add("Verification of source of funds");
                 	docs.add("Conditional Use Permit or receipt");
                 	if(structure == "Corporation")
                 	{
                 		docs.add("ABC-243 Corporate Questionnaire");
                 		docs.add("Articles of Incorporation");
                 		docs.add("Minutes showing current officers/directors or Certificate of Incumbency");
                 		docs.add("Stock Register or issued/blank stock certificates");
                 		docs.add("Certificate of Qualification for out-of-state corporations");
                 	}
                 	else if(structure == "LLC")
                 	{
                 		docs.add("ABC-256-LLC Limited Liability Company Questionnaire");
                 		docs.add("LLC-1 Articles of Organization");
                 		docs.add("LLC-5 Registration as Foreign LLC, if applicable");
                 		docs.add("Operating Agreement and amendments");
                 	}
                 	else if(structure == "Limited Partnership")
                 	{
                 		docs.add("ABC-256 Limited Partnership Questionnaire");
                 		docs.add("LP-1 Certificate of Limited Partnership");
                 		docs.add("LP-5 Registration as Foreign Limited Partnership, if applicable");
                 		docs.add("Limited Partnership Agreement and amendments");
                 	}
                 	else if(structure == "Trust")
                 	{
                 		docs.add("Trust Agreement");
                 	}
                 	return docs.toString("\n");
                 
}