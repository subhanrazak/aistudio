int Create_Correspondence_Stub(string moduleName, int sourceRecordId, string templateCode, string recipientEmail, string statusText)
{

                 	sourceFormName = ifnull(moduleName,"");
                 	subjectText = ifnull(templateCode,"Correspondence") + " - Manual merge required";
                 	stubId = insert into Correspondence
                 	[
                 		Module=moduleName
                 		Source_Form=sourceFormName
                 		Source_Record_ID=sourceRecordId
                 		Template_Code=templateCode
                 		Recipient_Email=recipientEmail
                 		Subject=subjectText
                 		Merge_Status="Ready for Manual Merge"
                 		Sign_Status=statusText
                 		Body_or_Merge_Notes="Integration is intentionally manual/stubbed for this POC."
                 		Added_User=zoho.loginuser
                 	];
                 	return stubId;
                 
}