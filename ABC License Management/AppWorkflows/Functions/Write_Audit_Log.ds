void Write_Audit_Log(string moduleName, string sourceForm, int sourceRecordId, string actionText, string detailText)
{

                 	insert into Audit_Log
                 	[
                 		Event_Time=zoho.currenttime
                 		Event_User=zoho.loginuserid
                 		Module=moduleName
                 		Source_Form=sourceForm
                 		Source_Record_ID=sourceRecordId
                 		Action=actionText
                 		Details=detailText
                 		IP_or_Context="Creator workflow"
                 		Added_User=zoho.loginuser
                 	]
                 
}