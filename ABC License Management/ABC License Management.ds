 driven by the existing enforcement reports and case records.&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Core enforcement views&lt;/h5&gt;\n\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Cases and legal review&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Mobile_Field_Capture&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline location-appointment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Field visits&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Notice_Of_Violation_Queue&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline files-exclamation&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Violations and NOV queue&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Disposition_Queue&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Evidence disposition&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;abc-table-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;abc-card abc-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Cases&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Open case queue with license context.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-table-link&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;License context&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Visit due&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tcaseShown = 0;\n\t\t\t\t\t\tfor each c in Cases[Case_Status != &quot;Closed&quot;] sort by Added_Time desc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(caseShown &lt; 6)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tcaseShown = caseShown + 1;\n\t\t\t\t\t\t\t\tcaseStatus = ifnull(c.Case_Status,&quot;New&quot;);\n\t\t\t\t\t\t\t\tcaseBadge = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\tcaseIcon = &quot;loader-dots-06&quot;;\n\t\t\t\t\t\t\t\tif(caseStatus == &quot;Legal Review&quot; || caseStatus == &quot;Referred to OLS&quot; || caseStatus == &quot;Hearing Status&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tcaseBadge = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t\tcaseIcon = &quot;business-law&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tpriorityBadge = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\tpriorityIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\tif(c.Priority == &quot;High&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tpriorityBadge = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\tpriorityIcon = &quot;ui-3-alert&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tlicenseLabel = &quot;No license context&quot;;\n\t\t\t\t\t\t\t\tlicenseBadge = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\tif(c.License != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tlicenseLabel = ifnull(c.License.License_Number,&quot;License selected&quot;) + &quot; &quot; + ifnull(c.License.License_Status,&quot;Status pending&quot;);\n\t\t\t\t\t\t\t\t\tlicenseBadge = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\tif(c.License.License_Status == &quot;Terminated&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tlicenseLabel = ifnull(c.License.License_Number,&quot;License selected&quot;) + &quot; historical terminated&quot;;\n\t\t\t\t\t\t\t\t\t\tlicenseBadge = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(c.Case_Number,&quot;Case&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border abc-status-cell&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=caseBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline &lt;%=caseIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=caseStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border abc-status-cell&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=priorityBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline &lt;%=priorityIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(c.Priority,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border abc-status-cell&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=licenseBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=licenseLabel%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(c.Initial_Visit_Due_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(caseShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;abc-empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;No open cases are currently queued.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;abc-card abc-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Complaints&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Screening queue and intake status.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-table-link&quot; href=&quot;#Report:Supervisor_Screening_Queue&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Complaint&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Decision&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Nature&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;License context&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tcomplaintShown = 0;\n\t\t\t\t\t\tfor each cp in Complaints[Screening_Decision == &quot;New&quot; || Screening_Decision == &quot;Need More Information&quot;] sort by Intake_Date desc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(complaintShown &lt; 6)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tcomplaintShown = complaintShown + 1;\n\t\t\t\t\t\t\t\tdecisionBadge = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\tdecisionIcon = &quot;loader-dots-06&quot;;\n\t\t\t\t\t\t\t\tif(cp.Screening_Decision == &quot;Need More Information&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tdecisionBadge = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t\tdecisionIcon = &quot;ui-3-alert&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tcomplaintPriorityBadge = if(cp.Priority == &quot;High&quot;,&quot;zcs-badge-red&quot;,&quot;zcs-badge-grey&quot;);\n\t\t\t\t\t\t\t\tcomplaintLicense = &quot;No license context&quot;;\n\t\t\t\t\t\t\t\tcomplaintLicenseBadge = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\tif(cp.License != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tcomplaintLicense = ifnull(cp.License.License_Number,&quot;License selected&quot;) + &quot; &quot; + ifnull(cp.License.License_Status,&quot;Status pending&quot;);\n\t\t\t\t\t\t\t\t\tcomplaintLicenseBadge = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\tif(cp.License.License_Status == &quot;Terminated&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tcomplaintLicense = ifnull(cp.License.License_Number,&quot;License selected&quot;) + &quot; historical terminated&quot;;\n\t\t\t\t\t\t\t\t\t\tcomplaintLicenseBadge = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(cp.Complaint_Number,&quot;Complaint&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border abc-status-cell&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=decisionBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline &lt;%=decisionIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(cp.Screening_Decision,&quot;New&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=complaintPriorityBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(cp.Priority,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(cp.Nature_of_Violation,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=complaintLicenseBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=complaintLicense%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(complaintShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;abc-empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;No complaints are waiting in the screening queue.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;abc-card abc-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Field visits&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Upcoming visits and capture state.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-table-link&quot; href=&quot;#Report:Mobile_Field_Capture&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Visit&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Visit type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date and time&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;FSM status&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tvisitShown = 0;\n\t\t\t\t\t\tfor each fv in Field_Visits[Visit_Date_Time &gt;= zoho.currentdate] sort by Visit_Date_Time asc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(visitShown &lt; 6)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tvisitShown = visitShown + 1;\n\t\t\t\t\t\t\t\tvisitCase = &quot;Case not linked&quot;;\n\t\t\t\t\t\t\t\tif(fv.Case != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tvisitCase = ifnull(fv.Case.Case_Number,&quot;Case linked&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tfsmBadge = if(fv.FSM_Status == &quot;Synced Manually&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-blue&quot;);\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(fv.Visit_Number,&quot;Visit&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=visitCase%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(fv.Visit_Type,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(fv.Visit_Date_Time,&quot;Not scheduled&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=fsmBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline location-appointment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(fv.FSM_Status,&quot;Not sent&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(visitShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;abc-empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;No upcoming field visits are currently scheduled.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;abc-card abc-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Violations and evidence&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Latest violation actions paired with custody status.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-table-link&quot; href=&quot;#Report:Notice_Of_Violation_Queue&quot;&gt;Open NOV queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Violation&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Recommended action&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;NOV&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tviolationShown = 0;\n\t\t\t\t\t\tfor each v in Violations[ID != 0] sort by Violation_Date desc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(violationShown &lt; 6)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tviolationShown = violationShown + 1;\n\t\t\t\t\t\t\t\tvCase = &quot;Case not linked&quot;;\n\t\t\t\t\t\t\t\tif(v.Case != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tvCase = ifnull(v.Case.Case_Number,&quot;Case linked&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tnovBadge = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\tnovText = &quot;Not issued&quot;;\n\t\t\t\t\t\t\t\tif(v.Notice_of_Violation_Issued == true)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tnovBadge = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t\tnovText = &quot;Issued&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(v.Violation_Number,&quot;Violation&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=vCase%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(v.Violation_Type,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(v.Recommended_Action,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=novBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline files-exclamation&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=novText%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(violationShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;abc-empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;No violation records are available.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;abc-table-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;abc-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Evidence custody&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Recent evidence and disposition level.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-table-link&quot; href=&quot;#Report:Disposition_Queue&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Evidence&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Custody&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Disposition&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tevidenceShown = 0;\n\t\t\t\t\t\tfor each ev in Evidence[ID != 0] sort by Date_Collected desc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(evidenceShown &lt; 6)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tevidenceShown = evidenceShown + 1;\n\t\t\t\t\t\t\t\tevCase = &quot;Case not linked&quot;;\n\t\t\t\t\t\t\t\tif(ev.Case != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tevCase = ifnull(ev.Case.Case_Number,&quot;Case linked&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tcustodyBadge = if(ev.Chain_of_Custody_Status == &quot;Disposed&quot; || ev.Chain_of_Custody_Status == &quot;Released to Owner&quot;,&quot;zcs-badge-grey&quot;,&quot;zcs-badge-green&quot;);\n\t\t\t\t\t\t\t\tdispositionBadge = if(ev.Disposition_Level == &quot;Not Ready&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-blue&quot;);\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ev.Evidence_Number,&quot;Evidence&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=evCase%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(ev.Evidence_Type,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=custodyBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(ev.Chain_of_Custody_Status,&quot;Collected&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=dispositionBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(ev.Disposition_Level,&quot;Not Ready&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(evidenceShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;abc-empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;No evidence records are available.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;abc-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Legal review status&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Case status distribution for OLS and hearing work.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-table-link&quot; href=&quot;#Report:Legal_Review_View&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Count&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Focus&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2&quot; colspan=&quot;3&quot;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline business-law&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;Pending OLS Review&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=legalPending%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;Attorney review&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;Accusation Drafted&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=legalDrafted%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;Draft review&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-orange zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;Hearing&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=legalHearing%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;Scheduled or held&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;Decision or appeal&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=legalDecision%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;Post-hearing resolution&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&quot;abc-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Cases&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Preserved Enforcement_Work_Queue embed.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Enforcement_Work_Queue&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Complaints&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Preserved Supervisor_Screening_Queue embed.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Supervisor_Screening_Queue&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Field_Visits&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Preserved Mobile_Field_Capture embed.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Mobile_Field_Capture&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Violations&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Preserved Notice_Of_Violation_Queue embed.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Notice_Of_Violation_Queue&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Evidence&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Preserved Disposition_Queue embed.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Disposition_Queue&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Legal review&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Preserved Legal_Review_View embed.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Legal_Review_View&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Enforcement_Documents&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;&lt;%=enforcementDocuments%&gt; enforcement document records.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Enforcement_Documents&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;abc-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Pending_Correspondence&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;&lt;%=pendingCorrespondence%&gt; draft or manual merge records.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Pending_Correspondence&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Enforcement_Supervisor_Action_Center
		{
					displayname = "Enforcement Supervisor Action Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Enforcement_Supervisor_Action_Center_Snippet' elementName='Enforcement_Supervisor_Action_Center_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Enforcement_Supervisor_Action_Center_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\tsupervisorEmail = ifnull(zoho.loginuserid,&quot;&quot;);\n\tif(supervisorEmail == &quot;&quot; || supervisorEmail == null)\n\t{\n\t\tsupervisorEmail = &quot;Current user&quot;;\n\t}\n\tsupervisorName = supervisorEmail;\n\tsupervisorRole = &quot;Enforcement Supervisor&quot;;\n\tagentRow = Add_Agents[Agent_Email == supervisorEmail &amp;&amp; Active == true];\n\tif(agentRow.count() &gt; 0)\n\t{\n\t\tfirstName = ifnull(agentRow.Agent_Name.first_name,&quot;&quot;);\n\t\tlastName = ifnull(agentRow.Agent_Name.last_name,&quot;&quot;);\n\t\tfullName = (firstName + &quot; &quot; + lastName).trim();\n\t\tif(fullName != &quot;&quot;)\n\t\t{\n\t\t\tsupervisorName = fullName;\n\t\t}\n\t\tsupervisorRole = ifnull(agentRow.Agent_Role,&quot;Enforcement Supervisor&quot;);\n\t}\n\n\tscreeningQueue = Complaints[Screening_Decision == &quot;New&quot; || Screening_Decision == &quot;Need More Information&quot;] sort by Intake_Date asc;\n\thighPriorityComplaints = Complaints[Priority == &quot;High&quot; &amp;&amp; Screening_Decision != &quot;Rejected&quot; &amp;&amp; Screening_Decision != &quot;Closed&quot;] sort by Intake_Date asc;\n\topenCases = Cases[Case_Status != &quot;Closed&quot;] sort by Initial_Visit_Due_Date asc;\n\tunassignedOpenCases = Cases[(Assigned_Agent_Email == null || Assigned_Agent_Email == &quot;&quot;) &amp;&amp; Case_Status != &quot;Closed&quot;] sort by Initial_Visit_Due_Date asc;\n\toverdueFieldVisits = Field_Visits[Visit_Date_Time &lt; zoho.currentdate &amp;&amp; FSM_Status != &quot;Synced Manually&quot;] sort by Visit_Date_Time asc;\n\tlegalReviewQueue = Cases[Case_Status == &quot;Referred to OLS&quot; || Case_Status == &quot;Legal Review&quot; || Case_Status == &quot;Hearing Status&quot; || Legal_Review_Status == &quot;Pending OLS Review&quot; || Legal_Review_Status == &quot;Accusation Drafted&quot; || Legal_Review_Status == &quot;Hearing Scheduled&quot;] sort by Initial_Visit_Due_Date asc;\n\tlegalReferralCandidates = Cases[Case_Status != &quot;Closed&quot; &amp;&amp; Recommend_Accusation == true] sort by Initial_Visit_Due_Date asc;\n\tevidenceDispositionQueue = Evidence[Chain_of_Custody_Status == &quot;Disposed&quot; || Disposition_Level != &quot;Not Ready&quot;] sort by Date_Collected asc;\n\tevidenceReadyForAction = Evidence[Disposition_Level != &quot;Not Ready&quot; &amp;&amp; Chain_of_Custody_Status != &quot;Disposed&quot; &amp;&amp; Chain_of_Custody_Status != &quot;Released to Owner&quot;] sort by Date_Collected asc;\n\tcorrespondenceQueue = Correspondence[Merge_Status == &quot;Draft&quot; || Merge_Status == &quot;Ready for Manual Merge&quot;] sort by Generated_Date asc;\n\tpendingMerge = Correspondence[Merge_Status == &quot;Draft&quot;].count();\n\tpendingSignature = Correspondence[Sign_Status == &quot;Not Required&quot; || Sign_Status == &quot;Declined&quot;].count();\n\n\tscreeningCount = screeningQueue.count();\n\thighPriorityCount = highPriorityComplaints.count();\n\topenCaseCount = openCases.count();\n\tunassignedCaseCount = unassignedOpenCases.count();\n\toverdueVisitCount = overdueFieldVisits.count();\n\tlegalReviewCount = legalReviewQueue.count();\n\tlegalReferralCount = legalReferralCandidates.count();\n\tevidenceDispositionCount = evidenceDispositionQueue.count();\n\tevidenceReadyCount = evidenceReadyForAction.count();\n\tpendingCorrespondenceCount = correspondenceQueue.count();\n\ttotalActionLoad = screeningCount + highPriorityCount + unassignedCaseCount + overdueVisitCount + legalReviewCount + evidenceDispositionCount + pendingCorrespondenceCount;\n\topenCaseLabel = if(openCaseCount == 1,&quot;open case&quot;,&quot;open cases&quot;);\n%&gt;\n&lt;style&gt;\n/* ZCS component ids used: zcs-global, header-heading-with-actions, card-sample-1, badge-badge-with-icon, button-primary-button, table-table-with-custom-action-button-icon. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#2563eb);--zcs-light-bg-color:var(--zcs_brand_light_color,#eaf2ff);--zcs-page-bg-color:#f5f7fb;--zcs-primary-text-color:var(--zcs_primary_text_color,#111827);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#4b5563);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#8a94a6);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e7eb);--zcs-white-color:#fff;--zcs-black-color:#000;--zcs-thead-color:#f9fafe;--zcs-tr-h-color:#f6f8ff;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-p-25{padding:1.5625rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-box-border{box-sizing:border-box}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-cursor-pointer{cursor:pointer}a{text-decoration:none;color:inherit}.zcs-list-none{list-style-type:none}\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-prim