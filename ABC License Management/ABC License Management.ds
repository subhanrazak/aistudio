					Submitted_Date
					(
		    			type = date
						displayname = "Submitted Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 2   
						width = medium
					)
					Completed_Date
					(
		    			type = date
						displayname = "Completed Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					Manual_Entry_By_Staff
					(
		    			type = checkbox
						displayname = "Manual Entry By Staff"
						initial value = false
			 			row = 1
			 			column = 2   
						width = medium
					)
					Notes
					(
		    			type = textarea
						height = 120px
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Save Renewal Batch"
							)
							reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update Renewal Batch"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

