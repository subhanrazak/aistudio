			Cases_On_Load as "Prepare Case Form"
			{
			
							type =  form
							form = Cases
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Priority == null)
													{
														input.Priority = "Standard";
													}
													if(input.Case_Status == null)
													{
														input.Case_Status = "New";
													}
													if(input.RFA_Status == null)
													{
														input.RFA_Status = "Not Started";
													}
													if(input.Legal_Review_Status == null)
													{
														input.Legal_Review_Status = "Not Referred";
													}
													if(input.Supervisor_Lock == true)
													{
														disable Case_Status;
														disable Closure_Outcome;
														disable Closure_Date;
														disable Investigation_Summary;
														disable Legal_Notes;
													}
									)
								}
							}
			
						
			}

			Cases_On_Success as "Audit Case Lifecycle"
			{
			
							type =  form
							form = Cases
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Priority == "High" && input.Initial_Visit_Due_Date == null)
													{
														input.Initial_Visit_Due_Date = zoho.currentdate.addDay(30);
													}
													if(input.Case_Status == "Report Preparation")
													{
														thisapp.Create_Correspondence_Stub("Enforcement",input.ID,"ABC-333",input.Supervising_Agent_Email,"Not Required");
														thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Report preparation","ABC-333 correspondence stub created.");
													}
													else if(input.Case_Status == "Referred to OLS")
													{
														input.Legal_Review_Status = "Pending OLS Review";
														thisapp.Create_Correspondence_Stub("Enforcement",input.ID,"ABC-300",input.OLS_Assigned_Attorney_Email,"Not Required");
														thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Referred to OLS","ABC-300 correspondence stub created.");
													}
													else if(input.Case_Status == "Closed")
													{
														input.Supervisor_Lock = true;
														input.Legal_Review_Status = "Closed";
														if(input.Closure_Documents_Filed != true)
														{
															thisapp.Create_Correspondence_Stub("Enforcement",input.ID,"Other",input.Supervising_Agent_Email,"Not Required");
														}
														thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Case closed","Outcome: " + input.Closure_Outcome);
													}
													else
													{
														thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Case saved","Status: " + input.Case_Status);
													}
									)
								}
							}
			
						
			}

			Cases_On_Validate as "Validate Case Milestones"
			{
			
							type =  form
							form = Cases
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Case_Status == "Closed")
													{
														if(input.Closure_Outcome == null || input.Closure_Date == null)
														{
															alert "Closure outcome and closure date are required before closing a case.";
															cancel submit;
														}
													}
													if(input.Recommend_Accusation == true && input.Case_Status == "Referred to OLS")
													{
														if(input.RFA_Status != "Submitted to Division/OLS" && input.RFA_Status != "Approved")
														{
															alert "RFA status must be Submitted to Division/OLS or Approved before referring an accusation case to OLS.";
															cancel submit;
														}
													}
													if(input.Supervisor_Lock == true && input.Case_Status != "Closed")
													{
														alert "Supervisor lock is only allowed for closed cases.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Complaints_On_Load as "Prepare Complaint Intake"
			{
			
							type =  form
							form = Complaints
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Intake_Date == null)
													{
														input.Intake_Date = zoho.currentdate;
													}
													if(input.Screening_Decision == null)
													{
														input.Screening_Decision = "New";
													}
													disable Created_Case;
									)
								}
							}
			
						
