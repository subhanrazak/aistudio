		schedule
		{
			License_Renewal_Schedule as "License Renewal Schedule"
			{
			
							type =  schedule
								status = inactive
							start = "2026-01-01 08:00:00"
							frequency = daily
							time zone = "America/Los_Angeles"
							on start
							{
								actions 
								{
								on load
								(
									noticeCandidates = Licenses[Expiration_Date in next 60 days && Renewal_Notice_Generated == false && License_Status == "Active" || License_Status == "Renewed"];
													for each  lic in noticeCandidates
													{
														noticeId = insert into Renewal_Notices
														[
															License=lic.ID
															Entity=lic.Entity
															Notice_Type="60-Day Renewal Notice"
															Notice_Date=zoho.currentdate
															Due_Date=lic.Expiration_Date
															Penalty_Stage="None"
															Recipient_Email=lic.Licensee_Email
															Delivery_Status="Draft"
															Added_User=zoho.loginuser
														];
														lic.Renewal_Notice_Generated=true;
														lic.License_Status="Renewal Due";
														thisapp.Write_Audit_Log("Renewal","Licenses",lic.ID,"Renewal notice generated","60-day renewal notice created.");
													}
													expiredCandidates = Licenses[Expiration_Date < zoho.currentdate && Penalty_Stage == "None" && License_Status != "Renewed" && License_Status != "Closed"];
													for each  lic2 in expiredCandidates
													{
														lic2.Penalty_Stage="50%";
														lic2.License_Status="50% Penalty";
														insert into Renewal_Notices
														[
															License=lic2.ID
															Entity=lic2.Entity
															Notice_Type="50% Late Notice"
															Notice_Date=zoho.currentdate
															Due_Date=lic2.Expiration_Date.addDay(14)
															Penalty_Stage="50%"
															Recipient_Email=lic2.Licensee_Email
															Delivery_Status="Draft"
															Added_User=zoho.loginuser
														]
														thisapp.Create_Correspondence_Stub("Renewal",lic2.ID,"50% Late Notice",lic2.Licensee_Email,"Not Required");
														thisapp.Write_Audit_Log("Renewal","Licenses",lic2.ID,"50% penalty applied","License expired without renewal.");
													}
													secondPenaltyCandidates = Licenses[Expiration_Date < zoho.currentdate.addDay(-14) && Penalty_Stage == "50%" && License_Status != "Renewed" && License_Status != "Closed"];
													for each  lic3 in secondPenaltyCandidates
													{
														lic3.Penalty_Stage="100%";
														lic3.License_Status="100% Penalty";
														insert into Renewal_Notices
														[
															License=lic3.ID
															Entity=lic3.Entity
															Notice_Type="100% Late Notice"
															Notice_Date=zoho.currentdate
															Due_Date=lic3.Expiration_Date.addDay(30)
															Penalty_Stage="100%"
															Recipient_Email=lic3.Licensee_Email
															Delivery_Status="Draft"
															Added_User=zoho.loginuser
														]
														thisapp.Create_Correspondence_Stub("Renewal",lic3.ID,"100% Late Notice",lic3.Licensee_Email,"Not Required");
														thisapp.Write_Audit_Log("Renewal","Licenses",lic3.ID,"100% penalty applied","Second penalty deadline lapsed.");
													}
								)
								}
							}
						
			}
		}

		functions
		{
			Approve_Application as "Approve Application"
			{
				type = functions
				form = Applications
				execution type = for each record
			
				on start
				{
					actions
					{
						on click
						(
							if(input.Application_Status == "In-progress" || input.Application_Status == "Ready for Approval")
							{
								input.Application_Status = "Approved";
								input.Checklist_Complete = true;
								thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Application approved","Application approved from application queue by " + zoho.loginuserid + ".");
							}
						)
					}
				}
			}

			Assign_Review as "Assign Review"
			{
				type = functions
				form = Applications
				execution type = for each record
			
				on start
				{
					actions
					{
						on click
						(
							if(input.Application_Status == "Submitted" || input.Application_Status == "In-progress")
							{
								input.Application_Status = "In-progress";
								input.Assigned_Licensing_Rep = zoho.loginuserid;
								thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Review assigned","Review assigned to " + zoho.loginuserid + " from application queue.");
							}
						)
					}
				}
			}

			Issue_License as "Issue License"
			{
				type = functions
				form = Applications
				execution type = for each record
			
				on start
				{
					actions
					{
						on click
						(
							if(input.Application_Status == "Approved")
							{
								issueDate = zoho.currentdate;
								if(input.Issued_License != null)
								{
									input.Application_Status = "License Issued";
									if(input.Issued_Date == null)
									{
										input.Issued_Date = issueDate;
									}
									thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"License issued","Existing issued license linked and status set by " + zoho.loginuserid + ".");
								}
								else if(input.Application_Type == "Original" && input.License_Type != null && input.Entity != null && input.Premises != null)
								{
									licenseId = insert into Licenses
									[
										License_Type=input.License_Type
										Entity=input.Entity
										Premises=input.Premises
										Source_Application=input.ID
										Source_New_Application=input.ID
										Applicant_Profile=input.Applicant_Profile
										Legal_Entity_New=input.Legal_Entity
										DBA_New=input.DBA
										Premise_Address_New=input.Premise_Address
										Issue_Date=issueDate
										Expiration_Date=issueDate.addYear(1)
										License_Status="Active"
										Penalty_Stage="None"
										Licensee_Email=input.Applicant_Email
									];
									input.Issued_License = licenseId;
									input.Issued_Date = issueDate;
									input.Application_Status = "License Issued";
									thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Original license issued","New active license created from report action by " + zoho.loginuserid + ".");
								}
								else if(input.Application_Type == "Transfer" && input.License != null && input.License_Type != null && input.Entity != null && input.Premises != null)
								{
									licenseId = insert into Licenses
									[
										License_Type=input.License_Type
										Entity=input.Entity
										Premises=input.Premises
										Source_Application=input.ID
										Source_New_Application=input.ID
										Applicant_Profile=input.Applicant_Profile
										Legal_Entity_New=input.Legal_Entity
										DBA_New=input.DBA
										Premise_Address_New=input.Premise_Address
										Issue_Date=issueDate
										Expiration_Date=issueDate.addYear(1)
										License_Status="Active"
										Penalty_Stage="None"
										Licensee_Email=input.Applicant_Email
									];
									input.Issued_License = licenseId;
									input.Issued_Date = issueDate;
									input.Application_Status = "License Issued";
									existingLicense = Licenses[ID == input.License];
									if(existingLicense.count() > 0)
									{
										existingLicense.License_Status = "Terminated";
										existingLicense.Terminated_Date = issueDate;
										existingLicense.Termination_Reason = "Terminated by transfer application " + input.ID;
										existingLicense.Replaced_By_License = input.Issued_License;
									}
									thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Transfer license issued","New active license created and selected existing license terminated from report action by " + zoho.loginuserid + ".");
								}
								else if(input.Application_Type == "Change" && input.License != null)
								{
									existingLicense = Licenses[ID == input.License];
									if(existingLicense.count() > 0)
									{
										if(input.License_Type != null)
										{
											existingLicense.License_Type = input.License_Type;
										}
										if(input.Entity != null)
										{
											existingLicense.Entity = input.Entity;
										}
										if(input.Premises != null)
										{
											existingLicense.Premises = input.Premises;
										}
										existingLicense.Source_New_Application = input.ID;
										existingLicense.Applicant_Profile = input.Applicant_Profile;
										existingLicense.Legal_Entity_New = input.Legal_Entity;
										existingLicense.DBA_New = input.DBA;
										existingLicense.Premise_Address_New = input.Premise_Address;
										existingLicense.License_Status = "Active";
										existingLicense.Licensee_Email = input.Applicant_Email;
										input.Issued_License = input.License;
										input.Issued_Date = issueDate;
										input.Application_Status = "License Issued";
										thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Change application issued","Selected existing license updated from report action by " + zoho.loginuserid + ".");
									}
								}
								else
								{
									thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Issue license skipped","Missing license creation prerequisites for report action by " + zoho.loginuserid + ".");
								}
							}
						)
					}
				}
			}

