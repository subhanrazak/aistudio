							}
						)
					}
				}
			}

			Accept_Complaint as "Accept Complaint"
			{
				type = functions
				form = Complaints
				execution type = for each record
				description = "Accepts or re-opens a complaint from complaint reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Screening_Decision != "Accepted")
							{
								input.Screening_Decision = "Accepted";
								input.Information_Sufficient = true;
								input.Jurisdictional = true;
								input.Assigned_Supervisor_Email = actorEmail;
								input.Screening_Notes = "Accepted from complaint report by " + actorEmail + " on " + zoho.currentdate + ".";
								thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Complaint accepted","Complaint accepted from complaint report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Accept complaint action skipped","Accept Complaint clicked by " + actorEmail + " but complaint was already Accepted.");
							}
						)
					}
				}
			}

			Create_Case as "Create Case"
			{
				type = functions
				form = Complaints
				execution type = for each record
				description = "Creates an enforcement case from an accepted complaint."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Screening_Decision == "Accepted" && input.Created_Case == null)
							{
								caseId = insert into Cases
								[
									Originating_Complaint=input.ID
									License=input.License
									Premises=input.Premises
									Case_Source="Complaint"
									Priority=input.Priority
									Supervising_Agent_Email=actorEmail
									Case_Status="Assigned"
								];
								input.Created_Case = caseId;
								input.Assigned_Supervisor_Email = actorEmail;
								input.Screening_Notes = "Case created from complaint report by " + actorEmail + " on " + zoho.currentdate + ".";
								thisapp.Create_Correspondence_Stub("Enforcement",caseId,"ABC-61",actorEmail,"Not Required");
								thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Complaint case created","Case created from complaint report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Create case action skipped","Create Case clicked by " + actorEmail + " but complaint was not Accepted or already had a case.");
							}
						)
					}
				}
			}

			Escalate_Priority as "Escalate Priority"
			{
				type = functions
				form = Complaints
				execution type = for each record
				description = "Escalates a non-closed complaint to High priority from complaint reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Priority != "High" && input.Screening_Decision != "Rejected" && input.Screening_Decision != "Closed")
							{
								oldPriority = input.Priority;
								input.Priority = "High";
								input.Assigned_Supervisor_Email = actorEmail;
								input.Screening_Notes = "Priority escalated from " + oldPriority + " to High by " + actorEmail + " on " + zoho.currentdate + ".";
								thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Complaint priority escalated","Priority escalated from " + oldPriority + " to High from complaint report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Escalate priority action skipped","Escalate Priority clicked by " + actorEmail + " but priority/status did not allow escalation.");
							}
						)
					}
				}
			}

			Reject_Complaint as "Reject Complaint"
			{
				type = functions
				form = Complaints
				execution type = for each record
				description = "Rejects a complaint from complaint screening reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Screening_Decision == "New" || input.Screening_Decision == "Need More Information")
							{
								input.Screening_Decision = "Rejected";
								input.Screening_Notes = "Rejected from complaint report by " + actorEmail + " on " + zoho.currentdate + ".";
