			License_Types_On_Validate as "Validate License Type Fees"
			{
			
							type =  form
							form = License_Types
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Code in {""," ","null"})
													{
														alert "Code is required.";
														cancel submit;
													}
													if(input.Primary_LT_Name in {""," ","null"})
													{
														alert "Primary LT Name is required.";
														cancel submit;
													}
													if(input.License_Code == null || input.License_Code.trim() == "")
													{
														input.License_Code = input.Code;
													}
													if(input.Full_License_Type_Name == null || input.Full_License_Type_Name.trim() == "")
													{
														input.Full_License_Type_Name = input.Primary_LT_Name;
													}
													if(ifnull(input.Base_License_Fee,0) < 0 || ifnull(input.Base_License_Fee_CPI,0) < 0 || ifnull(input.Appeals_Board_Surcharge,0) < 0 || ifnull(input.CHP_Surcharge,0) < 0 || ifnull(input.BPU24_Fee,0) < 0 || ifnull(input.BU52_Fee,0) < 0 || ifnull(input.Total_Surcharges,0) < 0 || ifnull(input.Annual_Fee_ANN,0) < 0 || ifnull(input.Renewal_Fee_REN,0) < 0 || ifnull(input.Renewal_Duplicate_DOR,0) < 0 || ifnull(input.Renewal_50_REN50,0) < 0 || ifnull(input.Renewal_100_REN100,0) < 0 || ifnull(input.ANN_or_DOR,0) < 0 || ifnull(input.Processing_Fee_Default,0) < 0 || ifnull(input.Federal_Fingerprint_Fee,0) < 0 || ifnull(input.State_Fingerprint_Fee,0) < 0)
													{
														alert "Fee amounts cannot be negative.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Licenses_On_Success as "License Post Save Automation"
			{
			
							type =  form
							form = Licenses
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Source_New_Application == null && input.Source_Application != null)
													{
														input.Source_New_Application = input.Source_Application;
													}
													if(input.Source_New_Application != null)
													{
														appRows = Applications[ID == input.Source_New_Application];
														if(appRows.count() > 0)
														{
															if(input.Applicant_Profile == null)
															{
																input.Applicant_Profile = appRows.Applicant_Profile;
															}
															if(input.Legal_Entity_New == null)
															{
																input.Legal_Entity_New = appRows.Legal_Entity;
															}
															if(input.DBA_New == null)
															{
																input.DBA_New = appRows.DBA;
															}
															if(input.Premise_Address_New == null)
															{
																input.Premise_Address_New = appRows.Premise_Address;
															}
															if(input.Licensee_Email in {""," ","null"})
															{
																input.Licensee_Email = appRows.Applicant_Email;
															}
														}
													}
													if(input.Issue_Date != null && input.Expiration_Date == null)
													{
														input.Expiration_Date = input.Issue_Date.addYear(1);
													}
													if(input.License_Status == "Renewed")
													{
														input.Last_Renewal_Date = zoho.currentdate;
														input.Expiration_Date = zoho.currentdate.addYear(1);
														input.Penalty_Stage = "None";
														input.Renewal_Notice_Generated = false;
														thisapp.Write_Audit_Log("Renewal","Licenses",input.ID,"License renewed","Expiration date advanced after renewal.");
													}
													else
													{
														thisapp.Write_Audit_Log("Licensing","Licenses",input.ID,"License saved","License record saved or updated.");
													}
									)
								}
							}
			
						
			}

			Payments_On_Success as "Update Linked Payment Status"
			{
			
							type =  form
							form = Payments
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Payment_Status == "Complete")
													{
														if(input.Application != null)
														{
															appRows = Applications[ID == input.Application];
															if(appRows.count() > 0)
															{
																appRows.Payment_Status="Complete";
																appRows.Books_Invoice_Status="Paid";
															}
														}
														if(input.Renewal_Batch != null)
														{
															batchRows = Renewal_Batches[ID == input.Renewal_Batch];
															if(batchRows.count() > 0)
															{
																batchRows.Payment_Status="Complete";
																batchRows.Batch_Status="Paid";
															}
														}
														if(input.Receipt_Generated != true)
														{
															thisapp.Create_Correspondence_Stub("Payment",input.ID,"Receipt","","Not Required");
															input.Receipt_Generated = true;
														}
														thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Payment completed","Manual/stub payment marked complete.");
													}
													if(input.Refund_Status == "Approved" || input.Refund_Status == "Completed")
													{
														thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Refund status updated","Refund status: " + input.Refund_Status);
													}
									)
								}
							}
			
						
			}

