			Application_Checklists_On_Success as "Update Application Checklist Gate"
			{
			
							type =  form
							form = Application_Checklists
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														appRows = Applications[ID == input.Application];
													if(appRows.count() > 0)
													{
														if(input.Checklist_Status == "Complete")
														{
															appRows.Checklist_Complete=true;
															if(input.Completed_Date == null)
															{
																input.Completed_Date = zoho.currentdate;
															}
															if(input.Completed_By == null || input.Completed_By.trim() == "")
															{
																input.Completed_By = zoho.loginuserid;
															}
															thisapp.Write_Audit_Log("Licensing Application","Application_Checklists",input.ID,"Checklist completed","Application checklist completed and issuance gate updated.");
														}
														else
														{
															appRows.Checklist_Complete=false;
															thisapp.Write_Audit_Log("Licensing Application","Application_Checklists",input.ID,"Checklist reopened","Application checklist is not complete.");
														}
													}
									)
								}
							}
			
						
			}

			Application_Checklists_On_Validate as "Validate Application Checklist"
			{
			
							type =  form
							form = Application_Checklists
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Checklist_Status == "Complete")
													{
														if(input.Public_Posting_30_Day != true || input.Public_Posting_Date == null || input.Resident_500_Foot_Notification != true || input.Resident_Notification_Date == null || input.Local_Agency_Notification != true || input.Local_Agency_Notification_Date == null)
														{
															alert "All posting and notification steps with dates are required before marking the checklist complete.";
															cancel submit;
														}
													}
									)
								}
							}
			
						
			}

			Application_Holds_On_Load as "Prepare Application Hold"
			{
			
							type =  form
							form = Application_Holds
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Created_Date == null)
													{
														input.Created_Date = zoho.currentdate;
													}
													if(input.Hold_Released == true && input.Released_Date == null)
													{
														input.Released_Date = zoho.currentdate;
													}
													disable Created_Date;
													disable Released_Date;
									)
								}
							}
			
						
			}

			Application_Holds_On_Success as "Apply Application Hold Status"
			{
			
							type =  form
							form = Application_Holds
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														appRows = Applications[ID == input.Application];
													if(appRows.count() > 0)
													{
														if(input.Hold_Released == false)
														{
															appRows.Application_Status="On-hold";
															insert into Docket_Notes
															[
																Application=input.Application
																Event_Date=ifnull(input.Created_Date,zoho.currentdate)
																Event_Code="HOLD_PLACED"
																Event_Description="Application hold placed"
																Comments=input.Hold_Type + ": " + input.Hold_Comment
																User=zoho.loginuserid
																Added_User=zoho.loginuser
															]
															thisapp.Write_Audit_Log("New License Application","Application_Holds",input.ID,"Hold placed","Application moved to On-hold.");
														}
														else
														{
															if(appRows.Application_Status == "On-hold")
															{
																appRows.Application_Status="In-progress";
															}
															insert into Docket_Notes
															[
																Application=input.Application
																Event_Date=ifnull(input.Released_Date,zoho.currentdate)
																Event_Code="HOLD_RELEASED"
																Event_Description="Application hold released"
																Comments=input.Hold_Type + " hold released."
																User=zoho.loginuserid
																Added_User=zoho.loginuser
															]
															thisapp.Write_Audit_Log("New License Application","Application_Holds",input.ID,"Hold released","Application hold released.");
														}
													}
									)
								}
							}
			
						
			}

			Application_Holds_On_Validate as "Validate Application Hold"
			{
			
							type =  form
							form = Application_Holds
			
