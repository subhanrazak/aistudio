e-filled.zcs-badge-yellow{background:#faae13;border-color:#faae13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background:#2a6ffc;border-color:#2a6ffc;color:#fff}.zcs-badge-filled.zcs-badge-orange{background:#f4660c;border-color:#f4660c;color:#fff}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background:#f9fafe;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.lsup{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f5f8ff 0%,#f5f7fb 66%,#fff 100%);min-height:100%;padding:28px;box-sizing:border-box}.lsup *{box-sizing:border-box}.lsup-shell{max-width:1540px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.lsup-header{background:rgba(255,255,255,.96);border:1px solid #e7e7ee;border-radius:20px;box-shadow:0 12px 34px rgba(20,44,84,.08);padding:22px 24px}.lsup-head-icon{width:50px;height:50px;border-radius:16px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:24px}.lsup-subtitle{margin-top:4px;color:#6