			Payment_Approve_Refund as "Approve Refund"
			{
				type = functions
				form = Payments
				execution type = for each record
				description = "Approves and completes requested refunds from payment reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Refund_Requested == true && input.Refund_Status == "Requested")
							{
								input.Refund_Status = "Completed";
								input.Payment_Status = "Refunded";
								if(ifnull(input.Refund_Amount,0) <= 0 && ifnull(input.Amount_Paid,0) > 0)
								{
									input.Refund_Amount = input.Amount_Paid;
								}
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Refund approved","Refund approved and marked completed from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Approve refund action skipped","Approve Refund clicked by " + actorEmail + " but refund status was " + input.Refund_Status + ".");
							}
						)
					}
				}
			}

			Payment_Mark_Paid as "Mark Paid"
			{
				type = functions
				form = Payments
				execution type = for each record
				description = "Marks pending payment records complete from payment reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Payment_Status == "Pending" || input.Payment_Status == "Failed")
							{
								if(ifnull(input.Amount_Paid,0) <= 0)
								{
									input.Amount_Paid = ifnull(input.Amount_Due,0);
								}
								input.Payment_Status = "Complete";
								if(input.Payment_Date == null)
								{
									input.Payment_Date = zoho.currentdate;
								}
								if(input.Application != null)
								{
									appRows = Applications[ID == input.Application];
									if(appRows.count() > 0)
									{
										appRows.Payment_Status = "Complete";
										appRows.Books_Invoice_Status = "Paid";
									}
								}
								if(input.Renewal_Batch != null)
								{
									batchRows = Renewal_Batches[ID == input.Renewal_Batch];
									if(batchRows.count() > 0)
									{
										batchRows.Payment_Status = "Complete";
										batchRows.Batch_Status = "Paid";
									}
								}
								if(input.Receipt_Generated != true)
								{
									thisapp.Create_Correspondence_Stub("Payment",input.ID,"Receipt","","Not Required");
									input.Receipt_Generated = true;
								}
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Payment marked paid","Payment marked paid from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Mark paid action skipped","Mark Paid clicked by " + actorEmail + " but payment status was " + input.Payment_Status + ".");
							}
						)
					}
				}
			}

			Payment_Reconcile_Payment as "Reconcile Payment"
			{
				type = functions
				form = Payments
				execution type = for each record
				description = "Reconciles complete/refunded/voided payments from payment reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Reconciled != true && (input.Payment_Status == "Complete" || input.Payment_Status == "Refunded" || input.Payment_Status == "Void"))
							{
								input.Reconciled = true;
								input.Reconciliation_Date = zoho.currentdate;
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Payment reconciled","Payment reconciled from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Reconcile payment action skipped","Reconcile Payment clicked by " + actorEmail + " but payment was already reconciled or not in a reconcilable status.");
							}
						)
					}
				}
			}

			Payment_Reject_Refund as "Reject Refund"
			{
				type = functions
				form = Payments
				execution type = for each record
				description = "Rejects requested refunds from payment reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Refund_Requested == true && (input.Refund_Status == "Requested" || input.Refund_Status == "Approved"))
							{
								input.Refund_Status = "Denied";
								input.Refund_Requested = false;
								if(input.Payment_Status == "Refund Requested")
								{
									input.Payment_Status = "Complete";
								}
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Refund rejected","Refund rejected from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Reject refund action skipped","Reject Refund clicked by " + actorEmail + " but refund was not in a rejectable state.");
							}
						)
					}
				}
			}

			Payment_Request_Refund as "Request Refund"
			{
				type = functions
				form = Payments
				execution type = for each record
				description = "Requests a refund from payment reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Payment_Status == "Complete" && input.Refund_Requested != true && ifnull(input.Amount_Paid,0) > 0)
							{
								input.Refund_Requested = true;
								if(ifnull(input.Refund_Amount,0) <= 0)
								{
									input.Refund_Amount = input.Amount_Paid;
								}
								if(input.Refund_Reason == null || input.Refund_Reason.trim() == "")
								{
									input.Refund_Reason = "Refund requested from report by " + actorEmail + " on " + zoho.currentdate + ".";
								}
								input.Refund_Status = "Requested";
								input.Payment_Status = "Refund Requested";
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Refund requested","Refund requested from payment report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Payment","Payments",input.ID,"Request refund action skipped","Request Refund clicked by " + actorEmail + " but payment was not eligible for refund request.");
							}
						)
					}
				}
			}

