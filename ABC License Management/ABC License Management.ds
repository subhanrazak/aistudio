											custom deluge script
											(
																		thisapp.Write_Audit_Log("Renewal","Licenses",input.ID,"Renewal completed","License moved to renewed stage.");
											)
										}
			         				}
			  				}
			    				Mark_Renewal_Due as "Mark Renewal Due"
			    				{
			         				type = normal
			         				from stage = "Active"
			         				to stage = "Renewal Due"
			         				before
			         				{
			            				transition owner
			            				(
			                				permissions = {"Licensing_Supervisor"}
			             				)
			         				}
			         				after
			         				{
			         				}
			  				}
			        			}
			    			
			}
		}
	}

	functions
	{
		Deluge
		{
			map Calculate_Application_Fees(int licenseTypeId, int ownerCount)
			{
			
			                 	fees = Map();
			                 	annualFee = 0.0;
			                 	processingFee = 0.0;
			                 	federalFee = 0.0;
			                 	stateFee = 0.0;
			                 	owners = ifnull(ownerCount,0);
			                 	if(owners < 0)
			                 	{
			                 		owners = 0;
			                 	}
			                 	licenseRows = License_Types[ID == licenseTypeId];
			                 	if(licenseRows.count() > 0)
			                 	{
			                 		annualFee = ifnull(licenseRows.Annual_Fee_ANN,0.0);
			                 		processingFee = ifnull(licenseRows.Processing_Fee_Default,0.0);
			                 		federalFee = ifnull(licenseRows.Federal_Fingerprint_Fee,0.0) * owners;
			                 		stateFee = ifnull(licenseRows.State_Fingerprint_Fee,0.0) * owners;
			                 	}
			                 	totalFingerprintFee = federalFee + stateFee;
			                 	totalDue = annualFee + processingFee + totalFingerprintFee;
			                 	fees.put("annual_fee",annualFee);
			                 	fees.put("processing_fee",processingFee);
			                 	fees.put("federal_fingerprint_fee",federalFee);
			                 	fees.put("state_fingerprint_fee",stateFee);
			                 	fees.put("owner_count",owners);
			                 	fees.put("total_fingerprint_fee",totalFingerprintFee);
			                 	fees.put("total_due",totalDue);
			                 	return fees;
			                 
			}

			float Calculate_Renewal_Fee(int licenseId, string penaltyStage)
			{
			
			                 	renewalAmount = 0.0;
			                 	stage = ifnull(penaltyStage,"None");
			                 	licenseRows = Licenses[ID == licenseId];
			                 	if(licenseRows.count() > 0 && licenseRows.License_Type != null)
			                 	{
			                 		typeRows = License_Types[ID == licenseRows.License_Type];
			                 		if(typeRows.count() > 0)
			                 		{
			                 			if(stage == "50%")
			                 			{
			                 				renewalAmount = ifnull(typeRows.Renewal_50_REN50,0.0);
			                 			}
			                 			else if(stage == "100%")
			                 			{
			                 				renewalAmount = ifnull(typeRows.Renewal_100_REN100,0.0);
			                 			}
			                 			else
			                 			{
			                 				renewalAmount = ifnull(typeRows.Renewal_Fee_REN,0.0);
			                 			}
			                 		}
			                 	}
			                 	return renewalAmount;
			                 
			}

			int Create_Correspondence_Stub(string moduleName, int sourceRecordId, string templateCode, string recipientEmail, string statusText)
			{
			
			                 	sourceFormName = ifnull(moduleName,"");
			                 	subjectText = ifnull(templateCode,"Correspondence") + " - Manual merge required";
			                 	stubId = insert into Correspondence
			                 	[
			                 		Module=moduleName
			                 		Source_Form=sourceFormName
			                 		Source_Record_ID=sourceRecordId
			                 		Template_Code=templateCode
			                 		Recipient_Email=recipientEmail
			                 		Subject=subjectText
			                 		Merge_Status="Ready for Manual Merge"
			                 		Sign_Status=statusText
			                 		Body_or_Merge_Notes="Integration is intentionally manual/stubbed for this POC."
			                 		Added_User=zoho.loginuser
			                 	];
			                 	return stubId;
			                 
			}

			string Determine_Required_Documents(string ownershipStructure, string retailOrNonRetail, string licenseCode)
			{
			
			                 	docs = List();
			                 	structure = ifnull(ownershipStructure,"");
			                 	retailFlag = ifnull(retailOrNonRetail,"");
			                 	code = ifnull(licenseCode,"");
			                 	docs.add("ABC-140NEW Certificate re Chapter 15 Tied-House Restrictions");
			                 	docs.add("ABC-208-A Individual Personal Affidavit");
			                 	docs.add("ABC-208-B Individual Financial Affidavit");
			                 	docs.add("ABC-211-SIG Application Signature Sheet");
			                 	docs.add("ABC-217 Application Questionnaire");
			                 	if(retailFlag != "Non-Retail")
			                 	{
			                 		docs.add("ABC-247 Statement re Residences");
			                 		docs.add("ABC-251 Statement re Consideration Points");
			                 		docs.add("ABC-258 Planned Operations Retail");
			                 	}
			                 	if(retailFlag != "Non-Retail" || code == "17/20")
			                 	{
			                 		docs.add("ABC-253 Supplemental Diagram");
			                 	}
			                 	docs.add("ABC-255 Zoning Affidavit");
			                 	docs.add("ABC-257 Licensed Premises Diagram/Planned Operation");
			                 	if(retailFlag == "Non-Retail" && code == "75" || code == "85")
			                 	{
			                 		docs.add("ABC-259 Planned Operations Non-Retail");
			                 	}
			                 	docs.add("State-issued identification for signing applicant(s)");
			                 	docs.add("Verification of source of funds");
			                 	docs.add("Conditional Use Permit or receipt");
			                 	if(structure == "Corporation")
			                 	{
			                 		docs.add("ABC-243 Corporate Questionnaire");
			                 		docs.add("Articles of Incorporation");
			                 		docs.add("Minutes showing current officers/directors or Certificate of Incumbency");
			                 		docs.add("Stock Register or issued/blank stock certificates");
			                 		docs.add("Certificate of Qualification for out-of-state corporations");
			                 	}
			                 	else if(structure == "LLC")
			                 	{
			                 		docs.add("ABC-256-LLC Limited Liability Company Questionnaire");
			                 		docs.add("LLC-1 Articles of Organization");
			                 		docs.add("LLC-5 Registration as Foreign LLC, if applicable");
			                 		docs.add("Operating Agreement and amendments");
			                 	}
			                 	else if(structure == "Limited Partnership")
			                 	{
			                 		docs.add("ABC-256 Limited Partnership Questionnaire");
			                 		docs.add("LP-1 Certificate of Limited Partnership");
			                 		docs.add("LP-5 Registration as Foreign Limited Partnership, if applicable");
			                 		docs.add("Limited Partnership Agreement and amendments");
			                 	}
			                 	else if(structure == "Trust")
			                 	{
			                 		docs.add("Trust Agreement");
			                 	}
			                 	return docs.toString("\n");
			                 
			}

			void Write_Audit_Log(string moduleName, string sourceForm, int sourceRecordId, string actionText, string detailText)
			{
			
			                 	insert into Audit_Log
			                 	[
			                 		Event_Time=zoho.currenttime
			                 		Event_User=zoho.loginuserid
			                 		Module=moduleName
			                 		Source_Form=sourceForm
			                 		Source_Record_ID=sourceRecordId
			                 		Action=actionText
			                 		Details=detailText
			                 		IP_or_Context="Creator workflow"
			                 		Added_User=zoho.loginuser
			                 	]
			                 
			}
		}
	}

