			Case_Accept_Legal_Review as "Accept Legal Review"
			{
				type = functions
				form = Cases
				execution type = for each record
				description = "Accepts a referred case for OLS/legal review and assigns it to the current attorney."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Case_Status == "Referred to OLS" && input.Legal_Review_Status == "Pending OLS Review")
							{
								input.Case_Status = "Legal Review";
								input.OLS_Assigned_Attorney_Email = actorEmail;
								thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Legal review accepted","Legal review accepted from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Accept legal review action skipped","Accept Legal Review clicked by " + actorEmail + " but case/legal status was " + input.Case_Status + " / " + input.Legal_Review_Status + ".");
							}
						)
					}
				}
			}

			Case_Assign_Case as "Assign Case"
			{
				type = functions
				form = Cases
				execution type = for each record
				description = "Assigns a new enforcement case to the current user from case reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Case_Status == "New")
							{
								input.Assigned_Agent_Email = actorEmail;
								input.Case_Status = "Assigned";
								thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Case assigned","Case assigned from report to " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Assign case action skipped","Assign Case clicked by " + actorEmail + " but case status was " + input.Case_Status + ".");
							}
						)
					}
				}
			}

			Case_Close_Case as "Close Case"
			{
				type = functions
				form = Cases
				execution type = for each record
				description = "Closes an open enforcement/legal case from case reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Case_Status != "Closed")
							{
								previousStatus = input.Case_Status;
								input.Case_Status = "Closed";
								input.Closure_Date = zoho.currentdate;
								if(input.Closure_Outcome == null)
								{
									input.Closure_Outcome = "Closed Other";
								}
								if(input.Legal_Review_Status != "Not Referred")
								{
									input.Legal_Review_Status = "Closed";
								}
								thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Case closed","Case closed from report by " + actorEmail + ". Previous status: " + previousStatus + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Cases",input.ID,"Close case action skipped","Close Case clicked by " + actorEmail + " but case was already closed.");
							}
						)
					}
				}
			}

			Case_Draft_Accusation as "Draft Accusation"
			{
				type = functions
				form = Cases
				execution type = for each record
				description = "Marks a legal review case as accusation drafted from case reports."
			
