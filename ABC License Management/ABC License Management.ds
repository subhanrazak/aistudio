			Complaints_On_Success as "Create Case From Complaint"
			{
			
							type =  form
							form = Complaints
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Screening_Decision == "Accepted" && input.Created_Case == null)
													{
														caseId = insert into Cases
														[
															Originating_Complaint=input.ID
															License=input.License
															Premises=input.Premises
															Case_Source=input.Complaint_Source
															Priority=input.Priority
															Supervising_Agent_Email=input.Assigned_Supervisor_Email
															Case_Status="Assigned"
															Added_User=zoho.loginuser
														];
														input.Created_Case = caseId;
														thisapp.Create_Correspondence_Stub("Enforcement",caseId,"ABC-61",input.Assigned_Supervisor_Email,"Not Required");
														thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Complaint accepted","Case and ABC-61 assignment stub created.");
													}
													else if(input.Screening_Decision == "Rejected" || input.Screening_Decision == "Closed")
													{
														thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Complaint closed",input.Screening_Notes);
													}
													else
													{
														thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Complaint saved","Complaint intake saved or updated.");
													}
									)
								}
							}
			
						
			}

			Complaints_On_Validate as "Validate Complaint Screening"
			{
			
							type =  form
							form = Complaints
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Screening_Decision == "Rejected" || input.Screening_Decision == "Closed" && input.Screening_Notes == null || input.Screening_Notes.trim() == "")
													{
														alert "Screening Notes are required when rejecting or closing a complaint.";
														cancel submit;
													}
													if(input.Screening_Decision == "Accepted" && input.Information_Sufficient != true || input.Jurisdictional != true)
													{
														alert "Accepted complaints must be marked information sufficient and jurisdictional.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Nature_of_Violation_On_User_Input as "Set Complaint Priority"
			{
			
							type =  form
							form = Complaints
			
							record event = on add or edit
			
							on user input of Nature_of_Violation
							{
								actions 
								{
									custom deluge script
									(
														if(input.Nature_of_Violation == "Police Report")
													{
														input.Priority = "No Priority Category";
													}
													else if(input.Nature_of_Violation == "Sales to Minors" || input.Nature_of_Violation == "Disorderly Premises" || input.Nature_of_Violation == "Service to Intoxicated Person" || input.Nature_of_Violation == "Restricted Hours" || input.Nature_of_Violation == "Unlicensed Privileges" || input.Nature_of_Violation == "Narcotics")
													{
														input.Priority = "High";
													}
													else
													{
														input.Priority = "Standard";
													}
									)
								}
							}
			
						
			}

