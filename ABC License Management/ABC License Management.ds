eb),#14b8a6)}.esac-section-sub{font-size:12px;color:#8a94a6}.esac-kpis{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:14px}.esac-kpi{position:relative;overflow:hidden;background:#fff;border:1px solid #e9edf5;border-radius:18px;padding:16px;box-shadow:0 1px 2px rgba(15,23,42,.04);min-height:142px}.esac-kpi:after{content:&quot;&quot;;position:absolute;right:-42px;top:-42px;width:120px;height:120px;border-radius:50%;background:var(--soft)}.esac-kpi-icon{position:relative;z-index:1;width:40px;height:40px;border-radius:14px;background:var(--soft);color:var(--tone);display:flex;align-items:center;justify-content:center;font-size:20px}.esac-kpi-value{position:relative;z-index:1;font-size:31px;line-height:1;font-weight:800;color:#111827;margin-top:15px;letter-spacing:-.5px}.esac-kpi-label{position:relative;z-index:1;font-size:12px;color:#475569;margin-top:5px;font-weight:700}.esac-kpi-note{position:relative;z-index:1;font-size:11px;color:#8a94a6;margin-top:6px}.esac-grid-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.52fr);gap:14px}.esac-card{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.esac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.esac-card-title{display:flex;gap:12px;align-items:flex-start}.esac-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.esac-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.esac-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.esac-card-body{padding:18px}.esac-command-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.esac-command{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:12px;min-height:176px}.esac-command.hot{border-color:rgba(254,69,93,.35);background:linear-gradient(180deg,#fff,#fff5f6)}.esac-command.warn{border-color:rgba(250,174,19,.38);background:linear-gradient(180deg,#fff,#fffaf0)}.esac-command-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.esac-command-title h4{font-size:15px;margin:0;color:#111827}.esac-command-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.esac-command-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.esac-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:800;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.esac-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:800;color:var(--zcs_brand_color,#2563eb)}.esac-link:hover{text-decoration:underline}.esac-quick{display:flex;flex-direction:column;gap:10px}.esac-quick-item{border:1px solid #e9edf5;border-radius:14px;padding:12px;background:#fff}.esac-quick-title{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.esac-quick-title h4{font-size:14px;margin:0;color:#111827}.esac-quick-meta{font-size:12px;color:#64748b;margin-top:4px;line-height:1.45}.esac-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.esac-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.esac-table-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.esac-table-card.wide{grid-column:1/-1}.esac-table-caption{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}.esac-table-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:800;color:var(--zcs_brand_color,#2563eb);white-space:nowrap}.esac-table-wrap{max-height:410px;overflow:auto}.esac-table-wrap table{min-width:900px}.esac-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.esac-report-card.wide{grid-column:1/-1}.esac-embed{border-top:1px solid #eef1f6;background:#fff;padding:8px}.esac-embed[zc-component=&quot;report&quot;]{min-height:360px;border:1px dashed #d7deea;border-radius:12px;overflow:hidden}.esac-foot-space{height:12px}@media(max-width:1360px){.esac-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.esac-command-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:1080px){.esac-hero-grid,.esac-grid-two{grid-template-columns:1fr}.esac-table-grid,.esac-report-grid{grid-template-columns:1fr}.esac-report-card.wide,.esac-table-card.wide{grid-column:auto}}@media(max-width:720px){.esac{padding:14px}.esac-hero{padding:22px;border-radius:20px}.esac-kpis,.esac-command-grid{grid-template-columns:1fr}.esac-profile-kv{grid-template-columns:1fr}.esac-section-title,.esac-card-head,.esac-table-caption{align-items:flex-start;flex-direction:column}.esac-hero-actions .zcs-button{width:100%}}\n&lt;/style&gt;\n&lt;div class=&quot;esac&quot;&gt;\n\t&lt;div class=&quot;esac-shell&quot;&gt;\n\t\t&lt;section class=&quot;esac-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;esac-hero-grid&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;esac-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline business-shield&quot;&gt;&lt;/i&gt;&lt;span&gt;Enforcement supervisor action center&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;h1&gt;Command view for screening, assignment, and escalations&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Action-first supervisor workspace for complaint intake decisions, high-priority work, case assignment, overdue field activity, legal referrals, evidence disposition, and pending correspondence. Embedded reports preserve row-level custom actions.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;esac-hero-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Supervisor_Screening_Queue&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-business-contact-89&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Screen complaints&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Assign cases&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Enforcement_Command_Center&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-board-30&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open command center&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;aside class=&quot;esac-profile&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-avatar&quot;&gt;&lt;i class=&quot;zc-li-outline users-police&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-common&quot;&gt;\n\t\t\t\t\t\t\t&lt;h2&gt;&lt;%=supervisorName%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;esac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-85&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=supervisorEmail%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;esac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=supervisorRole%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;esac-profile-kv&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-kv&quot;&gt;&lt;span&gt;Total action load&lt;/span&gt;&lt;strong&gt;&lt;%=totalActionLoad%&gt; queue items&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-kv&quot;&gt;&lt;span&gt;Case inventory&lt;/span&gt;&lt;strong&gt;&lt;%=openCaseCount%&gt; &lt;%=openCaseLabel%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-kv&quot;&gt;&lt;span&gt;Needs assignment&lt;/span&gt;&lt;strong&gt;&lt;%=unassignedCaseCount%&gt; unassigned&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-kv&quot;&gt;&lt;span&gt;Legal exposure&lt;/span&gt;&lt;strong&gt;&lt;%=legalReviewCount%&gt; active review&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;esac-section-title&quot;&gt;&lt;h2&gt;Supervisor queue snapshot&lt;/h2&gt;&lt;span class=&quot;esac-section-sub&quot;&gt;Counts update from live records at page load.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;esac-kpis&quot;&gt;\n\t\t\t&lt;div class=&quot;esac-kpi&quot; style=&quot;--soft:#eff6ff;--tone:#2563eb&quot;&gt;&lt;div class=&quot;esac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-business-contact-89&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-value&quot;&gt;&lt;%=screeningCount%&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-label&quot;&gt;Screening queue&lt;/div&gt;&lt;div class=&quot;esac-kpi-note&quot;&gt;New or more information&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-kpi&quot; style=&quot;--soft:#fff1f2;--tone:#e11d48&quot;&gt;&lt;div class=&quot;esac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-value&quot;&gt;&lt;%=highPriorityCount%&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-label&quot;&gt;High priority complaints&lt;/div&gt;&lt;div class=&quot;esac-kpi-note&quot;&gt;Active non-rejected intake&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-kpi&quot; style=&quot;--soft:#f0f9ff;--tone:#0284c7&quot;&gt;&lt;div class=&quot;esac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-value&quot;&gt;&lt;%=openCaseCount%&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-label&quot;&gt;Open cases&lt;/div&gt;&lt;div class=&quot;esac-kpi-note&quot;&gt;All non-closed cases&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-kpi&quot; style=&quot;--soft:#fffbeb;--tone:#b45309&quot;&gt;&lt;div class=&quot;esac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-agenda&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-value&quot;&gt;&lt;%=unassignedCaseCount%&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-label&quot;&gt;Unassigned cases&lt;/div&gt;&lt;div class=&quot;esac-kpi-note&quot;&gt;Assignment action needed&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-kpi&quot; style=&quot;--soft:#fff1f2;--tone:#be123c&quot;&gt;&lt;div class=&quot;esac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-value&quot;&gt;&lt;%=overdueVisitCount%&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-label&quot;&gt;Overdue visits&lt;/div&gt;&lt;div class=&quot;esac-kpi-note&quot;&gt;Not synced manually&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-kpi&quot; style=&quot;--soft:#f5f3ff;--tone:#7c3aed&quot;&gt;&lt;div class=&quot;esac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-law&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-value&quot;&gt;&lt;%=legalReviewCount%&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-label&quot;&gt;Legal review&lt;/div&gt;&lt;div class=&quot;esac-kpi-note&quot;&gt;&lt;%=legalReferralCount%&gt; referral candidates&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-kpi&quot; style=&quot;--soft:#ecfdf5;--tone:#059669&quot;&gt;&lt;div class=&quot;esac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-value&quot;&gt;&lt;%=evidenceDispositionCount%&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-label&quot;&gt;Evidence disposition&lt;/div&gt;&lt;div class=&quot;esac-kpi-note&quot;&gt;&lt;%=evidenceReadyCount%&gt; ready for action&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-kpi&quot; style=&quot;--soft:#eef2ff;--tone:#4338ca&quot;&gt;&lt;div class=&quot;esac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-value&quot;&gt;&lt;%=pendingCorrespondenceCount%&gt;&lt;/div&gt;&lt;div class=&quot;esac-kpi-label&quot;&gt;Correspondence&lt;/div&gt;&lt;div class=&quot;esac-kpi-note&quot;&gt;&lt;%=pendingMerge%&gt; draft merge items&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;esac-grid-two&quot;&gt;\n\t\t\t&lt;section class=&quot;esac-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;esac-card-head&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;esac-card-title&quot;&gt;&lt;div class=&quot;esac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Supervisor command actions&lt;/h3&gt;&lt;p&gt;Open the report that owns the row-level action; the embedded reports below keep the same custom buttons available.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;esac-link&quot; href=&quot;#Page:Enforcement_Command_Center&quot;&gt;Command Center &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;esac-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;esac-command-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-command hot&quot;&gt;&lt;div class=&quot;esac-command-title&quot;&gt;&lt;h4&gt;Complaint screening&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-bad&quot;&gt;&lt;i class=&quot;zc-li-outline business-business-contact-89&quot;&gt;&lt;/i&gt;&lt;%=screeningCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;esac-command-copy&quot;&gt;Accept, reject, or escalate complaints from the supervisor screening queue.&lt;/p&gt;&lt;div class=&quot;esac-command-links&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Supervisor_Screening_Queue&quot;&gt;Open queue&lt;/a&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:High_Priority_Complaints&quot;&gt;High priority&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-command warn&quot;&gt;&lt;div class=&quot;esac-command-title&quot;&gt;&lt;h4&gt;Case assignment&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline business-agenda&quot;&gt;&lt;/i&gt;&lt;%=unassignedCaseCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;esac-command-copy&quot;&gt;Use the enforcement work queue to assign new cases and balance open work.&lt;/p&gt;&lt;div class=&quot;esac-command-links&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;Open work queue&lt;/a&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Case_Status_Board&quot;&gt;Status board&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-command&quot;&gt;&lt;div class=&quot;esac-command-title&quot;&gt;&lt;h4&gt;Field visit oversight&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-bad&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;%=overdueVisitCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;esac-command-copy&quot;&gt;Identify overdue visit records and follow up on mobile capture synchronization.&lt;/p&gt;&lt;div class=&quot;esac-command-links&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Mobile_Field_Capture&quot;&gt;Mobile capture&lt;/a&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Field_Visit_Calendar&quot;&gt;Calendar&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-command&quot;&gt;&lt;div class=&quot;esac-command-title&quot;&gt;&lt;h4&gt;Legal escalations&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-theme&quot;&gt;&lt;i class=&quot;zc-li-outline business-law&quot;&gt;&lt;/i&gt;&lt;%=legalReviewCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;esac-command-copy&quot;&gt;Refer qualifying cases, monitor OLS acceptance, and track hearing or accusation stages.&lt;/p&gt;&lt;div class=&quot;esac-command-links&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Legal_Review_View&quot;&gt;Legal review&lt;/a&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;Referral candidates&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-command&quot;&gt;&lt;div class=&quot;esac-command-title&quot;&gt;&lt;h4&gt;Evidence disposition&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-ok&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;&lt;%=evidenceDispositionCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;esac-command-copy&quot;&gt;Log custody, mark reviewed, dispose, or return evidence from evidence queues.&lt;/p&gt;&lt;div class=&quot;esac-command-links&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Disposition_Queue&quot;&gt;Disposition&lt;/a&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Chain_Of_Custody_Log&quot;&gt;Custody log&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-command&quot;&gt;&lt;div class=&quot;esac-command-title&quot;&gt;&lt;h4&gt;Pending correspondence&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-info&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;%=pendingCorrespondenceCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;esac-command-copy&quot;&gt;Prepare merges, mark sent, and request signatures for enforcement documents.&lt;/p&gt;&lt;div class=&quot;esac-command-links&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Pending_Correspondence&quot;&gt;Pending queue&lt;/a&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Enforcement_Documents&quot;&gt;Documents&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t\t&lt;section class=&quot;esac-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;esac-card-head&quot;&gt;&lt;div class=&quot;esac-card-title&quot;&gt;&lt;div class=&quot;esac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-board-30&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Priority lane&lt;/h3&gt;&lt;p&gt;Fast scan of the queues most likely to block enforcement progress.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;esac-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;esac-quick&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-quick-item&quot;&gt;&lt;div class=&quot;esac-quick-title&quot;&gt;&lt;h4&gt;Screening decisions&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-bad&quot;&gt;&lt;%=screeningCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;esac-quick-meta&quot;&gt;Accept, reject, or escalate complaints before case creation.&lt;/div&gt;&lt;div class=&quot;zcs-mt-10&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Supervisor_Screening_Queue&quot;&gt;Open screening queue&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-quick-item&quot;&gt;&lt;div class=&quot;esac-quick-title&quot;&gt;&lt;h4&gt;High priority complaints&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-warn&quot;&gt;&lt;%=highPriorityCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;esac-quick-meta&quot;&gt;High priority complaints that are not rejected or closed.&lt;/div&gt;&lt;div class=&quot;zcs-mt-10&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:High_Priority_Complaints&quot;&gt;Open high priority report&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-quick-item&quot;&gt;&lt;div class=&quot;esac-quick-title&quot;&gt;&lt;h4&gt;Legal referrals&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-theme&quot;&gt;&lt;%=legalReferralCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;esac-quick-meta&quot;&gt;Open cases marked Recommend Accusation plus current legal review work.&lt;/div&gt;&lt;div class=&quot;zcs-mt-10&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Legal_Review_View&quot;&gt;Open legal review&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;esac-quick-item&quot;&gt;&lt;div class=&quot;esac-quick-title&quot;&gt;&lt;h4&gt;Correspondence follow-up&lt;/h4&gt;&lt;span class=&quot;esac-chip chip-info&quot;&gt;&lt;%=pendingSignature%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;esac-quick-meta&quot;&gt;Signature or manual-merge work awaiting staff action.&lt;/div&gt;&lt;div class=&quot;zcs-mt-10&quot;&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Pending_Correspondence&quot;&gt;Open correspondence queue&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;esac-section-title&quot;&gt;&lt;h2&gt;Action tables&lt;/h2&gt;&lt;span class=&quot;esac-section-sub&quot;&gt;Top records are shown for command scanning; open the linked report for full row actions.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;esac-table-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;esac-card esac-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Supervisor screening queue&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Accept, reject, or escalate complaint priority.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;esac-table-link&quot; href=&quot;#Report:Supervisor_Screening_Queue&quot;&gt;Open action report &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper esac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Complaint&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Decision&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Intake&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Nature&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-center zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Open&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tshown = 0;\n\t\t\t\t\t\tfor each cp in screeningQueue\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(shown &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tshown = shown + 1;\n\t\t\t\t\t\t\t\tpriorityBadge = if(cp.Priority == &quot;High&quot;,&quot;zcs-badge-red&quot;,if(cp.Priority == &quot;Medium&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-grey&quot;));\n\t\t\t\t\t\t\t\tdecisionBadge = if(cp.Screening_Decision == &quot;Need More Information&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-blue&quot;);\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(cp.Complaint_Number,&quot;Complaint&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=priorityBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(cp.Priority,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=decisionBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(cp.Screening_Decision,&quot;New&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(cp.Intake_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(cp.Nature_of_Violation,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-center&quot;&gt;&lt;a class=&quot;zcs-custom-action-icon zcs-approve-icon zcs-rounded-half&quot; href=&quot;#Report:Supervisor_Screening_Queue&quot;&gt;&lt;i class=&quot;zcs-font-20 zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(shown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;6&quot;&gt;&lt;div class=&quot;esac-empty&quot;&gt;&lt;span class=&quot;esac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;No complaints are waiting for screening decisions.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;esac-card esac-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Unassigned and open cases&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Cases needing assignment or queue review.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;esac-table-link&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;Open work queue &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper esac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Assigned agent&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Visit due&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tcaseShown = 0;\n\t\t\t\t\t\tfor each c in unassignedOpenCases\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(caseShown &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tcaseShown = caseShown + 1;\n\t\t\t\t\t\t\t\tcasePriorityBadge = if(c.Priority == &quot;High&quot;,&quot;zcs-badge-red&quot;,if(c.Priority == &quot;Medium&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-grey&quot;));\n\t\t\t\t\t\t\t\tstatusBadge = if(c.Case_Status == &quot;New&quot;,&quot;zcs-badge-blue&quot;,if(c.Case_Status == &quot;Referred to OLS&quot; || c.Case_Status == &quot;Legal Review&quot;,&quot;zcs-badge-theme&quot;,&quot;zcs-badge-orange&quot;));\n\t\t\t\t\t\t\t\tagentLabel = ifnull(c.Assigned_Agent_Email,&quot;Unassigned&quot;);\n\t\t\t\t\t\t\t\tif(agentLabel == &quot;&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tagentLabel = &quot;Unassigned&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(c.Case_Number,&quot;Case&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=casePriorityBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(c.Priority,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=statusBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(c.Case_Status,&quot;New&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=agentLabel%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(c.Initial_Visit_Due_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(caseShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;esac-empty&quot;&gt;&lt;span class=&quot;esac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;No unassigned open cases were found. Open the work queue for all active cases.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;esac-card esac-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Overdue field visits&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Past visit date and not synced manually.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;esac-table-link&quot; href=&quot;#Report:Mobile_Field_Capture&quot;&gt;Open field capture &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper esac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Visit&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Agent&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Visit date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;FSM status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tvisitShown = 0;\n\t\t\t\t\t\tfor each fv in overdueFieldVisits\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(visitShown &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tvisitShown = visitShown + 1;\n\t\t\t\t\t\t\t\tvisitCase = &quot;Case not linked&quot;;\n\t\t\t\t\t\t\t\tif(fv.Case != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tvisitCase = ifnull(fv.Case.Case_Number,&quot;Case linked&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(fv.Visit_Number,&quot;Visit&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=visitCase%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(fv.Agent_Email,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(fv.Visit_Date_Time,&quot;Not scheduled&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(fv.FSM_Status,&quot;Not sent&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(visitShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;esac-empty&quot;&gt;&lt;span class=&quot;esac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;No overdue field visits are currently queued.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;esac-card esac-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Legal review and referral queue&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;OLS, accusation draft, hearing, and referred cases.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;esac-table-link&quot; href=&quot;#Report:Legal_Review_View&quot;&gt;Open legal report &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper esac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Legal status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;RFA&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Attorney&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tlegalShown = 0;\n\t\t\t\t\t\tfor each lc in legalReviewQueue\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(legalShown &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlegalShown = legalShown + 1;\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(lc.Case_Number,&quot;Case&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline business-law&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(lc.Case_Status,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(lc.Legal_Review_Status,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(lc.RFA_Status,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(lc.OLS_Assigned_Attorney_Email,&quot;Not assigned&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(legalShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;esac-empty&quot;&gt;&lt;span class=&quot;esac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;No cases are currently in legal review.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;esac-card esac-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Evidence disposition queue&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Custody and disposition actions.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;esac-table-link&quot; href=&quot;#Report:Disposition_Queue&quot;&gt;Open disposition &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper esac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Evidence&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Custody&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Disposition&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Custodian&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tevShown = 0;\n\t\t\t\t\t\tfor each ev in evidenceDispositionQueue\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(evShown &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tevShown = evShown + 1;\n\t\t\t\t\t\t\t\tevCase = &quot;Case not linked&quot;;\n\t\t\t\t\t\t\t\tif(ev.Case != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tevCase = ifnull(ev.Case.Case_Number,&quot;Case linked&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tcustodyBadge = if(ev.Chain_of_Custody_Status == &quot;Disposed&quot; || ev.Chain_of_Custody_Status == &quot;Released to Owner&quot;,&quot;zcs-badge-grey&quot;,&quot;zcs-badge-green&quot;);\n\t\t\t\t\t\t\t\tdispositionBadge = if(ev.Disposition_Level == &quot;Not Ready&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-blue&quot;);\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ev.Evidence_Number,&quot;Evidence&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=evCase%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=custodyBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(ev.Chain_of_Custody_Status,&quot;Collected&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=dispositionBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(ev.Disposition_Level,&quot;Not Ready&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(ev.Current_Custodian,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(evShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;esac-empty&quot;&gt;&lt;span class=&quot;esac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;No evidence disposition records are currently queued.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;esac-card esac-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Pending correspondence&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Manual merge, sent, and signature actions.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;esac-table-link&quot; href=&quot;#Report:Pending_Correspondence&quot;&gt;Open correspondence &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper esac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Correspondence&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Module&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Template&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Merge&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Signature&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tcorrShown = 0;\n\t\t\t\t\t\tfor each co in correspondenceQueue\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(corrShown &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tcorrShown = corrShown + 1;\n\t\t\t\t\t\t\t\tmergeBadge = if(co.Merge_Status == &quot;Draft&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-blue&quot;);\n\t\t\t\t\t\t\t\tsignBadge = if(co.Sign_Status == &quot;Signed&quot;,&quot;zcs-badge-green&quot;,if(co.Sign_Status == &quot;Declined&quot;,&quot;zcs-badge-red&quot;,&quot;zcs-badge-grey&quot;));\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(co.Correspondence_Number,&quot;Correspondence&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(co.Module,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(co.Template_Code,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=mergeBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(co.Merge_Status,&quot;Draft&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=signBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(co.Sign_Status,&quot;Not Required&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(corrShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;esac-empty&quot;&gt;&lt;span class=&quot;esac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;No pending correspondence records are queued.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;esac-section-title&quot;&gt;&lt;h2&gt;Embedded action-enabled reports&lt;/h2&gt;&lt;span class=&quot;esac-section-sub&quot;&gt;Use embedded report controls for approved row workflows and full queue filtering.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;esac-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;esac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Supervisor screening queue&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Accept, reject, and escalate complaint priority.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;esac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Supervisor_Screening_Queue&quot; zc-height=&quot;380px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;High priority complaints&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;High priority complaint screening and case creation actions.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;esac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;High_Priority_Complaints&quot; zc-height=&quot;380px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Enforcement work queue&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Assign Case, Refer to Legal, and Close Case actions.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;esac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Enforcement_Work_Queue&quot; zc-height=&quot;380px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Mobile field capture&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Overdue and scheduled field visits.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;esac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Mobile_Field_Capture&quot; zc-height=&quot;380px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Legal review view&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Accept review, draft accusation, schedule hearing, and close case actions.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;esac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Legal_Review_View&quot; zc-height=&quot;380px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Evidence disposition queue&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Log custody, mark reviewed, dispose, and return evidence actions.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;esac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Disposition_Queue&quot; zc-height=&quot;380px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;esac-report-card wide zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;esac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Pending correspondence&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Prepare Merge, Mark Sent, and Request Signature actions.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;esac-link&quot; href=&quot;#Report:Enforcement_Documents&quot;&gt;Open enforcement documents &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;esac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Pending_Correspondence&quot; zc-height=&quot;380px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;div class=&quot;esac-foot-space&quot;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Licensee_Action_Center
		{
					displayname = "Licensee Action Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Licensee_Action_Center_Snippet' elementName='Licensee_Action_Center_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Licensee_Action_Center_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\tlicenseeEmail = ifnull(zoho.loginuserid,&quot;&quot;);\n\temailParam = encodeURL(licenseeEmail);\n\n\tlicenseeEntities = Entities[Licensee_Portal_Email == licenseeEmail || Contact_Email == licenseeEmail];\n\tentityCount = licenseeEntities.count();\n\n\tactiveLicenses = Licenses[(Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; (License_Status == &quot;Active&quot; || License_Status == &quot;Renewed&quot;)];\n\trenewableLicenses = Licenses[(Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; (License_Status == &quot;Renewal Due&quot; || License_Status == &quot;50% Penalty&quot; || License_Status == &quot;100% Penalty&quot; || Penalty_Stage == &quot;50%&quot; || Penalty_Stage == &quot;100%&quot; || (Expiration_Date &gt;= zoho.currentdate &amp;&amp; Expiration_Date &lt;= zoho.currentdate.addDay(60)))];\n\tallLicenseCount = Licenses[Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail].count();\n\tactiveCount = activeLicenses.count();\n\trenewableCount = renewableLicenses.count();\n\tpenaltyCount = Licenses[(Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; (License_Status == &quot;50% Penalty&quot; || License_Status == &quot;100% Penalty&quot; || Penalty_Stage == &quot;50%&quot; || Penalty_Stage == &quot;100%&quot;)].count();\n\n\tpendingBatches = Renewal_Batches[(Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; (Batch_Status == &quot;Draft&quot; || Batch_Status == &quot;Submitted&quot; || Batch_Status == &quot;Payment Pending&quot; || Payment_Status == &quot;Pending&quot;)];\n\tpendingItems = Renewal_Items[(Renewal_Batch.Licensee_Email == licenseeEmail || License.Licensee_Email == licenseeEmail) &amp;&amp; (Item_Status == &quot;Selected&quot; || Item_Status == &quot;Payment Pending&quot;)];\n\tpendingBatchCount = pendingBatches.count();\n\tpendingItemCount = pendingItems.count();\n\n\tpendingBatchPayments = Renewal_Batches[(Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; Payment_Status == &quot;Pending&quot;];\n\tpendingPaymentRecords = Payments[(Renewal_Batch.Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; (Payment_Status == &quot;Pending&quot; || Payment_Status == &quot;Failed&quot;)];\n\tpendingPaymentCount = pendingBatchPayments.count() + pendingPaymentRecords.count();\n\tpendingBatchAmount = ifnull(pendingBatchPayments.sum(Total_Amount_Due),0);\n\tpendingPaymentAmount = ifnull(pendingPaymentRecords.sum(Amount_Due),0);\n\tpendingAmount = pendingBatchAmount + pendingPaymentAmount;\n\n\tsubmittedCorrespondence = Correspondence[Recipient_Email == licenseeEmail &amp;&amp; (Merge_Status == &quot;Ready for Manual Merge&quot; || Merge_Status == &quot;Generated Manually&quot; || Merge_Status == &quot;Sent Manually&quot; || Sign_Status == &quot;Pending Manual Sign&quot; || Sign_Status == &quot;Signed&quot;)];\n\tsubmittedNotices = Renewal_Notices[Recipient_Email == licenseeEmail &amp;&amp; Delivery_Status != &quot;Draft&quot;];\n\tcorrespondenceCount = submittedCorrespondence.count();\n\tnoticeCount = submittedNotices.count();\n\tfailedCorrespondence = Correspondence[Recipient_Email == licenseeEmail &amp;&amp; Merge_Status == &quot;Failed&quot;].count();\n\tfailedNotices = Renewal_Notices[Recipient_Email == licenseeEmail &amp;&amp; Delivery_Status == &quot;Failed&quot;].count();\n\n\ttotalAttention = renewableCount + pendingBatchCount + pendingItemCount + pendingPaymentCount + failedCorrespondence + failedNotices;\n\tstatusGoodCount = activeCount;\n\tif(totalAttention == 0 &amp;&amp; statusGoodCount &gt; 0)\n\t{\n\t\tworkspaceStatus = &quot;Current&quot;;\n\t\tworkspaceBadge = &quot;zcs-badge-green&quot;;\n\t\tworkspaceIcon = &quot;ui-1-check-circle-08&quot;;\n\t}\n\telse if(totalAttention &gt; 0)\n\t{\n\t\tworkspaceStatus = &quot;Action needed&quot;;\n\t\tworkspaceBadge = &quot;zcs-badge-yellow&quot;;\n\t\tworkspaceIcon = &quot;ui-2-time&quot;;\n\t}\n\telse\n\t{\n\t\tworkspaceStatus = &quot;No records found&quot;;\n\t\tworkspaceBadge = &quot;zcs-badge-grey&quot;;\n\t\tworkspaceIcon = &quot;travel-info&quot;;\n\t}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility styles included once for this page from zcs-global; scoped subset covers utility classes used below. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-black-color:#000000;font-size:16px;line-height:1.5;--column-gap:0px}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-14{gap:.875rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-28{gap:1.75rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}\n/* ZCS component CSS used: header-heading-with-actions, button-primary-button, badge-badge-with-icon, quick-actions-card-type-quick-actions, card-fleets-performance-metrics, table-simple-table, banner-outline-banner-with-icon, no-data-no-data-with-button. */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:#fff;color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-grey{background:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#F4660C}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}.zcs-outline-toast{border:1px solid}.zcs-theme-toast{background-color:var(--zcs_component_hover_color)}.zcs-outline-toast.zcs-theme-toast{border:1px solid var(--zcs_brand_color)}.zcs-warning-toast{background:#fef4e5;color:#663c01}.zcs-info-toast{background:#e4f6fd;color:#024361}.zcs-nodata-wrapper{min-height:220px}.zcs-page-header .zcs-button{white-space:nowrap}\n/* Licensee Action Center layout. */\n.lac-page{background:linear-gradient(180deg,#f7fbff 0%,var(--zcs-page-bg-color) 100%);color:var(--zcs-primary-text-color);font-family:Inter,Arial,sans-serif;min-height:100%;padding:28px;box-sizing:border-box}.lac-shell{max-width:1480px;margin:0 auto}.lac-page-header{background:rgba(255,255,255,.94);border:1px solid #e7e7ee;border-radius:20px;box-shadow:0 12px 34px rgba(20,44,84,.08);padding:22px 24px}.lac-head-icon{width:48px;height:48px;border-radius:16px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:24px}.lac-subtitle{margin-top:4px;color:var(--zcs-teritiary-text-color)}.lac-hero{position:relative;overflow:hidden;margin-top:18px;border-radius:28px;background:radial-gradient(circle at 85% 8%,rgba(255,255,255,.24),transparent 30%),radial-gradient(circle at 10% 8%,rgba(20,184,166,.30),transparent 31%),linear-gradient(135deg,#0b2f5f 0%,var(--zcs_brand_color) 58%,#14b8a6 130%);color:#fff;padding:30px;box-shadow:0 24px 64px rgba(15,108,201,.23)}.lac-hero h1{font-size:34px;line-height:1.12;margin:0}.lac-hero p{max-width:880px;color:rgba(255,255,255,.86);margin:10px 0 0}.lac-hero-pills{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.lac-hero-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.28);background:rgba(255,255,255,.14);color:#fff;border-radius:999px;padding:7px 12px;font-size:13px}.lac-grid{display:grid;gap:16px}.lac-section{margin-top:18px}.lac-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.lac-kpi{position:relative;overflow:hidden;min-height:150px}.lac-kpi:after{content:&quot;&quot;;position:absolute;right:-32px;top:-32px;width:100px;height:100px;border-radius:50%;background:var(--lac-soft)}.lac-icon{width:46px;height:46px;border-radius:14px;background:var(--lac-soft);color:var(--lac-color);display:flex;align-items:center;justify-content:center;font-size:22px}.lac-kpi-value{font-size:32px;font-weight:800;line-height:1.1;color:var(--zcs-primary-text-color);margin-top:14px}.lac-kpi-label{font-size:13px;color:var(--zcs-teritiary-text-color);margin-top:4px}.lac-kpi-note{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:8px}.lac-two{grid-template-columns:minmax(0,1.1fr) minmax(360px,.9fr)}.lac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}.lac-card-head h2{font-size:18px;line-height:1.25;margin:0;color:var(--zcs-primary-text-color)}.lac-card-head p{font-size:13px;color:var(--zcs-teritiary-text-color);margin:4px 0 0}.lac-todo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.lac-todo{border-left:4px solid var(--lac-color);background:linear-gradient(90deg,var(--lac-soft),#fff);border-radius:14px;padding:16px}.lac-todo strong{display:block;font-size:26px;line-height:1;color:var(--zcs-primary-text-color)}.lac-todo span{display:block;margin-top:5px;font-size:13px;color:var(--zcs-secondary-text-color)}.lac-action-panel{height:100%}.lac-status-list{list-style:none}.lac-table-card{overflow:hidden}.lac-table-scroll{max-height:360px}.lac-row-action{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;border:1px solid var(--zcs_brand_color);color:var(--zcs_brand_color);background:#fff}.lac-row-action:hover{background:var(--zcs_component_hover_color)}.lac-split{grid-template-columns:repeat(2,minmax(0,1fr))}.lac-mini-note{border-left:4px solid var(--zcs_brand_color);background:linear-gradient(90deg,var(--zcs_component_hover_color),#fff);border-radius:14px;padding:16px}.lac-empty-icon{width:70px;height:70px;border-radius:22px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:34px;margin:0 auto}.lac-muted{color:var(--zcs-teritiary-text-color)}@media(max-width:1180px){.lac-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.lac-two,.lac-split{grid-template-columns:1fr}}@media(max-width:720px){.lac-page{padding:14px}.lac-page-header{padding:18px}.lac-hero{padding:22px;border-radius:20px}.lac-hero h1{font-size:28px}.lac-kpis,.lac-todo-grid{grid-template-columns:1fr}.lac-card-head,.lac-page-header{flex-direction:column;align-items:flex-start}.lac-table-scroll{overflow:auto}}\n&lt;/style&gt;\n&lt;div class=&quot;lac-page&quot;&gt;\n\t&lt;div class=&quot;lac-shell&quot;&gt;\n\t\t&lt;div class=&quot;zcs-page-header lac-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-head-icon zcs-no-shrink&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Licensee Action Center&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;lac-subtitle zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;Renewal, payment, correspondence, and license-status actions for &lt;%=licenseeEmail%&gt;&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Renewal_Portal&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open Renewal Portal&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Licensee_Portal_Licenses?Licensee_Email=&lt;%=emailParam%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;My licenses&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&quot;lac-hero&quot;&gt;\n\t\t\t&lt;span class=&quot;lac-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-dashboard-29&quot;&gt;&lt;/i&gt; Workspace summary&lt;/span&gt;\n\t\t\t&lt;h1&gt;Your licensing tasks at a glance&lt;/h1&gt;\n\t\t\t&lt;p&gt;Counts and tables on this page are filtered to your login user ID and licensee email fields across licenses, renewal batches, renewal items, payments, renewal notices, and correspondence.&lt;/p&gt;\n\t\t\t&lt;div class=&quot;lac-hero-pills&quot;&gt;\n\t\t\t\t&lt;span class=&quot;lac-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt; &lt;%=licenseeEmail%&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;lac-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline business-contact-86&quot;&gt;&lt;/i&gt; Entities: &lt;%=entityCount%&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;lac-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt; Licenses: &lt;%=allLicenseCount%&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;lac-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Attention items: &lt;%=totalAttention%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;lac-section lac-grid lac-kpis&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border lac-kpi&quot; style=&quot;--lac-color:#179E6C;--lac-soft:#E4FCF3;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-value&quot;&gt;&lt;%=activeCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-label&quot;&gt;Active licenses&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-note&quot;&gt;Active or renewed records currently tied to your email.&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border lac-kpi&quot; style=&quot;--lac-color:#b8770d;--lac-soft:#FCF4E6;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-value&quot;&gt;&lt;%=renewableCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-label&quot;&gt;Renewable or penalty licenses&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-note&quot;&gt;Includes Renewal Due, penalty status, penalty stage, or expiring in 60 days.&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border lac-kpi&quot; style=&quot;--lac-color:#09598e;--lac-soft:#e4f6fd;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-value&quot;&gt;&lt;%=pendingBatchCount + pendingItemCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-label&quot;&gt;Pending renewals&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-note&quot;&gt;Batches: &lt;%=pendingBatchCount%&gt; | Items: &lt;%=pendingItemCount%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border lac-kpi&quot; style=&quot;--lac-color:#F4660C;--lac-soft:#F8F0EB;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-value&quot;&gt;&lt;%=pendingPaymentCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-label&quot;&gt;Pending payments&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-kpi-note&quot;&gt;Amount flagged due: $&lt;%=pendingAmount%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;lac-section lac-grid lac-two&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-card-head&quot;&gt;\n\t\t\t\t\t&lt;div&gt;&lt;h2&gt;What needs your attention&lt;/h2&gt;&lt;p&gt;Use these to-do cards to prioritize your next renewal or payment action.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=workspaceBadge%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline &lt;%=workspaceIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=workspaceStatus%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lac-grid lac-todo-grid&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;lac-todo&quot; style=&quot;--lac-color:#b8770d;--lac-soft:#FCF4E6;&quot;&gt;&lt;strong&gt;&lt;%=renewableCount%&gt;&lt;/strong&gt;&lt;span&gt;Licenses ready for renewal or already in penalty status&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;lac-todo&quot; style=&quot;--lac-color:#09598e;--lac-soft:#e4f6fd;&quot;&gt;&lt;strong&gt;&lt;%=pendingBatchCount%&gt;&lt;/strong&gt;&lt;span&gt;Renewal batches not completed or cancelled&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;lac-todo&quot; style=&quot;--lac-color:#F4660C;--lac-soft:#F8F0EB;&quot;&gt;&lt;strong&gt;&lt;%=pendingPaymentCount%&gt;&lt;/strong&gt;&lt;span&gt;Payment entries or batches still pending&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;lac-todo&quot; style=&quot;--lac-color:#FE455D;--lac-soft:#FDE3E6;&quot;&gt;&lt;strong&gt;&lt;%=failedCorrespondence + failedNotices%&gt;&lt;/strong&gt;&lt;span&gt;Failed correspondence or renewal notices needing follow-up&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0 zcs-mt-20 lac-status-list&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Active license coverage&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=activeCount%&gt; of &lt;%=allLicenseCount%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=if(allLicenseCount == 0,0,(activeCount * 100) / allLicenseCount)%&gt;%;background:#179E6C;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Renewal action load&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=renewableCount%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=if(allLicenseCount == 0,0,(renewableCount * 100) / allLicenseCount)%&gt;%;background:#FAAE13;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border lac-action-panel&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quick actions and reports&lt;/h5&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Page:Renewal_Portal&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open Renewal Portal&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Renewable_Licenses?Licensee_Email=&lt;%=emailParam%&gt;&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Review Renewable Licenses report&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Licensee_Renewal_Batches?Licensee_Email=&lt;%=emailParam%&gt;&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open Licensee Renewal Batches report&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Renewal_Payment_Queue?Licensee_Email=&lt;%=emailParam%&gt;&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open Renewal Payment Queue report&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Correspondence_Log?Recipient_Email=&lt;%=emailParam%&gt;&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline files-single-copy-04&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open Correspondence Log report&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;% if(allLicenseCount == 0 &amp;&amp; pendingBatchCount == 0 &amp;&amp; pendingPaymentCount == 0 &amp;&amp; correspondenceCount == 0 &amp;&amp; noticeCount == 0) { %&gt;\n\t\t&lt;section class=&quot;lac-section&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-card zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;lac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-16 zcs-mb-0&quot;&gt;No licensee records found&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mb-0&quot;&gt;No records matched &lt;%=licenseeEmail%&gt;. If this is unexpected, confirm that your licensee portal email is stored on the entity, license, renewal batch, or notice record.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-16 zcs-mt-20&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Renewal_Portal&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Go to Renewal Portal&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;% } %&gt;\n\n\t\t&lt;section class=&quot;lac-section lac-grid lac-split&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border lac-table-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Active licenses&lt;/h2&gt;&lt;p&gt;License records currently active or renewed for your email.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=activeCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border lac-table-scroll&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;License&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Entity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Expires&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Open&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;% rowCount = 0; for each lic in Licenses[(Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; (License_Status == &quot;Active&quot; || License_Status == &quot;Renewed&quot;)] sort by Expiration_Date asc { if(rowCount &lt; 6) { rowCount = rowCount + 1; %&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(lic.License_Number,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(lic.Entity,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&quot;&gt;&lt;%=ifnull(lic.License_Status,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(lic.Expiration_Date,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right&quot;&gt;&lt;a class=&quot;lac-row-action&quot; href=&quot;#Report:Licensee_Portal_Licenses?ID=&lt;%=lic.ID%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } if(rowCount == 0) { %&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No active licenses matched this login email.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border lac-table-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Renewable and penalty licenses&lt;/h2&gt;&lt;p&gt;Expiring, renewal due, or penalty-stage licenses that may need action.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=renewableCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border lac-table-scroll&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;License&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Penalty&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Expires&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;% rowCount = 0; for each lic in Licenses[(Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; (License_Status == &quot;Renewal Due&quot; || License_Status == &quot;50% Penalty&quot; || License_Status == &quot;100% Penalty&quot; || Penalty_Stage == &quot;50%&quot; || Penalty_Stage == &quot;100%&quot; || (Expiration_Date &gt;= zoho.currentdate &amp;&amp; Expiration_Date &lt;= zoho.currentdate.addDay(60)))] sort by Expiration_Date asc { if(rowCount &lt; 6) { rowCount = rowCount + 1; %&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(lic.License_Number,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&quot;&gt;&lt;%=ifnull(lic.License_Status,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(lic.Penalty_Stage,&quot;None&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(lic.Expiration_Date,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right&quot;&gt;&lt;a class=&quot;lac-row-action&quot; href=&quot;#Page:Renewal_Portal&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } if(rowCount == 0) { %&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No renewable or penalty licenses are currently flagged.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;lac-section lac-grid lac-split&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border lac-table-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Pending renewal batches and items&lt;/h2&gt;&lt;p&gt;Submitted, payment pending, selected, or payment-pending renewal records.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=pendingBatchCount + pendingItemCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border lac-table-scroll&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Reference&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;% rowCount = 0; for each batch in Renewal_Batches[(Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; (Batch_Status == &quot;Draft&quot; || Batch_Status == &quot;Submitted&quot; || Batch_Status == &quot;Payment Pending&quot; || Payment_Status == &quot;Pending&quot;)] sort by Submitted_Date desc { if(rowCount &lt; 4) { rowCount = rowCount + 1; %&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Batch&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(batch.Renewal_Batch_Number,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-l_blue&quot;&gt;&lt;%=ifnull(batch.Batch_Status,&quot;&quot;)%&gt; / &lt;%=ifnull(batch.Payment_Status,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;$&lt;%=ifnull(batch.Total_Amount_Due,0)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } for each item in Renewal_Items[(Renewal_Batch.Licensee_Email == licenseeEmail || License.Licensee_Email == licenseeEmail) &amp;&amp; (Item_Status == &quot;Selected&quot; || Item_Status == &quot;Payment Pending&quot;)] { if(rowCount &lt; 8) { rowCount = rowCount + 1; %&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Item&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(item.License.License_Number,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-yellow&quot;&gt;&lt;%=ifnull(item.Item_Status,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;$&lt;%=ifnull(item.Total_Item_Amount,0)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } if(rowCount == 0) { %&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;4&quot;&gt;No pending renewal batches or items found.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border lac-table-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Pending payments&lt;/h2&gt;&lt;p&gt;Renewal batches and payment records waiting for completion.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;$&lt;%=pendingAmount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border lac-table-scroll&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Source&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Reference&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Due&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;% rowCount = 0; for each batch in Renewal_Batches[(Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; Payment_Status == &quot;Pending&quot;] sort by Submitted_Date desc { if(rowCount &lt; 4) { rowCount = rowCount + 1; %&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Renewal batch&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(batch.Renewal_Batch_Number,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-yellow&quot;&gt;&lt;%=ifnull(batch.Payment_Status,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;$&lt;%=ifnull(batch.Total_Amount_Due,0)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } for each pay in Payments[(Renewal_Batch.Licensee_Email == licenseeEmail || Entity.Licensee_Portal_Email == licenseeEmail || Entity.Contact_Email == licenseeEmail) &amp;&amp; (Payment_Status == &quot;Pending&quot; || Payment_Status == &quot;Failed&quot;)] sort by Payment_Date desc { if(rowCount &lt; 8) { rowCount = rowCount + 1; %&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Payment&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(pay.Payment_Reference,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-red&quot;&gt;&lt;%=ifnull(pay.Payment_Status,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;$&lt;%=ifnull(pay.Amount_Due,0)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } if(rowCount == 0) { %&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;4&quot;&gt;No pending payments found.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;lac-section lac-grid lac-split&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border lac-table-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Submitted correspondence&lt;/h2&gt;&lt;p&gt;Generated, signed, or sent correspondence for your email.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-single-copy-04&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=correspondenceCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border lac-table-scroll&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Number&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Subject&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Merge&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Sign&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;% rowCount = 0; for each cor in Correspondence[Recipient_Email == licenseeEmail &amp;&amp; (Merge_Status == &quot;Ready for Manual Merge&quot; || Merge_Status == &quot;Generated Manually&quot; || Merge_Status == &quot;Sent Manually&quot; || Sign_Status == &quot;Pending Manual Sign&quot; || Sign_Status == &quot;Signed&quot;)] sort by Generated_Date desc { if(rowCount &lt; 6) { rowCount = rowCount + 1; %&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(cor.Correspondence_Number,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(cor.Subject,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-l_blue&quot;&gt;&lt;%=ifnull(cor.Merge_Status,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(cor.Sign_Status,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } if(rowCount == 0) { %&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;4&quot;&gt;No submitted correspondence found.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border lac-table-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lac-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Submitted renewal notices&lt;/h2&gt;&lt;p&gt;Renewal notices and penalty notices generated for your email.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=noticeCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border lac-table-scroll&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Notice&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Due date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Delivery&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;% rowCount = 0; for each notice in Renewal_Notices[Recipient_Email == licenseeEmail &amp;&amp; Delivery_Status != &quot;Draft&quot;] sort by Notice_Date desc { if(rowCount &lt; 6) { rowCount = rowCount + 1; %&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(notice.Notice_Number,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(notice.Notice_Type,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(notice.Due_Date,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-l_blue&quot;&gt;&lt;%=ifnull(notice.Delivery_Status,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } if(rowCount == 0) { %&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;4&quot;&gt;No submitted renewal notices found.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;lac-section&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-toast zcs-outline-toast zcs-theme-toast zcs-w-full zcs-flex zcs-gap-12 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;div class=&quot;zcs-toast-text&quot;&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;For payment or renewal questions, open the Renewal Portal first, then use the linked Creator reports above to view the underlying filtered records.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Licensing_Operations_Dashboard
		{
					displayname = "Licensing Operations Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Licensing_Operations_Dashboard_Single_Snippet' elementName='Licensing_Operations_Dashboard_Single_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Licensing_Operations_Dashboard_Single_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\tuserName = zoho.loginuserid;\n\tif(userName == null || userName == &quot;&quot;)\n\t{\n\t\tuserName = zoho.loginuserid;\n\t}\n\tsnapshotDate = zoho.currentdate;\n\tsubmittedApps = Applications[Application_Status == &quot;Submitted&quot;].count();\n\tinProgressApps = Applications[Application_Status == &quot;In-progress&quot;].count();\n\tonHoldApps = Applications[Application_Status == &quot;On-hold&quot;].count();\n\tapprovedApps = Applications[Application_Status == &quot;Approved&quot;].count();\n\tlicenseIssuedApps = Applications[Application_Status == &quot;License Issued&quot;].count();\n\trejectedApps = Applications[Application_Status == &quot;Rejected&quot;].count();\n\ttotalStatusApps = submittedApps + inProgressApps + onHoldApps + approvedApps + licenseIssuedApps + rejectedApps;\n\tsubmittedPct = 0;\n\tinProgressPct = 0;\n\tonHoldPct = 0;\n\tapprovedPct = 0;\n\tissuedPct = 0;\n\trejectedPct = 0;\n\tif(totalStatusApps &gt; 0)\n\t{\n\t\tsubmittedPct = (submittedApps * 100.0) / totalStatusApps;\n\t\tinProgressPct = (inProgressApps * 100.0) / totalStatusApps;\n\t\tonHoldPct = (onHoldApps * 100.0) / totalStatusApps;\n\t\tapprovedPct = (approvedApps * 100.0) / totalStatusApps;\n\t\tissuedPct = (licenseIssuedApps * 100.0) / totalStatusApps;\n\t\trejectedPct = (rejectedApps * 100.0) / totalStatusApps;\n\t}\n\toriginalApps = Applications[Application_Type == &quot;Original&quot;].count();\n\ttransferApps = Applications[Application_Type == &quot;Transfer&quot;].count();\n\tchangeApps = Applications[Application_Type == &quot;Change&quot;].count();\n\tapprovedOriginalReady = Applications[Application_Type == &quot;Original&quot; &amp;&amp; Application_Status == &quot;Approved&quot; &amp;&amp; (Payment_Status == &quot;Complete&quot; || Payment_Status == &quot;Waived&quot;) &amp;&amp; Checklist_Complete == true].count();\n\tapprovedTransferReady = Applications[Application_Type == &quot;Transfer&quot; &amp;&amp; Application_Status == &quot;Approved&quot; &amp;&amp; (Payment_Status == &quot;Complete&quot; || Payment_Status == &quot;Waived&quot;) &amp;&amp; Checklist_Complete == true].count();\n\tapprovedChangeReady = Applications[Application_Type == &quot;Change&quot; &amp;&amp; Application_Status == &quot;Approved&quot; &amp;&amp; (Payment_Status == &quot;Complete&quot; || Payment_Status == &quot;Waived&quot;) &amp;&amp; Checklist_Complete == true].count();\n\ttransferWithExisting = Applications[Application_Type == &quot;Transfer&quot; &amp;&amp; Application_Status == &quot;Approved&quot; &amp;&amp; License != null].count();\n\tchangeWithExisting = Applications[Application_Type == &quot;Change&quot; &amp;&amp; Application_Status == &quot;Approved&quot; &amp;&amp; License != null].count();\n\treadyToIssue = approvedOriginalReady + approvedTransferReady + approvedChangeReady;\n\tfeeReady = Applications[Application_Status == &quot;Approved&quot; &amp;&amp; (Payment_Status == &quot;Complete&quot; || Payment_Status == &quot;Waived&quot;)].count();\n\tchecklistReady = Applications[Application_Status == &quot;Approved&quot; &amp;&amp; Checklist_Complete == true].count();\n\tnotReady = approvedApps - readyToIssue;\n\tif(notReady &lt; 0)\n\t{\n\t\tnotReady = 0;\n\t}\n\treadinessPct = 0;\n\tif(approvedApps &gt; 0)\n\t{\n\t\treadinessPct = (readyToIssue * 100.0) / approvedApps;\n\t}\n\tactiveHolds = Application_Holds[Hold_Released == false].count();\n\trecentDocketNotes = Docket_Notes[Event_Date &gt;= zoho.currentdate.subDay(14)].count();\n\tallDocketNotes = Docket_Notes[ID != 0].count();\n\tpendingFeeApps = Applications[Application_Status != &quot;Rejected&quot; &amp;&amp; Application_Status != &quot;License Issued&quot; &amp;&amp; Payment_Status != &quot;Complete&quot; &amp;&amp; Payment_Status != &quot;Waived&quot;].count();\n\tpendingFeeTotal = ifnull(Applications[Application_Status != &quot;Rejected&quot; &amp;&amp; Application_Status != &quot;License Issued&quot; &amp;&amp; Payment_Status != &quot;Complete&quot; &amp;&amp; Payment_Status != &quot;Waived&quot;].sum(Total_Fee_Due),0);\n\tif(pendingFeeTotal == 0)\n\t{\n\t\tpendingFeeTotal = ifnull(Applications[Application_Status != &quot;Rejected&quot; &amp;&amp; Application_Status != &quot;License Issued&quot; &amp;&amp; Payment_Status != &quot;Complete&quot; &amp;&amp; Payment_Status != &quot;Waived&quot;].sum(Total_Fee),0);\n\t}\n\tpendingPaymentCount = Payments[Payment_Status == &quot;Pending&quot;].count();\n\tpendingPaymentDue = ifnull(Payments[Payment_Status == &quot;Pending&quot;].sum(Amount_Due),0);\n\tqueueCount = submittedApps + inProgressApps + onHoldApps;\n\tallLicenses = Licenses[ID != 0].count();\n\tactiveLicenses = Licenses[License_Status == &quot;Active&quot;].count();\n\tterminatedLicenses = Licenses[License_Status == &quot;Terminated&quot;].count();\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css: utility classes used by this page ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; }\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-m-0{margin:0}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-full{border-radius:100%}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-w-full{width:100%}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-overflow-auto{overflow:auto}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}\n/* ===== card-sample-6 ===== */\n.zcs-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-card-header-count{background-color:#F5F6FA}\n/* ===== badge-badge-with-icon ===== */\n.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#E8E8E8;border-color:#64748B;color:#475569}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#A96800}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background-color:#F8F0EB;border-color:#F4660C;color:#F4660C}\n/* ===== button-primary-button ===== */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-button-icon{width:16px;max-height:16px}\n/* ===== table-simple-table ===== */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}\n/* ===== progress-bar-range-bar-with-texts ===== */\n.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}\n/* ===== dashboard styling ===== */\n.abc-ops{min-height:100%;background:linear-gradient(180deg,var(--zcs-page-bg-color) 0%,#fff 100%);padding:24px;color:var(--zcs-primary-text-color);font-family:Inter,Arial,sans-serif}.abc-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.65fr);gap:16px;margin-bottom:16px}.abc-panel{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color,#E7E7EE);border-radius:16px;box-shadow:0 14px 34px rgba(15,23,42,.06);overflow:hidden}.abc-hero-title{padding:28px;background:linear-gradient(135deg,var(--zcs_brand_color),#102A43);color:var(--zcs_brand_foreground_color);position:relative}.abc-hero-title h1{font-size:clamp(26px,3vw,36px);margin:12px 0 8px;line-height:1.15}.abc-hero-title p{max-width:950px;margin:0;opacity:.92}.abc-hero-title:after{content:&apos;&apos;;position:absolute;right:-60px;top:-90px;width:260px;height:260px;border-radius:50%;border:32px solid rgba(255,255,255,.11)}.abc-hero-context{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px;position:relative;z-index:1}.abc-hero-side{padding:22px}.abc-stack{display:flex;height:34px;border-radius:12px;overflow:hidden;background:#E8EDF5}.abc-stack span{display:block;min-width:2px}.abc-muted{color:var(--zcs-secondary-text-color)}.abc-fee-note{font-size:13px;color:var(--zcs-secondary-text-color);margin-top:8px}.abc-kpis{display:grid;grid-template-columns:repeat(6,minmax(150px,1fr));gap:14px;margin-bottom:16px}.abc-kpi{min-height:132px;position:relative;overflow:hidden}.abc-kpi:after{content:&apos;&apos;;position:absolute;width:76px;height:76px;border-radius:50%;right:-22px;top:-24px;background:var(--metric-color);opacity:.13}.abc-kpi-icon{width:42px;height:42px;border-radius:14px;background:var(--metric-bg);color:var(--metric-color);font-size:20px}.abc-kpi-value{font-size:28px;font-weight:700;margin-top:14px;color:var(--zcs-primary-text-color)}.abc-kpi-label{color:var(--zcs-secondary-text-color);font-size:13px}.abc-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.abc-wide{grid-column:1/-1}.abc-section-head{padding:18px 20px 12px;border-bottom:1px solid var(--zcs-border-color,#E7E7EE)}.abc-section-head h2{font-size:19px;margin:0;color:var(--zcs-primary-text-color)}.abc-section-head p{font-size:13px;margin:4px 0 0;color:var(--zcs-secondary-text-color)}.abc-report-embed{min-height:420px;padding:8px;background:#FBFCFE}.abc-report-embed.tall{min-height:560px}.abc-report-embed.compact{min-height:360px}.abc-actions{display:grid;grid-template-columns:repeat(6,minmax(150px,1fr));gap:10px}.abc-actions .zcs-button{justify-content:flex-start;min-height:42px}.abc-readiness{display:grid;grid-template-columns:minmax(300px,.9fr) minmax(0,1.1fr);gap:16px;padding:20px}.abc-meter{height:12px;background:#E8EDF5;border-radius:999px;overflow:hidden}.abc-meter-fill{height:100%;width:&lt;%=readinessPct%&gt;%;background:linear-gradient(90deg,var(--zcs_brand_color),#28CC97);border-radius:999px}.abc-ready-list{display:grid;gap:10px}.abc-ready-row{display:flex;justify-content:space-between;align-items:center;border:1px solid var(--zcs-border-color,#E7E7EE);border-radius:12px;padding:12px;background:#fff}.abc-docket-count{font-weight:700;color:var(--zcs_brand_color)}.abc-type-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:20px}.abc-type-card{border:1px solid var(--zcs-border-color,#E7E7EE);border-radius:14px;padding:16px;background:#fff}.abc-type-card h3{margin:0 0 8px;font-size:16px}.abc-type-count{font-size:28px;font-weight:700;color:var(--zcs-primary-text-color)}.abc-type-note{font-size:13px;color:var(--zcs-secondary-text-color);margin-top:6px}.abc-license-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:20px}.abc-license-stat{border:1px solid var(--zcs-border-color,#E7E7EE);border-radius:14px;padding:16px;background:#fff}.abc-license-stat strong{display:block;font-size:26px}.abc-note-box{margin:0 20px 20px;border:1px dashed var(--zcs-border-color,#E7E7EE);border-radius:12px;padding:12px;color:var(--zcs-secondary-text-color);font-size:13px;background:#FBFCFE}.zcs-legend-wrapper li{list-style-type:none}.zcs-legend-wrapper li label{min-width:145px}.zcs-legend-wrapper li label:before{content:&apos;&apos;;display:inline-block;vertical-align:top;width:12px;height:12px;margin:4px 12px;border-radius:50%}.zcs-legend-wrapper li:nth-child(1) label:before{background-color:#2A6FFC}.zcs-legend-wrapper li:nth-child(2) label:before{background-color:#36A2EB}.zcs-legend-wrapper li:nth-child(3) label:before{background-color:#FAAE13}.zcs-legend-wrapper li:nth-child(4) label:before{background-color:#28CC97}.zcs-legend-wrapper li:nth-child(5) label:before{background-color:#179E6C}.zcs-legend-wrapper li:nth-child(6) label:before{background-color:#FE455D}.zcs-donut-chart-wrapper{--donut-cx:100px;--donut-cy:100px;--donut-r:80;--donut-stroke_width:20;--donut-pi:3.14;--donut-donut_size:calc(var(--donut-cx) + var(--donut-cy));--donut-a1:&lt;%=submittedPct%&gt;;--donut-a2:&lt;%=inProgressPct%&gt;;--donut-a3:&lt;%=onHoldPct%&gt;;--donut-a4:&lt;%=approvedPct%&gt;;--donut-a5:&lt;%=issuedPct%&gt;;--donut-a6:&lt;%=rejectedPct%&gt;}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg{width:var(--donut-donut_size);height:var(--donut-donut_size);overflow:hidden}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle{cx:var(--donut-cx);cy:var(--donut-cy);r:var(--donut-r);stroke-width:var(--donut-stroke_width);fill:transparent}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(1){stroke:#2A6FFC;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) calc(2 * var(--donut-pi) * var(--donut-r));stroke-dashoffset:calc((2 * var(--donut-pi) * var(--donut-r)) / 4)}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(2){stroke:#36A2EB;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) calc(2 * var(--donut-pi) * var(--donut-r));stroke-dashoffset:calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100))}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(3){stroke:#FAAE13;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100) calc(2 * var(--donut-pi) * var(--donut-r));stroke-dashoffset:calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2)) / 100))}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(4){stroke:#28CC97;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a4) / 100) calc(2 * var(--donut-pi) * var(--donut-r));stroke-dashoffset:calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2) + var(--donut-a3)) / 100))}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(5){stroke:#179E6C;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a5) / 100) calc(2 * var(--donut-pi) * var(--donut-r));stroke-dashoffset:calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2) + var(--donut-a3) + var(--donut-a4)) / 100))}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(6){stroke:#FE455D;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a6) / 100) calc(2 * var(--donut-pi) * var(--donut-r));stroke-dashoffset:calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2) + var(--donut-a3) + var(--donut-a4) + var(--donut-a5)) / 100))}@media(max-width:1320px){.abc-kpis{grid-template-columns:repeat(4,1fr)}.abc-actions{grid-template-columns:repeat(3,1fr)}.abc-hero,.abc-grid{grid-template-columns:1fr}.abc-readiness{grid-template-columns:1fr}}@media(max-width:760px){.abc-ops{padding:12px}.abc-kpis,.abc-actions,.abc-type-cards,.abc-license-summary{grid-template-columns:1fr}.zcs-donut-chart-wrapper{flex-direction:column}.abc-hero-title h1{font-size:25px}}\n&lt;/style&gt;\n&lt;div class=&quot;abc-ops&quot;&gt;\n\t&lt;div class=&quot;abc-hero&quot;&gt;\n\t\t&lt;section class=&quot;abc-panel abc-hero-title&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline business-chart-bar-33&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Licensing staff workspace&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;h1&gt;Licensing Operations Dashboard&lt;/h1&gt;\n\t\t\t&lt;p&gt;Hello &lt;%=userName%&gt;. Current snapshot for intake queues, issuance readiness, transfer and change workload, active holds, fee exposure, and docket activity.&lt;/p&gt;\n\t\t\t&lt;div class=&quot;abc-hero-context&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;As of &lt;%=snapshotDate%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=readyToIssue%&gt; issue-ready&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=activeHolds%&gt; active holds&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;section class=&quot;abc-panel abc-hero-side&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Active staff queue&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-30 zcs-font-bold zcs-color-primary&quot;&gt;&lt;%=queueCount%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-muted zcs-font-13&quot;&gt;Submitted, in-progress, and on-hold applications&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline business-payment&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=pendingFeeApps%&gt; fee-pending&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-stack&quot; style=&quot;margin-top:18px&quot;&gt;\n\t\t\t\t&lt;span style=&quot;width:&lt;%=submittedPct%&gt;%;background:#2A6FFC&quot;&gt;&lt;/span&gt;\n\t\t\t\t&lt;span style=&quot;width:&lt;%=inProgressPct%&gt;%;background:#36A2EB&quot;&gt;&lt;/span&gt;\n\t\t\t\t&lt;span style=&quot;width:&lt;%=onHoldPct%&gt;%;background:#FAAE13&quot;&gt;&lt;/span&gt;\n\t\t\t\t&lt;span style=&quot;width:&lt;%=approvedPct%&gt;%;background:#28CC97&quot;&gt;&lt;/span&gt;\n\t\t\t\t&lt;span style=&quot;width:&lt;%=issuedPct%&gt;%;background:#179E6C&quot;&gt;&lt;/span&gt;\n\t\t\t\t&lt;span style=&quot;width:&lt;%=rejectedPct%&gt;%;background:#FE455D&quot;&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-fee-note&quot;&gt;Application fee exposure: &lt;strong&gt;$&lt;%=pendingFeeTotal%&gt;&lt;/strong&gt;. Payment report due: &lt;strong&gt;$&lt;%=pendingPaymentDue%&gt;&lt;/strong&gt;.&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-fee-note&quot;&gt;Docket activity in the last 14 days: &lt;strong&gt;&lt;%=recentDocketNotes%&gt;&lt;/strong&gt; notes.&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&quot;abc-kpis&quot;&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#2A6FFC;--metric-bg:#E8EFFF&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-add&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=submittedApps%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Submitted&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#36A2EB;--metric-bg:#EAF7FF&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=inProgressApps%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;In-progress&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#FAAE13;--metric-bg:#FCF4E6&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=onHoldApps%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;On-hold&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#28CC97;--metric-bg:#E4FCF3&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=approvedApps%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Approved&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#179E6C;--metric-bg:#E4FCF3&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=licenseIssuedApps%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;License issued&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#FE455D;--metric-bg:#FDE3E6&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=rejectedApps%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Rejected&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#09598E;--metric-bg:#E8F4FC&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-paper&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=originalApps%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Original applications&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#7C3AED;--metric-bg:#F2ECFF&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=transferApps%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Transfer applications&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#F4660C;--metric-bg:#F8F0EB&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=changeApps%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Change applications&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:var(--zcs_brand_color);--metric-bg:var(--zcs_component_hover_color)&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;$&lt;%=pendingFeeTotal%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Pending fees&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;abc-kpi zcs-card zcs-p-20 zcs-box-border&quot; style=&quot;--metric-color:#B8770D;--metric-bg:#FCF4E6&quot;&gt;&lt;div class=&quot;abc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=activeHolds%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Active holds&lt;/div&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;div class=&quot;abc-grid&quot;&gt;\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;\n\t\t\t\t&lt;h2&gt;Status distribution&lt;/h2&gt;\n\t\t\t\t&lt;p&gt;Application status mix across submission, review, hold, approval, issuance, and rejection.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12 zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-donut-chart zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;svg class=&quot;zcs-rounded-full&quot;&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;/svg&gt;\n\t\t\t\t\t&lt;h6 class=&quot;zcs-donut-chart-name zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0 zcs-absolute zcs-text-center&quot;&gt;Total&lt;br&gt;&lt;%=totalStatusApps%&gt;&lt;/h6&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-legend-wrapper&quot;&gt;\n\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-10 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Submitted: &lt;%=submittedApps%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;In-progress: &lt;%=inProgressApps%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;On-hold: &lt;%=onHoldApps%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Approved: &lt;%=approvedApps%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;License issued: &lt;%=licenseIssuedApps%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Rejected: &lt;%=rejectedApps%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;\n\t\t\t\t&lt;h2&gt;Issue-readiness&lt;/h2&gt;\n\t\t\t\t&lt;p&gt;Approved applications ready for the license action after payment and checklist completion.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-readiness&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;strong class=&quot;zcs-font-24 zcs-color-primary&quot;&gt;&lt;%=readyToIssue%&gt; ready&lt;/strong&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=readinessPct%&gt;% of approved&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-meter&quot; style=&quot;margin:14px 0 10px&quot;&gt;&lt;div class=&quot;abc-meter-fill&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-muted zcs-font-13&quot;&gt;&lt;%=notReady%&gt; approved applications still need fee clearance, checklist completion, hold release, or final supervisory action.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-ready-list&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-ready-row&quot;&gt;&lt;span&gt;Payment cleared or waived&lt;/span&gt;&lt;strong&gt;&lt;%=feeReady%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-ready-row&quot;&gt;&lt;span&gt;Checklist complete&lt;/span&gt;&lt;strong&gt;&lt;%=checklistReady%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-ready-row&quot;&gt;&lt;span&gt;Open holds to clear&lt;/span&gt;&lt;strong&gt;&lt;%=activeHolds%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-ready-row&quot;&gt;&lt;span&gt;Recent docket notes&lt;/span&gt;&lt;strong class=&quot;abc-docket-count&quot;&gt;&lt;%=recentDocketNotes%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel abc-wide&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;\n\t\t\t\t&lt;h2&gt;Issuance action by application type&lt;/h2&gt;\n\t\t\t\t&lt;p&gt;Clear routing for Original, Transfer, and Change applications before staff performs the license action.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-type-cards&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-type-card&quot;&gt;&lt;h3&gt;Original&lt;/h3&gt;&lt;div class=&quot;abc-type-count&quot;&gt;&lt;%=approvedOriginalReady%&gt;&lt;/div&gt;&lt;div class=&quot;abc-type-note&quot;&gt;Creates a new license from the approved application.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-type-card&quot;&gt;&lt;h3&gt;Transfer&lt;/h3&gt;&lt;div class=&quot;abc-type-count&quot;&gt;&lt;%=approvedTransferReady%&gt;&lt;/div&gt;&lt;div class=&quot;abc-type-note&quot;&gt;Creates a new license and terminates the existing license. Approved transfers with an existing license selected: &lt;strong&gt;&lt;%=transferWithExisting%&gt;&lt;/strong&gt;.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-type-card&quot;&gt;&lt;h3&gt;Change&lt;/h3&gt;&lt;div class=&quot;abc-type-count&quot;&gt;&lt;%=approvedChangeReady%&gt;&lt;/div&gt;&lt;div class=&quot;abc-type-note&quot;&gt;Updates the existing license record. Approved changes with an existing license selected: &lt;strong&gt;&lt;%=changeWithExisting%&gt;&lt;/strong&gt;.&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot; style=&quot;margin:0 20px 20px&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Application type&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;License operation&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Ready count&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Staff check&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Original&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Create new license&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-green&quot;&gt;&lt;%=approvedOriginalReady%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Confirm entity, premise, DBA, and license type line items.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Transfer&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Create new and terminate existing&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-yellow&quot;&gt;&lt;%=approvedTransferReady%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Verify the existing active license is selected before termination.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Change&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Update existing license&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-blue&quot;&gt;&lt;%=approvedChangeReady%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Verify license continuity and docket note summary.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel abc-wide&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;\n\t\t\t\t&lt;h2&gt;Quick links&lt;/h2&gt;\n\t\t\t\t&lt;p&gt;Primary forms used by licensing staff, supervisors, and accounting during the licensing process.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-actions zcs-p-20&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Applications&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Applications&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Application_Holds&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Application Holds&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Docket_Notes&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-paper&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Docket Notes&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Licenses&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Licenses&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:License_Type_Line_Items&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-list-bullet&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;License Type Line Items&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Legal_Entities&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-building&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Legal Entities&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel abc-wide&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;&lt;h2&gt;New license application queue&lt;/h2&gt;&lt;p&gt;Submitted, in-progress, and on-hold application workload for licensing staff.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-embed tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;New_License_Application_Queue&quot; zc-height=&quot;560px&quot;&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;&lt;h2&gt;Active holds&lt;/h2&gt;&lt;p&gt;Open hold records requiring staff follow-up or release action.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Active_Holds&quot; zc-height=&quot;420px&quot;&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;&lt;h2&gt;Recent docket notes&lt;/h2&gt;&lt;p&gt;Application history and staff comments. Total docket notes on file: &lt;strong&gt;&lt;%=allDocketNotes%&gt;&lt;/strong&gt;.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Docket_Notes_By_Application&quot; zc-height=&quot;420px&quot;&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel abc-wide&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;&lt;h2&gt;Approved applications&lt;/h2&gt;&lt;p&gt;Supervisor-approved applications waiting for issuance action or final queue review.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Approved_Applications&quot; zc-height=&quot;460px&quot;&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel abc-wide&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;&lt;h2&gt;License register&lt;/h2&gt;&lt;p&gt;Useful license context for issuance verification, transfer termination, and change updates.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-license-summary&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-license-stat&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;All licenses&lt;/span&gt;&lt;strong&gt;&lt;%=allLicenses%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-license-stat&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Active licenses&lt;/span&gt;&lt;strong&gt;&lt;%=activeLicenses%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-license-stat&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Terminated licenses&lt;/span&gt;&lt;strong&gt;&lt;%=terminatedLicenses%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-note-box&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; Terminated license counts are summarized from Licenses because a Terminated_Licenses report is not present in this app folder.&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;&lt;h2&gt;Active licenses&lt;/h2&gt;&lt;p&gt;Current licenses for transfer/change validation.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-embed compact&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Active_Licenses&quot; zc-height=&quot;360px&quot;&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;&lt;h2&gt;All licenses&lt;/h2&gt;&lt;p&gt;Full license history for lookup and audit support.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-embed compact&quot; zc-component=&quot;report&quot; zc-linkname=&quot;All_Licenses&quot; zc-height=&quot;360px&quot;&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;&lt;h2&gt;Pending payments&lt;/h2&gt;&lt;p&gt;Accounting visibility retained. Pending payment records: &lt;strong&gt;&lt;%=pendingPaymentCount%&gt;&lt;/strong&gt;, amount due: &lt;strong&gt;$&lt;%=pendingPaymentDue%&gt;&lt;/strong&gt;.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-embed compact&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Pending_Payments&quot; zc-height=&quot;360px&quot;&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-section-head&quot;&gt;&lt;h2&gt;Daily reconciliation&lt;/h2&gt;&lt;p&gt;Existing reconciliation view retained while the licensing queue remains the dashboard focus.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-report-embed compact&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Daily_Reconciliation&quot; zc-height=&quot;360px&quot;&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Licensing_Staff_Action_Center
		{
					displayname = "Licensing Staff Action Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Licensing_Staff_Action_Center_Snippet' elementName='Licensing_Staff_Action_Center_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Licensing_Staff_Action_Center_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\tstaffEmail = ifnull(zoho.loginuserid,&quot;&quot;);\n\tif(staffEmail == &quot;&quot; || staffEmail == null)\n\t{\n\t\tstaffEmail = &quot;Licensing staff&quot;;\n\t}\n\n\tassignedOpen = Applications[Assigned_Licensing_Rep == zoho.loginuserid &amp;&amp; (Application_Status == &quot;Submitted&quot; || Application_Status == &quot;In-progress&quot; || Application_Status == &quot;Ready for Approval&quot; || Application_Status == &quot;On-hold&quot; || Application_Status == &quot;Approved&quot;)] sort by Application_Submitted_Date asc;\n\tunassignedQueue = Applications[(Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == &quot;&quot;) &amp;&amp; (Application_Status == &quot;Submitted&quot; || Application_Status == &quot;In-progress&quot;)] sort by Application_Submitted_Date asc;\n\tnewSubmissions = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == &quot;&quot;) &amp;&amp; Application_Status == &quot;Submitted&quot;] sort by Application_Submitted_Date asc;\n\tverificationNeeded = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == &quot;&quot;) &amp;&amp; Checklist_Complete == false &amp;&amp; (Application_Status == &quot;Submitted&quot; || Application_Status == &quot;In-progress&quot; || Application_Status == &quot;Ready for Approval&quot;)] sort by Application_Submitted_Date asc;\n\tactiveHolds = Application_Holds[Hold_Released == false &amp;&amp; (Application.Assigned_Licensing_Rep == zoho.loginuserid || Application.Assigned_Licensing_Rep == null || Application.Assigned_Licensing_Rep == &quot;&quot;)] sort by Created_Date desc;\n\trequestInfoApps = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == &quot;&quot;) &amp;&amp; Application_Status == &quot;On-hold&quot; &amp;&amp; Tracking_Url_or_Note.contains(&quot;Information requested&quot;)] sort by Application_Submitted_Date asc;\n\tinvestigatorFlags = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == &quot;&quot;) &amp;&amp; Investigator_Review_Flag == true &amp;&amp; Application_Status != &quot;Rejected&quot; &amp;&amp; Application_Status != &quot;License Issued&quot;] sort by Application_Submitted_Date asc;\n\tapprovedAwaitingIssue = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == &quot;&quot;) &amp;&amp; Application_Status == &quot;Approved&quot; &amp;&amp; Issued_License == null] sort by Estimated_Issue_Date asc;\n\tpendingDocs = Correspondence[(Merge_Status == &quot;Draft&quot; || Merge_Status == &quot;Ready for Manual Merge&quot;) &amp;&amp; (Related_Application.Assigned_Licensing_Rep == zoho.loginuserid || Related_Application.Assigned_Licensing_Rep == null || Related_Application.Assigned_Licensing_Rep == &quot;&quot;)] sort by Generated_Date asc;\n\n\tassignedCount = assignedOpen.count();\n\tunassignedCount = unassignedQueue.count();\n\tnewCount = newSubmissions.count();\n\tverificationCount = verificationNeeded.count();\n\tholdCount = activeHolds.count();\n\trequestInfoCount = requestInfoApps.count();\n\tflagCount = investigatorFlags.count();\n\tapprovedIssueCount = approvedAwaitingIssue.count();\n\tcorrespondenceCount = pendingDocs.count();\n\tworkloadTotal = newCount + verificationCount + holdCount + requestInfoCount + flagCount + approvedIssueCount + correspondenceCount;\n\tassignedPct = 0;\n\tif((assignedCount + unassignedCount) &gt; 0)\n\t{\n\t\tassignedPct = ((assignedCount * 100) / (assignedCount + unassignedCount)).round(0);\n\t}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility stylesheet included once for this page; component ids used: zcs-global, button-primary-button, badge-badge-with-icon, table-simple-table, card-fleets-performance-metrics. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#2563eb);--zcs-light-bg-color:var(--zcs_brand_light_color,#eaf2ff);--zcs-page-bg-color:#f5f7fb;--zcs-primary-text-color:var(--zcs_primary_text_color,#111827);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#4b5563);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#8a94a6);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e7eb);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-box-border{box-sizing:border-box}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}.zcs-list-none{list-style-type:none}\n/* ZCS Button, Badge, Table, and Performance Metrics CSS. */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#2563eb);background:#fff;color:var(--zcs_brand_color,#2563eb)}.zcs-primary-button.zcs-button:hover{background:var(--zcs_brand_dark_color,#1d4ed8)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-filled-outline.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-filled-outline.zcs-badge-grey{background:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-filled-outline.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#f4660c}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background:#f9fafe;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color,#eff6ff);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color,#2563eb)}\n/* Page-specific layout. */\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.lsac{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f6f8ff 0%,#f5f7fb 60%,#fff 100%);min-height:100%;padding:28px;box-sizing:border-box}.lsac *{box-sizing:border-box}.lsac-shell{max-width:1500px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.lsac-hero{position:relative;overflow:hidden;border-radius:28px;padding:30px;background:radial-gradient(circle at 86% 8%,rgba(255,255,255,.28),transparent 28%),radial-gradient(circle at 6% 18%,rgba(45,212,191,.20),transparent 30%),linear-gradient(135deg,#14213d 0%,var(--zcs_brand_color,#2563eb) 62%,#0f766e 126%);color:#fff;box-shadow:0 24px 60px rgba(37,99,235,.18)}.lsac-hero:after{content:&quot;&quot;;position:absolute;right:-120px;bottom:-150px;width:360px;height:360px;border-radius:50%;border:1px solid rgba(255,255,255,.20);box-shadow:0 0 0 54px rgba(255,255,255,.08),0 0 0 108px rgba(255,255,255,.04)}.lsac-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.18fr) minmax(330px,.82fr);gap:24px;align-items:center}.lsac-eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.15);color:#fff;border-radius:999px;padding:7px 12px;font-size:12px;font-weight:750;letter-spacing:.5px;text-transform:uppercase}.lsac-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.03;letter-spacing:-.7px;margin:14px 0 10px;color:#fff}.lsac-hero p{max-width:820px;color:rgba(255,255,255,.86);font-size:15px;line-height:1.65;margin:0}.lsac-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.lsac-hero-actions .zcs-button{box-shadow:0 10px 22px rgba(0,0,0,.14)}.lsac-profile{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);border-radius:20px;padding:18px;backdrop-filter:blur(4px)}.lsac-avatar{width:58px;height:58px;border-radius:18px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28px}.lsac-profile h2{font-size:20px;line-height:1.2;margin:0;color:#fff}.lsac-profile-line{font-size:13px;color:rgba(255,255,255,.82);display:flex;align-items:center;gap:8px;margin-top:6px}.lsac-profile-kv{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.lsac-kv{border:1px solid rgba(255,255,255,.18);border-radius:14px;padding:10px;background:rgba(255,255,255,.08)}.lsac-kv span{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.55px;color:rgba(255,255,255,.62)}.lsac-kv strong{display:block;font-size:14px;margin-top:4px;color:#fff}.lsac-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 4px -2px}.lsac-section-title h2{font-size:11px;font-weight:800;color:#8a94a6;text-transform:uppercase;letter-spacing:1.1px;margin:0;display:flex;align-items:center;gap:8px}.lsac-section-title h2:before{content:&quot;&quot;;width:4px;height:15px;border-radius:4px;background:linear-gradient(180deg,var(--zcs_brand_color,#2563eb),#14b8a6)}.lsac-section-sub{font-size:12px;color:#8a94a6}.lsac-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.lsac-kpi{position:relative;overflow:hidden;background:#fff;border:1px solid #e9edf5;border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);min-height:145px}.lsac-kpi:after{content:&quot;&quot;;position:absolute;right:-42px;top:-42px;width:120px;height:120px;border-radius:50%;background:var(--soft)}.lsac-kpi-icon{position:relative;z-index:1;width:42px;height:42px;border-radius:14px;background:var(--soft);color:var(--tone);display:flex;align-items:center;justify-content:center;font-size:21px}.lsac-kpi-value{position:relative;z-index:1;font-size:32px;line-height:1;font-weight:800;color:#111827;margin-top:16px;letter-spacing:-.5px}.lsac-kpi-label{position:relative;z-index:1;font-size:12px;color:#64748b;margin-top:5px;font-weight:650}.lsac-kpi-note{position:relative;z-index:1;font-size:11px;color:#8a94a6;margin-top:6px}.lsac-grid-two{display:grid;grid-template-columns:minmax(0,.96fr) minmax(360px,.58fr);gap:14px}.lsac-card{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.lsac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.lsac-card-title{display:flex;gap:12px;align-items:flex-start}.lsac-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.lsac-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.lsac-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.lsac-card-body{padding:18px}.lsac-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.lsac-action{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:12px}.lsac-action.top{border-color:rgba(250,174,19,.45);background:linear-gradient(180deg,#fff,#fffbeb)}.lsac-action-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.lsac-action-title h4{font-size:15px;margin:0;color:#111827}.lsac-action-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.lsac-action-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.lsac-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:750;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.lsac-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb)}.lsac-link:hover{text-decoration:underline}.lsac-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.lsac-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.lsac-list{display:flex;flex-direction:column;gap:10px}.lsac-item{border:1px solid #e9edf5;border-radius:14px;padding:12px;background:#fff}.lsac-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.lsac-item-title{font-size:14px;font-weight:800;color:#111827}.lsac-item-meta{font-size:12px;color:#64748b;margin-top:3px}.lsac-item-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.lsac-health-list{list-style:none}.lsac-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.lsac-report-card.wide{grid-column:1/-1}.lsac-embed{border-top:1px solid #eef1f6;background:#fff;padding:8px}.lsac-embed-box{min-height:360px;border:1px dashed #d7deea;border-radius:12px;background:#fff;overflow:hidden}.lsac-table-wrap{max-height:460px;overflow:auto}.lsac-table-wrap table{min-width:940px}.lsac-foot-space{height:12px}@media(max-width:1240px){.lsac-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.lsac-hero-grid,.lsac-grid-two{grid-template-columns:1fr}.lsac-action-grid{grid-template-columns:1fr}}@media(max-width:780px){.lsac{padding:14px}.lsac-hero{padding:22px;border-radius:20px}.lsac-kpis,.lsac-report-grid{grid-template-columns:1fr}.lsac-profile-kv{grid-template-columns:1fr}.lsac-section-title{align-items:flex-start;flex-direction:column}.lsac-card-head{flex-direction:column}.lsac-hero-actions .zcs-button{width:100%}.lsac-report-card.wide{grid-column:auto}}\n&lt;/style&gt;\n&lt;div class=&quot;lsac&quot;&gt;\n\t&lt;div class=&quot;lsac-shell&quot;&gt;\n\t\t&lt;section class=&quot;lsac-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;lsac-hero-grid&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;span class=&quot;lsac-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt; Licensing staff action center&lt;/span&gt;\n\t\t\t\t\t&lt;h1&gt;Assigned workload and unassigned intake&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Hello &lt;%=staffEmail%&gt;. This landing page uses zoho.loginuserid to focus work assigned to your email and also surfaces unassigned Submitted or In-progress application queues that need licensing staff ownership.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;lsac-hero-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open staff queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:New_License_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;New submissions&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Public_Application_Wizard?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open application wizard&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;aside class=&quot;lsac-profile&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-avatar&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-common&quot;&gt;\n\t\t\t\t\t\t\t&lt;h2&gt;Licensing workload&lt;/h2&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;lsac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=staffEmail%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;lsac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=workloadTotal%&gt; open task signals&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;lsac-profile-kv&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-kv&quot;&gt;&lt;span&gt;Assigned open&lt;/span&gt;&lt;strong&gt;&lt;%=assignedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-kv&quot;&gt;&lt;span&gt;Unassigned queue&lt;/span&gt;&lt;strong&gt;&lt;%=unassignedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-kv&quot;&gt;&lt;span&gt;Issue ready&lt;/span&gt;&lt;strong&gt;&lt;%=approvedIssueCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-kv&quot;&gt;&lt;span&gt;Correspondence&lt;/span&gt;&lt;strong&gt;&lt;%=correspondenceCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;lsac-section-title&quot;&gt;&lt;h2&gt;Workload snapshot&lt;/h2&gt;&lt;span class=&quot;lsac-section-sub&quot;&gt;Assigned records match Assigned_Licensing_Rep to zoho.loginuserid; unassigned records have no representative email.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;lsac-kpis&quot;&gt;\n\t\t\t&lt;div class=&quot;lsac-kpi&quot; style=&quot;--tone:#2a6ffc;--soft:#e8efff;&quot;&gt;&lt;div class=&quot;lsac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-value&quot;&gt;&lt;%=newCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-label&quot;&gt;New submissions&lt;/div&gt;&lt;div class=&quot;lsac-kpi-note&quot;&gt;Submitted assigned or unassigned&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsac-kpi&quot; style=&quot;--tone:#1094c5;--soft:#e4f6fd;&quot;&gt;&lt;div class=&quot;lsac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-value&quot;&gt;&lt;%=verificationCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-label&quot;&gt;Verification needed&lt;/div&gt;&lt;div class=&quot;lsac-kpi-note&quot;&gt;Checklist not complete&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsac-kpi&quot; style=&quot;--tone:#b8770d;--soft:#fcf4e6;&quot;&gt;&lt;div class=&quot;lsac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-value&quot;&gt;&lt;%=holdCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-label&quot;&gt;Active holds&lt;/div&gt;&lt;div class=&quot;lsac-kpi-note&quot;&gt;Unreleased application holds&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsac-kpi&quot; style=&quot;--tone:#f4660c;--soft:#f8f0eb;&quot;&gt;&lt;div class=&quot;lsac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-value&quot;&gt;&lt;%=requestInfoCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-label&quot;&gt;Request-info follow-ups&lt;/div&gt;&lt;div class=&quot;lsac-kpi-note&quot;&gt;On-hold info requests&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsac-kpi&quot; style=&quot;--tone:#7c3aed;--soft:#f1eaff;&quot;&gt;&lt;div class=&quot;lsac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-flag-diagonal-33&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-value&quot;&gt;&lt;%=flagCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-label&quot;&gt;Investigator flags&lt;/div&gt;&lt;div class=&quot;lsac-kpi-note&quot;&gt;Review flag enabled&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsac-kpi&quot; style=&quot;--tone:#179e6c;--soft:#e4fcf3;&quot;&gt;&lt;div class=&quot;lsac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-value&quot;&gt;&lt;%=approvedIssueCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-kpi-label&quot;&gt;Approved awaiting issue&lt;/div&gt;&lt;div class=&quot;lsac-kpi-note&quot;&gt;Approved, no license linked&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;lsac-grid-two&quot;&gt;\n\t\t\t&lt;div class=&quot;lsac-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lsac-card-head&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;lsac-card-title&quot;&gt;&lt;div class=&quot;lsac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Action queues&lt;/h3&gt;&lt;p&gt;Open the action-enabled reports for row buttons such as Verify Intake, Request Info, Place Hold, Release Hold, Assign Review, Approve Application, Reject Application, and Issue License.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(workloadTotal &gt; 0,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-green&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline &lt;%=if(workloadTotal &gt; 0,&quot;ui-2-time&quot;,&quot;ui-1-check-circle-08&quot;)%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=if(workloadTotal &gt; 0,workloadTotal + &quot; signals&quot;,&quot;No open signals&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lsac-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;lsac-action-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-action &lt;%=if(newCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsac-action-title&quot;&gt;&lt;h4&gt;New submissions&lt;/h4&gt;&lt;span class=&quot;lsac-chip &lt;%=if(newCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;%=newCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsac-action-copy&quot;&gt;Verify intake, assign ownership, or route submissions that are not yet in progress.&lt;/p&gt;&lt;div class=&quot;lsac-action-links&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:New_License_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open report&lt;/a&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Verify intake&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-action &lt;%=if(verificationCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsac-action-title&quot;&gt;&lt;h4&gt;Verification needed&lt;/h4&gt;&lt;span class=&quot;lsac-chip &lt;%=if(verificationCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;%=verificationCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsac-action-copy&quot;&gt;Review checklist completion and supporting compliance details before approval routing.&lt;/p&gt;&lt;div class=&quot;lsac-action-links&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Open_Application_Checklists?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-check&quot;&gt;&lt;/i&gt;Open checklists&lt;/a&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Queue&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-action &lt;%=if(holdCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsac-action-title&quot;&gt;&lt;h4&gt;Holds&lt;/h4&gt;&lt;span class=&quot;lsac-chip &lt;%=if(holdCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;&lt;%=holdCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsac-action-copy&quot;&gt;Review active holds and use the staff queue to release holds when conditions are satisfied.&lt;/p&gt;&lt;div class=&quot;lsac-action-links&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Active_Holds?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;Active holds&lt;/a&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-unlocked&quot;&gt;&lt;/i&gt;Release hold&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-action &lt;%=if(requestInfoCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsac-action-title&quot;&gt;&lt;h4&gt;Request-info follow-ups&lt;/h4&gt;&lt;span class=&quot;lsac-chip &lt;%=if(requestInfoCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;%=requestInfoCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsac-action-copy&quot;&gt;Follow applications whose tracking note records an information request and remain on hold.&lt;/p&gt;&lt;div class=&quot;lsac-action-links&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;Follow up&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-action &lt;%=if(flagCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsac-action-title&quot;&gt;&lt;h4&gt;Investigator review flags&lt;/h4&gt;&lt;span class=&quot;lsac-chip &lt;%=if(flagCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-flag-diagonal-33&quot;&gt;&lt;/i&gt;&lt;%=flagCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsac-action-copy&quot;&gt;Applications marked for investigator review need screening before they proceed to approval or issuance.&lt;/p&gt;&lt;div class=&quot;lsac-action-links&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Investigator_Review_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-flag-diagonal-33&quot;&gt;&lt;/i&gt;Investigator queue&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsac-action &lt;%=if(approvedIssueCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsac-action-title&quot;&gt;&lt;h4&gt;Approved awaiting issue&lt;/h4&gt;&lt;span class=&quot;lsac-chip &lt;%=if(approvedIssueCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;%=approvedIssueCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsac-action-copy&quot;&gt;Approved applications without an issued license link should be issued from the approved applications report.&lt;/p&gt;&lt;div class=&quot;lsac-action-links&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Approved_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;Issue license&lt;/a&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Form:Applications?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Application form&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt; Workload health&lt;/h5&gt;\n\t\t\t\t&lt;ul class=&quot;lsac-health-list zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Assigned share&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=assignedPct%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=assignedPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Unassigned pressure&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=unassignedCount%&gt; records&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=if(unassignedCount &gt; 10,&quot;100&quot;,unassignedCount * 10)%&gt;%;background:&lt;%=if(unassignedCount &gt; 0,&quot;#faae13&quot;,&quot;#179e6c&quot;)%&gt;;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Issuance pressure&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=approvedIssueCount%&gt; ready&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=if(approvedIssueCount &gt; 10,&quot;100&quot;,approvedIssueCount * 10)%&gt;%;background:&lt;%=if(approvedIssueCount &gt; 0,&quot;#1094c5&quot;,&quot;#179e6c&quot;)%&gt;;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;div class=&quot;lsac-card-body&quot; style=&quot;padding:0;&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;lsac-list&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:All_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;All applications&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Pending_Correspondence?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;Pending correspondence&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Application_Status_Board?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;Status board&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;lsac-section-title&quot;&gt;&lt;h2&gt;Assigned and unassigned workload&lt;/h2&gt;&lt;span class=&quot;lsac-section-sub&quot;&gt;&lt;%=assignedCount%&gt; assigned to you, &lt;%=unassignedCount%&gt; unassigned submitted/in-progress.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;lsac-card&quot;&gt;\n\t\t\t&lt;div class=&quot;lsac-card-head&quot;&gt;&lt;div class=&quot;lsac-card-title&quot;&gt;&lt;div class=&quot;lsac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Priority application rows&lt;/h3&gt;&lt;p&gt;Use the report links for row-level actions and the application form links for record review.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Full staff queue&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsac-card-body&quot;&gt;\n&lt;%\n\tif(assignedOpen.count() == 0 &amp;&amp; unassignedQueue.count() == 0)\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;lsac-empty&quot;&gt;&lt;div class=&quot;lsac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;No assigned or unassigned intake records are currently open.&lt;/strong&gt;&lt;br&gt;Use the reports below for all historical application records.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper lsac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Queue&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Application&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Applicant / DBA&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Checklist&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Next action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tassignedRows = 0;\n\t\tfor each app in assignedOpen\n\t\t{\n\t\t\tif(assignedRows &lt; 8)\n\t\t\t{\n\t\t\t\tappNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,&quot;Application&quot;));\n\t\t\t\tappTitle = ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,&quot;Applicant&quot;));\n\t\t\t\tappStatus = ifnull(app.Application_Status,&quot;Submitted&quot;);\n\t\t\t\tstatusCls = &quot;chip-info&quot;;\n\t\t\t\tif(appStatus == &quot;On-hold&quot;)\n\t\t\t\t{\n\t\t\t\t\tstatusCls = &quot;chip-warn&quot;;\n\t\t\t\t}\n\t\t\t\telse if(appStatus == &quot;Approved&quot;)\n\t\t\t\t{\n\t\t\t\t\tstatusCls = &quot;chip-ok&quot;;\n\t\t\t\t}\n\t\t\t\tcheckText = if(app.Checklist_Complete == true,&quot;Complete&quot;,&quot;Needed&quot;);\n\t\t\t\tcheckCls = if(app.Checklist_Complete == true,&quot;chip-ok&quot;,&quot;chip-warn&quot;);\n%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsac-chip chip-theme&quot;&gt;Assigned&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appTitle%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsac-chip &lt;%=statusCls%&gt;&quot;&gt;&lt;%=appStatus%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsac-chip &lt;%=checkCls%&gt;&quot;&gt;&lt;%=checkText%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Staff_Application_Queue?ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Actions&lt;/a&gt; &lt;a class=&quot;lsac-link&quot; href=&quot;#Form:Applications?recLinkID=&lt;%=app.ID%&gt;&amp;amp;viewLinkName=All_Applications&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Record&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\tassignedRows = assignedRows + 1;\n\t\t}\n\t\tunassignedRows = 0;\n\t\tfor each app in unassignedQueue\n\t\t{\n\t\t\tif(unassignedRows &lt; 8)\n\t\t\t{\n\t\t\t\tappNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,&quot;Application&quot;));\n\t\t\t\tappTitle = ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,&quot;Applicant&quot;));\n\t\t\t\tappStatus = ifnull(app.Application_Status,&quot;Submitted&quot;);\n\t\t\t\tstatusCls = if(appStatus == &quot;Submitted&quot;,&quot;chip-info&quot;,&quot;chip-warn&quot;);\n\t\t\t\tcheckText = if(app.Checklist_Complete == true,&quot;Complete&quot;,&quot;Needed&quot;);\n\t\t\t\tcheckCls = if(app.Checklist_Complete == true,&quot;chip-ok&quot;,&quot;chip-warn&quot;);\n%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsac-chip chip-warn&quot;&gt;Unassigned&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appTitle%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsac-chip &lt;%=statusCls%&gt;&quot;&gt;&lt;%=appStatus%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsac-chip &lt;%=checkCls%&gt;&quot;&gt;&lt;%=checkText%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Staff_Application_Queue?ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Actions&lt;/a&gt; &lt;a class=&quot;lsac-link&quot; href=&quot;#Form:Applications?recLinkID=&lt;%=app.ID%&gt;&amp;amp;viewLinkName=All_Applications&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Record&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\tunassignedRows = unassignedRows + 1;\n\t\t}\n%&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;lsac-section-title&quot;&gt;&lt;h2&gt;Focused sections&lt;/h2&gt;&lt;span class=&quot;lsac-section-sub&quot;&gt;Holds, request-info follow-ups, investigator flags, issuance, and correspondence.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;lsac-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;lsac-card&quot;&gt;&lt;div class=&quot;lsac-card-head&quot;&gt;&lt;div class=&quot;lsac-card-title&quot;&gt;&lt;div class=&quot;lsac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Holds&lt;/h3&gt;&lt;p&gt;Active hold records tied to your assigned or unassigned applications.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsac-chip &lt;%=if(holdCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=holdCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsac-card-body&quot;&gt;&lt;div class=&quot;lsac-list&quot;&gt;\n&lt;% if(activeHolds.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;lsac-empty&quot;&gt;&lt;div class=&quot;lsac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No active holds are currently in your staff workload.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { holdRows = 0; for each hold in activeHolds { if(holdRows &lt; 4) { %&gt;\n\t\t\t\t&lt;div class=&quot;lsac-item&quot;&gt;&lt;div class=&quot;lsac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;lsac-item-title&quot;&gt;&lt;%=ifnull(hold.Hold_Type,&quot;Application hold&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-item-meta&quot;&gt;&lt;%=ifnull(hold.Application.Application_Number,&quot;Application&quot;)%&gt; | Created &lt;%=ifnull(hold.Created_Date,&quot;Not dated&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsac-chip chip-warn&quot;&gt;Open&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsac-item-actions&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Active_Holds?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;View hold&lt;/a&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Staff_Application_Queue?ID=&lt;%=hold.Application%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-unlocked&quot;&gt;&lt;/i&gt;Release action&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } holdRows = holdRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;lsac-card&quot;&gt;&lt;div class=&quot;lsac-card-head&quot;&gt;&lt;div class=&quot;lsac-card-title&quot;&gt;&lt;div class=&quot;lsac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-flag-diagonal-33&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Investigator review flags&lt;/h3&gt;&lt;p&gt;Flagged applications needing investigative review coordination.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsac-chip &lt;%=if(flagCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=flagCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsac-card-body&quot;&gt;&lt;div class=&quot;lsac-list&quot;&gt;\n&lt;% if(investigatorFlags.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;lsac-empty&quot;&gt;&lt;div class=&quot;lsac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No investigator flags are open for your workload.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { flagRows = 0; for each app in investigatorFlags { if(flagRows &lt; 4) { %&gt;\n\t\t\t\t&lt;div class=&quot;lsac-item&quot;&gt;&lt;div class=&quot;lsac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;lsac-item-title&quot;&gt;&lt;%=ifnull(app.Application_Number,&quot;Application&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-item-meta&quot;&gt;&lt;%=ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,&quot;Applicant&quot;))%&gt; | &lt;%=ifnull(app.Application_Status,&quot;Status not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsac-chip chip-warn&quot;&gt;Flagged&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsac-item-actions&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Investigator_Review_Queue?ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-flag-diagonal-33&quot;&gt;&lt;/i&gt;Open review&lt;/a&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Form:Applications?recLinkID=&lt;%=app.ID%&gt;&amp;amp;viewLinkName=All_Applications&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Record&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } flagRows = flagRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;lsac-card&quot;&gt;&lt;div class=&quot;lsac-card-head&quot;&gt;&lt;div class=&quot;lsac-card-title&quot;&gt;&lt;div class=&quot;lsac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Approved awaiting issue&lt;/h3&gt;&lt;p&gt;Approved applications where Issued License is still empty.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsac-chip &lt;%=if(approvedIssueCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=approvedIssueCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsac-card-body&quot;&gt;&lt;div class=&quot;lsac-list&quot;&gt;\n&lt;% if(approvedAwaitingIssue.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;lsac-empty&quot;&gt;&lt;div class=&quot;lsac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No approved applications are awaiting license issuance.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { issueRows = 0; for each app in approvedAwaitingIssue { if(issueRows &lt; 4) { %&gt;\n\t\t\t\t&lt;div class=&quot;lsac-item&quot;&gt;&lt;div class=&quot;lsac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;lsac-item-title&quot;&gt;&lt;%=ifnull(app.Application_Number,&quot;Application&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-item-meta&quot;&gt;&lt;%=ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,&quot;Applicant&quot;))%&gt; | Estimated issue &lt;%=ifnull(app.Estimated_Issue_Date,&quot;Not dated&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsac-chip chip-warn&quot;&gt;Issue&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsac-item-actions&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Approved_Applications?ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;Issue action&lt;/a&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Form:Applications?recLinkID=&lt;%=app.ID%&gt;&amp;amp;viewLinkName=All_Applications&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Record&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } issueRows = issueRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;lsac-card&quot;&gt;&lt;div class=&quot;lsac-card-head&quot;&gt;&lt;div class=&quot;lsac-card-title&quot;&gt;&lt;div class=&quot;lsac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Pending correspondence&lt;/h3&gt;&lt;p&gt;Draft or ready-for-merge correspondence tied to assigned or unassigned applications.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsac-chip &lt;%=if(correspondenceCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=correspondenceCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsac-card-body&quot;&gt;&lt;div class=&quot;lsac-list&quot;&gt;\n&lt;% if(pendingDocs.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;lsac-empty&quot;&gt;&lt;div class=&quot;lsac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No pending correspondence was found for your application workload.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { docRows = 0; for each doc in pendingDocs { if(docRows &lt; 4) { %&gt;\n\t\t\t\t&lt;div class=&quot;lsac-item&quot;&gt;&lt;div class=&quot;lsac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;lsac-item-title&quot;&gt;&lt;%=ifnull(doc.Subject,&quot;Correspondence&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;lsac-item-meta&quot;&gt;&lt;%=ifnull(doc.Correspondence_Number,&quot;Document&quot;)%&gt; | &lt;%=ifnull(doc.Merge_Status,&quot;Draft&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsac-chip chip-warn&quot;&gt;Pending&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsac-item-actions&quot;&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Pending_Correspondence?ID=&lt;%=doc.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;Open correspondence&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } docRows = docRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;lsac-section-title&quot;&gt;&lt;h2&gt;Embedded action reports&lt;/h2&gt;&lt;span class=&quot;lsac-section-sub&quot;&gt;Native reports are reachable in-page and through dialog links for full row actions.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;lsac-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;lsac-card wide lsac-report-card&quot;&gt;&lt;div class=&quot;lsac-card-head&quot;&gt;&lt;div class=&quot;lsac-card-title&quot;&gt;&lt;div class=&quot;lsac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;My assigned staff queue&lt;/h3&gt;&lt;p&gt;Action-enabled application queue filtered to Assigned_Licensing_Rep equals your login email.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open full report&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;lsac-embed&quot;&gt;&lt;div class=&quot;lsac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Staff_Application_Queue&quot; zc-criteria=&quot;Assigned_Licensing_Rep == &amp;quot;&lt;%=staffEmail%&gt;&amp;quot;&quot; zc-height=&quot;520px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsac-card&quot;&gt;&lt;div class=&quot;lsac-card-head&quot;&gt;&lt;div class=&quot;lsac-card-title&quot;&gt;&lt;div class=&quot;lsac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Unassigned intake&lt;/h3&gt;&lt;p&gt;Submitted and in-progress application records needing staff assignment.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:New_License_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;lsac-embed&quot;&gt;&lt;div class=&quot;lsac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;New_License_Application_Queue&quot; zc-criteria=&quot;(Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == &amp;quot;&amp;quot;) &amp;&amp; (Application_Status == &amp;quot;Submitted&amp;quot; || Application_Status == &amp;quot;In-progress&amp;quot;)&quot; zc-height=&quot;420px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsac-card&quot;&gt;&lt;div class=&quot;lsac-card-head&quot;&gt;&lt;div class=&quot;lsac-card-title&quot;&gt;&lt;div class=&quot;lsac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Pending correspondence&lt;/h3&gt;&lt;p&gt;Document merge and signature work queue.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;lsac-link&quot; href=&quot;#Report:Pending_Correspondence?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;lsac-embed&quot;&gt;&lt;div class=&quot;lsac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Pending_Correspondence&quot; zc-height=&quot;420px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;div class=&quot;lsac-foot-space&quot;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Licensing_Supervisor_Action_Center
		{
					displayname = "Licensing Supervisor Action Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Licensing_Supervisor_Action_Center_Snippet' elementName='Licensing_Supervisor_Action_Center_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Licensing_Supervisor_Action_Center_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\tsupervisorEmail = ifnull(zoho.loginuserid,&quot;&quot;);\n\tif(supervisorEmail == &quot;&quot; || supervisorEmail == null)\n\t{\n\t\tsupervisorEmail = &quot;Licensing supervisor&quot;;\n\t}\n\n\tdraftCount = Applications[Application_Status == &quot;Draft&quot; || Application_Status is null || Application_Status == &quot;&quot;].count();\n\tsubmittedQueue = Applications[Application_Status == &quot;Submitted&quot;] sort by Application_Submitted_Date asc;\n\tinProgressQueue = Applications[Application_Status == &quot;In-progress&quot;] sort by Application_Submitted_Date asc;\n\treadyApproval = Applications[Application_Status == &quot;Ready for Approval&quot;] sort by Application_Submitted_Date asc;\n\tonHoldApps = Applications[Application_Status == &quot;On-hold&quot;] sort by Application_Submitted_Date asc;\n\trejectedApps = Applications[Application_Status == &quot;Rejected&quot;] sort by Application_Submitted_Date desc;\n\tapprovedApps = Applications[Application_Status == &quot;Approved&quot;] sort by Estimated_Issue_Date asc;\n\tlicenseIssuedCount = Applications[Application_Status == &quot;License Issued&quot;].count();\n\tactiveHolds = Application_Holds[Hold_Released == false] sort by Created_Date desc;\n\trequestInfoApps = Applications[Application_Status == &quot;On-hold&quot; &amp;&amp; Tracking_Url_or_Note.contains(&quot;Information requested&quot;)] sort by Application_Submitted_Date asc;\n\tinvestigatorFlags = Applications[Investigator_Review_Flag == true &amp;&amp; Application_Status != &quot;Rejected&quot; &amp;&amp; Application_Status != &quot;License Issued&quot;] sort by Application_Submitted_Date asc;\n\tapprovedAwaitingLicense = Applications[Application_Status == &quot;Approved&quot; &amp;&amp; Issued_License == null] sort by Estimated_Issue_Date asc;\n\tunassignedApps = Applications[(Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == &quot;&quot;) &amp;&amp; (Application_Status == &quot;Submitted&quot; || Application_Status == &quot;In-progress&quot; || Application_Status == &quot;Ready for Approval&quot;)] sort by Application_Submitted_Date asc;\n\n\tsubmittedCount = submittedQueue.count();\n\tinProgressCount = inProgressQueue.count();\n\treadyApprovalCount = readyApproval.count();\n\tonHoldCount = onHoldApps.count();\n\trejectedCount = rejectedApps.count();\n\tapprovedCount = approvedApps.count();\n\tholdCount = activeHolds.count();\n\trequestInfoCount = requestInfoApps.count();\n\tflagCount = investigatorFlags.count();\n\tapprovedIssueCount = approvedAwaitingLicense.count();\n\tunassignedCount = unassignedApps.count();\n\tallOpenAppCount = submittedCount + inProgressCount + readyApprovalCount + onHoldCount + approvedIssueCount;\n\n\trenewalPaymentQueue = Renewal_Batches[(Payment_Status == &quot;Pending&quot; || Batch_Status == &quot;Payment Pending&quot;) &amp;&amp; Batch_Status != &quot;Cancelled&quot;] sort by Submitted_Date asc;\n\trenewalSubmittedQueue = Renewal_Batches[(Batch_Status == &quot;Submitted&quot; || Batch_Status == &quot;Draft&quot; || Batch_Status == &quot;Paid&quot;) &amp;&amp; Batch_Status != &quot;Completed&quot; &amp;&amp; Batch_Status != &quot;Cancelled&quot;] sort by Submitted_Date asc;\n\tpendingPayments = Payments[(Payment_Status == &quot;Pending&quot; || Payment_Status == &quot;Failed&quot;) &amp;&amp; Amount_Due &gt; 0] sort by Payment_Date asc;\n\trefundQueue = Payments[Refund_Requested == true &amp;&amp; Refund_Status != &quot;Completed&quot;] sort by Payment_Date asc;\n\treconciliationQueue = Payments[Reconciled != true &amp;&amp; (Payment_Status == &quot;Complete&quot; || Payment_Status == &quot;Refunded&quot; || Payment_Status == &quot;Void&quot;)] sort by Payment_Date asc;\n\trenewalPaymentCount = renewalPaymentQueue.count();\n\trenewalSubmittedCount = renewalSubmittedQueue.count();\n\tpendingPaymentCount = pendingPayments.count();\n\trefundCount = refundQueue.count();\n\treconCount = reconciliationQueue.count();\n\tpaymentAmountDue = ifnull(pendingPayments.sum(Amount_Due),0);\n\trenewalAmountDue = ifnull(renewalPaymentQueue.sum(Total_Amount_Due),0);\n\tpaymentBottleneckCount = renewalPaymentCount + pendingPaymentCount + refundCount + reconCount;\n\n\tstaffRoster = Add_Agents[Agent_Role == &quot;Licensing Staff&quot; &amp;&amp; Active == true] sort by Agent_Email asc;\n\tstaffCount = staffRoster.count();\n\tbottleneckTotal = readyApprovalCount + holdCount + requestInfoCount + approvedIssueCount + unassignedCount + paymentBottleneckCount;\n\tattentionBadge = if(bottleneckTotal &gt; 0,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-green&quot;);\n\tattentionLabel = if(bottleneckTotal &gt; 0,&quot;Supervisor action needed&quot;,&quot;Queues clear&quot;);\n\tattentionIcon = if(bottleneckTotal &gt; 0,&quot;ui-2-time&quot;,&quot;ui-1-check-circle-08&quot;);\n%&gt;\n&lt;style&gt;\n/* ZCS components used on this page: zcs-global, header-heading-with-actions, card-sample-1, table-simple-table, button-primary-button, button-primary-outline-button, badge-filled-badge. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#2563eb);--zcs-light-bg-color:var(--zcs_brand_light_color,#eaf2ff);--zcs-page-bg-color:#f5f7fb;--zcs-primary-text-color:var(--zcs_primary_text_color,#111827);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#4b5563);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#8a94a6);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e7eb);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-