			Applications_On_Load as "Prepare New License Application"
			{
			
							type =  form
							form = Applications
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
													if(input.Applicant_Profile == null)
													{
														profileRec = Applicant_Profile[Profile_Email == zoho.loginuserid];
														if(profileRec.count() > 0)
														{
															input.Applicant_Profile = profileRec.ID;
															input.Applicant_Email = profileRec.Profile_Email;
														}
													}
													if(input.Application_Type in {""," ","null"} || input.Application_Type == null)
													{
														input.Application_Type = "Original";
													}
													if(input.Application_Submitted_Date == null)
													{
														input.Application_Submitted_Date = zoho.currentdate;
													}
													if(input.Submitted_Date == null)
													{
														input.Submitted_Date = input.Application_Submitted_Date;
													}
													if(input.Application_Status == null)
													{
														input.Application_Status = "Draft";
													}
													if(input.Payment_Status == null)
													{
														input.Payment_Status = "Pending";
													}
													if(input.Signature_Status == null)
													{
														input.Signature_Status = "Not Started";
													}
													if(input.Books_Invoice_Status == null)
													{
														input.Books_Invoice_Status = "Not Created";
													}
													lineTotal = 0;
													if(input.ID != null)
													{
														relatedLines = License_Type_Line_Items[License_Application == input.ID];
														for each  line in relatedLines
														{
															lineTotal = lineTotal + ifnull(line.Line_Item_Fee,0);
														}
													}
													input.Total_Fee = lineTotal;
													input.Total_Fee_Due = input.Total_Fee;
													disable Total_Fee;
													disable Total_Fee_Due;
													disable Issued_License;
													disable Issued_Date;
													disable Submitted_Date;
													hide Month_field;
													hide Year_field;
													hide loadIn;
													hide Current_Stage;
													hide Show_Value;
													hide From_Page;
													guidedStage = ifnull(input.Current_Stage,"0");
													if(input.Show_Value != null && input.Show_Value.trim() != "")
													{
														guidedStage = input.Show_Value;
														input.Current_Stage = guidedStage;
													}
													else
													{
														input.Show_Value = guidedStage;
													}
													if(input.From_Page == true)
													{
														hide Applicant_Profile;
														hide Legal_Entity;
														hide Premise_Address;
														hide Attorney;
														hide License;
														hide Application_Type;
														hide DBA;
														hide Mailing_Address;
														hide Total_Fee;
														hide License_Type_Line_Items;
														hide Felony;
														hide Violation;
														hide Copies_Mailed;
														hide Sent_INS;
														hide Cleared_Date;
														hide New_Beer_Price_Posting_Email;
														hide Section_23826_8;
														hide Application_Submitted_Date;
														hide Estimated_Issue_Date;
														hide Fingerprints;
														hide See_211_Signature_Page;
														hide Applicant_Email;
														hide Entity;
														hide Payment_Status;
														hide Denial_Reason;
														hide Issued_Date;
														hide Total_Fee_Due;
														hide Books_Invoice_Status;
														hide Investigator_Review_Flag;
														hide Application_Status;
														hide Business_DBA_Name;
														hide License_Type;
														hide Premises;
														hide Checklist_Complete;
														hide Issued_License;
														hide Submitted_Date;
														hide Signature_Status;
														hide Assigned_Licensing_Rep;
														hide Tracking_Url_or_Note;
														if(guidedStage == "0")
														{
															show Applicant_Profile;
															show Legal_Entity;
															show Applicant_Email;
															show Entity;
														}
														else if(guidedStage == "1")
														{
															show Application_Type;
															if(input.Application_Type == "Transfer" || input.Application_Type == "Change")
															{
																show License;
															}
														}
														else if(guidedStage == "2")
														{
															show DBA;
															show Premise_Address;
															show Mailing_Address;
															show Attorney;
															show Business_DBA_Name;
															show Premises;
														}
														else if(guidedStage == "3")
														{
															show License_Type_Line_Items;
															show License_Type;
															show Total_Fee;
															show Total_Fee_Due;
															show Books_Invoice_Status;
														}
														else if(guidedStage == "4")
														{
															show Felony;
															show Violation;
															show Copies_Mailed;
															show Sent_INS;
															show Cleared_Date;
															show New_Beer_Price_Posting_Email;
															show Section_23826_8;
															show Fingerprints;
															show See_211_Signature_Page;
															show Checklist_Complete;
															show Investigator_Review_Flag;
														}
														else if(guidedStage == "5")
														{
															show Application_Submitted_Date;
															show Estimated_Issue_Date;
															show Payment_Status;
															show Signature_Status;
															show Application_Status;
															show Denial_Reason;
															show Assigned_Licensing_Rep;
															show Total_Fee;
															show Total_Fee_Due;
														}
														else if(guidedStage == "6")
														{
															show Submitted_Date;
															show Application_Status;
															show Issued_License;
															show Issued_Date;
															show Tracking_Url_or_Note;
															show Payment_Status;
															show Signature_Status;
														}
													}
													else
													{
														show Applicant_Profile;
														show Legal_Entity;
														show Premise_Address;
														show Attorney;
														show Application_Type;
														show DBA;
														show Mailing_Address;
														show Total_Fee;
														show License_Type_Line_Items;
														show Felony;
														show Violation;
														show Copies_Mailed;
														show Sent_INS;
														show Cleared_Date;
														show New_Beer_Price_Posting_Email;
														show Section_23826_8;
														show Application_Submitted_Date;
														show Estimated_Issue_Date;
														show Fingerprints;
														show See_211_Signature_Page;
														show Applicant_Email;
														show Entity;
														show Payment_Status;
														show Denial_Reason;
														show Issued_Date;
														show Total_Fee_Due;
														show Books_Invoice_Status;
														show Investigator_Review_Flag;
														show Application_Status;
														show Business_DBA_Name;
														show License_Type;
														show Premises;
														show Checklist_Complete;
														show Issued_License;
														show Submitted_Date;
														show Signature_Status;
														show Assigned_Licensing_Rep;
														show Tracking_Url_or_Note;
														if(input.Application_Type == "Transfer" || input.Application_Type == "Change")
														{
															show License;
														}
														else
														{
															input.License = null;
															hide License;
														}
													}
									)
								}
							}
			
						
			}

			Applications_On_Success as "Application Post Submit Automation"
			{
			
							type =  form
							form = Applications
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Submitted_Date == null)
													{
														input.Submitted_Date = ifnull(input.Application_Submitted_Date,zoho.currentdate);
													}
													if(input.Applicant_Profile != null)
													{
														profileRows = Applicant_Profile[ID == input.Applicant_Profile];
														if(profileRows.count() > 0 && input.Applicant_Email in {""," ","null"})
														{
															input.Applicant_Email = profileRows.Profile_Email;
														}
													}
													if(input.DBA != null)
													{
														dbaRows = DBA[ID == input.DBA];
														if(dbaRows.count() > 0)
														{
															input.Business_DBA_Name = dbaRows.DBA_Name;
														}
													}
													else if(input.Legal_Entity != null)
													{
														entityRows = Legal_Entities[ID == input.Legal_Entity];
														if(entityRows.count() > 0)
														{
															if(entityRows.Entity_Type == "Company")
															{
																input.Business_DBA_Name = entityRows.Company_Name;
															}
															else
															{
																input.Business_DBA_Name = entityRows.Person_Name.first_name + " " + entityRows.Person_Name.last_name;
															}
														}
													}
													if(input.Business_DBA_Name in {""," ","null"})
													{
														input.Business_DBA_Name = "Application " + input.ID;
													}
													input.Total_Fee_Due = input.Total_Fee;
													if(input.Signature_Status == null || input.Signature_Status == "Not Started")
													{
														input.Signature_Status = "Pending Manual Sign";
													}
													if(input.Books_Invoice_Status == null || input.Books_Invoice_Status == "Not Created")
													{
														input.Books_Invoice_Status = "Manual Invoice Created";
													}
													if(input.Payment_Status == null)
													{
														input.Payment_Status = "Pending";
													}
													if(input.Entity == null)
													{
														legacyKind = "Other";
														legalRows = Legal_Entities[ID == input.Legal_Entity];
														if(legalRows.count() > 0)
														{
															if(legalRows.Entity_Type == "Company")
															{
																legacyKind = "Corporation";
															}
															else
															{
																legacyKind = "Individual";
															}
														}
														entityId = insert into Entities
														[
															Entity_Name=input.Business_DBA_Name
															Entity_Kind=legacyKind
															Contact_Email=input.Applicant_Email
															Licensee_Portal_Email=input.Applicant_Email
															Active=true
															Added_User=zoho.loginuser
														];
														input.Entity = entityId;
													}
													if(input.Premises == null && input.Premise_Address != null)
													{
														addrRows = Address_Records[ID == input.Premise_Address];
														if(addrRows.count() > 0)
														{
															premisesId = insert into Premises
															[
																DBA_Name=input.Business_DBA_Name
																Premises_Address=addrRows.Address
																County=ifnull(addrRows.Address.district_city,"Unknown")
																Inside_City_Limits="Unknown"
																Active=true
																Added_User=zoho.loginuser
															];
															input.Premises = premisesId;
														}
													}
													if(input.License_Type == null)
													{
														relatedLines = License_Type_Line_Items[License_Application == input.ID] sort by Added_Time;
														for each  line in relatedLines
														{
															if(input.License_Type == null && line.Primary_LT_Name != null)
															{
																input.License_Type = line.Primary_LT_Name;
															}
														}
													}
													if(input.Application_Status == "License Issued" && input.Application_Type == "Original" && input.Issued_License == null && input.License_Type != null && input.Entity != null && input.Premises != null)
													{
														issueDate = zoho.currentdate;
														licenseId = insert into Licenses
														[
															License_Type=input.License_Type
															Entity=input.Entity
															Premises=input.Premises
															Source_Application=input.ID
															Source_New_Application=input.ID
															Applicant_Profile=input.Applicant_Profile
															Legal_Entity_New=input.Legal_Entity
															DBA_New=input.DBA
															Premise_Address_New=input.Premise_Address
															Issue_Date=issueDate
															Expiration_Date=issueDate.addYear(1)
															License_Status="Active"
															Penalty_Stage="None"
															Licensee_Email=input.Applicant_Email
															Added_User=zoho.loginuser
														];
														input.Issued_License = licenseId;
														input.Issued_Date = issueDate;
														insert into Docket_Notes
														[
															Application=input.ID
															Event_Date=issueDate
															Event_Code="ORIGINAL_LICENSE_ISSUED"
															Event_Description="Original application issued"
															Comments="New active license created from Original application."
															User=zoho.loginuserid
															Added_User=zoho.loginuser
														]
														thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Original license issued","New active license created from Original application.");
													}
													else if(input.Application_Status == "License Issued" && input.Application_Type == "Transfer" && input.License != null && input.License_Type != null && input.Entity != null && input.Premises != null)
													{
														issueDate = zoho.currentdate;
														if(input.Issued_License == null)
														{
															licenseId = insert into Licenses
															[
																License_Type=input.License_Type
																Entity=input.Entity
																Premises=input.Premises
																Source_Application=input.ID
																Source_New_Application=input.ID
																Applicant_Profile=input.Applicant_Profile
																Legal_Entity_New=input.Legal_Entity
																DBA_New=input.DBA
																Premise_Address_New=input.Premise_Address
																Issue_Date=issueDate
																Expiration_Date=issueDate.addYear(1)
																License_Status="Active"
																Penalty_Stage="None"
																Licensee_Email=input.Applicant_Email
																Added_User=zoho.loginuser
															];
															input.Issued_License = licenseId;
														}
														input.Issued_Date = issueDate;
														existingLicense = Licenses[ID == input.License];
														if(existingLicense.count() > 0)
														{
															existingLicense.License_Status = "Terminated";
															existingLicense.Terminated_Date = issueDate;
															existingLicense.Termination_Reason = "Terminated by transfer application " + input.Application_Number;
															existingLicense.Replaced_By_License = input.Issued_License;
														}
														insert into Docket_Notes
														[
															Application=input.ID
															Event_Date=issueDate
															Event_Code="TRANSFER_LICENSE_ISSUED"
															Event_Description="Transfer application issued"
															Comments="New active license created and selected existing license terminated."
															User=zoho.loginuserid
															Added_User=zoho.loginuser
														]
														thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Transfer license issued","New active license created and selected existing license terminated.");
													}
													else if(input.Application_Status == "License Issued" && input.Application_Type == "Change" && input.License != null)
													{
														issueDate = zoho.currentdate;
														existingLicense = Licenses[ID == input.License];
														if(existingLicense.count() > 0)
														{
															if(input.License_Type != null)
															{
																existingLicense.License_Type = input.License_Type;
															}
															if(input.Entity != null)
															{
																existingLicense.Entity = input.Entity;
															}
															if(input.Premises != null)
															{
																existingLicense.Premises = input.Premises;
															}
															existingLicense.Source_New_Application = input.ID;
															existingLicense.Applicant_Profile = input.Applicant_Profile;
															existingLicense.Legal_Entity_New = input.Legal_Entity;
															existingLicense.DBA_New = input.DBA;
															existingLicense.Premise_Address_New = input.Premise_Address;
															existingLicense.License_Status = "Active";
															existingLicense.Licensee_Email = input.Applicant_Email;
														}
														input.Issued_License = input.License;
														input.Issued_Date = issueDate;
														insert into Docket_Notes
														[
															Application=input.ID
															Event_Date=issueDate
															Event_Code="CHANGE_LICENSE_UPDATED"
															Event_Description="Change application issued"
															Comments="Selected existing license updated from Change application; no new license created."
															User=zoho.loginuserid
															Added_User=zoho.loginuser
														]
														thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Change application issued","Selected existing license updated; no new license created.");
													}
													else if(input.Application_Status == "Rejected")
													{
														insert into Docket_Notes
														[
															Application=input.ID
															Event_Date=zoho.currentdate
															Event_Code="REJECTED"
															Event_Description="Application rejected"
															Comments=input.Denial_Reason
															User=zoho.loginuserid
															Added_User=zoho.loginuser
														]
														thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Application rejected",input.Denial_Reason);
													}
													else
													{
														insert into Docket_Notes
														[
															Application=input.ID
															Event_Date=zoho.currentdate
															Event_Code="SAVED"
															Event_Description="Application saved or updated"
															Comments="Application status: " + input.Application_Status
															User=zoho.loginuserid
															Added_User=zoho.loginuser
														]
														thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Application saved","Application submission/update completed.");
													}
									)
								}
							}
			
						
			}

			Applications_On_Validate as "Validate New License Application"
			{
			
							type =  form
							form = Applications
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
													if(input.Applicant_Profile == null || input.Application_Type in {""," ","null"} || input.Application_Type == null || input.Legal_Entity == null || input.Premise_Address == null)
													{
														alert "Applicant Profile, Application Type, Legal Entity, and Premise Address are required.";
														cancel submit;
													}
													if((input.Application_Type == "Transfer" || input.Application_Type == "Change") && input.License == null)
													{
														alert "Existing License is required for Transfer and Change applications.";
														cancel submit;
													}
													if(input.Application_Type == "Original")
													{
														input.License = null;
													}
													if(input.Felony in {""," ","null"} || input.Violation in {""," ","null"} || input.Fingerprints in {""," ","null"} || input.Application_Submitted_Date == null)
													{
														alert "Felony, Violation, Fingerprints, and Application Submitted Date are required.";
														cancel submit;
													}
													if(input.Total_Fee < 0 || input.Total_Fee_Due < 0)
													{
														alert "Total Fee cannot be negative.";
														cancel submit;
													}
													if(input.Application_Status == "Rejected" && (input.Denial_Reason == null || input.Denial_Reason.trim() == ""))
													{
														alert "Denial Reason is required when rejecting an application.";
														cancel submit;
													}
													if(input.Application_Status == "License Issued" && (input.Application_Type == "Original" || input.Application_Type == "Transfer") && input.License_Type == null)
													{
														alert "A primary License Type is required before issuing Original or Transfer applications.";
														cancel submit;
													}
													if(input.Application_Status == "License Issued" && input.Application_Type == "Change" && input.License == null)
													{
														alert "Existing License is required before issuing a Change application.";
														cancel submit;
													}
													if(input.Felony == "Yes" || input.Violation == "Yes")
													{
														input.Investigator_Review_Flag = true;
													}
									)
								}
							}
			
						
			}

			Current_Stage_On_User_Input as "Apply Guided Intake Current Stage"
			{
				type = form
				form = Applications
				record event = on add or edit
			
				on user input of Current_Stage
				{
					actions
					{
						custom deluge script
						(
							input.Show_Value = ifnull(input.Current_Stage,"0");
							guidedStage = ifnull(input.Current_Stage,"0");
							if(input.From_Page == true)
							{
								hide Applicant_Profile;
								hide Legal_Entity;
								hide Premise_Address;
								hide Attorney;
								hide License;
								hide Application_Type;
								hide DBA;
								hide Mailing_Address;
								hide Total_Fee;
								hide License_Type_Line_Items;
								hide Felony;
								hide Violation;
								hide Copies_Mailed;
								hide Sent_INS;
								hide Cleared_Date;
								hide New_Beer_Price_Posting_Email;
								hide Section_23826_8;
								hide Application_Submitted_Date;
								hide Estimated_Issue_Date;
								hide Fingerprints;
								hide See_211_Signature_Page;
								hide Applicant_Email;
								hide Entity;
								hide Payment_Status;
								hide Denial_Reason;
								hide Issued_Date;
								hide Total_Fee_Due;
								hide Books_Invoice_Status;
								hide Investigator_Review_Flag;
								hide Application_Status;
								hide Business_DBA_Name;
								hide License_Type;
								hide Premises;
								hide Checklist_Complete;
								hide Issued_License;
								hide Submitted_Date;
								hide Signature_Status;
								hide Assigned_Licensing_Rep;
								hide Tracking_Url_or_Note;
								if(guidedStage == "0")
								{
									show Applicant_Profile;
									show Legal_Entity;
									show Applicant_Email;
									show Entity;
								}
								else if(guidedStage == "1")
								{
									show Application_Type;
									if(input.Application_Type == "Transfer" || input.Application_Type == "Change")
									{
										show License;
									}
								}
								else if(guidedStage == "2")
								{
									show DBA;
									show Premise_Address;
									show Mailing_Address;
									show Attorney;
									show Business_DBA_Name;
									show Premises;
								}
								else if(guidedStage == "3")
								{
									show License_Type_Line_Items;
									show License_Type;
									show Total_Fee;
									show Total_Fee_Due;
									show Books_Invoice_Status;
								}
								else if(guidedStage == "4")
								{
									show Felony;
									show Violation;
									show Copies_Mailed;
									show Sent_INS;
									show Cleared_Date;
									show New_Beer_Price_Posting_Email;
									show Section_23826_8;
									show Fingerprints;
									show See_211_Signature_Page;
									show Checklist_Complete;
									show Investigator_Review_Flag;
								}
								else if(guidedStage == "5")
								{
									show Application_Submitted_Date;
									show Estimated_Issue_Date;
									show Payment_Status;
									show Signature_Status;
									show Application_Status;
									show Denial_Reason;
									show Assigned_Licensing_Rep;
									show Total_Fee;
									show Total_Fee_Due;
								}
								else if(guidedStage == "6")
								{
									show Submitted_Date;
									show Application_Status;
									show Issued_License;
									show Issued_Date;
									show Tracking_Url_or_Note;
									show Payment_Status;
									show Signature_Status;
								}
							}
						)
					}
				}
			}

			License_Type_Line_Items_Fee_On_User_Input as "Recalculate Fee From Line Item"
			{
			
							type =  form
							form = Applications
			
							record event = on add or edit
			
							on user input of License_Type_Line_Items.Line_Item_Fee
							{
								actions 
								{
									custom deluge script
									(
													lineTotal = 0;
													for each  rowLine in input.License_Type_Line_Items
													{
														lineTotal = lineTotal + ifnull(rowLine.Line_Item_Fee,0);
													}
													input.Total_Fee = lineTotal;
													input.Total_Fee_Due = input.Total_Fee;
									)
								}
							}
			
						
			}

