class=&quot;abc-fill&quot; style=&quot;--v:&lt;%=highPct%&gt;%;--accent:#fe455d&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=highPct%&gt;%&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-bar-row&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Visits due&lt;/span&gt;&lt;div class=&quot;abc-track&quot;&gt;&lt;div class=&quot;abc-fill&quot; style=&quot;--v:&lt;%=visitPct%&gt;%;--accent:#b8770d&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=visitPct%&gt;%&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-bar-row&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Violations&lt;/span&gt;&lt;div class=&quot;abc-track&quot;&gt;&lt;div class=&quot;abc-fill&quot; style=&quot;--v:&lt;%=violationPct%&gt;%;--accent:#f4660c&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=violationPct%&gt;%&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-bar-row&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Accusations&lt;/span&gt;&lt;div class=&quot;abc-track&quot;&gt;&lt;div class=&quot;abc-fill&quot; style=&quot;--v:&lt;%=accusationPct%&gt;%;--accent:#7c3aed&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=accusationPct%&gt;%&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-bar-row&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Legal review&lt;/span&gt;&lt;div class=&quot;abc-track&quot;&gt;&lt;div class=&quot;abc-fill&quot; style=&quot;--v:&lt;%=legalPct%&gt;%;--accent:#09598e&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=legalPct%&gt;%&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-bar-row&quot;&gt;&lt;span clas