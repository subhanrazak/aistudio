application "ABC-License-Management"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Add_Agents
		{
		
					displayname = "Add Agents"
					success message = "Agent saved"
					Agent_Information
					(
						type = section
						displayname = "Agent Information"
			 			row = 1
			 			column = 0   
						width = medium
					)
					Agent_Number
					(
		    			type = autonumber
						displayname = "Agent Number"
						start index = 200000
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Agent_Name
					(
		    			type = name
						displayname = "Agent Name"
		     			prefix
		     			(
			     			 type = prefix
			     			 displayname ="Title"
			     			 visibility = false
			     			 value = {"Mr.","Mrs.","Ms.","Dr."}
		     			) 
		     			first_name
		     			(
			     			 type = first_name
			     			 displayname ="First Name"
		     			) 
		     			last_name
		     			(
			     			 type = last_name
			     			 displayname ="Last Name"
		     			) 
		     			suffix
		     			(
			     			 type = suffix
			     			 displayname ="Suffix"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have unique Agent_Email
					(
		    			type = email
						displayname = "Agent Email"
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					Phone
					(
		    			type = phonenumber
		    			defaultcountry="us"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Agent_Role
					(
						type = picklist
						displayname = "Agent Role"
						values = {"Licensing Staff","Licensing Supervisor","Enforcement Agent","Enforcement Supervisor","OLS Attorney","Accounting Staff","Administrator"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					Supervisor
					(
						type = picklist	
						values  = Add_Agents.ID
		    			displayformat = [Agent_Name.first_name]
			 			row = 1
			 			column = 1   
						width = medium
					)
					Notes
					(
		    			type = textarea
						height = 100px
			 			row = 1
			 			column = 1   
						width = medium
					)
					Active
					(
		    			type = checkbox
						initial value = true
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Add_Users
		{
		
					displayname = "Add Users"
					success message = "User Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique User_Email
					(
		    			type = email
						displayname = "User Email"
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have Profile
					(
						type = picklist
						maxchar = 100
						values = {"Choice 1"}
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Add"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Address_Records
		{
		
					displayname = "Address Records"
					success message = "Address saved"
					Address_Information
					(
						type = section
						displayname = "Address Information"
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Applicant_Profile
					(
						type = picklist	
						displayname = "Applicant Profile"
						values  = Applicant_Profile.ID
		    			displayformat = [Profile_Email]
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Address_Title
					(
		    			type = text
						displayname = "Address Title"
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Address_Scope
					(
						type = picklist
						displayname = "Address Scope"
						values = {"In California","In USA out of California","Outside USA"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Address
					(
		    			type = address
		     			capture_coordinates = true
		     			adjust_using_map = true
		     			address_line_1
		     			(
			     			  type = address_line_1
			     			  displayname = "Street Address"
		     			) 
		     			address_line_2
		     			(
			     			  type = address_line_2
			     			  displayname = "Suite / Unit"
		     			) 
		     			district_city
		     			(
			     			  type = district_city
			     			  displayname = "City"
		     			) 
		     			state_province
		     			(
			     			  type = state_province
			     			  displayname = "State / Province"
		     			) 
		     			postal_Code
		     			(
			     			  type = postal_Code
			     			  displayname = "ZIP / Postal Code"
		     			) 
		     			country
		     			(
			     			  type = country
			     			  displayname = "Country"
		     			) 
		     			latitude
		     			(
			     			  type = latitude
			     			  displayname = "Latitude"
			     			 visibility = false
		     			) 
		     			longitude
		     			(
			     			  type = longitude
			     			  displayname = "Longitude"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 2   
						width = medium
					)
					Is_Mailing_Address
					(
		    			type = checkbox
						displayname = "Is Mailing Address"
						initial value = false
			 			row = 1
			 			column = 1   
						width = medium
					)
					Active
					(
		    			type = checkbox
						initial value = true
			 			row = 1
			 			column = 2   
						width = medium
					)
					Notes
					(
		    			type = textarea
						height = 100px
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Applicant_Profile
		{
		
					displayname = "Applicant Profile"
					success message = "Applicant profile saved"
					Profile_Information
					(
						type = section
						displayname = "Profile Information"
			 			row = 1
			 			column = 0   
						width = medium
					)
					Profile_Number
					(
		    			type = autonumber
						displayname = "Profile Number"
						start index = 100000
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have unique Profile_Email
					(
		    			type = email
						displayname = "Profile Email"
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have Profile_Name
					(
		    			type = name
						displayname = "Profile Name"
		     			prefix
		     			(
			     			 type = prefix
			     			 displayname ="Title"
			     			 visibility = false
			     			 value = {"Mr.","Mrs.","Ms.","Dr."}
		     			) 
		     			first_name
		     			(
			     			 type = first_name
			     			 displayname ="First Name"
		     			) 
		     			last_name
		     			(
			     			 type = last_name
			     			 displayname ="Last Name"
		     			) 
		     			suffix
		     			(
			     			 type = suffix
			     			 displayname ="Suffix"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 1   
						width = medium
					)
					Phone
					(
		    			type = phonenumber
		    			defaultcountry="us"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Profile_Image
					(
		    			type = image
						displayname = "Profile Image"
						source  = file
						aspect ratio = original
						camera = primary
						show gallery = true
						switch camera = true
			 			row = 1
			 			column = 1   
						width = medium
					)
					Notes
					(
		    			type = textarea
						height = 100px
			 			row = 1
			 			column = 1   
						width = medium
					)
					Active
					(
		    			type = checkbox
						initial value = true
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Application_Checklists
		{
		
					displayname = "Application Checklists"
					success message = "Checklist saved"
					Checklist_Details
					(
						type = section
						displayname = "Checklist Details"
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Application
					(
						type = picklist	
						values  = Applications.ID
		    			displayformat = [Business_DBA_Name]
			 			row = 1
			 			column = 1   
						width = medium
					)
					Checklist_Status
					(
						type = picklist
						displayname = "Checklist Status"
						values = {"Open","In Progress","Complete"}
						initial value = "Open"
			 			row = 1
			 			column = 2   
						width = medium
					)
					Public_Posting_30_Day
					(
		    			type = checkbox
						displayname = "30-Day Public Posting"
						initial value = false
			 			row = 1
			 			column = 1   
						width = medium
					)
					Public_Posting_Date
					(
		    			type = date
						displayname = "Public Posting Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 2   
						width = medium
					)
					Resident_500_Foot_Notification
					(
		    			type = checkbox
						displayname = "500-Foot Resident Notification"
						initial value = false
			 			row = 1
			 			column = 1   
						width = medium
					)
					Resident_Notification_Date
					(
		    			type = date
						displayname = "Resident Notification Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 2   
						width = medium
					)
					Local_Agency_Notification
					(
		    			type = checkbox
						displayname = "Local Agency Notification"
						initial value = false
			 			row = 1
			 			column = 1   
						width = medium
					)
					Local_Agency_Notification_Date
					(
		    			type = date
						displayname = "Local Agency Notification Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 2   
						width = medium
					)
					Investigation_Notes
					(
		    			type = textarea
						displayname = "Investigation Notes"
						height = 150px
			 			row = 1
			 			column = 1   
						width = medium
					)
					Completed_By
					(
		    			type = email
						displayname = "Completed By"
						maxchar = 80
			 			row = 1
			 			column = 2   
						width = medium
					)
					Completed_Date
					(
		    			type = date
						displayname = "Completed Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Save Checklist"
							)
							reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update Checklist"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Application_Holds
		{
		
					displayname = "Application Holds"
					success message = "Application hold saved"
					Hold_Details
					(
						type = section
						displayname = "Hold Details"
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Application
					(
						type = picklist	
						values  = Applications.ID
		    			displayformat = [Application_Number]
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Hold_Placed_By
					(
						type = picklist	
						displayname = "Hold Placed By"
						values  = Add_Agents.ID
		    			displayformat = [Agent_Name.first_name]
			 			row = 1
			 			column = 2   
						width = medium
					)
					Released_By
					(
						type = picklist	
						displayname = "Released By"
						values  = Add_Agents.ID
		    			displayformat = [Agent_Name.first_name]
			 			row = 1
			 			column = 1   
						width = medium
					)
					Created_Date
					(
		    			type = date
						displayname = "Created Date"
						initial value = "${zoho.currentdate}"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Hold_Type
					(
		    			type = text
						displayname = "Hold Type"
						maxchar = 100
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Hold_Comment
					(
		    			type = textarea
						displayname = "Hold Comment"
						height = 140px
			 			row = 1
			 			column = 2   
						width = medium
					)
					Hold_Until
					(
		    			type = date
						displayname = "Hold Until"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					Hold_Released
					(
		    			type = checkbox
						displayname = "Hold Released"
						initial value = false
			 			row = 1
			 			column = 2   
						width = medium
					)
					Released_Date
					(
		    			type = date
						displayname = "Released Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					Notes
					(
		    			type = textarea
						height = 100px
			 			row = 1
			 			column = 2   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Application_Legal_Entity
		{
		
					displayname = "Application Legal Entity"
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Application_Number
					(
						type = picklist	
						displayname = "Application Number"
						values  = Applications.ID
		    			displayformat = [Application_Number]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Applicant_Profile
					(
						type = picklist	
						displayname = "Applicant Profile"
						values  = Applicant_Profile.ID
		    			displayformat = [" " + Profile_Name.prefix + " " + Profile_Name.first_name + " " + Profile_Name.last_name + " " + Profile_Name.suffix]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Legal_Entity
					(
						type = picklist	
						displayname = "Legal Entity"
						values  = Legal_Entities[Applicant_Profile.ID == input.Applicant_Profile].ID
		    			displayformat = [Entity_ID + " - " + Entity_Name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Is_Primary_Entity
					(
		    			type = checkbox
						displayname = "Is Primary Entity"
						initial value = false
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Application_Types
		{
		
					displayname = "Application Types"
					success message = "Application type saved"
					Application_Type_Details
					(
						type = section
						displayname = "Application Type Details"
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique Type_Name
					(
		    			type = text
						displayname = "Type Name"
						maxchar = 100
			 			row = 1
			 			column = 1   
						width = medium
					)
					Charges
					(
						type = USD
						initial value = 0
						maxchar = 12
			 			row = 1
			 			column = 2   
						width = medium
					)
					Active
					(
		    			type = checkbox
						initial value = true
			 			row = 1
			 			column = 1   
						width = medium
					)
					Notes
					(
		    			type = textarea
						height = 100px
			 			row = 1
			 			column = 2   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
