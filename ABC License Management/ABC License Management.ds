							update
							(
		   						type = submit
		   						displayname = "Update Violation"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}
	}

	reports
	{
		list Active_Agents
		{
		
					displayName = "Active Agents"
					show all rows from Add_Agents  [Active == true]  
					(
						Agent_Number as "Agent Number"
						Agent_Name.first_name as "Agent First Name"
						Agent_Name.last_name as "Agent Last Name"
						Agent_Email as "Agent Email"
						Phone
						(
							displayformat = formattednumber 
						)
						Agent_Role as "Agent Role"
						Active
					)
					filters
					(
						Agent_Email
						Agent_Role
						Active
					)
					sort by
					(
						Agent_Email ascending
					)
				
		}

		default list All_Agents
		{
		
					displayName = "All Agents"
					show all rows from Add_Agents    
					(
						Agent_Number as "Agent Number"
						Agent_Name.first_name as "Agent First Name"
						Agent_Name.last_name as "Agent Last Name"
						Agent_Email as "Agent Email"
						Phone
						(
							displayformat = formattednumber 
						)
						Agent_Role as "Agent Role"
						Supervisor
						Active
						Notes
					)
					filters
					(
						Agent_Email
						Agent_Role
						Active
						"Active Only"  :  Active == true
					)
					sort by
					(
						Agent_Email ascending
					)
				
		}

		list Enforcement_Agents
		{
		
					displayName = "Enforcement Agents"
					show all rows from Add_Agents  [Agent_Role == "Enforcement Agent" || Agent_Role == "Enforcement Supervisor"]  
