ttom:1px solid #eef1f6;background:#fbfcff}.lsup-card-title{display:flex;gap:12px;align-items:flex-start}.lsup-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.lsup-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.lsup-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.lsup-card-body{padding:18px}.lsup-queue-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.lsup-queue{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;min-height:126px;display:flex;flex-direction:column;gap:10px}.lsup-queue.hot{border-color:rgba(250,174,19,.45);background:linear-gradient(180deg,#fff,#fffbeb)}.lsup-queue-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.lsup-queue h4{font-size:14px;margin:0;color:#111827}.lsup-queue-value{font-size:26px;font-weight:850;line-height:1;color:#111827}.lsup-queue-copy{font-size:12px;color:#64748b;line-height:1.45;margin:0}.lsup-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:750;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.lsup-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb);margin-right:10px}.lsup-link:hover{text-decoration:underline}.lsup-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.lsup-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.lsup-table-wrap{max-height:520px;overflow:auto}.lsup-table-wrap table{min-width:980px}.lsup-staff-table table{min-width:760px}.lsup-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.lsup-action{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:10px}.lsup-action.top{border-color:rgba(250,174,19,.45);background:linear-gradient(180deg,#fff,#fffbeb)}.lsup-action-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.lsup-action-title h4{font-size:15px;margin:0;color:#111827}.lsup-action-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.lsup-action-links{display:flex;flex-wrap:wrap;gap:4px;margin-top:auto}.lsup-report-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.lsup-report{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;gap:12px;align-items:flex-start}.lsup-report-icon{width:36px;height:36px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto}.lsup-report h4{font-size:14px;margin:0 0 4px;color:#111827}.lsup-report p{font-size:12px;color:#64748b;line-height:1.45;margin:0}.lsup-progress{height:8px;background:#edf2f7;border-radius:8px;overflow:hidden}.lsup-progress span{display:block;height:100%;border-radius:inherit;background:var(--bar,#2563eb)}.lsup-foot-space{height:10px}@media(max-width:1280px){.lsup-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.lsup-queue-grid,.lsup-report-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.lsup-hero-grid,.lsup-grid-two{grid-template-columns:1fr}}@media(max-width:780px){.lsup{padding:14px}.lsup-header,.lsup-card-head{flex-direction:column;align-items:flex-start}.lsup-hero{padding:22px;border-radius:20px}.lsup-kpis,.lsup-queue-grid,.lsup-report-grid,.lsup-action-grid{grid-template-columns:1fr}.lsup-kv-grid{grid-template-columns:1fr}.lsup-section-title{align-items:flex-start;flex-direction:column}.lsup-hero-actions .zcs-button{width:100%}}\n&lt;/style&gt;\n&lt;div class=&quot;lsup&quot;&gt;\n\t&lt;div class=&quot;lsup-shell&quot;&gt;\n\t\t&lt;div class=&quot;zcs-page-header lsup-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lsup-head-icon zcs-no-shrink&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Licensing Supervisor Action Center&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;lsup-subtitle zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;Approvals, escalations, queue oversight, issuance monitoring, and renewal/payment bottlenecks for &lt;%=supervisorEmail%&gt;&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open staff queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Application_Status_Board?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Status board&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&quot;lsup-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;lsup-hero-grid&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;span class=&quot;lsup-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-dashboard-29&quot;&gt;&lt;/i&gt; Supervisor command view&lt;/span&gt;\n\t\t\t\t\t&lt;h1&gt;Act on licensing bottlenecks from one page&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;This command center aggregates all application queues, approval-ready files, request-info and rejected items, active holds, staff workload distribution, approved applications awaiting license issuance, and renewal/payment bottlenecks. Use the linked reports for action-enabled row buttons.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;lsup-hero-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Approved_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Issue licenses&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Renewal payments&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Pending payments&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Active_Holds?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Active holds&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;aside class=&quot;lsup-command&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-avatar&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-common&quot;&gt;\n\t\t\t\t\t\t\t&lt;h2&gt;Supervisor oversight&lt;/h2&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;lsup-command-line&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=supervisorEmail%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;lsup-command-line&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=bottleneckTotal%&gt; active bottleneck signals&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;lsup-kv-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-kv&quot;&gt;&lt;span&gt;Open application load&lt;/span&gt;&lt;strong&gt;&lt;%=allOpenAppCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-kv&quot;&gt;&lt;span&gt;Staff roster&lt;/span&gt;&lt;strong&gt;&lt;%=staffCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-kv&quot;&gt;&lt;span&gt;Unassigned work&lt;/span&gt;&lt;strong&gt;&lt;%=unassignedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-kv&quot;&gt;&lt;span&gt;Payment bottlenecks&lt;/span&gt;&lt;strong&gt;&lt;%=paymentBottleneckCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;lsup-section-title&quot;&gt;&lt;h2&gt;KPI snapshot&lt;/h2&gt;&lt;span class=&quot;lsup-section-sub&quot;&gt;Counts are supervisor-wide across licensing operations.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;lsup-kpis&quot;&gt;\n\t\t\t&lt;div class=&quot;lsup-kpi&quot; style=&quot;--tone:#2a6ffc;--soft:#e8efff;&quot;&gt;&lt;div class=&quot;lsup-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-value&quot;&gt;&lt;%=submittedCount + inProgressCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-label&quot;&gt;Submitted and in progress&lt;/div&gt;&lt;div class=&quot;lsup-kpi-note&quot;&gt;Intake and active review queues&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsup-kpi&quot; style=&quot;--tone:#b8770d;--soft:#fcf4e6;&quot;&gt;&lt;div class=&quot;lsup-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-value&quot;&gt;&lt;%=readyApprovalCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-label&quot;&gt;Approvals pending&lt;/div&gt;&lt;div class=&quot;lsup-kpi-note&quot;&gt;Ready for Approval status&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsup-kpi&quot; style=&quot;--tone:#f4660c;--soft:#f8f0eb;&quot;&gt;&lt;div class=&quot;lsup-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-value&quot;&gt;&lt;%=holdCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-label&quot;&gt;Active holds&lt;/div&gt;&lt;div class=&quot;lsup-kpi-note&quot;&gt;Unreleased hold records&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsup-kpi&quot; style=&quot;--tone:#fe455d;--soft:#fde3e6;&quot;&gt;&lt;div class=&quot;lsup-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-remove&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-value&quot;&gt;&lt;%=rejectedCount + requestInfoCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-label&quot;&gt;Rejected and request-info&lt;/div&gt;&lt;div class=&quot;lsup-kpi-note&quot;&gt;Rejected plus on-hold information requests&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsup-kpi&quot; style=&quot;--tone:#179e6c;--soft:#e4fcf3;&quot;&gt;&lt;div class=&quot;lsup-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-value&quot;&gt;&lt;%=approvedIssueCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-label&quot;&gt;Approved awaiting license&lt;/div&gt;&lt;div class=&quot;lsup-kpi-note&quot;&gt;Approved, no issued license link&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsup-kpi&quot; style=&quot;--tone:#09598e;--soft:#e4f6fd;&quot;&gt;&lt;div class=&quot;lsup-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-value&quot;&gt;&lt;%=paymentBottleneckCount%&gt;&lt;/div&gt;&lt;div class=&quot;lsup-kpi-label&quot;&gt;Renewal/payment bottlenecks&lt;/div&gt;&lt;div class=&quot;lsup-kpi-note&quot;&gt;Renewals, payments, refunds, reconciliation&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;lsup-grid-two&quot;&gt;\n\t\t\t&lt;div class=&quot;lsup-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lsup-card-head&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;lsup-card-title&quot;&gt;&lt;div class=&quot;lsup-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;All application queues&lt;/h3&gt;&lt;p&gt;Status queue oversight with direct links to action-enabled reports and board views.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=attentionBadge%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline &lt;%=attentionIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=attentionLabel%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lsup-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;lsup-queue-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-queue &lt;%=if(submittedCount &gt; 0,&quot;hot&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-queue-top&quot;&gt;&lt;h4&gt;Submitted&lt;/h4&gt;&lt;span class=&quot;lsup-chip chip-info&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;%=submittedCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsup-queue-value&quot;&gt;&lt;%=submittedCount%&gt;&lt;/div&gt;&lt;p class=&quot;lsup-queue-copy&quot;&gt;Verify intake, assign review, or request info.&lt;/p&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:New_License_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;New queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-queue &lt;%=if(inProgressCount &gt; 0,&quot;hot&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-queue-top&quot;&gt;&lt;h4&gt;In progress&lt;/h4&gt;&lt;span class=&quot;lsup-chip chip-theme&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;%=inProgressCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsup-queue-value&quot;&gt;&lt;%=inProgressCount%&gt;&lt;/div&gt;&lt;p class=&quot;lsup-queue-copy&quot;&gt;Active staff review and escalation queue.&lt;/p&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Staff queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-queue &lt;%=if(readyApprovalCount &gt; 0,&quot;hot&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-queue-top&quot;&gt;&lt;h4&gt;Ready for Approval&lt;/h4&gt;&lt;span class=&quot;lsup-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;%=readyApprovalCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsup-queue-value&quot;&gt;&lt;%=readyApprovalCount%&gt;&lt;/div&gt;&lt;p class=&quot;lsup-queue-copy&quot;&gt;Supervisor approvals pending action.&lt;/p&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Approve or reject&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-queue &lt;%=if(onHoldCount &gt; 0,&quot;hot&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-queue-top&quot;&gt;&lt;h4&gt;On hold&lt;/h4&gt;&lt;span class=&quot;lsup-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;&lt;%=onHoldCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsup-queue-value&quot;&gt;&lt;%=onHoldCount%&gt;&lt;/div&gt;&lt;p class=&quot;lsup-queue-copy&quot;&gt;Hold release and request-info follow-up.&lt;/p&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Active_Holds?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;Hold report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-queue &lt;%=if(approvedIssueCount &gt; 0,&quot;hot&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-queue-top&quot;&gt;&lt;h4&gt;Approved&lt;/h4&gt;&lt;span class=&quot;lsup-chip chip-ok&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;%=approvedCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsup-queue-value&quot;&gt;&lt;%=approvedIssueCount%&gt;&lt;/div&gt;&lt;p class=&quot;lsup-queue-copy&quot;&gt;Approved records waiting for license issuance.&lt;/p&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Approved_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;Issue license&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-queue &lt;%=if(rejectedCount &gt; 0,&quot;hot&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-queue-top&quot;&gt;&lt;h4&gt;Rejected&lt;/h4&gt;&lt;span class=&quot;lsup-chip chip-bad&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-remove&quot;&gt;&lt;/i&gt;&lt;%=rejectedCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsup-queue-value&quot;&gt;&lt;%=rejectedCount%&gt;&lt;/div&gt;&lt;p class=&quot;lsup-queue-copy&quot;&gt;Review rejection trends and supervisor escalations.&lt;/p&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:All_Applications?Application_Status=Rejected&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Rejected items&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-queue &lt;%=if(unassignedCount &gt; 0,&quot;hot&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-queue-top&quot;&gt;&lt;h4&gt;Unassigned&lt;/h4&gt;&lt;span class=&quot;lsup-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;%=unassignedCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsup-queue-value&quot;&gt;&lt;%=unassignedCount%&gt;&lt;/div&gt;&lt;p class=&quot;lsup-queue-copy&quot;&gt;Submitted, in-progress, or approval-ready without a rep.&lt;/p&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:All_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;Assign review&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-queue&quot;&gt;&lt;div class=&quot;lsup-queue-top&quot;&gt;&lt;h4&gt;License issued&lt;/h4&gt;&lt;span class=&quot;lsup-chip chip-ok&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;%=licenseIssuedCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;lsup-queue-value&quot;&gt;&lt;%=licenseIssuedCount%&gt;&lt;/div&gt;&lt;p class=&quot;lsup-queue-copy&quot;&gt;Completed issuance records for trend monitoring.&lt;/p&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Application_Status_Board?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;Status board&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;lsup-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lsup-card-head&quot;&gt;&lt;div class=&quot;lsup-card-title&quot;&gt;&lt;div class=&quot;lsup-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Assigned staff workload&lt;/h3&gt;&lt;p&gt;Open workload by active Licensing Staff agents. Use this to rebalance assignments and escalations.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsup-chip chip-theme&quot;&gt;&lt;%=staffCount%&gt; staff&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lsup-card-body&quot;&gt;\n&lt;%\n\tif(staffRoster.count() == 0)\n\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;lsup-empty&quot;&gt;&lt;div class=&quot;lsup-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No active Licensing Staff agents were found in Add Agents.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper lsup-table-wrap lsup-staff-table zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Staff&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Open&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Approval&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Holds&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Issue&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Load&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tstaffRows = 0;\n\t\tfor each staff in staffRoster\n\t\t{\n\t\t\tif(staffRows &lt; 12)\n\t\t\t{\n\t\t\t\tstaffEmail = ifnull(staff.Agent_Email,&quot;&quot;);\n\t\t\t\tstaffName = ifnull(staff.Agent_Name.first_name,&quot;&quot;);\n\t\t\t\tif(ifnull(staff.Agent_Name.last_name,&quot;&quot;) != &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tstaffName = staffName + &quot; &quot; + staff.Agent_Name.last_name;\n\t\t\t\t}\n\t\t\t\tif(staffName == &quot;&quot; || staffName == null)\n\t\t\t\t{\n\t\t\t\t\tstaffName = staffEmail;\n\t\t\t\t}\n\t\t\t\tstaffOpen = Applications[Assigned_Licensing_Rep == staffEmail &amp;&amp; (Application_Status == &quot;Submitted&quot; || Application_Status == &quot;In-progress&quot; || Application_Status == &quot;Ready for Approval&quot; || Application_Status == &quot;On-hold&quot; || Application_Status == &quot;Approved&quot;)].count();\n\t\t\t\tstaffApproval = Applications[Assigned_Licensing_Rep == staffEmail &amp;&amp; Application_Status == &quot;Ready for Approval&quot;].count();\n\t\t\t\tstaffHolds = Applications[Assigned_Licensing_Rep == staffEmail &amp;&amp; Application_Status == &quot;On-hold&quot;].count();\n\t\t\t\tstaffIssue = Applications[Assigned_Licensing_Rep == staffEmail &amp;&amp; Application_Status == &quot;Approved&quot; &amp;&amp; Issued_License == null].count();\n\t\t\t\tstaffPct = if(staffOpen &gt; 20,100,staffOpen * 5);\n\t\t\t\tbarColor = if(staffOpen &gt; 12,&quot;#f4660c&quot;,if(staffOpen &gt; 6,&quot;#faae13&quot;,&quot;#179e6c&quot;));\n%&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=staffName%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=staffEmail%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=staffOpen%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=staffApproval%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=staffHolds%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=staffIssue%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;div class=&quot;lsup-progress&quot;&gt;&lt;span style=&quot;width:&lt;%=staffPct%&gt;%;--bar:&lt;%=barColor%&gt;;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-8&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:All_Applications?Assigned_Licensing_Rep=&lt;%=encodeURL(staffEmail)%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Review&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\tstaffRows = staffRows + 1;\n\t\t}\n%&gt;\n\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;lsup-section-title&quot;&gt;&lt;h2&gt;Pending action tables&lt;/h2&gt;&lt;span class=&quot;lsup-section-sub&quot;&gt;Bottleneck rows link back to reports that host row-level actions.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;lsup-card&quot;&gt;\n\t\t\t&lt;div class=&quot;lsup-card-head&quot;&gt;&lt;div class=&quot;lsup-card-title&quot;&gt;&lt;div class=&quot;lsup-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Priority licensing bottlenecks&lt;/h3&gt;&lt;p&gt;Approvals, holds, request-info follow-ups, rejected items, and approved applications awaiting a license.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:All_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;All applications&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;lsup-card-body&quot;&gt;\n&lt;%\n\tif(readyApproval.count() == 0 &amp;&amp; activeHolds.count() == 0 &amp;&amp; requestInfoApps.count() == 0 &amp;&amp; rejectedApps.count() == 0 &amp;&amp; approvedAwaitingLicense.count() == 0)\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;lsup-empty&quot;&gt;&lt;div class=&quot;lsup-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;No priority licensing bottlenecks are currently open.&lt;/strong&gt;&lt;br&gt;Use the status board for broader operational review.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper lsup-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Bottleneck&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Application&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Applicant / DBA&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Assigned rep&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Next action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tpriorityRows = 0;\n\t\tfor each app in readyApproval\n\t\t{\n\t\t\tif(priorityRows &lt; 6)\n\t\t\t{\n\t\t\t\tappNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,&quot;Application&quot;));\n\t\t\t\tappTitle = ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,&quot;Applicant&quot;));\n\t\t\t\trep = ifnull(app.Assigned_Licensing_Rep,&quot;Unassigned&quot;);\n%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsup-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;Approval pending&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appTitle%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=rep%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Staff_Application_Queue?ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Approve or reject&lt;/a&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Form:Applications?recLinkID=&lt;%=app.ID%&gt;&amp;amp;viewLinkName=All_Applications&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Record&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\tpriorityRows = priorityRows + 1;\n\t\t}\n\t\tfor each hold in activeHolds\n\t\t{\n\t\t\tif(priorityRows &lt; 12)\n\t\t\t{\n\t\t\t\tappNo = ifnull(hold.Application.Application_Number,ifnull(hold.Application.Application_Reference,&quot;Application&quot;));\n\t\t\t\tappTitle = ifnull(hold.Application.Business_DBA_Name,ifnull(hold.Application.Applicant_Profile.Profile_Name,&quot;Applicant&quot;));\n\t\t\t\trep = ifnull(hold.Application.Assigned_Licensing_Rep,&quot;Unassigned&quot;);\n%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsup-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;&lt;%=ifnull(hold.Hold_Type,&quot;Hold&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appTitle%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=rep%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Active_Holds?ID=&lt;%=hold.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;View hold&lt;/a&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Staff_Application_Queue?ID=&lt;%=hold.Application%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-unlocked&quot;&gt;&lt;/i&gt;Release action&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\tpriorityRows = priorityRows + 1;\n\t\t}\n\t\tfor each app in requestInfoApps\n\t\t{\n\t\t\tif(priorityRows &lt; 16)\n\t\t\t{\n\t\t\t\tappNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,&quot;Application&quot;));\n\t\t\t\tappTitle = ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,&quot;Applicant&quot;));\n\t\t\t\trep = ifnull(app.Assigned_Licensing_Rep,&quot;Unassigned&quot;);\n%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsup-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;Request info&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appTitle%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=rep%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Staff_Application_Queue?ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;Follow up&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\tpriorityRows = priorityRows + 1;\n\t\t}\n\t\tfor each app in approvedAwaitingLicense\n\t\t{\n\t\t\tif(priorityRows &lt; 20)\n\t\t\t{\n\t\t\t\tappNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,&quot;Application&quot;));\n\t\t\t\tappTitle = ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,&quot;Applicant&quot;));\n\t\t\t\trep = ifnull(app.Assigned_Licensing_Rep,&quot;Unassigned&quot;);\n%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;lsup-chip chip-ok&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;Issue license&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appTitle%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=rep%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Approved_Applications?ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;Issue License&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\tpriorityRows = priorityRows + 1;\n\t\t}\n%&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;lsup-grid-two&quot;&gt;\n\t\t\t&lt;div class=&quot;lsup-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lsup-card-head&quot;&gt;&lt;div class=&quot;lsup-card-title&quot;&gt;&lt;div class=&quot;lsup-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Renewal and payment bottlenecks&lt;/h3&gt;&lt;p&gt;Financial and renewal queues that can prevent license issuance or renewal completion.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsup-chip &lt;%=if(paymentBottleneckCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=paymentBottleneckCount%&gt; bottlenecks&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lsup-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;lsup-action-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-action &lt;%=if(renewalPaymentCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-action-title&quot;&gt;&lt;h4&gt;Renewal payment queue&lt;/h4&gt;&lt;span class=&quot;lsup-chip &lt;%=if(renewalPaymentCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;%=renewalPaymentCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsup-action-copy&quot;&gt;Renewal batches with pending payment. Amount due flagged: $&lt;%=renewalAmountDue%&gt;.&lt;/p&gt;&lt;div class=&quot;lsup-action-links&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;Mark paid or complete&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-action &lt;%=if(pendingPaymentCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-action-title&quot;&gt;&lt;h4&gt;Pending payments&lt;/h4&gt;&lt;span class=&quot;lsup-chip &lt;%=if(pendingPaymentCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;%=pendingPaymentCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsup-action-copy&quot;&gt;Payment records pending or failed with amount due. Amount due: $&lt;%=paymentAmountDue%&gt;.&lt;/p&gt;&lt;div class=&quot;lsup-action-links&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Mark paid&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-action &lt;%=if(refundCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-action-title&quot;&gt;&lt;h4&gt;Refund queue&lt;/h4&gt;&lt;span class=&quot;lsup-chip &lt;%=if(refundCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;%=refundCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsup-action-copy&quot;&gt;Refund requests awaiting approval, rejection, or completion.&lt;/p&gt;&lt;div class=&quot;lsup-action-links&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Refund_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Review refunds&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-action &lt;%=if(reconCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-action-title&quot;&gt;&lt;h4&gt;Daily reconciliation&lt;/h4&gt;&lt;span class=&quot;lsup-chip &lt;%=if(reconCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;%=reconCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsup-action-copy&quot;&gt;Completed, refunded, or void payments still unreconciled.&lt;/p&gt;&lt;div class=&quot;lsup-action-links&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Daily_Reconciliation?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Reconcile&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;lsup-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;lsup-card-head&quot;&gt;&lt;div class=&quot;lsup-card-title&quot;&gt;&lt;div class=&quot;lsup-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-flag-diagonal-33&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Escalation oversight&lt;/h3&gt;&lt;p&gt;Investigator flags, request-info records, rejected records, and unassigned work requiring supervisor coordination.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lsup-chip &lt;%=if(flagCount + requestInfoCount + rejectedCount + unassignedCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=flagCount + requestInfoCount + rejectedCount + unassignedCount%&gt; signals&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;lsup-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;lsup-action-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-action &lt;%=if(flagCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-action-title&quot;&gt;&lt;h4&gt;Investigator flags&lt;/h4&gt;&lt;span class=&quot;lsup-chip &lt;%=if(flagCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=flagCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsup-action-copy&quot;&gt;Applications with investigator review flag enabled.&lt;/p&gt;&lt;div class=&quot;lsup-action-links&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Investigator_Review_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-flag-diagonal-33&quot;&gt;&lt;/i&gt;Investigator queue&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-action &lt;%=if(requestInfoCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-action-title&quot;&gt;&lt;h4&gt;Request info&lt;/h4&gt;&lt;span class=&quot;lsup-chip &lt;%=if(requestInfoCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=requestInfoCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsup-action-copy&quot;&gt;On-hold applications whose tracking note indicates information was requested.&lt;/p&gt;&lt;div class=&quot;lsup-action-links&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;Follow up&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-action &lt;%=if(rejectedCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-action-title&quot;&gt;&lt;h4&gt;Rejected items&lt;/h4&gt;&lt;span class=&quot;lsup-chip &lt;%=if(rejectedCount &gt; 0,&quot;chip-bad&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=rejectedCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsup-action-copy&quot;&gt;Rejected applications to monitor for appeal, correction, or trend review.&lt;/p&gt;&lt;div class=&quot;lsup-action-links&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:All_Applications?Application_Status=Rejected&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Rejected report&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;lsup-action &lt;%=if(unassignedCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;lsup-action-title&quot;&gt;&lt;h4&gt;Unassigned queue&lt;/h4&gt;&lt;span class=&quot;lsup-chip &lt;%=if(unassignedCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=unassignedCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;lsup-action-copy&quot;&gt;Submitted, in-progress, and approval-ready records without Assigned Licensing Rep.&lt;/p&gt;&lt;div class=&quot;lsup-action-links&quot;&gt;&lt;a class=&quot;lsup-link&quot; href=&quot;#Report:All_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;Assign ownership&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;lsup-section-title&quot;&gt;&lt;h2&gt;Action-enabled report shortcuts&lt;/h2&gt;&lt;span class=&quot;lsup-section-sub&quot;&gt;Every queue and referenced report is reachable from these links.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;lsup-report-grid&quot;&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;Staff Application Queue&lt;/h4&gt;&lt;p&gt;Verify Intake, Request Info, Place Hold, Release Hold, Assign Review, Approve, Reject.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:New_License_Application_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;New License Queue&lt;/h4&gt;&lt;p&gt;Submitted and active new-license workflow.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:Approved_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;Approved Applications&lt;/h4&gt;&lt;p&gt;Issue License action for approved records without a linked license.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:Application_Status_Board?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;Application Status Board&lt;/h4&gt;&lt;p&gt;Supervisor-wide application status oversight.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:Investigator_Review_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-flag-diagonal-33&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;Investigator Review Queue&lt;/h4&gt;&lt;p&gt;Flags and escalations needing investigative coordination.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:Active_Holds?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-locked&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;Active Holds&lt;/h4&gt;&lt;p&gt;Open application hold records and release oversight.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;Renewal Payment Queue&lt;/h4&gt;&lt;p&gt;Mark Renewal Paid, Complete Renewal, and Cancel Renewal.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;Pending Payments&lt;/h4&gt;&lt;p&gt;Mark Paid action for pending or failed payment records.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:Refund_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;Refund Queue&lt;/h4&gt;&lt;p&gt;Approve Refund and Reject Refund actions.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:Daily_Reconciliation?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;Daily Reconciliation&lt;/h4&gt;&lt;p&gt;Reconcile payment action and payment audit oversight.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:All_Renewal_Batches?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;All Renewal Batches&lt;/h4&gt;&lt;p&gt;Supervisor review of renewal lifecycle bottlenecks.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;lsup-report&quot; href=&quot;#Report:All_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;span class=&quot;lsup-report-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;h4&gt;All Applications&lt;/h4&gt;&lt;p&gt;Full application search and assignment oversight.&lt;/p&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;div class=&quot;lsup-foot-space&quot;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page OLS_Attorney_Action_Center
		{
					displayname = "OLS Attorney Action Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='OLS_Attorney_Action_Center_Final_Dsp' elementName='OLS_Attorney_Action_Center_Content'>\n\t\t\t\t\t<![CDATA[htmlpage OLS_Attorney_Action_Center_Final_Dsp()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\ncurrentUser = zoho.loginuserid;\nif(currentUser == null)\n{\n\tcurrentUser = &quot;&quot;;\n}\nassignedCount = Cases[OLS_Assigned_Attorney_Email == currentUser].count();\nreferredCount = Cases[Case_Status == &quot;Referred to OLS&quot;].count();\nlegalReviewCount = Cases[Case_Status == &quot;Legal Review&quot;].count();\nhearingStatusCount = Cases[Case_Status == &quot;Hearing Status&quot;].count();\npendingReviewCount = Cases[Legal_Review_Status == &quot;Pending OLS Review&quot;].count();\naccusationCount = Cases[Legal_Review_Status == &quot;Accusation Drafted&quot;].count();\nhearingScheduledCount = Cases[Legal_Review_Status == &quot;Hearing Scheduled&quot;].count();\nhearingHeldCount = Cases[Legal_Review_Status == &quot;Hearing Held&quot;].count();\nproposedDecisionCount = Cases[Legal_Review_Status == &quot;Proposed Decision&quot;].count();\ndirectorActionCount = Cases[Legal_Review_Status == &quot;Director Action&quot;].count();\nappealStatusCount = Cases[Legal_Review_Status == &quot;Appeal Status&quot;].count();\nhearingCount = hearingScheduledCount + hearingHeldCount + hearingStatusCount;\ndecisionCount = proposedDecisionCount + directorActionCount + appealStatusCount;\nopenLegalCount = referredCount + legalReviewCount + hearingStatusCount;\ndraftDocCount = Correspondence[Module == &quot;Enforcement&quot; &amp;&amp; Merge_Status == &quot;Draft&quot;].count();\nfailedDocCount = Correspondence[Module == &quot;Enforcement&quot; &amp;&amp; Merge_Status == &quot;Failed&quot;].count();\nreadyMergeDocCount = Correspondence[Module == &quot;Enforcement&quot; &amp;&amp; Merge_Status == &quot;Ready for Manual Merge&quot;].count();\npendingSignCount = Correspondence[Module == &quot;Enforcement&quot; &amp;&amp; Sign_Status == &quot;Pending Manual Sign&quot;].count();\ndocumentActionCount = draftDocCount + failedDocCount + readyMergeDocCount + pendingSignCount;\ntotalQueueCount = openLegalCount + pendingReviewCount + accusationCount + hearingCount + decisionCount + documentActionCount;\nscopeLabel = &quot;Full legal queue&quot;;\nif(assignedCount &gt; 0)\n{\n\tscopeLabel = &quot;My assigned legal queue&quot;;\n}\n%&gt;\n&lt;style&gt;\n:root{--ols-brand:var(--zcs_brand_color,#2563eb);--ols-light:var(--zcs_brand_light_color,#eef4ff);--ols-text:var(--zcs_primary_text_color,#111827);--ols-muted:var(--zcs_secondary_text_color,#64748b);--ols-border:#e7e7ee}.ols-page,.ols-page *{box-sizing:border-box}.ols-page{min-height:100%;padding:28px;background:linear-gradient(180deg,#f8fbff 0%,#f4f6fb 70%,#fff 100%);font-family:Inter,Arial,sans-serif;color:var(--ols-text)}.ols-shell{max-width:1480px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.ols-hero{border-radius:26px;padding:28px;background:linear-gradient(135deg,#0f2748 0%,var(--ols-brand) 65%,#0f766e 130%);color:#fff;box-shadow:0 24px 58px rgba(37,99,235,.18)}.ols-hero-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr);gap:22px;align-items:center}.ols-eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.14);border-radius:999px;padding:7px 12px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}.ols-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.05;margin:14px 0 10px;color:#fff}.ols-hero p{max-width:850px;margin:0;color:rgba(255,255,255,.86);font-size:15px;line-height:1.6}.ols-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.ols-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:9px 14px;border-radius:8px;font-size:14px;text-decoration:none;border:1px solid rgba(255,255,255,.45);color:#fff;background:rgba(255,255,255,.14)}.ols-btn.primary{background:#fff;color:var(--ols-brand);border-color:#fff}.ols-profile{border:1px solid rgba(255,255,255,.24);background:rgba(255,255,255,.12);border-radius:18px;padding:18px}.ols-profile-line{display:flex;align-items:center;gap:8px;margin-top:7px;color:rgba(255,255,255,.85);font-size:13px}.ols-kv-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.ols-kv{border:1px solid rgba(255,255,255,.18);border-radius:12px;padding:10px;background:rgba(255,255,255,.08)}.ols-kv span{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:rgba(255,255,255,.64)}.ols-kv strong{display:block;margin-top:4px;font-size:15px;color:#fff}.ols-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:4px 2px -4px}.ols-section-title h2{margin:0;font-size:11px;text-transform:uppercase;letter-spacing:1.1px;color:#8a94a6}.ols-section-title span{font-size:12px;color:#8a94a6}.ols-grid{display:grid;gap:14px}.ols-kpis{grid-template-columns:repeat(6,minmax(0,1fr))}.ols-card{background:#fff;border:1px solid var(--ols-border);border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.ols-kpi{min-height:144px;padding:18px}.ols-kpi-icon{width:42px;height:42px;border-radius:14px;background:var(--tone-soft);color:var(--tone);display:flex;align-items:center;justify-content:center;font-size:21px}.ols-kpi-value{margin-top:14px;font-size:31px;line-height:1;font-weight:800;color:#111827}.ols-kpi-label{margin-top:5px;font-size:12px;font-weight:650;color:#64748b}.ols-kpi-note{margin-top:6px;font-size:11px;color:#8a94a6}.ols-two{grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr)}.ols-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.ols-card-head h3{font-size:17px;margin:0;color:#111827}.ols-card-head p{font-size:12px;line-height:1.5;color:#64748b;margin:4px 0 0}.ols-card-body{padding:18px}.ols-mini-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.ols-mini{border:1px solid #e9edf5;border-radius:14px;padding:14px;background:#fff}.ols-mini strong{font-size:26px;display:block;color:#111827}.ols-mini span{font-size:12px;color:#64748b}.ols-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:5px 10px;font-size:12px;font-weight:700;border:1px solid transparent;text-decoration:none}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-theme{background:var(--ols-light);color:var(--ols-brand);border-color:rgba(37,99,235,.22)}.ols-links{display:flex;flex-direction:column;gap:10px}.ols-link-card{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid #e9edf5;border-radius:14px;background:#fff;padding:13px 14px;text-decoration:none;color:#111827}.ols-link-card:hover{border-color:var(--ols-brand);background:var(--ols-light)}.ols-link-card small{display:block;margin-top:3px;color:#64748b}.ols-table-wrap{overflow:auto;border:1px solid var(--ols-border);border-radius:12px}.ols-table{width:100%;border-collapse:collapse;min-width:720px;background:#fff}.ols-table th{background:#f9fafe;text-align:left;font-size:13px;color:#111827;padding:10px 12px;border-bottom:1px solid var(--ols-border)}.ols-table td{font-size:13px;color:#334155;padding:10px 12px;border-top:1px solid #eef1f6;vertical-align:top}.ols-report-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ols-embed{min-height:420px;border:1px dashed #d7deea;border-radius:12px;background:#fff;overflow:hidden}.ols-foot-space{height:12px}@media(max-width:1180px){.ols-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.ols-hero-grid,.ols-two,.ols-report-grid{grid-template-columns:1fr}}@media(max-width:720px){.ols-page{padding:14px}.ols-kpis,.ols-mini-grid{grid-template-columns:1fr}.ols-card-head,.ols-section-title{flex-direction:column;align-items:flex-start}.ols-actions .ols-btn{width:100%}}\n&lt;/style&gt;\n&lt;div class=&quot;ols-page&quot;&gt;\n\t&lt;div class=&quot;ols-shell&quot;&gt;\n\t\t&lt;section class=&quot;ols-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;ols-hero-grid&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;ols-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline business-law&quot;&gt;&lt;/i&gt;&lt;span&gt;OLS legal workspace&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;h1&gt;OLS Attorney Action Center&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Review legal matters, monitor accusation and hearing stages, and open the legal and correspondence reports from one focused workspace.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;ols-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;ols-btn primary&quot; href=&quot;#Report:Legal_Review_View?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span&gt;Open legal review&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;ols-btn&quot; href=&quot;#Report:Pending_Correspondence?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span&gt;Open pending correspondence&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;ols-btn&quot; href=&quot;#Report:Enforcement_Documents?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-copy-04&quot;&gt;&lt;/i&gt;&lt;span&gt;Open enforcement documents&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;aside class=&quot;ols-profile&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ols-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=scopeLabel%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ols-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=currentUser%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ols-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=totalQueueCount%&gt; legal and document signals&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ols-kv-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ols-kv&quot;&gt;&lt;span&gt;Assigned to me&lt;/span&gt;&lt;strong&gt;&lt;%=assignedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ols-kv&quot;&gt;&lt;span&gt;Open legal cases&lt;/span&gt;&lt;strong&gt;&lt;%=openLegalCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ols-kv&quot;&gt;&lt;span&gt;Document actions&lt;/span&gt;&lt;strong&gt;&lt;%=documentActionCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ols-kv&quot;&gt;&lt;span&gt;Hearings&lt;/span&gt;&lt;strong&gt;&lt;%=hearingCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;ols-section-title&quot;&gt;&lt;h2&gt;Legal review snapshot&lt;/h2&gt;&lt;span&gt;Counts use simple direct criteria for upload safety.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;ols-grid ols-kpis&quot;&gt;\n\t\t\t&lt;div class=&quot;ols-card ols-kpi&quot; style=&quot;--tone:#2a6ffc;--tone-soft:#e8efff;&quot;&gt;&lt;div class=&quot;ols-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-value&quot;&gt;&lt;%=assignedCount%&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-label&quot;&gt;Assigned to current user&lt;/div&gt;&lt;div class=&quot;ols-kpi-note&quot;&gt;OLS assigned attorney email&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card ols-kpi&quot; style=&quot;--tone:#b8770d;--tone-soft:#fcf4e6;&quot;&gt;&lt;div class=&quot;ols-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-value&quot;&gt;&lt;%=pendingReviewCount%&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-label&quot;&gt;Pending OLS review&lt;/div&gt;&lt;div class=&quot;ols-kpi-note&quot;&gt;Legal review status&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card ols-kpi&quot; style=&quot;--tone:#7c3aed;--tone-soft:#f1eaff;&quot;&gt;&lt;div class=&quot;ols-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-value&quot;&gt;&lt;%=accusationCount%&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-label&quot;&gt;Accusation drafted&lt;/div&gt;&lt;div class=&quot;ols-kpi-note&quot;&gt;Drafting stage&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card ols-kpi&quot; style=&quot;--tone:#f4660c;--tone-soft:#fff0e4;&quot;&gt;&lt;div class=&quot;ols-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-value&quot;&gt;&lt;%=hearingCount%&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-label&quot;&gt;Hearing work&lt;/div&gt;&lt;div class=&quot;ols-kpi-note&quot;&gt;Hearing status or stage&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card ols-kpi&quot; style=&quot;--tone:#179e6c;--tone-soft:#e4fcf3;&quot;&gt;&lt;div class=&quot;ols-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-value&quot;&gt;&lt;%=decisionCount%&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-label&quot;&gt;Decision or appeal&lt;/div&gt;&lt;div class=&quot;ols-kpi-note&quot;&gt;Post-hearing stages&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card ols-kpi&quot; style=&quot;--tone:#09598e;--tone-soft:#e4f6fd;&quot;&gt;&lt;div class=&quot;ols-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-copy-04&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-value&quot;&gt;&lt;%=documentActionCount%&gt;&lt;/div&gt;&lt;div class=&quot;ols-kpi-label&quot;&gt;Document actions&lt;/div&gt;&lt;div class=&quot;ols-kpi-note&quot;&gt;Merge, failure, or signature work&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;ols-grid ols-two&quot;&gt;\n\t\t\t&lt;div class=&quot;ols-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ols-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Priority legal actions&lt;/h3&gt;&lt;p&gt;Use the linked native reports for row-level actions.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;ols-chip chip-theme&quot;&gt;&lt;%=scopeLabel%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ols-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ols-mini-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ols-mini&quot;&gt;&lt;strong&gt;&lt;%=referredCount%&gt;&lt;/strong&gt;&lt;span&gt;Referred to OLS cases&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ols-mini&quot;&gt;&lt;strong&gt;&lt;%=legalReviewCount%&gt;&lt;/strong&gt;&lt;span&gt;Legal Review status cases&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ols-mini&quot;&gt;&lt;strong&gt;&lt;%=hearingScheduledCount%&gt;&lt;/strong&gt;&lt;span&gt;Hearing scheduled&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ols-mini&quot;&gt;&lt;strong&gt;&lt;%=hearingHeldCount%&gt;&lt;/strong&gt;&lt;span&gt;Hearing held&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ols-table-wrap&quot; style=&quot;margin-top:14px;&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;ols-table&quot;&gt;\n\t\t\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Stage&lt;/th&gt;&lt;th&gt;Count&lt;/th&gt;&lt;th&gt;Primary report&lt;/th&gt;&lt;th&gt;Next action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td&gt;&lt;span class=&quot;ols-chip chip-warn&quot;&gt;Pending review&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;%=pendingReviewCount%&gt;&lt;/td&gt;&lt;td&gt;Legal Review View&lt;/td&gt;&lt;td&gt;Accept review or return for more work&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td&gt;&lt;span class=&quot;ols-chip chip-info&quot;&gt;Accusation draft&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;%=accusationCount%&gt;&lt;/td&gt;&lt;td&gt;Legal Review View&lt;/td&gt;&lt;td&gt;Draft accusation and prepare hearing path&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td&gt;&lt;span class=&quot;ols-chip chip-warn&quot;&gt;Hearing&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;%=hearingCount%&gt;&lt;/td&gt;&lt;td&gt;Legal Review View&lt;/td&gt;&lt;td&gt;Schedule, monitor, or update hearing status&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td&gt;&lt;span class=&quot;ols-chip chip-ok&quot;&gt;Decision or appeal&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;%=decisionCount%&gt;&lt;/td&gt;&lt;td&gt;Legal Review View&lt;/td&gt;&lt;td&gt;Track proposed decision, director action, or appeal&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ols-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Related report shortcuts&lt;/h3&gt;&lt;p&gt;Open the Creator reports that own the legal review and correspondence workflows.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ols-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ols-links&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;ols-link-card&quot; href=&quot;#Report:Legal_Review_View?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span&gt;&lt;strong&gt;Legal Review View&lt;/strong&gt;&lt;small&gt;Legal matters and row-level case actions.&lt;/small&gt;&lt;/span&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;ols-link-card&quot; href=&quot;#Report:Pending_Correspondence?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span&gt;&lt;strong&gt;Pending Correspondence&lt;/strong&gt;&lt;small&gt;Draft, merge, send, and signature follow-up.&lt;/small&gt;&lt;/span&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;ols-link-card&quot; href=&quot;#Report:Enforcement_Documents?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span&gt;&lt;strong&gt;Enforcement Documents&lt;/strong&gt;&lt;small&gt;Document archive and enforcement correspondence.&lt;/small&gt;&lt;/span&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;ols-link-card&quot; href=&quot;#Report:Correspondence_Log?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;span&gt;&lt;strong&gt;Correspondence Log&lt;/strong&gt;&lt;small&gt;Full correspondence history and audit trail.&lt;/small&gt;&lt;/span&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;ols-section-title&quot;&gt;&lt;h2&gt;Document workload&lt;/h2&gt;&lt;span&gt;Enforcement correspondence requiring legal or staff follow-up.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;ols-card&quot;&gt;\n\t\t\t&lt;div class=&quot;ols-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Correspondence and document signals&lt;/h3&gt;&lt;p&gt;These counts use direct status fields only and link to the native reports for processing.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;ols-chip chip-info&quot;&gt;&lt;%=documentActionCount%&gt; open signals&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ols-table-wrap&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;ols-table&quot;&gt;\n\t\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Document signal&lt;/th&gt;&lt;th&gt;Count&lt;/th&gt;&lt;th&gt;Report&lt;/th&gt;&lt;th&gt;Action route&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td&gt;Draft merge&lt;/td&gt;&lt;td&gt;&lt;%=draftDocCount%&gt;&lt;/td&gt;&lt;td&gt;Pending Correspondence&lt;/td&gt;&lt;td&gt;Prepare merge&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td&gt;Failed merge&lt;/td&gt;&lt;td&gt;&lt;%=failedDocCount%&gt;&lt;/td&gt;&lt;td&gt;Pending Correspondence&lt;/td&gt;&lt;td&gt;Review failure and retry manually&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td&gt;Ready for manual merge&lt;/td&gt;&lt;td&gt;&lt;%=readyMergeDocCount%&gt;&lt;/td&gt;&lt;td&gt;Pending Correspondence&lt;/td&gt;&lt;td&gt;Mark generated or sent&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td&gt;Pending manual sign&lt;/td&gt;&lt;td&gt;&lt;%=pendingSignCount%&gt;&lt;/td&gt;&lt;td&gt;Enforcement Documents&lt;/td&gt;&lt;td&gt;Request or confirm signature&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;ols-section-title&quot;&gt;&lt;h2&gt;Embedded action reports&lt;/h2&gt;&lt;span&gt;Native reports remain embedded for search and row actions.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;ols-grid ols-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;ols-card&quot;&gt;&lt;div class=&quot;ols-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Legal Review View&lt;/h3&gt;&lt;p&gt;Use this report for legal review row actions and complete case detail.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;ols-chip chip-theme&quot; href=&quot;#Report:Legal_Review_View?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;ols-card-body&quot;&gt;&lt;div class=&quot;ols-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Legal_Review_View&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card&quot;&gt;&lt;div class=&quot;ols-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Pending Correspondence&lt;/h3&gt;&lt;p&gt;Draft and merge-related correspondence tasks.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;ols-chip chip-theme&quot; href=&quot;#Report:Pending_Correspondence?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;ols-card-body&quot;&gt;&lt;div class=&quot;ols-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Pending_Correspondence&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card&quot;&gt;&lt;div class=&quot;ols-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Enforcement Documents&lt;/h3&gt;&lt;p&gt;Enforcement document status, signature, and archive actions.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;ols-chip chip-theme&quot; href=&quot;#Report:Enforcement_Documents?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;ols-card-body&quot;&gt;&lt;div class=&quot;ols-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Enforcement_Documents&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ols-card&quot;&gt;&lt;div class=&quot;ols-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Correspondence Log&lt;/h3&gt;&lt;p&gt;Full correspondence history for review and audit context.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;ols-chip chip-theme&quot; href=&quot;#Report:Correspondence_Log?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;ols-card-body&quot;&gt;&lt;div class=&quot;ols-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Correspondence_Log&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;div class=&quot;ols-foot-space&quot;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Public_Applicant_Action_Center
		{
					displayname = "Public Applicant Action Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Public_Applicant_Action_Center_Snippet' elementName='Public_Applicant_Action_Center_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Public_Applicant_Action_Center_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\tapplicantEmail = ifnull(zoho.loginuserid,&quot;&quot;);\n\tif(applicantEmail == &quot;&quot; || applicantEmail == null)\n\t{\n\t\tapplicantEmail = &quot;Applicant&quot;;\n\t}\n\tprofileRows = Applicant_Profile[Profile_Email == zoho.loginuserid];\n\tprofileCount = profileRows.count();\n\tprofileName = applicantEmail;\n\tprofilePhone = &quot;Not provided&quot;;\n\tprofileNumber = &quot;Not assigned&quot;;\n\tif(profileCount &gt; 0)\n\t{\n\t\tprofileName = ifnull(profileRows.Profile_Name,applicantEmail);\n\t\tprofilePhone = ifnull(profileRows.Phone,&quot;Not provided&quot;);\n\t\tprofileNumber = ifnull(profileRows.Profile_Number,&quot;Not assigned&quot;);\n\t}\n\n\tdraftApps = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; Application_Status == &quot;Draft&quot;] sort by Added_Time desc;\n\tdraftCount = draftApps.count();\n\tsubmittedCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; Application_Status == &quot;Submitted&quot;].count() + Applications[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; Application_Status == &quot;In-progress&quot;].count() + Applications[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; Application_Status == &quot;Ready for Approval&quot;].count();\n\tholdCount = Application_Holds[Application.Applicant_Email == zoho.loginuserid &amp;&amp; Hold_Released == false].count();\n\tpaymentPendingCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; Payment_Status == &quot;Pending&quot;].count() + Payments[Application.Applicant_Email == zoho.loginuserid &amp;&amp; Payment_Status == &quot;Pending&quot;].count() + Payments[Renewal_Batch.Licensee_Email == zoho.loginuserid &amp;&amp; Payment_Status == &quot;Pending&quot;].count() + Renewal_Batches[Licensee_Email == zoho.loginuserid &amp;&amp; Payment_Status == &quot;Pending&quot;].count();\n\tsignaturePendingCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; Signature_Status == &quot;Pending Manual Sign&quot;].count();\n\trenewalStatusDueCount = Licenses[Licensee_Email == zoho.loginuserid &amp;&amp; License_Status == &quot;Renewal Due&quot;].count() + Licenses[Licensee_Email == zoho.loginuserid &amp;&amp; License_Status == &quot;50% Penalty&quot;].count() + Licenses[Licensee_Email == zoho.loginuserid &amp;&amp; License_Status == &quot;100% Penalty&quot;].count();\n\trenewalSoonCount = Licenses[Licensee_Email == zoho.loginuserid &amp;&amp; Expiration_Date in next 60 days].count();\n\trenewalDueCount = renewalStatusDueCount;\n\tif(renewalSoonCount &gt; renewalDueCount)\n\t{\n\t\trenewalDueCount = renewalSoonCount;\n\t}\n\ttodoTotal = draftCount + holdCount + paymentPendingCount + signaturePendingCount + renewalDueCount;\n\tallAppsCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid].count();\n\tactiveLicenseCount = Licenses[Licensee_Email == zoho.loginuserid &amp;&amp; License_Status == &quot;Active&quot;].count();\n\n\trecentApps = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid] sort by Added_Time desc;\n\tactiveHolds = Application_Holds[Application.Applicant_Email == zoho.loginuserid &amp;&amp; Hold_Released == false] sort by Created_Date desc;\n\tpendingAppPayments = Payments[Application.Applicant_Email == zoho.loginuserid &amp;&amp; Payment_Status == &quot;Pending&quot;] sort by Added_Time desc;\n\tpendingRenewalPayments = Renewal_Batches[Licensee_Email == zoho.loginuserid &amp;&amp; Payment_Status == &quot;Pending&quot;] sort by Added_Time desc;\n\tsignatureApps = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; Signature_Status == &quot;Pending Manual Sign&quot;] sort by Added_Time desc;\n\trenewableLicenses = Licenses[Licensee_Email == zoho.loginuserid &amp;&amp; License_Status == &quot;Renewal Due&quot;] sort by Expiration_Date asc;\n%&gt;\n&lt;style&gt;\n/* ZCS global utility stylesheet included once for this page; component ids used: zcs-global, button-primary-button, badge-badge-with-icon, table-simple-table, quick-actions-card-type-quick-actions, card-fleets-performance-metrics. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#2563eb);--zcs-light-bg-color:var(--zcs_brand_light_color,#eaf2ff);--zcs-page-bg-color:#f5f7fb;--zcs-primary-text-color:var(--zcs_primary_text_color,#111827);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#4b5563);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#8a94a6);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e7eb);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-box-border{box-sizing:border-box}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}.zcs-list-none{list-style-type:none}\n/* ZCS Button, Badge, Table, Quick Action, Progress Bar CSS. */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#2563eb);background:#fff;color:var(--zcs_brand_color,#2563eb)}.zcs-primary-button.zcs-button:hover{background:var(--zcs_brand_dark_color,#1d4ed8)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-filled-outline.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-filled-outline.zcs-badge-grey{background:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-filled-outline.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#f4660c}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background:#f9fafe;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color,#2563eb)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color,#2563eb)}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color,#eff6ff);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color,#2563eb)}\n/* Page-specific layout. */\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.paac{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f7f9ff 0%,#f5f7fb 58%,#fff 100%);min-height:100%;padding:28px;box-sizing:border-box}.paac *{box-sizing:border-box}.paac-shell{max-width:1480px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.paac-hero{position:relative;overflow:hidden;border-radius:28px;padding:30px;background:radial-gradient(circle at 86% 10%,rgba(255,255,255,.28),transparent 28%),radial-gradient(circle at 5% 22%,rgba(20,184,166,.22),transparent 30%),linear-gradient(135deg,#0f2f66 0%,var(--zcs_brand_color,#2563eb) 62%,#14b8a6 126%);color:#fff;box-shadow:0 24px 60px rgba(37,99,235,.2)}.paac-hero:after{content:&quot;&quot;;position:absolute;right:-120px;bottom:-150px;width:360px;height:360px;border-radius:50%;border:1px solid rgba(255,255,255,.22);box-shadow:0 0 0 54px rgba(255,255,255,.08),0 0 0 108px rgba(255,255,255,.04)}.paac-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(330px,.75fr);gap:24px;align-items:center}.paac-eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.15);color:#fff;border-radius:999px;padding:7px 12px;font-size:12px;font-weight:700;letter-spacing:.5px;text-transform:uppercase}.paac-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.03;letter-spacing:-.7px;margin:14px 0 10px;color:#fff}.paac-hero p{max-width:820px;color:rgba(255,255,255,.86);font-size:15px;line-height:1.65;margin:0}.paac-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.paac-hero-actions .zcs-button{box-shadow:0 10px 22px rgba(0,0,0,.14)}.paac-profile{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);border-radius:20px;padding:18px;backdrop-filter:blur(4px)}.paac-avatar{width:58px;height:58px;border-radius:18px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28px}.paac-profile h2{font-size:20px;line-height:1.2;margin:0;color:#fff}.paac-profile-line{font-size:13px;color:rgba(255,255,255,.82);display:flex;align-items:center;gap:8px;margin-top:6px}.paac-profile-kv{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.paac-kv{border:1px solid rgba(255,255,255,.18);border-radius:14px;padding:10px;background:rgba(255,255,255,.08)}.paac-kv span{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.55px;color:rgba(255,255,255,.62)}.paac-kv strong{display:block;font-size:14px;margin-top:4px;color:#fff}.paac-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 4px -2px}.paac-section-title h2{font-size:11px;font-weight:800;color:#8a94a6;text-transform:uppercase;letter-spacing:1.1px;margin:0;display:flex;align-items:center;gap:8px}.paac-section-title h2:before{content:&quot;&quot;;width:4px;height:15px;border-radius:4px;background:linear-gradient(180deg,var(--zcs_brand_color,#2563eb),#14b8a6)}.paac-section-sub{font-size:12px;color:#8a94a6}.paac-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.paac-kpi{position:relative;overflow:hidden;background:#fff;border:1px solid #e9edf5;border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);min-height:150px}.paac-kpi:after{content:&quot;&quot;;position:absolute;right:-42px;top:-42px;width:120px;height:120px;border-radius:50%;background:var(--soft)}.paac-kpi-icon{position:relative;z-index:1;width:42px;height:42px;border-radius:14px;background:var(--soft);color:var(--tone);display:flex;align-items:center;justify-content:center;font-size:21px}.paac-kpi-value{position:relative;z-index:1;font-size:32px;line-height:1;font-weight:800;color:#111827;margin-top:16px;letter-spacing:-.5px}.paac-kpi-label{position:relative;z-index:1;font-size:12px;color:#64748b;margin-top:5px;font-weight:650}.paac-kpi-note{position:relative;z-index:1;font-size:11px;color:#8a94a6;margin-top:6px}.paac-two{display:grid;grid-template-columns:minmax(0,.94fr) minmax(360px,.6fr);gap:14px}.paac-card{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.paac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.paac-card-title{display:flex;gap:12px;align-items:flex-start}.paac-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.paac-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.paac-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.paac-card-body{padding:18px}.paac-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.paac-action{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:12px}.paac-action.top{border-color:rgba(250,174,19,.45);background:linear-gradient(180deg,#fff,#fffbeb)}.paac-action-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.paac-action-title h4{font-size:15px;margin:0;color:#111827}.paac-action-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.paac-action-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.paac-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:750;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.paac-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb)}.paac-link:hover{text-decoration:underline}.paac-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.paac-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.paac-list{display:flex;flex-direction:column;gap:10px}.paac-item{border:1px solid #e9edf5;border-radius:14px;padding:12px;background:#fff}.paac-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.paac-item-title{font-size:14px;font-weight:800;color:#111827}.paac-item-meta{font-size:12px;color:#64748b;margin-top:3px}.paac-item-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.paac-health-list{list-style:none}.paac-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.paac-report-card{overflow:hidden}.paac-report-card.wide{grid-column:1/-1}.paac-embed{border-top:1px solid #eef1f6;background:#fff;padding:8px}.paac-embed-box{min-height:360px;border:1px dashed #d7deea;border-radius:12px;background:#fff;overflow:hidden}.paac-table-wrap{max-height:450px;overflow:auto}.paac-table-wrap table{min-width:860px}.paac-status{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.paac-foot-space{height:12px}@media(max-width:1240px){.paac-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.paac-hero-grid,.paac-two{grid-template-columns:1fr}.paac-action-grid{grid-template-columns:1fr}}@media(max-width:780px){.paac{padding:14px}.paac-hero{padding:22px;border-radius:20px}.paac-kpis,.paac-report-grid{grid-template-columns:1fr}.paac-profile-kv{grid-template-columns:1fr}.paac-section-title{align-items:flex-start;flex-direction:column}.paac-card-head{flex-direction:column}.paac-hero-actions .zcs-button{width:100%}.paac-report-card.wide{grid-column:auto}}\n&lt;/style&gt;\n&lt;div class=&quot;paac&quot;&gt;\n\t&lt;div class=&quot;paac-shell&quot;&gt;\n\t\t&lt;section class=&quot;paac-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;paac-hero-grid&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;span class=&quot;paac-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; Applicant action center&lt;/span&gt;\n\t\t\t\t\t&lt;h1&gt;Your ABC application workspace&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Hello &lt;%=profileName%&gt;. This page highlights your profile, draft and submitted applications, holds, signature tasks, payment items, and renewal deadlines using records tied to &lt;%=applicantEmail%&gt;.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;paac-hero-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Public_Application_Wizard?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Start new application&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open my applications&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Review payment queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;aside class=&quot;paac-profile&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-avatar&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-common&quot;&gt;\n\t\t\t\t\t\t\t&lt;h2&gt;&lt;%=profileName%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;paac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=applicantEmail%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;paac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline tech-mobile-button&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=profilePhone%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;paac-profile-kv&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-kv&quot;&gt;&lt;span&gt;Profile&lt;/span&gt;&lt;strong&gt;&lt;%=if(profileCount &gt; 0,&quot;Ready&quot;,&quot;Missing&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-kv&quot;&gt;&lt;span&gt;Profile No.&lt;/span&gt;&lt;strong&gt;&lt;%=profileNumber%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-kv&quot;&gt;&lt;span&gt;Open tasks&lt;/span&gt;&lt;strong&gt;&lt;%=todoTotal%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-kv&quot;&gt;&lt;span&gt;Licenses&lt;/span&gt;&lt;strong&gt;&lt;%=activeLicenseCount%&gt; active&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;paac-section-title&quot;&gt;&lt;h2&gt;To-do snapshot&lt;/h2&gt;&lt;span class=&quot;paac-section-sub&quot;&gt;Counts are filtered with zoho.loginuserid and applicant or licensee email relationships.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;paac-kpis&quot;&gt;\n\t\t\t&lt;div class=&quot;paac-kpi&quot; style=&quot;--tone:#2a6ffc;--soft:#e8efff;&quot;&gt;&lt;div class=&quot;paac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-value&quot;&gt;&lt;%=draftCount%&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-label&quot;&gt;Draft applications&lt;/div&gt;&lt;div class=&quot;paac-kpi-note&quot;&gt;Continue or start a new wizard draft&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-kpi&quot; style=&quot;--tone:#1094c5;--soft:#e4f6fd;&quot;&gt;&lt;div class=&quot;paac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-value&quot;&gt;&lt;%=submittedCount%&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-label&quot;&gt;Submitted or in progress&lt;/div&gt;&lt;div class=&quot;paac-kpi-note&quot;&gt;Track submitted work&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-kpi&quot; style=&quot;--tone:#b8770d;--soft:#fcf4e6;&quot;&gt;&lt;div class=&quot;paac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-value&quot;&gt;&lt;%=holdCount%&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-label&quot;&gt;Active holds&lt;/div&gt;&lt;div class=&quot;paac-kpi-note&quot;&gt;Resolve staff hold requests&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-kpi&quot; style=&quot;--tone:#f4660c;--soft:#f8f0eb;&quot;&gt;&lt;div class=&quot;paac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-value&quot;&gt;&lt;%=paymentPendingCount%&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-label&quot;&gt;Payment pending&lt;/div&gt;&lt;div class=&quot;paac-kpi-note&quot;&gt;Application or renewal fees&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-kpi&quot; style=&quot;--tone:#7c3aed;--soft:#f1eaff;&quot;&gt;&lt;div class=&quot;paac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline design-pen-23&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-value&quot;&gt;&lt;%=signaturePendingCount%&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-label&quot;&gt;Signature pending&lt;/div&gt;&lt;div class=&quot;paac-kpi-note&quot;&gt;Manual signature requests&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-kpi&quot; style=&quot;--tone:#179e6c;--soft:#e4fcf3;&quot;&gt;&lt;div class=&quot;paac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-68&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-value&quot;&gt;&lt;%=renewalDueCount%&gt;&lt;/div&gt;&lt;div class=&quot;paac-kpi-label&quot;&gt;Renewal due&lt;/div&gt;&lt;div class=&quot;paac-kpi-note&quot;&gt;Due, penalty, or due soon&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;paac-two&quot;&gt;\n\t\t\t&lt;div class=&quot;paac-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;paac-card-head&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;p&gt;Complete these items first. Each action opens a wizard, form, or report without adding JavaScript.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(todoTotal &gt; 0,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-green&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline &lt;%=if(todoTotal &gt; 0,&quot;ui-2-time&quot;,&quot;ui-1-check-circle-08&quot;)%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=if(todoTotal &gt; 0,todoTotal + &quot; open&quot;,&quot;No open tasks&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;paac-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;paac-action-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-action &lt;%=if(draftCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;paac-action-title&quot;&gt;&lt;h4&gt;Complete draft applications&lt;/h4&gt;&lt;span class=&quot;paac-chip &lt;%=if(draftCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;%=draftCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;paac-action-copy&quot;&gt;Return to saved draft applications or start a new application when you are ready.&lt;/p&gt;&lt;div class=&quot;paac-action-links&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Page:Public_Application_Wizard?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;New application&lt;/a&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Draft list&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-action &lt;%=if(holdCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;paac-action-title&quot;&gt;&lt;h4&gt;Resolve holds&lt;/h4&gt;&lt;span class=&quot;paac-chip &lt;%=if(holdCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;%=holdCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;paac-action-copy&quot;&gt;Holds can block approval until staff-requested information or corrections are complete.&lt;/p&gt;&lt;div class=&quot;paac-action-links&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Active_Holds?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open holds&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-action &lt;%=if(paymentPendingCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;paac-action-title&quot;&gt;&lt;h4&gt;Complete payments&lt;/h4&gt;&lt;span class=&quot;paac-chip &lt;%=if(paymentPendingCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;%=paymentPendingCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;paac-action-copy&quot;&gt;Review application payments and renewal batch payments that are still pending.&lt;/p&gt;&lt;div class=&quot;paac-action-links&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;Application payments&lt;/a&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;Renewal payments&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-action &lt;%=if(signaturePendingCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;paac-action-title&quot;&gt;&lt;h4&gt;Submit signatures&lt;/h4&gt;&lt;span class=&quot;paac-chip &lt;%=if(signaturePendingCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline design-pen-23&quot;&gt;&lt;/i&gt;&lt;%=signaturePendingCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;paac-action-copy&quot;&gt;Applications marked Pending Manual Sign need a signature sheet or staff-approved waiver.&lt;/p&gt;&lt;div class=&quot;paac-action-links&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Signature queue&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-action &lt;%=if(renewalDueCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;paac-action-title&quot;&gt;&lt;h4&gt;Renew licenses due&lt;/h4&gt;&lt;span class=&quot;paac-chip &lt;%=if(renewalDueCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-68&quot;&gt;&lt;/i&gt;&lt;%=renewalDueCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;paac-action-copy&quot;&gt;Renewal due and penalty-stage licenses should be handled through the renewal portal workflow.&lt;/p&gt;&lt;div class=&quot;paac-action-links&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Page:Renewal_Portal&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-68&quot;&gt;&lt;/i&gt;Renewal portal&lt;/a&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Renewable_Licenses?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Renewable licenses&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paac-action&quot;&gt;&lt;div class=&quot;paac-action-title&quot;&gt;&lt;h4&gt;Track submitted work&lt;/h4&gt;&lt;span class=&quot;paac-chip chip-info&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;%=submittedCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;paac-action-copy&quot;&gt;Monitor submitted and in-progress applications, staff status changes, and public docket activity.&lt;/p&gt;&lt;div class=&quot;paac-action-links&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Public_Application_Status?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Status report&lt;/a&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:My_Application_Docket?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline education-paper&quot;&gt;&lt;/i&gt;Docket&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt; Quick links&lt;/h5&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:My_Profile?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;span&gt;View my profile&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Applicant_Profile?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;span&gt;Update profile&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Page:Public_Application_Wizard?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span&gt;Open application wizard&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Licensee_Portal_Licenses?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;span&gt;View my licenses&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Licensee_Renewal_Batches?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;span&gt;View renewal batches&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Readiness&lt;/h5&gt;\n\t\t\t\t\t&lt;ul class=&quot;paac-health-list zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Profile ready&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=if(profileCount &gt; 0,&quot;100%&quot;,&quot;0%&quot;)%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=if(profileCount &gt; 0,&quot;100&quot;,&quot;0&quot;)%&gt;%;background:#179e6c;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;No open to-dos&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=if(todoTotal == 0,&quot;100%&quot;,&quot;40%&quot;)%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=if(todoTotal == 0,&quot;100&quot;,&quot;40&quot;)%&gt;%;background:&lt;%=if(todoTotal == 0,&quot;#179e6c&quot;,&quot;#faae13&quot;)%&gt;;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;paac-section-title&quot;&gt;&lt;h2&gt;Draft and submitted applications&lt;/h2&gt;&lt;span class=&quot;paac-section-sub&quot;&gt;&lt;%=allAppsCount%&gt; application records tied to your applicant profile.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;paac-card&quot;&gt;\n\t\t\t&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Application list&lt;/h3&gt;&lt;p&gt;Use the wizard link for drafts and the full report link for complete filtering and record details.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Full report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-card-body&quot;&gt;\n&lt;%\n\tif(recentApps.count() == 0)\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;paac-empty&quot;&gt;&lt;div class=&quot;paac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;No applications yet.&lt;/strong&gt;&lt;br&gt;Start a new application when your profile and supporting records are ready.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper paac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Application&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Payment&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Signature&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\trowCount = 0;\n\t\tfor each app in recentApps\n\t\t{\n\t\t\tif(rowCount &lt; 10)\n\t\t\t{\n\t\t\t\tappNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,&quot;Application&quot;));\n\t\t\t\tappTypeName = ifnull(app.Application_Type,&quot;Not selected&quot;);\n\t\t\t\tappStatus = ifnull(app.Application_Status,&quot;Draft&quot;);\n\t\t\t\tappStatusLower = appStatus.toLowerCase();\n\t\t\t\tstatusCls = &quot;chip-neutral&quot;;\n\t\t\t\tif(appStatusLower.contains(&quot;issued&quot;) || appStatusLower.contains(&quot;approved&quot;))\n\t\t\t\t{\n\t\t\t\t\tstatusCls = &quot;chip-ok&quot;;\n\t\t\t\t}\n\t\t\t\telse if(appStatusLower.contains(&quot;review&quot;) || appStatusLower.contains(&quot;submitted&quot;) || appStatusLower.contains(&quot;progress&quot;))\n\t\t\t\t{\n\t\t\t\t\tstatusCls = &quot;chip-info&quot;;\n\t\t\t\t}\n\t\t\t\telse if(appStatusLower.contains(&quot;hold&quot;) || appStatusLower.contains(&quot;draft&quot;))\n\t\t\t\t{\n\t\t\t\t\tstatusCls = &quot;chip-warn&quot;;\n\t\t\t\t}\n\t\t\t\telse if(appStatusLower.contains(&quot;reject&quot;) || appStatusLower.contains(&quot;denied&quot;))\n\t\t\t\t{\n\t\t\t\t\tstatusCls = &quot;chip-bad&quot;;\n\t\t\t\t}\n\t\t\t\tpaymentStatus = ifnull(app.Payment_Status,&quot;Not set&quot;);\n\t\t\t\tsignStatus = ifnull(app.Signature_Status,&quot;Not started&quot;);\n%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appTypeName%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;paac-chip &lt;%=statusCls%&gt;&quot;&gt;&lt;%=appStatus%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=paymentStatus%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=signStatus%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;% if(appStatus == &quot;Draft&quot;) { %&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Page:Public_Application_Wizard?Application_ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Continue&lt;/a&gt;&lt;% } else { %&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Public_Application_Status?ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;Status&lt;/a&gt;&lt;% } %&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\trowCount = rowCount + 1;\n\t\t}\n%&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;paac-section-title&quot;&gt;&lt;h2&gt;Focused work queues&lt;/h2&gt;&lt;span class=&quot;paac-section-sub&quot;&gt;Live summaries for holds, payments, signatures, and renewals.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;paac-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;paac-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Active holds&lt;/h3&gt;&lt;p&gt;Unreleased holds tied to your applications.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip &lt;%=if(holdCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=holdCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-card-body&quot;&gt;&lt;div class=&quot;paac-list&quot;&gt;\n&lt;% if(activeHolds.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;paac-empty&quot;&gt;&lt;div class=&quot;paac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No active holds are currently tied to your applications.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { holdRows = 0; for each hold in activeHolds { if(holdRows &lt; 4) { %&gt;\n\t\t\t\t&lt;div class=&quot;paac-item&quot;&gt;&lt;div class=&quot;paac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;paac-item-title&quot;&gt;&lt;%=ifnull(hold.Hold_Type,&quot;Application hold&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-meta&quot;&gt;&lt;%=ifnull(hold.Application.Application_Number,&quot;Application&quot;)%&gt; | Created &lt;%=ifnull(hold.Created_Date,&quot;Not dated&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip chip-warn&quot;&gt;Open&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-actions&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Active_Holds?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;View hold&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } holdRows = holdRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;paac-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline design-pen-23&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Signature pending&lt;/h3&gt;&lt;p&gt;Applications waiting for manual signature completion.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip &lt;%=if(signaturePendingCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=signaturePendingCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-card-body&quot;&gt;&lt;div class=&quot;paac-list&quot;&gt;\n&lt;% if(signatureApps.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;paac-empty&quot;&gt;&lt;div class=&quot;paac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No manual signatures are pending.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { sigRows = 0; for each sigApp in signatureApps { if(sigRows &lt; 4) { %&gt;\n\t\t\t\t&lt;div class=&quot;paac-item&quot;&gt;&lt;div class=&quot;paac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;paac-item-title&quot;&gt;&lt;%=ifnull(sigApp.Application_Number,&quot;Application&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-meta&quot;&gt;Status: &lt;%=ifnull(sigApp.Application_Status,&quot;Draft&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip chip-warn&quot;&gt;Signature&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-actions&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open application&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } sigRows = sigRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;paac-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Payment pending&lt;/h3&gt;&lt;p&gt;Application and renewal payment records available through applicant or licensee email.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip &lt;%=if(paymentPendingCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=paymentPendingCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-card-body&quot;&gt;&lt;div class=&quot;paac-list&quot;&gt;\n&lt;% if(pendingAppPayments.count() == 0 &amp;&amp; pendingRenewalPayments.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;paac-empty&quot;&gt;&lt;div class=&quot;paac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No pending payment records were found for this login.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { payRows = 0; for each pay in pendingAppPayments { if(payRows &lt; 3) { %&gt;\n\t\t\t\t&lt;div class=&quot;paac-item&quot;&gt;&lt;div class=&quot;paac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;paac-item-title&quot;&gt;&lt;%=ifnull(pay.Payment_Reference,&quot;Application payment&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-meta&quot;&gt;Application: &lt;%=ifnull(pay.Application.Application_Number,&quot;Application&quot;)%&gt; | Due: &lt;%=ifnull(pay.Amount_Due,0)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip chip-warn&quot;&gt;Pending&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-actions&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;Open payment&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } payRows = payRows + 1; } for each rpay in pendingRenewalPayments { if(payRows &lt; 5) { %&gt;\n\t\t\t\t&lt;div class=&quot;paac-item&quot;&gt;&lt;div class=&quot;paac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;paac-item-title&quot;&gt;&lt;%=ifnull(rpay.Renewal_Batch_Number,&quot;Renewal payment&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-meta&quot;&gt;Renewal batch | Due: &lt;%=ifnull(rpay.Total_Amount_Due,0)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip chip-warn&quot;&gt;Pending&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-actions&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;Open renewal queue&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } payRows = payRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;paac-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-68&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Renewal due&lt;/h3&gt;&lt;p&gt;Renewal due licenses tied to your licensee email.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip &lt;%=if(renewalDueCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=renewalDueCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-card-body&quot;&gt;&lt;div class=&quot;paac-list&quot;&gt;\n&lt;% if(renewableLicenses.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;paac-empty&quot;&gt;&lt;div class=&quot;paac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No Renewal Due license records were found. Due-soon or penalty records may still appear in the full renewable license report.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { renRows = 0; for each lic in renewableLicenses { if(renRows &lt; 4) { %&gt;\n\t\t\t\t&lt;div class=&quot;paac-item&quot;&gt;&lt;div class=&quot;paac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;paac-item-title&quot;&gt;&lt;%=ifnull(lic.License_Number,&quot;License&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-meta&quot;&gt;Expiration: &lt;%=ifnull(lic.Expiration_Date,&quot;Not dated&quot;)%&gt; | Status: &lt;%=ifnull(lic.License_Status,&quot;Renewal Due&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip chip-warn&quot;&gt;Due&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-item-actions&quot;&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Page:Renewal_Portal&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-68&quot;&gt;&lt;/i&gt;Renew&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } renRows = renRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;paac-section-title&quot;&gt;&lt;h2&gt;Embedded reports and forms&lt;/h2&gt;&lt;span class=&quot;paac-section-sub&quot;&gt;Reports remain reachable from the page and use applicant-owned criteria where available.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;paac-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;paac-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;My profile&lt;/h3&gt;&lt;p&gt;Your applicant profile record.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:My_Profile?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;paac-embed&quot;&gt;&lt;div class=&quot;paac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;My_Profile&quot; zc-criteria=&quot;Profile_Email == &amp;quot;&lt;%=applicantEmail%&gt;&amp;quot;&quot; zc-height=&quot;360px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Update profile&lt;/h3&gt;&lt;p&gt;Use only if your contact information needs correction.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;paac-chip chip-theme&quot;&gt;Form&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;paac-embed&quot;&gt;&lt;div class=&quot;paac-embed-box&quot; zc-component=&quot;form&quot; zc-linkname=&quot;Applicant_Profile&quot; zc-height=&quot;500px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-card wide paac-report-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;My applications&lt;/h3&gt;&lt;p&gt;Draft, submitted, in-progress, hold, payment, and signature status in the full report.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;paac-embed&quot;&gt;&lt;div class=&quot;paac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;My_New_License_Applications&quot; zc-criteria=&quot;Applicant_Profile.Profile_Email == &amp;quot;&lt;%=applicantEmail%&gt;&amp;quot;&quot; zc-height=&quot;520px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Pending payments&lt;/h3&gt;&lt;p&gt;Application payment records filtered through applicant email.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;paac-embed&quot;&gt;&lt;div class=&quot;paac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Pending_Payments&quot; zc-criteria=&quot;Application.Applicant_Email == &amp;quot;&lt;%=applicantEmail%&gt;&amp;quot;&quot; zc-height=&quot;420px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Renewal batches&lt;/h3&gt;&lt;p&gt;Renewal batches where licensee email matches your login.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Licensee_Renewal_Batches?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;paac-embed&quot;&gt;&lt;div class=&quot;paac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Licensee_Renewal_Batches&quot; zc-criteria=&quot;Licensee_Email == &amp;quot;&lt;%=applicantEmail%&gt;&amp;quot;&quot; zc-height=&quot;420px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paac-card wide paac-report-card&quot;&gt;&lt;div class=&quot;paac-card-head&quot;&gt;&lt;div class=&quot;paac-card-title&quot;&gt;&lt;div class=&quot;paac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Licenses and renewal due records&lt;/h3&gt;&lt;p&gt;Licensee portal license records available to renewal and payment workflows.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;paac-link&quot; href=&quot;#Report:Licensee_Portal_Licenses?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;paac-embed&quot;&gt;&lt;div class=&quot;paac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Licensee_Portal_Licenses&quot; zc-criteria=&quot;Licensee_Email == &amp;quot;&lt;%=applicantEmail%&gt;&amp;quot;&quot; zc-height=&quot;480px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;div class=&quot;paac-foot-space&quot;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Public_Application_Portal
		{
					displayname = "Public Application Portal"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Public_Application_Portal_Single_Snippet' elementName='Public_Application_Portal_Single_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Public_Application_Portal_Single_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tapplicantName = ifnull(zoho.loginuserid,&quot;Applicant&quot;);\n\tif(applicantName == &quot;&quot; || applicantName == null)\n\t{\n\t\tapplicantName = &quot;Applicant&quot;;\n\t}\n\tprofileCount = Applicant_Profile[Profile_Email == zoho.loginuserid].count();\n\tentityCount = Legal_Entities[Applicant_Profile.Profile_Email == zoho.loginuserid].count();\n\tdbaCount = DBA[Applicant_Profile.Profile_Email == zoho.loginuserid].count();\n\taddressCount = Address_Records[Applicant_Profile.Profile_Email == zoho.loginuserid].count();\n\tattorneyCount = Attorneys[Applicant_Profile.Profile_Email == zoho.loginuserid].count();\n\tapplicationCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid].count();\n\tdocketCount = Docket_Notes[Application.Applicant_Email == zoho.loginuserid].count();\n\tselectedLicenseAppCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; License != null].count();\n\tissuedLicenseAppCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; Issued_License != null].count();\n\tlicenseCount = Licenses[Applicant_Profile.Profile_Email == zoho.loginuserid].count();\n\tactiveLicenseCount = Licenses[Applicant_Profile.Profile_Email == zoho.loginuserid &amp;&amp; License_Status == &quot;Active&quot;].count();\n\tsetupCount = entityCount + dbaCount + addressCount + attorneyCount;\n\tappTypes = Application_Types[Active == true] sort by Type_Name;\n\tlineItems = License_Type_Line_Items[Status == &quot;Active&quot;];\n\trecentApps = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid] sort by Added_Time desc;\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset - included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6366f1);--zcs-light-bg-color:var(--zcs_brand_light_color,#eef2ff);--zcs-page-bg-color:#f8f9fc;--zcs-primary-text-color:var(--zcs_primary_text_color,#0f172a);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#475569);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#94a3b8);--zcs-border-color:var(--zcs_tertiary_border_color,#e4e7ee);--zcs-white-color:#fff;--zcs-black-color:#000;--zcs-brand-foreground:var(--zcs_brand_foreground_color,#fff);font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-box-border{box-sizing:border-box}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-list-none{list-style-type:none}.zcs-color-green{color:#179e6c}.zcs-color-red{color:#fe455d}.zcs-color-yellow{color:#b8770d}.zcs-color-l_blue{color:#1094c5}\n/* ZCS components used: button-primary-button, button-primary-outline-button, badge-badge-with-icon, table-simple-table, quick-actions-card-type-quick-actions, notes-notes-simple */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color,#6366f1);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#6366f1);background-color:var(--zcs-white-color);color:var(--zcs_brand_color,#6366f1)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color,#4f46e5)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color,#eef2ff);border-color:var(--zcs_brand_color,#6366f1);color:var(--zcs_brand_color,#6366f1)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color,#eef2ff);border-color:var(--zcs_brand_color,#6366f1);color:var(--zcs_brand_color,#6366f1)}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-filled-outline.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#9b6500}.zcs-badge-filled-outline.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#f4660c}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background:#f9fafe;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color,#6366f1)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color,#6366f1)}.zcs-notes-wrapper ul{list-style-type:disc}.zcs-notes-wrapper ul li::marker{color:var(--zcs-teritiary-text-color)}.zcs-notes-text a:hover{text-decoration:underline}\n/* Portal shell */\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,div#zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.abc-shell{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f8f9fc 0%,#f4f6fb 48%,#fff 100%);min-height:100%;padding:24px;box-sizing:border-box}.abc-shell *{box-sizing:border-box}.abc-page{max-width:1480px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.abc-hero{position:relative;background:#fff;border:1px solid #eef0f5;border-radius:22px;padding:28px;overflow:hidden;box-shadow:0 1px 2px rgba(15,23,42,.04)}.abc-hero:before{content:&quot;&quot;;position:absolute;right:-80px;top:-90px;width:290px;height:290px;border-radius:50%;background:linear-gradient(135deg,var(--zcs-theme-brand-color),#8b5cf6,#ec4899);opacity:.09;filter:blur(2px)}.abc-hero:after{content:&quot;&quot;;position:absolute;right:60px;bottom:-110px;width:230px;height:230px;border-radius:50%;border:1px solid rgba(99,102,241,.15);box-shadow:0 0 0 48px rgba(99,102,241,.04),0 0 0 96px rgba(99,102,241,.03)}.abc-hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(320px,.8fr);gap:24px;align-items:center}.abc-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color);padding:6px 12px;border-radius:999px}.abc-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.03;letter-spacing:-.8px;margin:12px 0 10px;color:#0f172a}.abc-hero p{font-size:15px;line-height:1.65;color:#475569;margin:0;max-width:900px}.abc-hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}.abc-hero-pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.abc-path-panel{background:linear-gradient(180deg,#fbfcff,#fff);border:1px solid #e4e7ee;border-radius:18px;padding:18px;box-shadow:0 12px 30px rgba(15,23,42,.05)}.abc-path-panel h3{font-size:14px;text-transform:uppercase;letter-spacing:.6px;color:#94a3b8;margin:0 0 12px}.abc-mini-path{display:grid;grid-template-columns:32px 1fr;gap:10px;padding:12px 0;border-top:1px solid #eef0f5}.abc-mini-path:first-of-type{border-top:0}.abc-mini-icon{width:32px;height:32px;border-radius:10px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);display:flex;align-items:center;justify-content:center}.abc-mini-title{font-size:14px;font-weight:700;color:#0f172a}.abc-mini-copy{font-size:12px;color:#64748b;line-height:1.45;margin-top:2px}.abc-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 4px -2px}.abc-section-title h2{font-size:11px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:1.1px;margin:0;display:flex;align-items:center;gap:8px}.abc-section-title h2:before{content:&quot;&quot;;width:4px;height:15px;border-radius:4px;background:linear-gradient(180deg,var(--zcs-theme-brand-color),#8b5cf6)}.abc-section-sub{font-size:12px;color:#94a3b8}.abc-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.abc-kpi{background:#fff;border:1px solid #eef0f5;border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);transition:all .2s ease}.abc-kpi:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(15,23,42,.07);border-color:#e4e7ee}.abc-kpi-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.abc-kpi-icon{width:42px;height:42px;border-radius:14px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);display:flex;align-items:center;justify-content:center;font-size:21px}.abc-kpi-label{font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.45px}.abc-kpi-value{font-size:30px;line-height:1;font-weight:800;letter-spacing:-.5px;color:#0f172a;margin-top:12px}.abc-kpi-foot{font-size:12px;color:#64748b;margin-top:9px;display:flex;align-items:center;gap:6px}.abc-grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.abc-grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.abc-card{background:#fff;border:1px solid #eef0f5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.abc-card-body{padding:18px}.abc-path-card{position:relative;min-height:218px;display:flex;flex-direction:column;gap:14px}.abc-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.abc-card-icon{width:44px;height:44px;border-radius:14px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);display:flex;align-items:center;justify-content:center;font-size:22px;flex:0 0 auto}.abc-card h3{font-size:17px;line-height:1.2;margin:0;color:#0f172a}.abc-card p{font-size:13px;line-height:1.55;color:#64748b;margin:0}.abc-card-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:auto}.abc-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:700;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);border-color:rgba(99,102,241,.25)}.abc-resource-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.abc-resource{padding:16px;display:flex;flex-direction:column;gap:14px}.abc-resource-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.abc-resource-title{display:flex;align-items:center;gap:10px}.abc-resource-title h3{font-size:15px;margin:0;color:#0f172a}.abc-resource-count{font-size:24px;font-weight:800;color:#0f172a;letter-spacing:-.4px}.abc-resource p{font-size:12px;line-height:1.5;color:#64748b;margin:0}.abc-link-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.abc-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--zcs-theme-brand-color);text-decoration:none}.abc-link:hover{text-decoration:underline}.abc-panel{background:#fff;border:1px solid #eef0f5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.abc-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:16px 18px;border-bottom:1px solid #eef0f5;background:#fff}.abc-panel-title-wrap{display:flex;gap:12px;align-items:flex-start}.abc-panel-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);display:flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto}.abc-panel h3{font-size:16px;line-height:1.25;margin:0;color:#0f172a}.abc-panel-sub{font-size:12px;color:#94a3b8;margin-top:3px}.abc-panel-body{padding:18px}.abc-guide-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.abc-rule-list{display:flex;flex-direction:column;gap:10px}.abc-rule{display:grid;grid-template-columns:150px 1fr;gap:12px;padding:12px;border:1px solid #eef0f5;border-radius:14px;background:#fbfcff}.abc-rule p{font-size:13px;line-height:1.5;color:#475569;margin:0}.abc-table-note{font-size:12px;color:#94a3b8;margin-top:10px}.abc-app-table-wrap{max-height:430px;overflow:auto}.abc-status-cell{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.abc-empty{padding:34px 20px;text-align:center;color:#94a3b8;font-size:13px;background:#fbfcff;border-radius:14px}.abc-embed-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.abc-embed-card{background:#fff;border:1px solid #eef0f5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.abc-embed-card.wide{grid-column:1/-1}.abc-embed-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid #eef0f5;background:#fbfcff}.abc-embed-head h3{font-size:15px;margin:0;color:#0f172a}.abc-embed-head p{font-size:12px;color:#64748b;margin:3px 0 0}.abc-embed{padding:8px;background:#fff}.abc-embed [zc-component]{width:100%;border-radius:12px;overflow:hidden}.abc-form-shell{display:grid;grid-template-columns:minmax(310px,.34fr) minmax(0,.66fr);gap:14px}.abc-form-side{display:flex;flex-direction:column;gap:12px}.abc-guidance-card{padding:16px;border:1px solid #eef0f5;border-radius:16px;background:#fbfcff}.abc-guidance-card h4{font-size:14px;margin:0 0 8px;color:#0f172a}.abc-guidance-card p{font-size:13px;line-height:1.55;color:#64748b;margin:0}.abc-quick-actions-wrapper{height:100%}.abc-quick-actions-wrapper h5{display:flex;align-items:center;gap:8px}.abc-quick-action-item.zcs-card{border-color:#eef0f5}.abc-quick-action-icon{color:var(--zcs-theme-brand-color);font-size:17px}.abc-note-band{background:var(--zcs-light-bg-color);border:1px solid rgba(99,102,241,.25);border-radius:14px;padding:12px 14px}.abc-foot-space{height:12px}@media(max-width:1180px){.abc-hero-inner,.abc-form-shell,.abc-guide-grid{grid-template-columns:1fr}.abc-kpi-grid,.abc-resource-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.abc-grid-3{grid-template-columns:1fr 1fr}}@media(max-width:760px){.abc-shell{padding:14px}.abc-hero{padding:22px}.abc-kpi-grid,.abc-resource-grid,.abc-grid-3,.abc-grid-2,.abc-embed-grid{grid-template-columns:1fr}.abc-rule{grid-template-columns:1fr}.abc-hero-actions .zcs-button{width:100%}.abc-section-title{align-items:flex-start;flex-direction:column}.abc-panel-head{flex-direction:column}.abc-embed-card.wide{grid-column:auto}.zcs-table-wrapper table{min-width:760px}}\n&lt;/style&gt;\n&lt;div class=&quot;abc-shell&quot;&gt;\n\t&lt;div class=&quot;abc-page&quot;&gt;\n\t\t&lt;section class=&quot;abc-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-hero-inner&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;span&gt;ABC License Management&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;h1&gt;New-license application portal&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Hello &lt;%=applicantName%&gt;. Use this portal to maintain intake records, choose the correct application path, submit a new license application, and track application and docket status through license issuance.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-hero-pills&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;abc-chip chip-theme&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Original creates a new license number&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;abc-chip chip-info&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;Transfer requires an existing license&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;abc-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Change requires an existing license&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-hero-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Applications?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Start application&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Review my applications&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;aside class=&quot;abc-path-panel&quot;&gt;\n\t\t\t\t\t&lt;h3&gt;Choose the path before selecting license records&lt;/h3&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-mini-path&quot;&gt;&lt;div class=&quot;abc-mini-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&quot;abc-mini-title&quot;&gt;Original&lt;/div&gt;&lt;div class=&quot;abc-mini-copy&quot;&gt;Use when no existing ABC license is being changed or replaced.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-mini-path&quot;&gt;&lt;div class=&quot;abc-mini-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&quot;abc-mini-title&quot;&gt;Transfer&lt;/div&gt;&lt;div class=&quot;abc-mini-copy&quot;&gt;Select the active existing license that will be terminated when the new active license is issued.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-mini-path&quot;&gt;&lt;div class=&quot;abc-mini-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&quot;abc-mini-title&quot;&gt;Change&lt;/div&gt;&lt;div class=&quot;abc-mini-copy&quot;&gt;Select the active existing license to update. A new license number is not created.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;abc-section-title&quot;&gt;&lt;h2&gt;Portal snapshot&lt;/h2&gt;&lt;span class=&quot;abc-section-sub&quot;&gt;Counts are filtered to the logged-in applicant where records are tied to the applicant profile.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;abc-kpi-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-kpi&quot;&gt;&lt;div class=&quot;abc-kpi-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Profiles&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=profileCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-foot&quot;&gt;&lt;span class=&quot;abc-chip &lt;%=if(profileCount &gt; 0,&quot;chip-ok&quot;,&quot;chip-warn&quot;)%&gt;&quot;&gt;&lt;%=if(profileCount &gt; 0,&quot;Ready&quot;,&quot;Add profile&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-kpi&quot;&gt;&lt;div class=&quot;abc-kpi-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Setup records&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=setupCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-foot&quot;&gt;Legal entities, DBAs, addresses, and attorneys&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-kpi&quot;&gt;&lt;div class=&quot;abc-kpi-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Applications&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=applicationCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-foot&quot;&gt;&lt;span class=&quot;abc-chip chip-info&quot;&gt;&lt;%=selectedLicenseAppCount%&gt; with existing license selected&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-kpi&quot;&gt;&lt;div class=&quot;abc-kpi-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Issued or active licenses&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=activeLicenseCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline education-paper&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-foot&quot;&gt;&lt;span class=&quot;abc-chip chip-ok&quot;&gt;&lt;%=issuedLicenseAppCount%&gt; issued from applications&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;abc-section-title&quot;&gt;&lt;h2&gt;Application paths&lt;/h2&gt;&lt;span class=&quot;abc-section-sub&quot;&gt;The Existing License field is only used for Transfer and Change paths.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;abc-grid-3&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-path-card abc-card-body&quot;&gt;&lt;div class=&quot;abc-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Original application&lt;/h3&gt;&lt;p&gt;Create a brand-new license record. Do not select an existing license unless staff instructs you to correct an application.&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-card-actions&quot;&gt;&lt;span class=&quot;abc-chip chip-ok&quot;&gt;Existing license not needed&lt;/span&gt;&lt;span class=&quot;abc-chip chip-theme&quot;&gt;New number at License Issued&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-path-card abc-card-body&quot;&gt;&lt;div class=&quot;abc-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Transfer application&lt;/h3&gt;&lt;p&gt;Use for a transfer from an existing active license. Select the active license in the Existing License field before submitting.&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-card-actions&quot;&gt;&lt;span class=&quot;abc-chip chip-warn&quot;&gt;Existing license required&lt;/span&gt;&lt;span class=&quot;abc-chip chip-info&quot;&gt;New active license created&lt;/span&gt;&lt;span class=&quot;abc-chip chip-bad&quot;&gt;Selected license terminated&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-path-card abc-card-body&quot;&gt;&lt;div class=&quot;abc-card-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Change application&lt;/h3&gt;&lt;p&gt;Use to update an existing active license. Select the license that needs the change; issuance updates that license instead of creating a new number.&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;abc-card-actions&quot;&gt;&lt;span class=&quot;abc-chip chip-warn&quot;&gt;Existing license required&lt;/span&gt;&lt;span class=&quot;abc-chip chip-neutral&quot;&gt;No new license number&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;abc-section-title&quot;&gt;&lt;h2&gt;Intake records&lt;/h2&gt;&lt;span class=&quot;abc-section-sub&quot;&gt;Create and maintain these records before and during application intake.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;abc-resource-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-resource&quot;&gt;&lt;div class=&quot;abc-resource-top&quot;&gt;&lt;div class=&quot;abc-resource-title&quot;&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3&gt;Applicant profile&lt;/h3&gt;&lt;/div&gt;&lt;div class=&quot;abc-resource-count&quot;&gt;&lt;%=profileCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p&gt;Your contact identity for application intake and applicant-specific reporting.&lt;/p&gt;&lt;div class=&quot;abc-link-row&quot;&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Form:Applicant_Profile?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Add or update&lt;/a&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:My_Profile?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;View&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-resource&quot;&gt;&lt;div class=&quot;abc-resource-top&quot;&gt;&lt;div class=&quot;abc-resource-title&quot;&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3&gt;Legal entities&lt;/h3&gt;&lt;/div&gt;&lt;div class=&quot;abc-resource-count&quot;&gt;&lt;%=entityCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p&gt;Companies, individuals, or managers connected to the application.&lt;/p&gt;&lt;div class=&quot;abc-link-row&quot;&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Form:Legal_Entities?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;Add entity&lt;/a&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:My_Legal_Entities?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;View&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-resource&quot;&gt;&lt;div class=&quot;abc-resource-top&quot;&gt;&lt;div class=&quot;abc-resource-title&quot;&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3&gt;DBAs&lt;/h3&gt;&lt;/div&gt;&lt;div class=&quot;abc-resource-count&quot;&gt;&lt;%=dbaCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p&gt;Business names used on the application and license record.&lt;/p&gt;&lt;div class=&quot;abc-link-row&quot;&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Form:DBA?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;Add DBA&lt;/a&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:My_DBAs?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;View&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-resource&quot;&gt;&lt;div class=&quot;abc-resource-top&quot;&gt;&lt;div class=&quot;abc-resource-title&quot;&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline location-pin-copy&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3&gt;Addresses&lt;/h3&gt;&lt;/div&gt;&lt;div class=&quot;abc-resource-count&quot;&gt;&lt;%=addressCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p&gt;Premise and mailing addresses used by the application form.&lt;/p&gt;&lt;div class=&quot;abc-link-row&quot;&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Form:Address_Records?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;Add address&lt;/a&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:My_Addresses?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;View&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-resource&quot;&gt;&lt;div class=&quot;abc-resource-top&quot;&gt;&lt;div class=&quot;abc-resource-title&quot;&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3&gt;Attorneys&lt;/h3&gt;&lt;/div&gt;&lt;div class=&quot;abc-resource-count&quot;&gt;&lt;%=attorneyCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p&gt;Optional representative information for application correspondence.&lt;/p&gt;&lt;div class=&quot;abc-link-row&quot;&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Form:Attorneys?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;Add attorney&lt;/a&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:My_Attorneys?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;View&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-resource&quot;&gt;&lt;div class=&quot;abc-resource-top&quot;&gt;&lt;div class=&quot;abc-resource-title&quot;&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3&gt;Applications&lt;/h3&gt;&lt;/div&gt;&lt;div class=&quot;abc-resource-count&quot;&gt;&lt;%=applicationCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p&gt;Application records with type, selected license, line items, fees, and status.&lt;/p&gt;&lt;div class=&quot;abc-link-row&quot;&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Form:Applications?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;Start&lt;/a&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;View&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-resource&quot;&gt;&lt;div class=&quot;abc-resource-top&quot;&gt;&lt;div class=&quot;abc-resource-title&quot;&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline education-paper&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3&gt;Docket notes&lt;/h3&gt;&lt;/div&gt;&lt;div class=&quot;abc-resource-count&quot;&gt;&lt;%=docketCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p&gt;Public activity notes and dated events tied to application processing.&lt;/p&gt;&lt;div class=&quot;abc-link-row&quot;&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:My_Application_Docket?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open docket&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-card abc-resource&quot;&gt;&lt;div class=&quot;abc-resource-top&quot;&gt;&lt;div class=&quot;abc-resource-title&quot;&gt;&lt;div class=&quot;abc-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3&gt;Selected and issued licenses&lt;/h3&gt;&lt;/div&gt;&lt;div class=&quot;abc-resource-count&quot;&gt;&lt;%=licenseCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p&gt;Existing licenses selected on Transfer or Change applications, plus licenses issued from approved applications.&lt;/p&gt;&lt;div class=&quot;abc-link-row&quot;&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:Licensee_Portal_Licenses?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;View licenses&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;abc-section-title&quot;&gt;&lt;h2&gt;Application type guidance&lt;/h2&gt;&lt;span class=&quot;abc-section-sub&quot;&gt;Use the Applications form after reviewing these rules.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-panel-head&quot;&gt;&lt;div class=&quot;abc-panel-title-wrap&quot;&gt;&lt;div class=&quot;abc-panel-icon&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Existing License selection rules&lt;/h3&gt;&lt;div class=&quot;abc-panel-sub&quot;&gt;Original, Transfer, and Change drive different license outcomes.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;abc-chip chip-theme&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;Confirm before submit&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-panel-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-guide-grid&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-rule-list&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;abc-rule&quot;&gt;&lt;span class=&quot;abc-chip chip-ok&quot;&gt;Original&lt;/span&gt;&lt;p&gt;Leave Existing License blank. When the application reaches License Issued, the workflow creates a new license number.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;abc-rule&quot;&gt;&lt;span class=&quot;abc-chip chip-warn&quot;&gt;Transfer&lt;/span&gt;&lt;p&gt;Select the active existing license. At issue, the app creates a new active license and terminates the selected existing license.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;abc-rule&quot;&gt;&lt;span class=&quot;abc-chip chip-info&quot;&gt;Change&lt;/span&gt;&lt;p&gt;Select the active existing license. At issue, the app updates that license and does not create a new license number.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Application type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Existing License field&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Charge&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tif(appTypes.count() == 0)\n\t{\n%&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Original&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-green&quot;&gt;Leave blank&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;See form&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Transfer&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-yellow&quot;&gt;Required&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;See form&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Change&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-yellow&quot;&gt;Required&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;See form&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each  appType in appTypes\n\t\t{\n\t\t\ttypeName = ifnull(appType.Type_Name,&quot;Application Type&quot;);\n\t\t\ttypeLower = typeName.toLowerCase();\n\t\t\texistingRule = &quot;Review before submit&quot;;\n\t\t\truleClass = &quot;zcs-color-l_blue&quot;;\n\t\t\tif(typeLower.contains(&quot;original&quot;))\n\t\t\t{\n\t\t\t\texistingRule = &quot;Leave blank&quot;;\n\t\t\t\truleClass = &quot;zcs-color-green&quot;;\n\t\t\t}\n\t\t\telse if(typeLower.contains(&quot;transfer&quot;) || typeLower.contains(&quot;change&quot;))\n\t\t\t{\n\t\t\t\texistingRule = &quot;Required&quot;;\n\t\t\t\truleClass = &quot;zcs-color-yellow&quot;;\n\t\t\t}\n%&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=typeName%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body &lt;%=ruleClass%&gt;&quot;&gt;&lt;%=existingRule%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;$&lt;%=ifnull(appType.Charges,0)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n%&gt;\n\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;abc-table-note&quot;&gt;The Applications form also calculates totals from selected license type line items. Staff review final fee and payment status before issuance.&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;abc-section-title&quot;&gt;&lt;h2&gt;Quick actions&lt;/h2&gt;&lt;span class=&quot;abc-section-sub&quot;&gt;Use dialog links to add records without leaving the portal.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;abc-grid-2&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper abc-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;Applicant actions&lt;/h5&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Applicant_Profile?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add or update applicant profile&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Legal_Entities?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add legal entity&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:DBA?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add DBA&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper abc-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;Intake actions&lt;/h5&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Address_Records?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline location-pin-copy&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add address&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Attorneys?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add attorney&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Applications?zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Start application&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;abc-section-title&quot;&gt;&lt;h2&gt;Recent application status&lt;/h2&gt;&lt;span class=&quot;abc-section-sub&quot;&gt;Compact summary from your application records.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;abc-panel&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-panel-head&quot;&gt;&lt;div class=&quot;abc-panel-title-wrap&quot;&gt;&lt;div class=&quot;abc-panel-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;My application summary&lt;/h3&gt;&lt;div class=&quot;abc-panel-sub&quot;&gt;Existing and issued license columns help confirm whether Transfer and Change records are linked correctly.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open full report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-panel-body&quot;&gt;\n&lt;%\n\tif(recentApps.count() == 0)\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;abc-empty&quot;&gt;No application records are tied to your applicant profile yet. Start an application after your profile, entity, address, and DBA records are ready.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper abc-app-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Application&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Existing license&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Issued license&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Fee due&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tfor each  app in recentApps\n\t\t{\n\t\t\tappNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,&quot;Application&quot;));\n\t\t\tappTypeName = ifnull(app.Application_Type,&quot;Not selected&quot;);\n\t\t\tappStatus = ifnull(app.Application_Status,&quot;Draft&quot;);\n\t\t\tappStatusLower = appStatus.toLowerCase();\n\t\t\tappStatusCls = &quot;chip-neutral&quot;;\n\t\t\tif(appStatusLower.contains(&quot;issued&quot;) || appStatusLower.contains(&quot;approved&quot;))\n\t\t\t{\n\t\t\t\tappStatusCls = &quot;chip-ok&quot;;\n\t\t\t}\n\t\t\telse if(appStatusLower.contains(&quot;review&quot;) || appStatusLower.contains(&quot;submitted&quot;) || appStatusLower.contains(&quot;pending&quot;))\n\t\t\t{\n\t\t\t\tappStatusCls = &quot;chip-info&quot;;\n\t\t\t}\n\t\t\telse if(appStatusLower.contains(&quot;hold&quot;) || appStatusLower.contains(&quot;incomplete&quot;))\n\t\t\t{\n\t\t\t\tappStatusCls = &quot;chip-warn&quot;;\n\t\t\t}\n\t\t\telse if(appStatusLower.contains(&quot;denied&quot;) || appStatusLower.contains(&quot;terminated&quot;))\n\t\t\t{\n\t\t\t\tappStatusCls = &quot;chip-bad&quot;;\n\t\t\t}\n\t\t\texistingLicense = ifnull(app.License.License_Number,&quot;Not selected&quot;);\n\t\t\tissuedLicense = ifnull(app.Issued_License.License_Number,&quot;Not issued&quot;);\n\t\t\tappTotal = ifnull(app.Total_Fee_Due,0);\n\t\t\tif(appTotal == 0)\n\t\t\t{\n\t\t\t\tappTotal = ifnull(app.Total_Fee,0);\n\t\t\t}\n%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appTypeName%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;abc-chip &lt;%=appStatusCls%&gt;&quot;&gt;&lt;%=appStatus%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=existingLicense%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=issuedLicense%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;$&lt;%=appTotal%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;abc-section-title&quot;&gt;&lt;h2&gt;Application workspace&lt;/h2&gt;&lt;span class=&quot;abc-section-sub&quot;&gt;Embedded form and applicant-facing reports.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;abc-form-shell&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-form-side&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-guidance-card&quot;&gt;&lt;h4&gt;Before you submit&lt;/h4&gt;&lt;p&gt;Confirm your Applicant Profile, Legal Entity, DBA, Premise Address, Mailing Address, and optional Attorney records. For Transfer or Change, select the existing active license in the Applications form.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-note-band zcs-notes-wrapper&quot;&gt;&lt;p class=&quot;zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;span class=&quot;zcs-notes-title zcs-font-medium zcs-color-tertiary&quot;&gt;Application Type guidance: &lt;/span&gt;Original creates a new license at License Issued. Transfer creates a new active license and terminates the selected license. Change updates the selected license only.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-guidance-card&quot;&gt;&lt;h4&gt;Active license line items&lt;/h4&gt;&lt;p&gt;&lt;%=lineItems.count()%&gt; active line item records are available for application fee calculation and staff review.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-embed-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-embed-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Applications form&lt;/h3&gt;&lt;p&gt;Select Application Type first, then use Existing License only when required.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;abc-chip chip-theme&quot;&gt;Embedded&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-embed&quot;&gt;&lt;div zc-component=&quot;form&quot; zc-linkname=&quot;Applications&quot; zc-height=&quot;1200px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;abc-section-title&quot;&gt;&lt;h2&gt;Reports and records&lt;/h2&gt;&lt;span class=&quot;abc-section-sub&quot;&gt;Functional embeds are kept inside restyled dashboard panels.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;abc-embed-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-embed-card wide&quot;&gt;&lt;div class=&quot;abc-embed-head&quot;&gt;&lt;div&gt;&lt;h3&gt;My New License Applications&lt;/h3&gt;&lt;p&gt;Full report of your submitted and in-progress application records.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot;&gt;&lt;div zc-component=&quot;report&quot; zc-linkname=&quot;My_New_License_Applications&quot; zc-height=&quot;560px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-embed-card&quot;&gt;&lt;div class=&quot;abc-embed-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Public Application Status&lt;/h3&gt;&lt;p&gt;Applicant-facing status report for application milestones.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:Public_Application_Status?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot;&gt;&lt;div zc-component=&quot;report&quot; zc-linkname=&quot;Public_Application_Status&quot; zc-height=&quot;520px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-embed-card&quot;&gt;&lt;div class=&quot;abc-embed-head&quot;&gt;&lt;div&gt;&lt;h3&gt;My Application Docket&lt;/h3&gt;&lt;p&gt;Events, comments, and public docket notes tied to your applications.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:My_Application_Docket?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot;&gt;&lt;div zc-component=&quot;report&quot; zc-linkname=&quot;My_Application_Docket&quot; zc-height=&quot;520px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;abc-embed-card wide&quot;&gt;&lt;div class=&quot;abc-embed-head&quot;&gt;&lt;div&gt;&lt;h3&gt;Selected and issued licenses&lt;/h3&gt;&lt;p&gt;Active, selected, and issued license records available to the licensee portal report.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;abc-link&quot; href=&quot;#Report:Licensee_Portal_Licenses?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;abc-embed&quot;&gt;&lt;div zc-component=&quot;report&quot; zc-linkname=&quot;Licensee_Portal_Licenses&quot; zc-height=&quot;520px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;div class=&quot;abc-foot-space&quot;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Public_Application_Wizard(int Application_ID, int checkNum, string loadIn)
		{
					displayname = "Public Application Wizard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Public_Application_Wizard_Snippet' elementName='Public_Application_Wizard_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Public_Application_Wizard_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\tcontainerName = ifnull(input.loadIn,&quot;&quot;);\n\tif(containerName == null || containerName.trim() == &quot;&quot;)\n\t{\n\t\tcontainerName = &quot;PublicApplicationWizardBody&quot;;\n\t}\n\tapplicationFound = false;\n\tapplicationIdUrl = &quot;&quot;;\n\tappNumber = &quot;New application&quot;;\n\tappStatus = &quot;Draft&quot;;\n\tappPaymentStatus = &quot;Pending&quot;;\n\tappSignatureStatus = &quot;Not Started&quot;;\n\tappType = &quot;Not selected&quot;;\n\trecordStageRaw = &quot;0&quot;;\n\trecordShowValue = &quot;&quot;;\n\tif(input.Application_ID != null)\n\t{\n\t\tapplicationIdUrl = ifnull(input.Application_ID,&quot;&quot;);\n\t\tapplicationRows = Applications[ID == input.Application_ID &amp;&amp; Applicant_Profile.Profile_Email == zoho.loginuserid];\n\t\tif(applicationRows.count() &gt; 0)\n\t\t{\n\t\t\tapplicationFound = true;\n\t\t\tappNumber = ifnull(applicationRows.Application_Number,ifnull(applicationRows.Application_Reference,&quot;Application &quot; + input.Application_ID));\n\t\t\tappStatus = ifnull(applicationRows.Application_Status,&quot;Draft&quot;);\n\t\t\tappPaymentStatus = ifnull(applicationRows.Payment_Status,&quot;Pending&quot;);\n\t\t\tappSignatureStatus = ifnull(applicationRows.Signature_Status,&quot;Not Started&quot;);\n\t\t\tappType = ifnull(applicationRows.Application_Type,&quot;Not selected&quot;);\n\t\t\trecordStageRaw = ifnull(applicationRows.Current_Stage,&quot;0&quot;);\n\t\t\trecordShowValue = ifnull(applicationRows.Show_Value,&quot;&quot;);\n\t\t\tif(recordShowValue != null &amp;&amp; recordShowValue.trim() != &quot;&quot;)\n\t\t\t{\n\t\t\t\trecordStageRaw = recordShowValue;\n\t\t\t}\n\t\t}\n\t}\n\tselectedStep = 0;\n\tif(input.checkNum != null)\n\t{\n\t\tselectedStep = input.checkNum;\n\t}\n\telse\n\t{\n\t\tif(recordStageRaw == &quot;1&quot;)\n\t\t{\n\t\t\tselectedStep = 1;\n\t\t}\n\t\telse if(recordStageRaw == &quot;2&quot;)\n\t\t{\n\t\t\tselectedStep = 2;\n\t\t}\n\t\telse if(recordStageRaw == &quot;3&quot;)\n\t\t{\n\t\t\tselectedStep = 3;\n\t\t}\n\t\telse if(recordStageRaw == &quot;4&quot;)\n\t\t{\n\t\t\tselectedStep = 4;\n\t\t}\n\t\telse if(recordStageRaw == &quot;5&quot;)\n\t\t{\n\t\t\tselectedStep = 5;\n\t\t}\n\t\telse if(recordStageRaw == &quot;6&quot;)\n\t\t{\n\t\t\tselectedStep = 6;\n\t\t}\n\t}\n\tif(selectedStep &lt; 0 || selectedStep &gt; 6)\n\t{\n\t\tselectedStep = 0;\n\t}\n\tselectedStepLabel = &quot;Applicant&quot;;\n\tif(selectedStep == 1)\n\t{\n\t\tselectedStepLabel = &quot;License&quot;;\n\t}\n\telse if(selectedStep == 2)\n\t{\n\t\tselectedStepLabel = &quot;Business&quot;;\n\t}\n\telse if(selectedStep == 3)\n\t{\n\t\tselectedStepLabel = &quot;Fees&quot;;\n\t}\n\telse if(selectedStep == 4)\n\t{\n\t\tselectedStepLabel = &quot;Compliance&quot;;\n\t}\n\telse if(selectedStep == 5)\n\t{\n\t\tselectedStepLabel = &quot;Review&quot;;\n\t}\n\telse if(selectedStep == 6)\n\t{\n\t\tselectedStepLabel = &quot;Submit&quot;;\n\t}\n\tprogressPct = (selectedStep * 100) / 6;\n\tif(appStatus == &quot;Submitted&quot; || appStatus == &quot;In-progress&quot; || appStatus == &quot;Ready for Approval&quot; || appStatus == &quot;Approved&quot; || appStatus == &quot;License Issued&quot;)\n\t{\n\t\tprogressPct = 100;\n\t}\n\tstatusLower = appStatus.toLowerCase();\n\tstatusBadgeClass = &quot;zcs-badge-yellow&quot;;\n\tstatusIcon = &quot;ui-2-time&quot;;\n\tif(statusLower.contains(&quot;submitted&quot;) || statusLower.contains(&quot;progress&quot;) || statusLower.contains(&quot;ready&quot;))\n\t{\n\t\tstatusBadgeClass = &quot;zcs-badge-blue&quot;;\n\t\tstatusIcon = &quot;loader-dots-06&quot;;\n\t}\n\telse if(statusLower.contains(&quot;approved&quot;) || statusLower.contains(&quot;issued&quot;))\n\t{\n\t\tstatusBadgeClass = &quot;zcs-badge-green&quot;;\n\t\tstatusIcon = &quot;ui-1-check-circle-08&quot;;\n\t}\n\telse if(statusLower.contains(&quot;reject&quot;) || statusLower.contains(&quot;denied&quot;))\n\t{\n\t\tstatusBadgeClass = &quot;zcs-badge-red&quot;;\n\t\tstatusIcon = &quot;ui-1-circle-remove&quot;;\n\t}\n\tif(applicationFound == true)\n\t{\n\t\tformParams = &quot;recLinkID=&quot; + applicationIdUrl + &quot;&amp;viewLinkName=All_Applications&amp;From_Page=true&amp;Show_Value=&quot; + selectedStep + &quot;&amp;loadIn=&quot; + containerName + &quot;&amp;zc_Header=false&quot;;\n\t}\n\telse\n\t{\n\t\tformParams = &quot;zc_SubmitVal=Save&amp;zc_Header=false&amp;From_Page=true&amp;Show_Value=0&amp;loadIn=&quot; + containerName;\n\t}\n%&gt;\n&lt;style&gt;\n/* Public Application Wizard scoped styles. ZCS component ids adapted: zcs-global, vertical-tab-vertical-tab-simple, layout-wizard-sample-1, header-heading-with-back, badge-badge-with-icon, button-primary-button. */\n.paw,.paw *{box-sizing:border-box}.paw{--paw-bg:#f5f7fb;--paw-card:#fff;--paw-border:var(--zcs_tertiary_border_color,#e5e7eb);--paw-primary:var(--zcs_primary_text_color,#111827);--paw-secondary:var(--zcs_secondary_text_color,#4b5563);--paw-tertiary:var(--zcs_tertiary_text_color,#8a94a6);--paw-brand:var(--zcs_brand_color,#2563eb);--paw-brand-light:var(--zcs_brand_light_color,#eff6ff);font-family:Inter,Arial,sans-serif;color:var(--paw-primary);background:linear-gradient(180deg,#f7f9ff 0%,var(--paw-bg) 58%,#fff 100%);min-height:100%;padding:24px}.paw a{text-decoration:none}.paw .zcs-flex{display:flex}.paw .zcs-inline-flex{display:inline-flex}.paw .zcs-direction-column{flex-direction:column}.paw .zcs-align-items-center{align-items:center}.paw .zcs-align-items-start{align-items:flex-start}.paw .zcs-justify-center{justify-content:center}.paw .zcs-justify-space-between{justify-content:space-between}.paw .zcs-col-common{flex:1 1 0}.paw .zcs-no-shrink{flex-shrink:0}.paw .zcs-relative{position:relative}.paw .zcs-absolute{position:absolute}.paw .zcs-w-full{width:100%}.paw .zcs-wh-full{width:100%;height:100%}.paw .zcs-overflow-auto{overflow:auto}.paw .zcs-overflow-hidden{overflow:hidden}.paw .zcs-box-border{box-sizing:border-box}.paw .zcs-gap-4{gap:.25rem}.paw .zcs-gap-6{gap:.375rem}.paw .zcs-gap-8{gap:.5rem}.paw .zcs-gap-10{gap:.625rem}.paw .zcs-gap-12{gap:.75rem}.paw .zcs-gap-16{gap:1rem}.paw .zcs-gap-20{gap:1.25rem}.paw .zcs-gap-24{gap:1.5rem}.paw .zcs-p-0{padding:0}.paw .zcs-p-8{padding:.5rem}.paw .zcs-p-10{padding:.625rem}.paw .zcs-p-12{padding:.75rem}.paw .zcs-p-16{padding:1rem}.paw .zcs-p-20{padding:1.25rem}.paw .zcs-p-24{padding:1.5rem}.paw .zcs-px-10{padding-left:.625rem;padding-right:.625rem}.paw .zcs-px-12{padding-left:.75rem;padding-right:.75rem}.paw .zcs-px-16{padding-left:1rem;padding-right:1rem}.paw .zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.paw .zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.paw .zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.paw .zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.paw .zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.paw .zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.paw .zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.paw .zcs-py-16{padding-top:1rem;padding-bottom:1rem}.paw .zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.paw .zcs-m-0{margin:0}.paw .zcs-mt-0{margin-top:0}.paw .zcs-mb-8{margin-bottom:.5rem}.paw .zcs-mb-12{margin-bottom:.75rem}.paw .zcs-mb-16{margin-bottom:1rem}.paw .zcs-mb-20{margin-bottom:1.25rem}.paw .zcs-mx-0{margin-left:0;margin-right:0}.paw .zcs-rounded-sm{border-radius:.25rem}.paw .zcs-rounded-md{border-radius:.375rem}.paw .zcs-rounded-lg{border-radius:.5rem}.paw .zcs-rounded-xl{border-radius:.75rem}.paw .zcs-rounded-2xl{border-radius:1rem}.paw .zcs-rounded-half{border-radius:50%}.paw .zcs-font-11{font-size:.6875rem}.paw .zcs-font-12{font-size:.75rem}.paw .zcs-font-13{font-size:.8125rem}.paw .zcs-font-14{font-size:.875rem}.paw .zcs-font-15{font-size:.9375rem}.paw .zcs-font-16{font-size:1rem}.paw .zcs-font-18{font-size:1.125rem}.paw .zcs-font-20{font-size:1.25rem}.paw .zcs-font-22{font-size:1.375rem}.paw .zcs-font-24{font-size:1.5rem}.paw .zcs-font-normal{font-weight:400}.paw .zcs-font-medium{font-weight:500}.paw .zcs-font-semibold{font-weight:600}.paw .zcs-font-bold{font-weight:700}.paw .zcs-lh-body{line-height:1.5}.paw .zcs-lh-heading{line-height:1.25}.paw .zcs-uppercase{text-transform:uppercase}.paw .zcs-text-center{text-align:center}.paw .zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.paw .zcs-color-primary{color:var(--paw-primary)}.paw .zcs-color-secondary{color:var(--paw-secondary)}.paw .zcs-color-tertiary{color:var(--paw-tertiary)}.paw .zcs-color-white{color:#fff}.paw .zcs-card{background:var(--paw-card);border:1px solid var(--paw-border);border-radius:16px}.paw-shell{max-width:1500px;margin:0 auto;min-height:calc(100vh - 48px);display:flex;flex-direction:column;gap:16px}.paw .zcs-page-header{border:1px solid rgba(255,255,255,.2);border-radius:24px;background:radial-gradient(circle at 88% 12%,rgba(255,255,255,.25),transparent 28%),linear-gradient(135deg,#0f2f66 0%,var(--paw-brand) 62%,#14b8a6 126%);color:#fff;box-shadow:0 20px 45px rgba(37,99,235,.18)}.paw .zcs-page-header h5{color:#fff;font-size:24px}.paw .zcs-page-header .paw-header-copy{margin:4px 0 0;color:rgba(255,255,255,.84);font-size:13px;line-height:1.5}.paw .zcs-back{width:38px;height:38px;border-radius:12px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center}.paw .zcs-back:hover{background:rgba(255,255,255,.24)}.paw .zcs-back-icon{color:#fff}.paw-header-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.paw .zcs-button{width:auto;min-width:5rem;min-height:36px;border:0}.paw .zcs-primary-button{background:var(--paw-brand);color:var(--zcs_brand_foreground_color,#fff)}.paw .zcs-primary-button:hover{background:var(--zcs_brand_dark_color,#1d4ed8)}.paw .zcs-primary-outline-button{border:1px solid var(--paw-brand);background:#fff;color:var(--paw-brand)}.paw .zcs-primary-outline-button:hover{background:var(--paw-brand-light)}.paw .zcs-button-icon{width:16px;max-height:16px}.paw .zcs-badge{width:auto}.paw .zcs-badge-filled-outline{border:1px solid}.paw .zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.paw .zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.paw .zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#b8770d}.paw .zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.paw .zcs-badge-theme{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--paw-brand);color:var(--paw-brand)}.paw-summary{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;padding:16px 18px;background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04)}.paw-summary-title{display:flex;align-items:center;gap:12px}.paw-summary-icon{width:44px;height:44px;border-radius:14px;background:var(--paw-brand-light);color:var(--paw-brand);display:flex;align-items:center;justify-content:center;font-size:22px}.paw-summary h2{font-size:18px;margin:0;color:var(--paw-primary)}.paw-summary p{font-size:12px;color:var(--paw-secondary);line-height:1.5;margin:4px 0 0}.paw-summary-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.paw-progress{height:8px;border-radius:999px;background:#eef2f7;overflow:hidden;margin-top:10px;max-width:460px}.paw-progress span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--paw-brand),#14b8a6)}.paw .zcs-vertical-tabpanel{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden;min-height:720px}.paw .zcs-mobile-vertical-tabinput,.paw .zcs-vertical-tabinput{display:none}.paw .zcs-vertical-tabhead{width:285px;flex:0 0 285px;border-right:1px solid var(--paw-border);background:#fbfcff;list-style:none}.paw .zcs-vertical-tabbody{width:calc(100% - 285px);min-width:0;background:#fff}.paw .zcs-vertical-tabitem{list-style-type:none}.paw .zcs-vertical-tablink{position:relative;color:var(--paw-primary);border:1px solid transparent;text-decoration:none;transition:background-color .15s ease,color .15s ease,border-color .15s ease}.paw .zcs-vertical-tablink:hover{background:var(--paw-brand-light);color:var(--paw-brand)}.paw .zcs-vertical-tabitem.zcs-vertical-tabactive .zcs-vertical-tablink{background:var(--paw-brand);font-weight:700;color:#fff}.paw .zcs-vertical-tabitem.zcs-vertical-tabcomplete .zcs-vertical-tablink{border-color:#bbf7d0;background:#ecfdf5;color:#0f8f61}.paw .zcs-vertical-tabitem.zcs-vertical-tabcomplete.zcs-vertical-tabactive .zcs-vertical-tablink{background:var(--paw-brand);border-color:var(--paw-brand);color:#fff}.paw .paw-step-disabled .zcs-vertical-tablink{cursor:not-allowed;opacity:.52;background:#f8fafc;color:var(--paw-tertiary)}.paw-step-num{width:26px;height:26px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;background:#f1f5f9;color:#64748b;font-size:12px;font-weight:800;flex:0 0 auto}.paw .zcs-vertical-tabactive .paw-step-num{background:rgba(255,255,255,.18);color:#fff}.paw .zcs-vertical-tabcomplete .paw-step-num{background:#bbf7d0;color:#0f8f61}.paw .zcs-vertical-tabcomplete.zcs-vertical-tabactive .paw-step-num{background:rgba(255,255,255,.18);color:#fff}.paw-step-text{display:flex;flex-direction:column;min-width:0}.paw-step-title{font-size:14px;line-height:1.2}.paw-step-sub{font-size:11px;line-height:1.3;opacity:.78;margin-top:2px}.paw-body-head{padding:20px 24px;border-bottom:1px solid #eef1f6;background:#fff;display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.paw-body-head h3{font-size:20px;line-height:1.25;margin:0;color:var(--paw-primary)}.paw-body-head p{font-size:13px;line-height:1.5;color:var(--paw-secondary);margin:5px 0 0}.paw-content-loadslot{min-height:620px}.paw-form-wrap{padding:18px 24px 24px}.paw-form-card{border:1px solid #e9edf5;border-radius:16px;overflow:hidden;background:#fff}.paw-form-card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid #eef1f6;background:#fbfcff}.paw-form-card-head h4{font-size:15px;margin:0;color:var(--paw-primary)}.paw-form-card-head p{font-size:12px;margin:3px 0 0;color:var(--paw-secondary)}.paw-form-embed{min-height:620px;background:#fff}.paw .paw-form-embed .zc-form-fullheight,.paw .paw-form-embed .row,.paw .paw-form-embed .form-outer-wrapper form.form-table{width:100%;height:100%}.paw .paw-form-embed .zc-form-fullheight .form-outer-wrapper{height:100%!important;border-width:0}.paw .paw-form-embed .form-outer-wrapper .zc-mobile-scroll-ctr{min-height:580px}.paw .paw-form-embed form .zc-form-scroll-wrapper{padding:0}.paw .paw-form-embed .formContainer{padding:20px 24px!important}.paw .paw-form-embed form .zc-footer-wrapper .zc-form-footer .formbutton{padding:16px 24px!important}.paw-callout{display:flex;align-items:flex-start;gap:12px;border-radius:16px;padding:14px 16px;margin:0 0 14px;border:1px solid #bfdbfe;background:#eff6ff;color:#1d4ed8}.paw-callout.success{border-color:#bbf7d0;background:#ecfdf5;color:#0f8f61}.paw-callout.warn{border-color:#fde68a;background:#fffbeb;color:#b45309}.paw-callout .paw-callout-icon{width:36px;height:36px;border-radius:12px;background:rgba(255,255,255,.65);display:flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto}.paw-callout h4{font-size:14px;margin:0;color:inherit}.paw-callout p{font-size:12px;line-height:1.5;margin:3px 0 0;color:inherit}.paw-empty{padding:28px;display:flex;align-items:flex-start;gap:14px;border:1px dashed #d7deea;background:#fbfcff;border-radius:16px;color:var(--paw-secondary)}.paw-empty-icon{width:44px;height:44px;border-radius:14px;background:var(--paw-brand-light);color:var(--paw-brand);display:flex;align-items:center;justify-content:center;font-size:22px;flex:0 0 auto}.paw-empty h3{font-size:16px;margin:0;color:var(--paw-primary)}.paw-empty p{font-size:13px;line-height:1.5;margin:5px 0 0}.paw-mobile-step-title{display:none}@media(max-width:980px){.paw{padding:14px}.paw-shell{min-height:calc(100vh - 28px)}.paw .zcs-page-header{border-radius:18px;padding:18px 20px}.paw .zcs-page-header h5{font-size:20px}.paw-summary{grid-template-columns:1fr}.paw-summary-meta{justify-content:flex-start}.paw .zcs-vertical-tabpanel{flex-direction:column;min-height:auto}.paw .zcs-vertical-tabhead{width:100%;flex:auto;border-right:0;border-bottom:1px solid var(--paw-border);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.paw .zcs-vertical-tabhead .zcs-mobile-vertical-tabheader{grid-column:1/-1}.paw .zcs-vertical-tabbody{width:100%}.paw-body-head{flex-direction:column}.paw-form-wrap{padding:14px}.paw-form-embed{min-height:680px}}@media(max-width:600px){.paw .zcs-vertical-tabhead{grid-template-columns:1fr}.paw .zcs-page-header{align-items:flex-start;flex-direction:column}.paw-header-actions{width:100%}.paw-header-actions .zcs-button{width:100%}.paw-summary-title{align-items:flex-start}.paw-body-head,.paw-form-card-head{padding:14px}.paw .zcs-vertical-tabhead{padding:14px}.paw-mobile-step-title{display:block}}\n&lt;/style&gt;\n&lt;div class=&quot;paw&quot;&gt;\n\t&lt;div class=&quot;paw-shell&quot;&gt;\n\t\t&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12 zcs-ellipsis&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Page:Public_Applicant_Action_Center&quot; class=&quot;zcs-back&quot; title=&quot;Back to action center&quot;&gt;&lt;i class=&quot;zcs-back-icon zcs-font-22 zc-li-outline arrows-1-minimal-left&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Public Application Wizard&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;paw-header-copy&quot;&gt;Guided intake for applicant, license, business, fees, compliance, review, and submission details.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paw-header-actions&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Public_Applicant_Action_Center&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-minimal-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Action center&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&quot;paw-summary&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;paw-summary-title&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;paw-summary-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h2&gt;&lt;%=appNumber%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p&gt;&lt;%=if(applicationFound == true,&quot;Application type: &quot; + appType + &quot; | Current wizard section: &quot; + selectedStepLabel,&quot;Start with the Applicant section. Save the form to create a draft application before moving through later sections.&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;paw-progress&quot;&gt;&lt;span style=&quot;width:&lt;%=progressPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;paw-summary-meta&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusBadgeClass%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline &lt;%=statusIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=appStatus%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=appPaymentStatus%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline design-pen-23&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=appSignatureStatus%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-vertical-tabpanel zcs-flex zcs-wh-full zcs-relative&quot;&gt;\n\t\t\t&lt;ul class=&quot;zcs-vertical-tabhead zcs-w-full zcs-flex zcs-direction-column zcs-gap-8 zcs-p-20 zcs-m-0 zcs-box-border zcs-overflow-auto&quot;&gt;\n\t\t\t\t&lt;h6 class=&quot;zcs-mobile-vertical-tabheader zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-mt-0 zcs-mx-0 zcs-mb-12 zcs-box-border&quot;&gt;Application steps&lt;/h6&gt;\n&lt;%\n\tstepLabels = {&quot;Applicant&quot;,&quot;License&quot;,&quot;Business&quot;,&quot;Fees&quot;,&quot;Compliance&quot;,&quot;Review&quot;,&quot;Submit&quot;};\n\tstepIndex = 0;\n\tfor each stepLabel in stepLabels\n\t{\n\t\tstepSub = &quot;Applicant and entity details&quot;;\n\t\tstepIcon = &quot;users-single-01&quot;;\n\t\tif(stepIndex == 1)\n\t\t{\n\t\t\tstepSub = &quot;Application type and license&quot;;\n\t\t\tstepIcon = &quot;business-badge&quot;;\n\t\t}\n\t\telse if(stepIndex == 2)\n\t\t{\n\t\t\tstepSub = &quot;DBA, premises, mailing&quot;;\n\t\t\tstepIcon = &quot;business-building&quot;;\n\t\t}\n\t\telse if(stepIndex == 3)\n\t\t{\n\t\t\tstepSub = &quot;Line items and totals&quot;;\n\t\t\tstepIcon = &quot;business-money-time&quot;;\n\t\t}\n\t\telse if(stepIndex == 4)\n\t\t{\n\t\t\tstepSub = &quot;Declarations and checks&quot;;\n\t\t\tstepIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t}\n\t\telse if(stepIndex == 5)\n\t\t{\n\t\t\tstepSub = &quot;Status, payment, signature&quot;;\n\t\t\tstepIcon = &quot;files-search&quot;;\n\t\t}\n\t\telse if(stepIndex == 6)\n\t\t{\n\t\t\tstepSub = &quot;Confirmation and submit&quot;;\n\t\t\tstepIcon = &quot;arrows-1-tail-right&quot;;\n\t\t}\n\t\tstepClass = &quot;zcs-vertical-tabitem zcs-relative&quot;;\n\t\tif(applicationFound == true &amp;&amp; stepIndex &lt; selectedStep)\n\t\t{\n\t\t\tstepClass = stepClass + &quot; zcs-vertical-tabcomplete&quot;;\n\t\t}\n\t\tif(stepIndex == selectedStep)\n\t\t{\n\t\t\tstepClass = stepClass + &quot; zcs-vertical-tabactive&quot;;\n\t\t}\n\t\tif(applicationFound == false &amp;&amp; stepIndex &gt; 0)\n\t\t{\n\t\t\tstepClass = stepClass + &quot; paw-step-disabled&quot;;\n\t\t}\n\t\ttargetStep = stepIndex;\n\t\tif(applicationFound == false)\n\t\t{\n\t\t\ttargetStep = 0;\n\t\t}\n\t\tstepHref = &quot;#Page:Public_Application_Wizard?Application_ID=&quot; + applicationIdUrl + &quot;&amp;amp;checkNum=&quot; + targetStep + &quot;&amp;amp;loadIn=&quot; + containerName + &quot;&amp;amp;zc_LoadIn=embed-&quot; + containerName;\n%&gt;\n\t\t\t\t&lt;li class=&quot;&lt;%=stepClass%&gt;&quot;&gt;\n\t\t\t\t\t&lt;input class=&quot;zcs-vertical-tabinput&quot; id=&quot;paw-step-&lt;%=stepIndex%&gt;&quot; name=&quot;paw-step&quot; type=&quot;checkbox&quot;&gt;\n\t\t\t\t\t&lt;label class=&quot;zcs-vertical-tablabel&quot; for=&quot;paw-step-&lt;%=stepIndex%&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-vertical-tablink zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-rounded-sm zcs-px-12 zcs-py-10 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-ellipsis zcs-cursor-pointer&quot; href=&quot;&lt;%=stepHref%&gt;&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 zcs-ellipsis&quot;&gt;&lt;span class=&quot;paw-step-num&quot;&gt;&lt;%=stepIndex + 1%&gt;&lt;/span&gt;&lt;span class=&quot;paw-step-text&quot;&gt;&lt;span class=&quot;paw-step-title&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;%=stepIcon%&gt;&quot;&gt;&lt;/i&gt; &lt;%=stepLabel%&gt;&lt;/span&gt;&lt;span class=&quot;paw-step-sub&quot;&gt;&lt;%=stepSub%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline arrows-1-minimal-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/label&gt;\n\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\tstepIndex = stepIndex + 1;\n\t}\n%&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;div class=&quot;zcs-vertical-tabbody zcs-w-full zcs-col-common zcs-flex zcs-direction-column zcs-overflow-auto&quot;&gt;\n\t\t\t\t&lt;div class=&quot;paw-body-head&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3&gt;&lt;span class=&quot;paw-mobile-step-title zcs-font-12 zcs-font-semibold zcs-uppercase zcs-color-tertiary zcs-mb-8&quot;&gt;Step &lt;%=selectedStep + 1%&gt; of 7&lt;/span&gt;&lt;%=selectedStepLabel%&gt;&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p&gt;The embedded Applications form receives From_Page=true, Show_Value=&lt;%=selectedStep%&gt;, and loadIn=&lt;%=containerName%&gt;. The Applications form workflows use Current_Stage and Show_Value to display only the fields for this step.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-settings-gear-63&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Show_Value &lt;%=selectedStep%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;paw-content-loadslot&quot; name=&quot;&lt;%=containerName%&gt;&quot; elName=&quot;zc-component&quot; pageLinkName=&quot;&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;paw-form-wrap&quot;&gt;\n&lt;%\n\tif(input.Application_ID != null &amp;&amp; applicationFound == false)\n\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paw-empty&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;paw-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h3&gt;Application not available&lt;/h3&gt;\n\t\t\t\t\t\t\t\t&lt;p&gt;The requested application could not be found for the current login. Return to the action center and open one of your draft applications, or start a new application.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Public_Applicant_Action_Center&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-minimal-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Back to action center&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Public_Application_Wizard?Application_ID=&amp;amp;checkNum=0&amp;amp;loadIn=&lt;%=containerName%&gt;&amp;amp;zc_LoadIn=embed-&lt;%=containerName%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Start new application&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tif(applicationFound == false)\n\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paw-callout warn&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;paw-callout-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div&gt;&lt;h4&gt;Create the draft first&lt;/h4&gt;&lt;p&gt;Complete and save the Applicant section. After the Applications record is created, reopen the draft from Public Applicant Action Center to continue License, Business, Fees, Compliance, Review, and Submit.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse if(selectedStep == 6 &amp;&amp; (appStatus == &quot;Submitted&quot; || appStatus == &quot;In-progress&quot; || appStatus == &quot;Ready for Approval&quot; || appStatus == &quot;Approved&quot; || appStatus == &quot;License Issued&quot;))\n\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paw-callout success&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;paw-callout-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div&gt;&lt;h4&gt;Application submitted&lt;/h4&gt;&lt;p&gt;This application has reached Submitted. Use the action center to track status, holds, payment, and signature follow-up.&lt;/p&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 zcs-mt-16&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Public_Applicant_Action_Center&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-minimal-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Return to action center&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse if(selectedStep == 6)\n\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paw-callout&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;paw-callout-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div&gt;&lt;h4&gt;Final review and submit&lt;/h4&gt;&lt;p&gt;Save this final section, then use the Submit Application action from My New License Applications when the draft is complete. After the status changes to Submitted, this step will show the return link to Public Applicant Action Center.&lt;/p&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 zcs-mt-16&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:My_New_License_Applications?ID=&lt;%=applicationIdUrl%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open submit action&lt;/span&gt;&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Public_Applicant_Action_Center&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-minimal-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Action center&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;paw-form-card&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;paw-form-card-head&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;h4&gt;Applications form section&lt;/h4&gt;&lt;p&gt;&lt;%=if(applicationFound == true,&quot;Edit mode through All_Applications using recLinkID &quot; + applicationIdUrl,&quot;Add mode with Save submit label&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Applications&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;paw-form-embed&quot; elName=&quot;zc-component&quot; zc-component=&quot;form&quot; zc-linkname=&quot;Applications&quot; formLinkName=&quot;Applications&quot; params=&quot;&lt;%=formParams%&gt;&quot; zc_MobileView=&quot;inline&quot; zc-height=&quot;700px&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Renewal_Portal
		{
					displayname = "Renewal Portal"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Renewal_Portal_Single_Snippet' elementName='Renewal_Portal_Single_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Renewal_Portal_Single_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tlicenseeEmail = ifnull(zoho.loginuserid,&quot;&quot;);\n\n\tactiveCount = Licenses[Licensee_Email == licenseeEmail &amp;&amp; License_Status == &quot;Active&quot;].count();\n\trenewalDueCount = Licenses[Licensee_Email == licenseeEmail &amp;&amp; License_Status == &quot;Renewal Due&quot;].count();\n\trenewedCount = Licenses[Licensee_Email == licenseeEmail &amp;&amp; License_Status == &quot;Renewed&quot;].count();\n\tpenalty50Status = Licenses[Licensee_Email == licenseeEmail &amp;&amp; License_Status == &quot;50% Penalty&quot;].count();\n\tpenalty100Status = Licenses[Licensee_Email == licenseeEmail &amp;&amp; License_Status == &quot;100% Penalty&quot;].count();\n\tsuspendedCount = Licenses[Licensee_Email == licenseeEmail &amp;&amp; License_Status == &quot;Suspended&quot;].count();\n\tclosedCount = Licenses[Licensee_Email == licenseeEmail &amp;&amp; License_Status == &quot;Closed&quot;].count();\n\tterminatedCount = Licenses[Licensee_Email == licenseeEmail &amp;&amp; License_Status == &quot;Terminated&quot;].count();\n\n\tpenalty50Stage = Licenses[Licensee_Email == licenseeEmail &amp;&amp; Penalty_Stage == &quot;50%&quot;].count();\n\tpenalty100Stage = Licenses[Licensee_Email == licenseeEmail &amp;&amp; Penalty_Stage == &quot;100%&quot;].count();\n\tpenalty50 = penalty50Status;\n\tif(penalty50Stage &gt; penalty50)\n\t{\n\t\tpenalty50 = penalty50Stage;\n\t}\n\tpenalty100 = penalty100Status;\n\tif(penalty100Stage &gt; penalty100)\n\t{\n\t\tpenalty100 = penalty100Stage;\n\t}\n\tpenaltyTotal = penalty50 + penalty100;\n\trenewable = renewalDueCount + penalty50Status + penalty100Status;\n\n\tbatchCount = Renewal_Batches[Licensee_Email == licenseeEmail].count();\n\topenBatches = Renewal_Batches[Licensee_Email == licenseeEmail &amp;&amp; Batch_Status != &quot;Completed&quot; &amp;&amp; Batch_Status != &quot;Cancelled&quot;].count();\n\tcompletedRenewals = Renewal_Batches[Licensee_Email == licenseeEmail &amp;&amp; Batch_Status == &quot;Completed&quot;].count();\n\tpendingPayments = Renewal_Batches[Licensee_Email == licenseeEmail &amp;&amp; Payment_Status == &quot;Pending&quot;].count();\n\tcompletePayments = Renewal_Batches[Licensee_Email == licenseeEmail &amp;&amp; Payment_Status == &quot;Complete&quot;].count();\n\twaivedPayments = Renewal_Batches[Licensee_Email == licenseeEmail &amp;&amp; Payment_Status == &quot;Waived&quot;].count();\n\trefundedPayments = Renewal_Batches[Licensee_Email == licenseeEmail &amp;&amp; Payment_Status == &quot;Refunded&quot;].count();\n\tpendingAmount = ifnull(Renewal_Batches[Licensee_Email == licenseeEmail &amp;&amp; Payment_Status == &quot;Pending&quot;].sum(Total_Amount_Due),0);\n\n\tnoticesGenerated = Renewal_Notices[Recipient_Email == licenseeEmail &amp;&amp; Delivery_Status == &quot;Generated&quot;].count() + Renewal_Notices[Recipient_Email == licenseeEmail &amp;&amp; Delivery_Status == &quot;Sent Manually&quot;].count() + Renewal_Notices[Recipient_Email == licenseeEmail &amp;&amp; Delivery_Status == &quot;Viewed&quot;].count();\n\tnoticesDraft = Renewal_Notices[Recipient_Email == licenseeEmail &amp;&amp; Delivery_Status == &quot;Draft&quot;].count();\n\tnoticesFailed = Renewal_Notices[Recipient_Email == licenseeEmail &amp;&amp; Delivery_Status == &quot;Failed&quot;].count();\n\n\ttotalLicenseContext = activeCount + renewalDueCount + renewedCount + penalty50Status + penalty100Status + suspendedCount + closedCount + terminatedCount;\n\tactiveShare = 0;\n\trenewalShare = 0;\n\tclosedShare = 0;\n\tif(totalLicenseContext &gt; 0)\n\t{\n\t\tactiveShare = ((activeCount + renewedCount) * 100) / totalLicenseContext;\n\t\trenewalShare = ((renewalDueCount + penalty50Status + penalty100Status) * 100) / totalLicenseContext;\n\t\tclosedShare = ((suspendedCount + closedCount + terminatedCount) * 100) / totalLicenseContext;\n\t}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset included once for this page from zcs-global. */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size:16px; line-height:1.5; --column-gap:0px; }\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-14{gap:.875rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}\n/* ZCS component CSS used: badge-badge-with-icon, banner-outline-banner-with-icon, button-primary-button, card-fleets-performance-metrics, table-simple-table, notes-notes-simple. */\n.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-grey{background:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#F4660C}.zcs-toast-link:hover,.zcs-notes-text a:hover{text-decoration:underline}.zcs-outline-toast{border:1px solid}.zcs-theme-toast{background:var(--zcs_component_hover_color)}.zcs-outline-toast.zcs-theme-toast{border:1px solid var(--zcs_brand_color)}.zcs-warning-toast{background:#fef4e5;color:#663c01}.zcs-info-toast{background:#e4f6fd;color:#024361}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead tr th{background:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#F9FAFE}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}.zcs-notes-wrapper ul{list-style-type:disc}.zcs-notes-wrapper ul li::marker{color:var(--zcs_tertiary_text_color)}\n/* Renewal portal layout. */\n.abc-renewal{background:linear-gradient(180deg,#f7fbff 0%,var(--zcs-page-bg-color) 100%);color:var(--zcs-primary-text-color);font-family:Inter,Arial,sans-serif;padding:28px;min-height:100%;box-sizing:border-box}.abc-shell{max-width:1440px;margin:0 auto}.abc-hero{position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.28);border-radius:28px;background:radial-gradient(circle at 88% 12%,rgba(255,255,255,.22),transparent 28%),radial-gradient(circle at 8% 20%,rgba(20,184,166,.28),transparent 30%),linear-gradient(135deg,#0b2f5f 0%,var(--zcs_brand_color) 60%,#14b8a6 125%);color:#fff;box-shadow:0 24px 60px rgba(15,108,201,.22);padding:32px}.abc-hero h1{font-size:34px;line-height:1.12;margin:0}.abc-hero p{max-width:850px;color:rgba(255,255,255,.86);margin:12px 0 0}.abc-hero-meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.abc-hero-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.14);color:#fff;border-radius:999px;padding:7px 12px;font-size:13px}.abc-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.abc-hero-actions .zcs-button{box-shadow:0 12px 22px rgba(0,0,0,.12)}.abc-section{margin-top:18px}.abc-grid{display:grid;gap:16px}.abc-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.abc-kpi{position:relative;overflow:hidden;min-height:142px}.abc-kpi:after{content:&quot;&quot;;position:absolute;right:-28px;top:-28px;width:96px;height:96px;border-radius:50%;background:var(--abc-soft)}.abc-icon{width:46px;height:46px;border-radius:14px;background:var(--abc-soft);color:var(--abc-color);display:flex;align-items:center;justify-content:center;font-size:22px}.abc-kpi-value{font-size:32px;font-weight:800;line-height:1.1;color:var(--zcs-primary-text-color);margin-top:14px}.abc-kpi-label{font-size:13px;color:var(--zcs-teritiary-text-color);margin-top:4px}.abc-kpi-note{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:8px}.abc-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}.abc-card-head h2{font-size:18px;line-height:1.25;margin:0;color:var(--zcs-primary-text-color)}.abc-card-head p{font-size:13px;color:var(--zcs-teritiary-text-color);margin:4px 0 0}.abc-two{grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr)}.abc-status-grid{display:flex;flex-wrap:wrap;gap:9px}.abc-status-chip{display:inline-flex;align-items:center;gap:7px;border-radius:999px;padding:7px 11px;font-size:13px;font-weight:600;border:1px solid var(--chip-border);color:var(--chip-color);background:var(--chip-bg)}.abc-status-chip i{font-size:14px}.abc-progress-list{list-style:none}.abc-context-bars{display:grid;gap:18px}.abc-bar-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px;color:var(--zcs-teritiary-text-color)}.abc-bar{height:10px;border-radius:999px;background:#eef2f8;overflow:hidden}.abc-bar-fill{height:100%;border-radius:999px;background:var(--bar-color);width:var(--bar-width)}.abc-notice-card{border-left:4px solid var(--zcs_brand_color);border-radius:14px;background:linear-gradient(90deg,var(--zcs_component_hover_color),#fff);padding:16px}.abc-payment-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.abc-mini{border:1px solid #e7e7ee;border-radius:12px;padding:12px;background:#fff}.abc-mini strong{display:block;font-size:22px;color:var(--zcs-primary-text-color)}.abc-mini span{font-size:12px;color:var(--zcs-teritiary-text-color)}.abc-report-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.abc-report-card{overflow:hidden}.abc-report-body{border-top:1px solid #e7e7ee;background:#fbfdff;padding:8px}.abc-embed{min-height:400px;border:1px dashed #d7deea;border-radius:10px;background:#fff;overflow:hidden}.abc-report-card.wide{grid-column:1/-1}.abc-table-wrapper{max-height:340px}.abc-table-wrapper td,.abc-table-wrapper th{vertical-align:top}.abc-transfer-icon{width:40px;height:40px;border-radius:12px;background:#fff3e2;color:#b8770d;display:flex;align-items:center;justify-content:center;font-size:21px}.abc-muted{color:var(--zcs-teritiary-text-color)}@media(max-width:1120px){.abc-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.abc-two,.abc-report-grid{grid-template-columns:1fr}}@media(max-width:720px){.abc-renewal{padding:14px}.abc-hero{padding:22px;border-radius:20px}.abc-hero h1{font-size:28px}.abc-kpis,.abc-payment-grid{grid-template-columns:1fr}.abc-card-head{flex-direction:column}.abc-embed{min-height:360px}.abc-table-wrapper{overflow:auto}}\n&lt;/style&gt;\n&lt;div class=&quot;abc-renewal&quot;&gt;\n\t&lt;div class=&quot;abc-shell&quot;&gt;\n\t\t&lt;section class=&quot;abc-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;span class=&quot;abc-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt; Renewal workspace&lt;/span&gt;\n\t\t\t\t&lt;h1&gt;Renewal Portal&lt;/h1&gt;\n\t\t\t\t&lt;p&gt;Review renewable licenses, renewal batches, payment status, notices, and active or terminated license context before taking the next renewal action.&lt;/p&gt;\n\t\t\t\t&lt;div class=&quot;abc-hero-meta&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt; &lt;%=licenseeEmail%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; Active: &lt;%=activeCount%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Renewal due: &lt;%=renewalDueCount%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt; Terminated: &lt;%=terminatedCount%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-hero-actions&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Renewal_Batches?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-folder-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Start renewal batch&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Licensee_Portal_Licenses&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;View license list&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-section abc-grid abc-kpis&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border abc-kpi&quot; style=&quot;--abc-color:var(--zcs_brand_color);--abc-soft:var(--zcs_component_hover_color);&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=renewable%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-label&quot;&gt;Renewable licenses&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-note&quot;&gt;Renewal Due plus 50% and 100% penalty statuses.&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border abc-kpi&quot; style=&quot;--abc-color:#09598e;--abc-soft:#e4f6fd;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=batchCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-label&quot;&gt;Renewal batches&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-note&quot;&gt;Open batches: &lt;%=openBatches%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border abc-kpi&quot; style=&quot;--abc-color:#b8770d;--abc-soft:#fef4e5;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=pendingPayments%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-label&quot;&gt;Pending payments&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-note&quot;&gt;Amount due: &lt;%=pendingAmount%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border abc-kpi&quot; style=&quot;--abc-color:#179E6C;--abc-soft:#E4FCF3;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=completedRenewals%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-label&quot;&gt;Completed renewals&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-note&quot;&gt;Renewed license records: &lt;%=renewedCount%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border abc-kpi&quot; style=&quot;--abc-color:#2A6FFC;--abc-soft:#E8EFFF;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-copy-04&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=noticesGenerated%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-label&quot;&gt;Notices generated&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-note&quot;&gt;Draft: &lt;%=noticesDraft%&gt; | Failed: &lt;%=noticesFailed%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;% if(penaltyTotal &gt; 0) { %&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-p-24 zcs-box-border abc-kpi&quot; style=&quot;--abc-color:#FE455D;--abc-soft:#FDE3E6;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=penaltyTotal%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-label&quot;&gt;Penalty stages&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-kpi-note&quot;&gt;50%: &lt;%=penalty50%&gt; | 100%: &lt;%=penalty100%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;% } %&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-section abc-grid abc-two&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-card-head&quot;&gt;\n\t\t\t\t\t&lt;div&gt;&lt;h2&gt;License status context&lt;/h2&gt;&lt;p&gt;Status chips show the renewal position for your current license records.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-status-grid&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-status-chip&quot; style=&quot;--chip-bg:#E4FCF3;--chip-border:#179E6C;--chip-color:#179E6C;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Active &lt;b&gt;&lt;%=activeCount%&gt;&lt;/b&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-status-chip&quot; style=&quot;--chip-bg:#FCF4E6;--chip-border:#FAAE13;--chip-color:#b8770d;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;Renewal Due &lt;b&gt;&lt;%=renewalDueCount%&gt;&lt;/b&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-status-chip&quot; style=&quot;--chip-bg:#E4FCF3;--chip-border:#179E6C;--chip-color:#179E6C;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Renewed &lt;b&gt;&lt;%=renewedCount%&gt;&lt;/b&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-status-chip&quot; style=&quot;--chip-bg:#F8F0EB;--chip-border:#F4660C;--chip-color:#F4660C;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;50% &lt;b&gt;&lt;%=penalty50Status%&gt;&lt;/b&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-status-chip&quot; style=&quot;--chip-bg:#FDE3E6;--chip-border:#FE455D;--chip-color:#FE455D;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;100% &lt;b&gt;&lt;%=penalty100Status%&gt;&lt;/b&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-status-chip&quot; style=&quot;--chip-bg:#e8e8e8;--chip-border:#242424;--chip-color:#242424;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;Suspended &lt;b&gt;&lt;%=suspendedCount%&gt;&lt;/b&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-status-chip&quot; style=&quot;--chip-bg:#e8e8e8;--chip-border:#242424;--chip-color:#242424;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-remove&quot;&gt;&lt;/i&gt;Closed &lt;b&gt;&lt;%=closedCount%&gt;&lt;/b&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-status-chip&quot; style=&quot;--chip-bg:#FDE3E6;--chip-border:#FE455D;--chip-color:#FE455D;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;Terminated &lt;b&gt;&lt;%=terminatedCount%&gt;&lt;/b&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;ul class=&quot;abc-progress-list zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0 zcs-mt-16&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Active or renewed&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=activeShare%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=activeShare%&gt;%;background:#179E6C;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Due or penalty stage&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=renewalShare%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=renewalShare%&gt;%;background:#FAAE13;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Suspended, closed, or terminated&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=closedShare%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=closedShare%&gt;%;background:#FE455D;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-card zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-card-head&quot;&gt;\n\t\t\t\t\t&lt;div&gt;&lt;h2&gt;Payment and notice status&lt;/h2&gt;&lt;p&gt;Use this snapshot with the payment queue and generated notices below.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-payment-grid&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-mini&quot;&gt;&lt;strong&gt;&lt;%=pendingPayments%&gt;&lt;/strong&gt;&lt;span&gt;Pending&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-mini&quot;&gt;&lt;strong&gt;&lt;%=completePayments%&gt;&lt;/strong&gt;&lt;span&gt;Complete&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-mini&quot;&gt;&lt;strong&gt;&lt;%=waivedPayments%&gt;&lt;/strong&gt;&lt;span&gt;Waived&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;abc-mini&quot;&gt;&lt;strong&gt;&lt;%=refundedPayments%&gt;&lt;/strong&gt;&lt;span&gt;Refunded&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-toast zcs-outline-toast zcs-theme-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-16&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-toast-text&quot;&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;Payment records remain tied to the renewal batch. If payment is pending, review the queue before assuming a renewal is complete.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-notes-wrapper zcs-mt-16&quot;&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;span class=&quot;zcs-notes-title zcs-font-medium zcs-color-tertiary&quot;&gt;Notice context: &lt;/span&gt;Generated, sent, and viewed notices are counted as notices generated. Draft and failed notices are shown separately for follow-up.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-section&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-12 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-transfer-icon zcs-no-shrink&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-68&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-toast-text&quot;&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;&lt;b&gt;Transferred license context:&lt;/b&gt; A transferred license may appear as Terminated after the transfer issuance is completed. Use the new Active license record for all future renewals, payments, and notices.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;abc-section abc-grid abc-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border abc-report-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Licensee portal licenses&lt;/h2&gt;&lt;p&gt;Active, renewal due, renewed, closed, and terminated license records.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;License status&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-report-body&quot;&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Licensee_Portal_Licenses&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border abc-report-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Licensee renewal batches&lt;/h2&gt;&lt;p&gt;Submitted, payment pending, paid, completed, and cancelled batches.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Batches&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-report-body&quot;&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Licensee_Renewal_Batches&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border abc-report-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Pending renewal items&lt;/h2&gt;&lt;p&gt;Selected and payment-pending items requiring completion.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Pending&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-report-body&quot;&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Pending_Renewal_Items&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border abc-report-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Renewal payment queue&lt;/h2&gt;&lt;p&gt;Renewal batches waiting for payment completion.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline business-payment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Payments&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-report-body&quot;&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Renewal_Payment_Queue&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-box-border abc-report-card wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-card-head zcs-p-20 zcs-mb-0&quot;&gt;&lt;div&gt;&lt;h2&gt;Renewal notices generated&lt;/h2&gt;&lt;p&gt;Notice date, due date, penalty stage, delivery status, and recipient email.&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-single-copy-04&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Notices&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;abc-report-body&quot;&gt;&lt;div class=&quot;abc-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;All_Renewal_Notices&quot; zc-height=&quot;420px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Add_Agents_On_Success as "Audit Agent Save"
			{
			
							type =  form
							form = Add_Agents
			
							record event = on add or edit
			
							on success
							{
