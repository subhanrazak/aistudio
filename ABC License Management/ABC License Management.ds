	pages
	{
		page Accounting_Staff_Action_Center
		{
					displayname = "Accounting Staff Action Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Accounting_Staff_Action_Center_Snippet' elementName='Accounting_Staff_Action_Center_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Accounting_Staff_Action_Center_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\toperatorEmail = ifnull(zoho.loginuserid,&quot;&quot;);\n\tif(operatorEmail == &quot;&quot; || operatorEmail == null)\n\t{\n\t\toperatorEmail = &quot;Accounting operator&quot;;\n\t}\n\n\tpendingPayments = Payments[(Payment_Status == &quot;Pending&quot; || Payment_Status == &quot;Failed&quot;)] sort by Payment_Date asc;\n\trefundQueue = Payments[Refund_Requested == true &amp;&amp; Refund_Status != &quot;Completed&quot;] sort by Payment_Date asc;\n\treconQueue = Payments[Payment_Date is not null &amp;&amp; Reconciled != true &amp;&amp; (Payment_Status == &quot;Complete&quot; || Payment_Status == &quot;Refunded&quot; || Payment_Status == &quot;Void&quot;)] sort by Payment_Date asc;\n\ttodaysRecon = Payments[Payment_Date == zoho.currentdate &amp;&amp; Reconciled != true &amp;&amp; (Payment_Status == &quot;Complete&quot; || Payment_Status == &quot;Refunded&quot; || Payment_Status == &quot;Void&quot;)];\n\tauditExceptions = Audit_Log[Module == &quot;Payment&quot; &amp;&amp; (Action.contains(&quot;skipped&quot;) || Details.contains(&quot;not eligible&quot;) || Details.contains(&quot;already reconciled&quot;) || Details.contains(&quot;not in a&quot;))] sort by Event_Time desc;\n\tunpaidApplications = Applications[Payment_Status == &quot;Pending&quot; &amp;&amp; (Total_Fee_Due &gt; 0 || Total_Fee &gt; 0)] sort by Application_Submitted_Date asc;\n\tunpaidRenewals = Renewal_Batches[Payment_Status == &quot;Pending&quot; &amp;&amp; Total_Amount_Due &gt; 0] sort by Submitted_Date asc;\n\n\tpendingCount = pendingPayments.count();\n\trefundCount = refundQueue.count();\n\treconCount = reconQueue.count();\n\ttodayReconCount = todaysRecon.count();\n\tauditCount = auditExceptions.count();\n\tunpaidAppCount = unpaidApplications.count();\n\tunpaidRenewalCount = unpaidRenewals.count();\n\tunpaidTotal = unpaidAppCount + unpaidRenewalCount;\n\tpendingAmount = ifnull(pendingPayments.sum(Amount_Due),0);\n\trefundAmount = ifnull(refundQueue.sum(Refund_Amount),0);\n\treconAmount = ifnull(reconQueue.sum(Amount_Paid),0);\n\tunpaidAppAmount = ifnull(unpaidApplications.sum(Total_Fee_Due),0) + ifnull(unpaidApplications.sum(Total_Fee),0);\n\tunpaidRenewalAmount = ifnull(unpaidRenewals.sum(Total_Amount_Due),0);\n\tunpaidAmount = unpaidAppAmount + unpaidRenewalAmount;\n\tactionTotal = pendingCount + refundCount + reconCount + auditCount + unpaidTotal;\n\n\treconPct = 0;\n\tpaidTodayCount = Payments[Payment_Date == zoho.currentdate &amp;&amp; (Payment_Status == &quot;Complete&quot; || Payment_Status == &quot;Refunded&quot; || Payment_Status == &quot;Void&quot;)].count();\n\tif(paidTodayCount &gt; 0)\n\t{\n\t\treconPct = (((paidTodayCount - todayReconCount) * 100) / paidTodayCount).round(0);\n\t}\n\tif(reconPct &lt; 0)\n\t{\n\t\treconPct = 0;\n\t}\n%&gt;\n&lt;style&gt;\n/* ZCS component ids used: zcs-global, button-primary-button, badge-badge-with-icon, table-table-with-custom-action-button, card-fleets-performance-metrics. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#2563eb);--zcs-light-bg-color:var(--zcs_brand_light_color,#eaf2ff);--zcs-page-bg-color:#f5f7fb;--zcs-primary-text-color:var(--zcs_primary_text_color,#111827);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#4b5563);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#8a94a6);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e7eb);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-14{gap:.875rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-box-border{box-sizing:border-box}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}.zcs-list-none{list-style-type:none}\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#2563eb);background:#fff;color:var(--zcs_brand_color,#2563eb)}.zcs-primary-button.zcs-button:hover{background:var(--zcs_brand_dark_color,#1d4ed8)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-filled-outline.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-filled-outline.zcs-badge-grey{background:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-filled-outline.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#f4660c}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background:#f9fafe;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color,#eff6ff);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color,#2563eb)}\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.asac{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f7fbff 0%,#f5f7fb 55%,#fff 100%);min-height:100%;padding:28px;box-sizing:border-box}.asac *{box-sizing:border-box}.asac-shell{max-width:1500px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.asac-hero{position:relative;overflow:hidden;border-radius:28px;padding:30px;background:radial-gradient(circle at 84% 8%,rgba(255,255,255,.30),transparent 29%),radial-gradient(circle at 8% 16%,rgba(250,174,19,.22),transparent 30%),linear-gradient(135deg,#172033 0%,var(--zcs_brand_color,#2563eb) 58%,#0f766e 130%);color:#fff;box-shadow:0 24px 60px rgba(37,99,235,.18)}.asac-hero:after{content:&quot;&quot;;position:absolute;right:-126px;bottom:-154px;width:370px;height:370px;border-radius:50%;border:1px solid rgba(255,255,255,.20);box-shadow:0 0 0 56px rgba(255,255,255,.08),0 0 0 112px rgba(255,255,255,.04)}.asac-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.16fr) minmax(330px,.84fr);gap:24px;align-items:center}.asac-eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.15);color:#fff;border-radius:999px;padding:7px 12px;font-size:12px;font-weight:750;letter-spacing:.5px;text-transform:uppercase}.asac-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.03;letter-spacing:-.7px;margin:14px 0 10px;color:#fff}.asac-hero p{max-width:820px;color:rgba(255,255,255,.86);font-size:15px;line-height:1.65;margin:0}.asac-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.asac-hero-actions .zcs-button{box-shadow:0 10px 22px rgba(0,0,0,.14)}.asac-profile{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);border-radius:20px;padding:18px;backdrop-filter:blur(4px)}.asac-avatar{width:58px;height:58px;border-radius:18px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28px}.asac-profile h2{font-size:20px;line-height:1.2;margin:0;color:#fff}.asac-profile-line{font-size:13px;color:rgba(255,255,255,.82);display:flex;align-items:center;gap:8px;margin-top:6px}.asac-profile-kv{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.asac-kv{border:1px solid rgba(255,255,255,.18);border-radius:14px;padding:10px;background:rgba(255,255,255,.08)}.asac-kv span{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.55px;color:rgba(255,255,255,.62)}.asac-kv strong{display:block;font-size:14px;margin-top:4px;color:#fff}.asac-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 4px -2px}.asac-section-title h2{font-size:11px;font-weight:800;color:#8a94a6;text-transform:uppercase;letter-spacing:1.1px;margin:0;display:flex;align-items:center;gap:8px}.asac-section-title h2:before{content:&quot;&quot;;width:4px;height:15px;border-radius:4px;background:linear-gradient(180deg,var(--zcs_brand_color,#2563eb),#14b8a6)}.asac-section-sub{font-size:12px;color:#8a94a6}.asac-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.asac-kpi{position:relative;overflow:hidden;background:#fff;border:1px solid #e9edf5;border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);min-height:145px}.asac-kpi:after{content:&quot;&quot;;position:absolute;right:-42px;top:-42px;width:120px;height:120px;border-radius:50%;background:var(--soft)}.asac-kpi-icon{position:relative;z-index:1;width:42px;height:42px;border-radius:14px;background:var(--soft);color:var(--tone);display:flex;align-items:center;justify-content:center;font-size:21px}.asac-kpi-value{position:relative;z-index:1;font-size:32px;line-height:1;font-weight:800;color:#111827;margin-top:16px;letter-spacing:-.5px}.asac-kpi-label{position:relative;z-index:1;font-size:12px;color:#64748b;margin-top:5px;font-weight:650}.asac-kpi-note{position:relative;z-index:1;font-size:11px;color:#8a94a6;margin-top:6px}.asac-grid-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.58fr);gap:14px}.asac-card{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.asac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.asac-card-title{display:flex;gap:12px;align-items:flex-start}.asac-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.asac-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.asac-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.asac-card-body{padding:18px}.asac-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.asac-action{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:12px}.asac-action.top{border-color:rgba(250,174,19,.45);background:linear-gradient(180deg,#fff,#fffbeb)}.asac-action-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.asac-action-title h4{font-size:15px;margin:0;color:#111827}.asac-action-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.asac-action-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.asac-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:750;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.asac-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb)}.asac-link:hover{text-decoration:underline}.asac-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.asac-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.asac-list{display:flex;flex-direction:column;gap:10px}.asac-item{border:1px solid #e9edf5;border-radius:14px;padding:12px;background:#fff}.asac-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.asac-item-title{font-size:14px;font-weight:800;color:#111827}.asac-item-meta{font-size:12px;color:#64748b;margin-top:3px}.asac-item-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.asac-health-list{list-style:none}.asac-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.asac-report-card.wide{grid-column:1/-1}.asac-embed{border-top:1px solid #eef1f6;background:#fff;padding:8px}.asac-embed-box{min-height:360px;border:1px dashed #d7deea;border-radius:12px;background:#fff;overflow:hidden}.asac-table-wrap{max-height:480px;overflow:auto}.asac-table-wrap table{min-width:980px}.asac-foot-space{height:12px}@media(max-width:1240px){.asac-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.asac-hero-grid,.asac-grid-two{grid-template-columns:1fr}.asac-action-grid{grid-template-columns:1fr}}@media(max-width:780px){.asac{padding:14px}.asac-hero{padding:22px;border-radius:20px}.asac-kpis,.asac-report-grid{grid-template-columns:1fr}.asac-profile-kv{grid-template-columns:1fr}.asac-section-title{align-items:flex-start;flex-direction:column}.asac-card-head{flex-direction:column}.asac-hero-actions .zcs-button{width:100%}.asac-report-card.wide{grid-column:auto}}\n&lt;/style&gt;\n&lt;div class=&quot;asac&quot;&gt;\n\t&lt;div class=&quot;asac-shell&quot;&gt;\n\t\t&lt;section class=&quot;asac-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;asac-hero-grid&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;span class=&quot;asac-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline business-wallet-44&quot;&gt;&lt;/i&gt; Accounting staff action center&lt;/span&gt;\n\t\t\t\t\t&lt;h1&gt;Payment, refund, and reconciliation queue&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Hello &lt;%=operatorEmail%&gt;. This workspace uses zoho.loginuserid for operator display and brings pending payments, refunds, daily reconciliation, payment audit exceptions, and unpaid application or renewal fees into one accounting queue.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;asac-hero-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Pending payments&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Refund_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-handout&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Refund queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Daily_Reconciliation?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-calculator&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Daily reconciliation&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;aside class=&quot;asac-profile&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;asac-avatar&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-common&quot;&gt;\n\t\t\t\t\t\t\t&lt;h2&gt;Accounting operator&lt;/h2&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;asac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-83&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=operatorEmail%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;asac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=actionTotal%&gt; open accounting signals&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;asac-profile-kv&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;asac-kv&quot;&gt;&lt;span&gt;Payment exposure&lt;/span&gt;&lt;strong&gt;$&lt;%=pendingAmount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;asac-kv&quot;&gt;&lt;span&gt;Refund exposure&lt;/span&gt;&lt;strong&gt;$&lt;%=refundAmount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;asac-kv&quot;&gt;&lt;span&gt;Recon amount&lt;/span&gt;&lt;strong&gt;$&lt;%=reconAmount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;asac-kv&quot;&gt;&lt;span&gt;Unpaid fees&lt;/span&gt;&lt;strong&gt;$&lt;%=unpaidAmount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;asac-section-title&quot;&gt;&lt;h2&gt;Accounting snapshot&lt;/h2&gt;&lt;span class=&quot;asac-section-sub&quot;&gt;Counts are live from Payments, Audit Log, Applications, and Renewal Batches.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;asac-kpis&quot;&gt;\n\t\t\t&lt;div class=&quot;asac-kpi&quot; style=&quot;--tone:#2a6ffc;--soft:#e8efff;&quot;&gt;&lt;div class=&quot;asac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-value&quot;&gt;&lt;%=pendingCount%&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-label&quot;&gt;Pending payments&lt;/div&gt;&lt;div class=&quot;asac-kpi-note&quot;&gt;Pending or failed status&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;asac-kpi&quot; style=&quot;--tone:#f4660c;--soft:#f8f0eb;&quot;&gt;&lt;div class=&quot;asac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-handout&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-value&quot;&gt;&lt;%=refundCount%&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-label&quot;&gt;Refund queue&lt;/div&gt;&lt;div class=&quot;asac-kpi-note&quot;&gt;Requested, approved, or denied&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;asac-kpi&quot; style=&quot;--tone:#1094c5;--soft:#e4f6fd;&quot;&gt;&lt;div class=&quot;asac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-calculator&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-value&quot;&gt;&lt;%=todayReconCount%&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-label&quot;&gt;Today unreconciled&lt;/div&gt;&lt;div class=&quot;asac-kpi-note&quot;&gt;Paid today and not reconciled&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;asac-kpi&quot; style=&quot;--tone:#7c3aed;--soft:#f1eaff;&quot;&gt;&lt;div class=&quot;asac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-value&quot;&gt;&lt;%=auditCount%&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-label&quot;&gt;Payment audit exceptions&lt;/div&gt;&lt;div class=&quot;asac-kpi-note&quot;&gt;Skipped or exception audit entries&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;asac-kpi&quot; style=&quot;--tone:#b8770d;--soft:#fcf4e6;&quot;&gt;&lt;div class=&quot;asac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-value&quot;&gt;&lt;%=unpaidAppCount%&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-label&quot;&gt;Unpaid applications&lt;/div&gt;&lt;div class=&quot;asac-kpi-note&quot;&gt;Application payment status pending&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;asac-kpi&quot; style=&quot;--tone:#179e6c;--soft:#e4fcf3;&quot;&gt;&lt;div class=&quot;asac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-value&quot;&gt;&lt;%=unpaidRenewalCount%&gt;&lt;/div&gt;&lt;div class=&quot;asac-kpi-label&quot;&gt;Unpaid renewals&lt;/div&gt;&lt;div class=&quot;asac-kpi-note&quot;&gt;Renewal payment status pending&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;asac-grid-two&quot;&gt;\n\t\t\t&lt;div class=&quot;asac-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;asac-card-head&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;asac-card-title&quot;&gt;&lt;div class=&quot;asac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Action queues&lt;/h3&gt;&lt;p&gt;Open the action-enabled reports for row buttons: Mark Paid, Request Refund, Approve Refund, Reject Refund, and Reconcile Payment.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(actionTotal &gt; 0,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-green&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline &lt;%=if(actionTotal &gt; 0,&quot;ui-2-time&quot;,&quot;ui-1-check-circle-08&quot;)%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=if(actionTotal &gt; 0,actionTotal + &quot; signals&quot;,&quot;No open signals&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;asac-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;asac-action-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;asac-action &lt;%=if(pendingCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;asac-action-title&quot;&gt;&lt;h4&gt;Mark paid&lt;/h4&gt;&lt;span class=&quot;asac-chip &lt;%=if(pendingCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;%=pendingCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;asac-action-copy&quot;&gt;Review payments with Pending or Failed status and use the Mark Paid report action after confirmation.&lt;/p&gt;&lt;div class=&quot;asac-action-links&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open Pending Payments&lt;/a&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:All_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-wallet-44&quot;&gt;&lt;/i&gt;All payments&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;asac-action &lt;%=if(refundCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;asac-action-title&quot;&gt;&lt;h4&gt;Refund decisions&lt;/h4&gt;&lt;span class=&quot;asac-chip &lt;%=if(refundCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline business-handout&quot;&gt;&lt;/i&gt;&lt;%=refundCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;asac-action-copy&quot;&gt;Use the Refund Queue to approve or reject refund requests; use All Payments to request new refunds.&lt;/p&gt;&lt;div class=&quot;asac-action-links&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Refund_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-handout&quot;&gt;&lt;/i&gt;Refund queue&lt;/a&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:All_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;Request refund&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;asac-action &lt;%=if(reconCount &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;asac-action-title&quot;&gt;&lt;h4&gt;Daily reconciliation&lt;/h4&gt;&lt;span class=&quot;asac-chip &lt;%=if(reconCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline business-calculator&quot;&gt;&lt;/i&gt;&lt;%=reconCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;asac-action-copy&quot;&gt;Reconcile completed, refunded, or void payments that have a payment date and have not been checked off.&lt;/p&gt;&lt;div class=&quot;asac-action-links&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Daily_Reconciliation?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-calculator&quot;&gt;&lt;/i&gt;Reconcile payment&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;asac-action &lt;%=if(unpaidTotal &gt; 0,&quot;top&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;div class=&quot;asac-action-title&quot;&gt;&lt;h4&gt;Unpaid application and renewal fees&lt;/h4&gt;&lt;span class=&quot;asac-chip &lt;%=if(unpaidTotal &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-time&quot;&gt;&lt;/i&gt;&lt;%=unpaidTotal%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;asac-action-copy&quot;&gt;Review applications and renewal batches with pending fee balances, then create or update matching payment records.&lt;/p&gt;&lt;div class=&quot;asac-action-links&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:All_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;Applications&lt;/a&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-time&quot;&gt;&lt;/i&gt;Renewal payments&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;i class=&quot;zc-li-outline business-progress&quot;&gt;&lt;/i&gt; Reconciliation health&lt;/h5&gt;\n\t\t\t\t&lt;ul class=&quot;asac-health-list zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Today reconciled share&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=reconPct%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=reconPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Pending payment pressure&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=pendingCount%&gt; records&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=if(pendingCount &gt; 10,&quot;100&quot;,pendingCount * 10)%&gt;%;background:&lt;%=if(pendingCount &gt; 0,&quot;#faae13&quot;,&quot;#179e6c&quot;)%&gt;;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Audit exception pressure&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=auditCount%&gt; records&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=if(auditCount &gt; 10,&quot;100&quot;,auditCount * 10)%&gt;%;background:&lt;%=if(auditCount &gt; 0,&quot;#fe455d&quot;,&quot;#179e6c&quot;)%&gt;;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;div class=&quot;asac-list&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Payment_Audit?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open payment audit&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;asac-link&quot; href=&quot;#Form:Payments?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;Add payment record&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-time&quot;&gt;&lt;/i&gt;Renewal payment queue&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;asac-section-title&quot;&gt;&lt;h2&gt;Pending payment worklist&lt;/h2&gt;&lt;span class=&quot;asac-section-sub&quot;&gt;&lt;%=pendingCount%&gt; payment records pending or failed.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;asac-card&quot;&gt;\n\t\t\t&lt;div class=&quot;asac-card-head&quot;&gt;&lt;div class=&quot;asac-card-title&quot;&gt;&lt;div class=&quot;asac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Pending payments&lt;/h3&gt;&lt;p&gt;Use report links for action-enabled Mark Paid workflow; record links open payment details.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Full payment queue&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;asac-card-body&quot;&gt;\n&lt;%\n\tif(pendingPayments.count() == 0)\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;asac-empty&quot;&gt;&lt;div class=&quot;asac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;No pending or failed payments are currently open.&lt;/strong&gt;&lt;br&gt;Use All Payments for completed or historical payment review.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper asac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Payment&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Module&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Entity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Due&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tpayRows = 0;\n\t\tfor each pay in pendingPayments\n\t\t{\n\t\t\tif(payRows &lt; 10)\n\t\t\t{\n\t\t\t\tstatusCls = if(pay.Payment_Status == &quot;Failed&quot;,&quot;chip-bad&quot;,&quot;chip-warn&quot;);\n%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(pay.Payment_Reference,&quot;Payment&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(pay.Payment_Module,&quot;Module&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(pay.Entity.Entity_Name,&quot;Entity not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;$&lt;%=ifnull(pay.Amount_Due,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;asac-chip &lt;%=statusCls%&gt;&quot;&gt;&lt;%=ifnull(pay.Payment_Status,&quot;Pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Pending_Payments?ID=&lt;%=pay.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Mark paid&lt;/a&gt; &lt;a class=&quot;asac-link&quot; href=&quot;#Form:Payments?recLinkID=&lt;%=pay.ID%&gt;&amp;amp;viewLinkName=All_Payments&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Record&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\tpayRows = payRows + 1;\n\t\t}\n%&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;asac-section-title&quot;&gt;&lt;h2&gt;Focused accounting sections&lt;/h2&gt;&lt;span class=&quot;asac-section-sub&quot;&gt;Refunds, reconciliation, audit exceptions, and unpaid fees.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;asac-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;asac-card&quot;&gt;&lt;div class=&quot;asac-card-head&quot;&gt;&lt;div class=&quot;asac-card-title&quot;&gt;&lt;div class=&quot;asac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-handout&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Refund queue&lt;/h3&gt;&lt;p&gt;Payments requesting refund action.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;asac-chip &lt;%=if(refundCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=refundCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;asac-card-body&quot;&gt;&lt;div class=&quot;asac-list&quot;&gt;\n&lt;% if(refundQueue.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;asac-empty&quot;&gt;&lt;div class=&quot;asac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No refund records are waiting for accounting action.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { refundRows = 0; for each pay in refundQueue { if(refundRows &lt; 5) { refundCls = if(pay.Refund_Status == &quot;Denied&quot;,&quot;chip-bad&quot;,if(pay.Refund_Status == &quot;Approved&quot;,&quot;chip-info&quot;,&quot;chip-warn&quot;)); %&gt;\n\t\t\t\t&lt;div class=&quot;asac-item&quot;&gt;&lt;div class=&quot;asac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;asac-item-title&quot;&gt;&lt;%=ifnull(pay.Payment_Reference,&quot;Payment&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-meta&quot;&gt;Refund $&lt;%=ifnull(pay.Refund_Amount,0)%&gt; | Paid $&lt;%=ifnull(pay.Amount_Paid,0)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;asac-chip &lt;%=refundCls%&gt;&quot;&gt;&lt;%=ifnull(pay.Refund_Status,&quot;Requested&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-actions&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Refund_Queue?ID=&lt;%=pay.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-handout&quot;&gt;&lt;/i&gt;Refund actions&lt;/a&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Form:Payments?recLinkID=&lt;%=pay.ID%&gt;&amp;amp;viewLinkName=All_Payments&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Record&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } refundRows = refundRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;asac-card&quot;&gt;&lt;div class=&quot;asac-card-head&quot;&gt;&lt;div class=&quot;asac-card-title&quot;&gt;&lt;div class=&quot;asac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-calculator&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Daily reconciliation&lt;/h3&gt;&lt;p&gt;Unreconciled completed, refunded, or void payment rows.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;asac-chip &lt;%=if(reconCount &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=reconCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;asac-card-body&quot;&gt;&lt;div class=&quot;asac-list&quot;&gt;\n&lt;% if(reconQueue.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;asac-empty&quot;&gt;&lt;div class=&quot;asac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No unreconciled payment records are currently in scope.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { reconRows = 0; for each pay in reconQueue { if(reconRows &lt; 5) { %&gt;\n\t\t\t\t&lt;div class=&quot;asac-item&quot;&gt;&lt;div class=&quot;asac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;asac-item-title&quot;&gt;&lt;%=ifnull(pay.Payment_Reference,&quot;Payment&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-meta&quot;&gt;&lt;%=ifnull(pay.Payment_Date,&quot;No payment date&quot;)%&gt; | &lt;%=ifnull(pay.Payment_Method,&quot;Method not set&quot;)%&gt; | $&lt;%=ifnull(pay.Amount_Paid,0)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;asac-chip chip-warn&quot;&gt;Unreconciled&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-actions&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Daily_Reconciliation?ID=&lt;%=pay.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline business-calculator&quot;&gt;&lt;/i&gt;Reconcile&lt;/a&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Form:Payments?recLinkID=&lt;%=pay.ID%&gt;&amp;amp;viewLinkName=All_Payments&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;Record&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } reconRows = reconRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;asac-card&quot;&gt;&lt;div class=&quot;asac-card-head&quot;&gt;&lt;div class=&quot;asac-card-title&quot;&gt;&lt;div class=&quot;asac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Payment audit exceptions&lt;/h3&gt;&lt;p&gt;Payment audit records containing skipped or exception action detail.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;asac-chip &lt;%=if(auditCount &gt; 0,&quot;chip-bad&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=auditCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;asac-card-body&quot;&gt;&lt;div class=&quot;asac-list&quot;&gt;\n&lt;% if(auditExceptions.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;asac-empty&quot;&gt;&lt;div class=&quot;asac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No payment audit exception records were found.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { auditRows = 0; for each aud in auditExceptions { if(auditRows &lt; 5) { %&gt;\n\t\t\t\t&lt;div class=&quot;asac-item&quot;&gt;&lt;div class=&quot;asac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;asac-item-title&quot;&gt;&lt;%=ifnull(aud.Action,&quot;Audit action&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-meta&quot;&gt;&lt;%=ifnull(aud.Event_Time,&quot;No time&quot;)%&gt; | Record &lt;%=ifnull(aud.Source_Record_ID,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;asac-chip chip-bad&quot;&gt;Audit&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-actions&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Payment_Audit?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open audit&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } auditRows = auditRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;asac-card&quot;&gt;&lt;div class=&quot;asac-card-head&quot;&gt;&lt;div class=&quot;asac-card-title&quot;&gt;&lt;div class=&quot;asac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Applications and renewals with unpaid fees&lt;/h3&gt;&lt;p&gt;Pending application fee and renewal batch balances.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;asac-chip &lt;%=if(unpaidTotal &gt; 0,&quot;chip-warn&quot;,&quot;chip-ok&quot;)%&gt;&quot;&gt;&lt;%=unpaidTotal%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;asac-card-body&quot;&gt;&lt;div class=&quot;asac-list&quot;&gt;\n&lt;% if(unpaidApplications.count() == 0 &amp;&amp; unpaidRenewals.count() == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;asac-empty&quot;&gt;&lt;div class=&quot;asac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;No unpaid application or renewal fee records are currently open.&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { appRows = 0; for each app in unpaidApplications { if(appRows &lt; 4) { appFee = ifnull(app.Total_Fee_Due,0); if(appFee == 0) { appFee = ifnull(app.Total_Fee,0); } %&gt;\n\t\t\t\t&lt;div class=&quot;asac-item&quot;&gt;&lt;div class=&quot;asac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;asac-item-title&quot;&gt;&lt;%=ifnull(app.Application_Number,ifnull(app.Application_Reference,&quot;Application&quot;))%&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-meta&quot;&gt;&lt;%=ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,&quot;Applicant&quot;))%&gt; | Fee $&lt;%=appFee%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;asac-chip chip-warn&quot;&gt;Application&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-actions&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:All_Applications?ID=&lt;%=app.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;Application&lt;/a&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Form:Payments?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-11&quot;&gt;&lt;/i&gt;Add payment&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } appRows = appRows + 1; } renewalRows = 0; for each batch in unpaidRenewals { if(renewalRows &lt; 4) { %&gt;\n\t\t\t\t&lt;div class=&quot;asac-item&quot;&gt;&lt;div class=&quot;asac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;asac-item-title&quot;&gt;&lt;%=ifnull(batch.Renewal_Batch_Number,&quot;Renewal batch&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-meta&quot;&gt;&lt;%=ifnull(batch.Licensee_Email,&quot;Licensee email not set&quot;)%&gt; | Due $&lt;%=ifnull(batch.Total_Amount_Due,0)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;asac-chip chip-warn&quot;&gt;Renewal&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;asac-item-actions&quot;&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Renewal_Payment_Queue?ID=&lt;%=batch.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-time&quot;&gt;&lt;/i&gt;Renewal actions&lt;/a&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Form:Payments?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-11&quot;&gt;&lt;/i&gt;Add payment&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } renewalRows = renewalRows + 1; } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;asac-section-title&quot;&gt;&lt;h2&gt;Embedded action reports&lt;/h2&gt;&lt;span class=&quot;asac-section-sub&quot;&gt;Native reports are reachable in-page and by dialog links for row-level workflow buttons.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;asac-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;asac-card wide asac-report-card&quot;&gt;&lt;div class=&quot;asac-card-head&quot;&gt;&lt;div class=&quot;asac-card-title&quot;&gt;&lt;div class=&quot;asac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Pending Payments report&lt;/h3&gt;&lt;p&gt;Action-enabled report with Mark Paid row button.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Pending_Payments?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Search=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open full report&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;asac-embed&quot;&gt;&lt;div class=&quot;asac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Pending_Payments&quot; zc-height=&quot;520px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;asac-card&quot;&gt;&lt;div class=&quot;asac-card-head&quot;&gt;&lt;div class=&quot;asac-card-title&quot;&gt;&lt;div class=&quot;asac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-handout&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Refund Queue report&lt;/h3&gt;&lt;p&gt;Approve Refund and Reject Refund actions.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Refund_Queue?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;asac-embed&quot;&gt;&lt;div class=&quot;asac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Refund_Queue&quot; zc-height=&quot;420px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;asac-card&quot;&gt;&lt;div class=&quot;asac-card-head&quot;&gt;&lt;div class=&quot;asac-card-title&quot;&gt;&lt;div class=&quot;asac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-calculator&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Daily Reconciliation report&lt;/h3&gt;&lt;p&gt;Reconcile Payment action.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;asac-link&quot; href=&quot;#Report:Daily_Reconciliation?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-search&quot;&gt;&lt;/i&gt;Open&lt;/a&gt;&lt;/div&gt;&lt;div class=&quot;asac-embed&quot;&gt;&lt;div class=&quot;asac-embed-box&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Daily_Reconciliation&quot; zc-height=&quot;420px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;div class=&quot;asac-foot-space&quot;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Enforcement_Agent_Action_Center
		{
					displayname = "Enforcement Agent Action Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Enforcement_Agent_Action_Center_Snippet' elementName='Enforcement_Agent_Action_Center_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Enforcement_Agent_Action_Center_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\tagentEmail = ifnull(zoho.loginuserid,&quot;&quot;);\n\tif(agentEmail == &quot;&quot; || agentEmail == null)\n\t{\n\t\tagentEmail = &quot;Current user&quot;;\n\t}\n\n\tagentName = agentEmail;\n\tagentRole = &quot;Enforcement Agent&quot;;\n\tagentRow = Add_Agents[Agent_Email == agentEmail &amp;&amp; Active == true];\n\tif(agentRow.count() &gt; 0)\n\t{\n\t\tfirstName = ifnull(agentRow.Agent_Name.first_name,&quot;&quot;);\n\t\tlastName = ifnull(agentRow.Agent_Name.last_name,&quot;&quot;);\n\t\tfullName = (firstName + &quot; &quot; + lastName).trim();\n\t\tif(fullName != &quot;&quot;)\n\t\t{\n\t\t\tagentName = fullName;\n\t\t}\n\t\tagentRole = ifnull(agentRow.Agent_Role,&quot;Enforcement Agent&quot;);\n\t}\n\n\tassignedCases = Cases[(Assigned_Agent_Email == agentEmail || Supervising_Agent_Email == agentEmail) &amp;&amp; Case_Status != &quot;Closed&quot;] sort by Initial_Visit_Due_Date asc;\n\tupcomingVisits = Field_Visits[Agent_Email == agentEmail &amp;&amp; Visit_Date_Time &gt;= zoho.currentdate &amp;&amp; FSM_Status != &quot;Synced Manually&quot;] sort by Visit_Date_Time asc;\n\toverdueVisits = Field_Visits[Agent_Email == agentEmail &amp;&amp; Visit_Date_Time &lt; zoho.currentdate &amp;&amp; FSM_Status != &quot;Synced Manually&quot;] sort by Visit_Date_Time asc;\n\tnovQueue = Violations[Notice_of_Violation_Issued == true &amp;&amp; (Case.Assigned_Agent_Email == agentEmail || Case.Supervising_Agent_Email == agentEmail)] sort by Violation_Date desc;\n\tevidenceQueue = Evidence[(Collected_By_Email == agentEmail || Case.Assigned_Agent_Email == agentEmail || Case.Supervising_Agent_Email == agentEmail) &amp;&amp; (Chain_of_Custody_Status != &quot;Disposed&quot; &amp;&amp; Chain_of_Custody_Status != &quot;Released to Owner&quot;)] sort by Date_Collected asc;\n\tdispositionQueue = Evidence[(Collected_By_Email == agentEmail || Case.Assigned_Agent_Email == agentEmail || Case.Supervising_Agent_Email == agentEmail) &amp;&amp; Disposition_Level != &quot;Not Ready&quot;] sort by Date_Collected asc;\n\thighPriorityComplaints = Complaints[Priority == &quot;High&quot; &amp;&amp; Screening_Decision != &quot;Rejected&quot; &amp;&amp; Screening_Decision != &quot;Closed&quot;] sort by Intake_Date asc;\n\n\tassignedCaseCount = assignedCases.count();\n\tupcomingVisitCount = upcomingVisits.count();\n\toverdueVisitCount = overdueVisits.count();\n\tnovCount = novQueue.count();\n\tevidenceCount = evidenceQueue.count();\n\tdispositionCount = dispositionQueue.count();\n\thighPriorityCount = highPriorityComplaints.count();\n\tfieldLoad = upcomingVisitCount + overdueVisitCount;\n\ttotalWorkload = assignedCaseCount + fieldLoad + novCount + evidenceCount + dispositionCount + highPriorityCount;\n\n\tcaseLabel = if(assignedCaseCount == 1,&quot;case&quot;,&quot;cases&quot;);\n\tvisitLabel = if(fieldLoad == 1,&quot;visit&quot;,&quot;visits&quot;);\n%&gt;\n&lt;style&gt;\n/* ZCS global utility stylesheet included once for this page; component ids used: zcs-global, button-primary-button, badge-badge-with-icon, table-simple-table, card-sample-1. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#2563eb);--zcs-light-bg-color:var(--zcs_brand_light_color,#eaf2ff);--zcs-page-bg-color:#f5f7fb;--zcs-primary-text-color:var(--zcs_primary_text_color,#111827);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#4b5563);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#8a94a6);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e7eb);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-box-border{box-sizing:border-box}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}.zcs-list-none{list-style-type:none}\n/* ZCS Button, Badge, and Table CSS. */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#2563eb);background:#fff;color:var(--zcs_brand_color,#2563eb)}.zcs-secondary-button{border:1px solid var(--zcs-border-color);background:#f8fafc;color:var(--zcs-primary-text-color)}.zcs-primary-button.zcs-button:hover{background:var(--zcs_brand_dark_color,#1d4ed8)}.zcs-primary-outline-button:hover,.zcs-secondary-button:hover{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-filled-outline.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-filled-outline.zcs-badge-grey{background:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-filled-outline.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#f4660c}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background:#f9fafe;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}\n/* Page-specific layout. */\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.eaac{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f7f9ff 0%,#f4f7fb 58%,#fff 100%);min-height:100%;padding:28px;box-sizing:border-box}.eaac *{box-sizing:border-box}.eaac-shell{max-width:1520px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.eaac-hero{position:relative;overflow:hidden;border-radius:28px;padding:30px;background:radial-gradient(circle at 86% 10%,rgba(255,255,255,.27),transparent 28%),radial-gradient(circle at 5% 22%,rgba(248,113,113,.18),transparent 28%),linear-gradient(135deg,#111827 0%,var(--zcs_brand_color,#2563eb) 56%,#0f766e 130%);color:#fff;box-shadow:0 24px 60px rgba(37,99,235,.18)}.eaac-hero:after{content:&quot;&quot;;position:absolute;right:-130px;bottom:-160px;width:370px;height:370px;border-radius:50%;border:1px solid rgba(255,255,255,.20);box-shadow:0 0 0 54px rgba(255,255,255,.08),0 0 0 108px rgba(255,255,255,.04)}.eaac-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.14fr) minmax(330px,.86fr);gap:24px;align-items:center}.eaac-eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.15);color:#fff;border-radius:999px;padding:7px 12px;font-size:12px;font-weight:750;letter-spacing:.5px;text-transform:uppercase}.eaac-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.03;letter-spacing:-.7px;margin:14px 0 10px;color:#fff}.eaac-hero p{max-width:820px;color:rgba(255,255,255,.86);font-size:15px;line-height:1.65;margin:0}.eaac-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.eaac-hero-actions .zcs-button{box-shadow:0 10px 22px rgba(0,0,0,.14)}.eaac-profile{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);border-radius:20px;padding:18px;backdrop-filter:blur(4px)}.eaac-avatar{width:58px;height:58px;border-radius:18px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28px}.eaac-profile h2{font-size:20px;line-height:1.2;margin:0;color:#fff}.eaac-profile-line{font-size:13px;color:rgba(255,255,255,.82);display:flex;align-items:center;gap:8px;margin-top:6px}.eaac-profile-kv{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.eaac-kv{border:1px solid rgba(255,255,255,.18);border-radius:14px;padding:10px;background:rgba(255,255,255,.08)}.eaac-kv span{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.55px;color:rgba(255,255,255,.62)}.eaac-kv strong{display:block;font-size:14px;margin-top:4px;color:#fff}.eaac-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 4px -2px}.eaac-section-title h2{font-size:11px;font-weight:800;color:#8a94a6;text-transform:uppercase;letter-spacing:1.1px;margin:0;display:flex;align-items:center;gap:8px}.eaac-section-title h2:before{content:&quot;&quot;;width:4px;height:15px;border-radius:4px;background:linear-gradient(180deg,var(--zcs_brand_color,#2563eb),#14b8a6)}.eaac-section-sub{font-size:12px;color:#8a94a6}.eaac-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.eaac-kpi{position:relative;overflow:hidden;background:#fff;border:1px solid #e9edf5;border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);min-height:145px}.eaac-kpi:after{content:&quot;&quot;;position:absolute;right:-42px;top:-42px;width:120px;height:120px;border-radius:50%;background:var(--soft)}.eaac-kpi-icon{position:relative;z-index:1;width:42px;height:42px;border-radius:14px;background:var(--soft);color:var(--tone);display:flex;align-items:center;justify-content:center;font-size:21px}.eaac-kpi-value{position:relative;z-index:1;font-size:32px;line-height:1;font-weight:800;color:#111827;margin-top:16px;letter-spacing:-.5px}.eaac-kpi-label{position:relative;z-index:1;font-size:12px;color:#64748b;margin-top:5px;font-weight:650}.eaac-kpi-note{position:relative;z-index:1;font-size:11px;color:#8a94a6;margin-top:6px}.eaac-grid-two{display:grid;grid-template-columns:minmax(0,.94fr) minmax(360px,.62fr);gap:14px}.eaac-card{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.eaac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.eaac-card-title{display:flex;gap:12px;align-items:flex-start}.eaac-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.eaac-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.eaac-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.eaac-card-body{padding:18px}.eaac-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.eaac-action{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:12px}.eaac-action.hot{border-color:rgba(254,69,93,.35);background:linear-gradient(180deg,#fff,#fff5f6)}.eaac-action-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.eaac-action-title h4{font-size:15px;margin:0;color:#111827}.eaac-action-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.eaac-action-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.eaac-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:750;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.eaac-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb)}.eaac-link:hover{text-decoration:underline}.eaac-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.eaac-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.eaac-list{display:flex;flex-direction:column;gap:10px}.eaac-item{border:1px solid #e9edf5;border-radius:14px;padding:12px;background:#fff}.eaac-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.eaac-item-title{font-size:14px;font-weight:800;color:#111827}.eaac-item-meta{font-size:12px;color:#64748b;margin-top:3px}.eaac-item-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.eaac-table-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.eaac-table-card.wide{grid-column:1/-1}.eaac-table-caption{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}.eaac-table-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb);white-space:nowrap}.eaac-table-wrap{max-height:420px;overflow:auto}.eaac-table-wrap table{min-width:900px}.eaac-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.eaac-report-card.wide{grid-column:1/-1}.eaac-embed{border-top:1px solid #eef1f6;background:#fff;padding:8px}.eaac-embed-box{min-height:390px;border:1px dashed #d7deea;border-radius:12px;background:#fff;overflow:hidden}.eaac-foot-space{height:12px}@media(max-width:1260px){.eaac-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.eaac-hero-grid,.eaac-grid-two{grid-template-columns:1fr}.eaac-action-grid{grid-template-columns:1fr}}@media(max-width:820px){.eaac{padding:14px}.eaac-hero{padding:22px;border-radius:20px}.eaac-kpis,.eaac-table-grid,.eaac-report-grid{grid-template-columns:1fr}.eaac-profile-kv{grid-template-columns:1fr}.eaac-section-title{align-items:flex-start;flex-direction:column}.eaac-card-head{flex-direction:column}.eaac-hero-actions .zcs-button{width:100%}.eaac-report-card.wide,.eaac-table-card.wide{grid-column:auto}}\n&lt;/style&gt;\n&lt;div class=&quot;eaac&quot;&gt;\n\t&lt;div class=&quot;eaac-shell&quot;&gt;\n\t\t&lt;section class=&quot;eaac-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;eaac-hero-grid&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;eaac-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline business-shield&quot;&gt;&lt;/i&gt;&lt;span&gt;Enforcement agent action center&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;h1&gt;Field workload and next actions&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Personal queues are filtered by &lt;strong&gt;&lt;%=agentEmail%&gt;&lt;/strong&gt; wherever the app has agent, investigator, collected-by, or supervising agent email fields. Shared sections surface active enforcement queues when no individual assignee field exists.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;eaac-hero-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open case queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Mobile_Field_Capture&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline location-appointment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open visits&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Disposition_Queue&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open evidence&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;aside class=&quot;eaac-profile&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-avatar&quot;&gt;&lt;i class=&quot;zc-li-outline users-police&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-common&quot;&gt;\n\t\t\t\t\t\t\t&lt;h2&gt;&lt;%=agentName%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;eaac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-email-85&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=agentEmail%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;eaac-profile-line&quot;&gt;&lt;i class=&quot;zc-li-outline business-badge&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=agentRole%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;eaac-profile-kv&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-kv&quot;&gt;&lt;span&gt;Total workload&lt;/span&gt;&lt;strong&gt;&lt;%=totalWorkload%&gt; active items&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-kv&quot;&gt;&lt;span&gt;Field load&lt;/span&gt;&lt;strong&gt;&lt;%=fieldLoad%&gt; &lt;%=visitLabel%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-kv&quot;&gt;&lt;span&gt;Assigned cases&lt;/span&gt;&lt;strong&gt;&lt;%=assignedCaseCount%&gt; &lt;%=caseLabel%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-kv&quot;&gt;&lt;span&gt;Overdue visits&lt;/span&gt;&lt;strong&gt;&lt;%=overdueVisitCount%&gt; needs review&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;eaac-section-title&quot;&gt;&lt;h2&gt;Current workload snapshot&lt;/h2&gt;&lt;span class=&quot;eaac-section-sub&quot;&gt;Counts update at page load from live enforcement records.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;eaac-kpis&quot;&gt;\n\t\t\t&lt;div class=&quot;eaac-kpi&quot; style=&quot;--soft:#eff6ff;--tone:#2563eb&quot;&gt;&lt;div class=&quot;eaac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-value&quot;&gt;&lt;%=assignedCaseCount%&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-label&quot;&gt;Assigned active cases&lt;/div&gt;&lt;div class=&quot;eaac-kpi-note&quot;&gt;Assigned or supervising agent&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-kpi&quot; style=&quot;--soft:#fff1f2;--tone:#e11d48&quot;&gt;&lt;div class=&quot;eaac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-value&quot;&gt;&lt;%=overdueVisitCount%&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-label&quot;&gt;Overdue visits&lt;/div&gt;&lt;div class=&quot;eaac-kpi-note&quot;&gt;Field capture not synced&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-kpi&quot; style=&quot;--soft:#ecfdf5;--tone:#059669&quot;&gt;&lt;div class=&quot;eaac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline location-appointment&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-value&quot;&gt;&lt;%=upcomingVisitCount%&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-label&quot;&gt;Scheduled visits&lt;/div&gt;&lt;div class=&quot;eaac-kpi-note&quot;&gt;Upcoming field work&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-kpi&quot; style=&quot;--soft:#fffbeb;--tone:#b45309&quot;&gt;&lt;div class=&quot;eaac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-exclamation&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-value&quot;&gt;&lt;%=novCount%&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-label&quot;&gt;NOV queue&lt;/div&gt;&lt;div class=&quot;eaac-kpi-note&quot;&gt;Related to assigned cases&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-kpi&quot; style=&quot;--soft:#f0f9ff;--tone:#0284c7&quot;&gt;&lt;div class=&quot;eaac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-value&quot;&gt;&lt;%=evidenceCount%&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-label&quot;&gt;Custody tasks&lt;/div&gt;&lt;div class=&quot;eaac-kpi-note&quot;&gt;Open chain-of-custody&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-kpi&quot; style=&quot;--soft:#fef3c7;--tone:#d97706&quot;&gt;&lt;div class=&quot;eaac-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-value&quot;&gt;&lt;%=highPriorityCount%&gt;&lt;/div&gt;&lt;div class=&quot;eaac-kpi-label&quot;&gt;High-priority complaints&lt;/div&gt;&lt;div class=&quot;eaac-kpi-note&quot;&gt;Active enforcement queue&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;eaac-grid-two&quot;&gt;\n\t\t\t&lt;section class=&quot;eaac-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;eaac-card-head&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;eaac-card-title&quot;&gt;&lt;div class=&quot;eaac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Next actions&lt;/h3&gt;&lt;p&gt;Start with overdue visits and custody records, then process assigned case and NOV queues.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;All case actions &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;eaac-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;eaac-action-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-action hot&quot;&gt;&lt;div class=&quot;eaac-action-title&quot;&gt;&lt;h4&gt;Overdue field visits&lt;/h4&gt;&lt;span class=&quot;eaac-chip chip-bad&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;%=overdueVisitCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;eaac-action-copy&quot;&gt;Review missed visit dates and update field capture status before new work is scheduled.&lt;/p&gt;&lt;div class=&quot;eaac-action-links&quot;&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Mobile_Field_Capture&quot;&gt;Open Mobile_Field_Capture&lt;/a&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Field_Visit_Log&quot;&gt;View full log&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-action&quot;&gt;&lt;div class=&quot;eaac-action-title&quot;&gt;&lt;h4&gt;Assigned cases&lt;/h4&gt;&lt;span class=&quot;eaac-chip chip-theme&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;%=assignedCaseCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;eaac-action-copy&quot;&gt;Work open cases where you are assigned agent or supervising agent.&lt;/p&gt;&lt;div class=&quot;eaac-action-links&quot;&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;Open queue&lt;/a&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Case_Status_Board&quot;&gt;Status board&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-action&quot;&gt;&lt;div class=&quot;eaac-action-title&quot;&gt;&lt;h4&gt;NOV and violations&lt;/h4&gt;&lt;span class=&quot;eaac-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline files-exclamation&quot;&gt;&lt;/i&gt;&lt;%=novCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;eaac-action-copy&quot;&gt;Use report actions to issue notices, mark citations, recommend action, or clear violations.&lt;/p&gt;&lt;div class=&quot;eaac-action-links&quot;&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Notice_Of_Violation_Queue&quot;&gt;Open NOV queue&lt;/a&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Violations_By_Case&quot;&gt;By case&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-action&quot;&gt;&lt;div class=&quot;eaac-action-title&quot;&gt;&lt;h4&gt;Evidence custody&lt;/h4&gt;&lt;span class=&quot;eaac-chip chip-info&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;&lt;%=evidenceCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;eaac-action-copy&quot;&gt;Log custody, mark reviewed, dispose, or return evidence from action-enabled evidence reports.&lt;/p&gt;&lt;div class=&quot;eaac-action-links&quot;&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Chain_Of_Custody_Log&quot;&gt;Custody log&lt;/a&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Disposition_Queue&quot;&gt;Disposition queue&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;eaac-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;eaac-card-head&quot;&gt;&lt;div class=&quot;eaac-card-title&quot;&gt;&lt;div class=&quot;eaac-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Active shared enforcement queues&lt;/h3&gt;&lt;p&gt;These queues are shown because complaint priority queues do not have an individual agent field.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;eaac-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;eaac-list&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-item&quot;&gt;&lt;div class=&quot;eaac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;eaac-item-title&quot;&gt;High-priority complaints&lt;/div&gt;&lt;div class=&quot;eaac-item-meta&quot;&gt;&lt;%=highPriorityCount%&gt; active high-priority complaints need screening or case creation.&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;eaac-chip chip-warn&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;Priority&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;eaac-item-actions&quot;&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:High_Priority_Complaints&quot;&gt;Open report&lt;/a&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Supervisor_Screening_Queue&quot;&gt;Screening queue&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-item&quot;&gt;&lt;div class=&quot;eaac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;eaac-item-title&quot;&gt;Evidence ready for disposition&lt;/div&gt;&lt;div class=&quot;eaac-item-meta&quot;&gt;&lt;%=dispositionCount%&gt; assigned or collected evidence records have disposition levels set.&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;eaac-chip chip-info&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;Evidence&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;eaac-item-actions&quot;&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Disposition_Queue&quot;&gt;Open disposition&lt;/a&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Evidence_Register&quot;&gt;Register&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;eaac-item&quot;&gt;&lt;div class=&quot;eaac-item-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;eaac-item-title&quot;&gt;Upcoming field visits&lt;/div&gt;&lt;div class=&quot;eaac-item-meta&quot;&gt;&lt;%=upcomingVisitCount%&gt; scheduled visits assigned to your email are ready for field capture.&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;eaac-chip chip-ok&quot;&gt;&lt;i class=&quot;zc-li-outline location-appointment&quot;&gt;&lt;/i&gt;Scheduled&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;eaac-item-actions&quot;&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Mobile_Field_Capture&quot;&gt;Open capture&lt;/a&gt;&lt;a class=&quot;eaac-link&quot; href=&quot;#Report:Field_Visit_Calendar&quot;&gt;Calendar&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;eaac-section-title&quot;&gt;&lt;h2&gt;Personal assignment tables&lt;/h2&gt;&lt;span class=&quot;eaac-section-sub&quot;&gt;Limited to top records so agents can scan and jump to action-enabled reports.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;eaac-table-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;eaac-card eaac-table-card zcs-card zcs-p-20 zcs-box-border wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;eaac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Assigned cases&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Open cases where Assigned Agent Email or Supervising Agent Email matches &lt;%=agentEmail%&gt;.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;eaac-table-link&quot; href=&quot;#Report:Enforcement_Work_Queue&quot;&gt;Open action report &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper eaac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Initial visit due&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Next action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tcaseShown = 0;\n\t\t\t\t\t\tfor each c in assignedCases\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(caseShown &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tcaseShown = caseShown + 1;\n\t\t\t\t\t\t\t\tpriorityClass = if(c.Priority == &quot;High&quot;,&quot;zcs-badge-red&quot;,&quot;zcs-badge-blue&quot;);\n\t\t\t\t\t\t\t\tstatusClass = if(c.Case_Status == &quot;Field Investigation&quot; || c.Case_Status == &quot;Preliminary Investigation&quot;,&quot;zcs-badge-orange&quot;,&quot;zcs-badge-theme&quot;);\n\t\t\t\t\t\t\t\tnextText = &quot;Review case&quot;;\n\t\t\t\t\t\t\t\tif(c.Initial_Visit_Due_Date != null &amp;&amp; c.Initial_Visit_Due_Date &lt; zoho.currentdate)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tnextText = &quot;Schedule or update overdue visit&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(c.Recommend_Accusation == true)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tnextText = &quot;Refer or prepare legal package&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(c.Case_Number,&quot;Case&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=priorityClass%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(c.Priority,&quot;Standard&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=statusClass%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(c.Case_Status,&quot;New&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(c.Initial_Visit_Due_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=nextText%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(caseShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot;&gt;&lt;div class=&quot;eaac-empty&quot;&gt;&lt;span class=&quot;eaac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;No open case records are assigned to your agent email. Use the embedded active enforcement queues below if you are covering shared work.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;eaac-card eaac-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;eaac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Scheduled and overdue visits&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Agent Email matches current user.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;eaac-table-link&quot; href=&quot;#Report:Mobile_Field_Capture&quot;&gt;Open capture&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper eaac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Visit&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tvisitShown = 0;\n\t\t\t\t\t\tfor each fv in Field_Visits[Agent_Email == agentEmail &amp;&amp; FSM_Status != &quot;Synced Manually&quot;] sort by Visit_Date_Time asc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(visitShown &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tvisitShown = visitShown + 1;\n\t\t\t\t\t\t\t\tvisitCase = &quot;Case not linked&quot;;\n\t\t\t\t\t\t\t\tif(fv.Case != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tvisitCase = ifnull(fv.Case.Case_Number,&quot;Case linked&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tvisitBadge = if(fv.Visit_Date_Time &lt; zoho.currentdate,&quot;zcs-badge-red&quot;,&quot;zcs-badge-green&quot;);\n\t\t\t\t\t\t\t\tvisitLabelText = if(fv.Visit_Date_Time &lt; zoho.currentdate,&quot;Overdue&quot;,&quot;Scheduled&quot;);\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(fv.Visit_Number,&quot;Visit&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=visitCase%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(fv.Visit_Date_Time,&quot;Not scheduled&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=visitBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=visitLabelText%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(visitShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot;&gt;&lt;div class=&quot;eaac-empty&quot;&gt;&lt;span class=&quot;eaac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline location-appointment&quot;&gt;&lt;/i&gt;&lt;/span&gt;No scheduled or overdue field visits are assigned to your email.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;eaac-card eaac-table-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;eaac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Evidence custody and disposition&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Collected by you or related to your cases.&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;eaac-table-link&quot; href=&quot;#Report:Disposition_Queue&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper eaac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Evidence&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Case&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Custody&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Disposition&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tevShown = 0;\n\t\t\t\t\t\tfor each ev in evidenceQueue\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(evShown &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tevShown = evShown + 1;\n\t\t\t\t\t\t\t\tevCase = &quot;Case not linked&quot;;\n\t\t\t\t\t\t\t\tif(ev.Case != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tevCase = ifnull(ev.Case.Case_Number,&quot;Case linked&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tcustodyBadge = if(ev.Chain_of_Custody_Status == &quot;Collected&quot; || ev.Chain_of_Custody_Status == &quot;Booked&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-blue&quot;);\n\t\t\t\t\t\t\t\tdispBadge = if(ev.Disposition_Level == &quot;Not Ready&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-orange&quot;);\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ev.Evidence_Number,&quot;Evidence&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=evCase%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=custodyBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline files-archive-content&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(ev.Chain_of_Custody_Status,&quot;Collected&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=dispBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;&lt;%=ifnull(ev.Disposition_Level,&quot;Not Ready&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(evShown == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot;&gt;&lt;div class=&quot;eaac-empty&quot;&gt;&lt;span class=&quot;eaac-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;No open evidence custody records are assigned to you or your cases.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;eaac-section-title&quot;&gt;&lt;h2&gt;Action-enabled enforcement reports&lt;/h2&gt;&lt;span class=&quot;eaac-section-sub&quot;&gt;Embedded reports preserve row-level actions such as Assign Case, Issue NOV, Log Custody, Dispose Evidence, and Create Case.&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;section class=&quot;eaac-report-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;eaac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;eaac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Assigned and active cases&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Enforcement_Work_Queue action report.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;eaac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Enforcement_Work_Queue&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;eaac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Field visits&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Mobile_Field_Capture and visit capture tasks.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;eaac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Mobile_Field_Capture&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;eaac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Notice of violation queue&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Issue NOV and violation outcome actions.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;eaac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Notice_Of_Violation_Queue&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;eaac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Evidence disposition&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Disposition_Queue action report.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;eaac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Disposition_Queue&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;eaac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Chain of custody&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Custody log for evidence movement.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;eaac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Chain_Of_Custody_Log&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eaac-report-card zcs-card zcs-p-20 zcs-box-border&quot;&gt;&lt;div class=&quot;eaac-table-caption&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;High-priority complaints&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8&quot;&gt;Relevant active enforcement queue without individual agent field.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;eaac-embed&quot; zc-component=&quot;report&quot; zc-linkname=&quot;High_Priority_Complaints&quot; zc-height=&quot;430px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;div class=&quot;eaac-foot-space&quot;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Enforcement_Command_Center
		{
					displayname = "Enforcement Command Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Enforcement_Command_Center_Single_Snippet' elementName='Enforcement_Command_Center_Single_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Enforcement_Command_Center_Single_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\topenCases = Cases[Case_Status != &quot;Closed&quot;].count();\n\thighPriorityCases = Cases[Case_Status != &quot;Closed&quot; &amp;&amp; Priority == &quot;High&quot;].count();\n\tvisitsDue = Field_Visits[Visit_Date_Time &gt;= zoho.currentdate].count();\n\tviolationsObserved = Violations[ID != 0].count();\n\trecommendedAccusations = Cases[Case_Status != &quot;Closed&quot; &amp;&amp; Recommend_Accusation == true].count();\n\tlegalReviewQueue = Cases[Case_Status == &quot;Referred to OLS&quot; || Case_Status == &quot;Legal Review&quot; || Case_Status == &quot;Hearing Status&quot; || Legal_Review_Status == &quot;Pending OLS Review&quot; || Legal_Review_Status == &quot;Accusation Drafted&quot; || Legal_Review_Status == &quot;Hearing Scheduled&quot;].count();\n\tevidenceItems = Evidence[ID != 0].count();\n\trecentlyClosedCases = Cases[Case_Status == &quot;Closed&quot; &amp;&amp; Closure_Date &gt;= zoho.currentdate.subDay(30)].count();\n\tcomplaintScreening = Complaints[Screening_Decision == &quot;New&quot; || Screening_Decision == &quot;Need More Information&quot;].count();\n\tnovQueue = Violations[Notice_of_Violation_Issued == true].count();\n\tevidenceDispositionQueue = Evidence[Chain_of_Custody_Status == &quot;Disposed&quot; || Disposition_Level != &quot;Not Ready&quot;].count();\n\tpendingCorrespondence = Correspondence[Merge_Status == &quot;Draft&quot; || Merge_Status == &quot;Ready for Manual Merge&quot;].count();\n\tenforcementDocuments = Correspondence[Module == &quot;Enforcement&quot;].count();\n\tactiveLicenseContext = Licenses[License_Status == &quot;Active&quot; || License_Status == &quot;Renewed&quot;].count();\n\tterminatedLicenseContext = Licenses[License_Status == &quot;Terminated&quot;].count();\n\tlegalPending = Cases[Legal_Review_Status == &quot;Pending OLS Review&quot;].count();\n\tlegalDrafted = Cases[Legal_Review_Status == &quot;Accusation Drafted&quot;].count();\n\tlegalHearing = Cases[Legal_Review_Status == &quot;Hearing Scheduled&quot; || Legal_Review_Status == &quot;Hearing Held&quot;].count();\n\tlegalDecision = Cases[Legal_Review_Status == &quot;Proposed Decision&quot; || Legal_Review_Status == &quot;Director Action&quot; || Legal_Review_Status == &quot;Appeal Status&quot;].count();\n\ttotalCommandLoad = openCases + highPriorityCases + visitsDue + violationsObserved + recommendedAccusations + legalReviewQueue + evidenceItems + recentlyClosedCases;\n\tcasePct = 0;\n\thighPct = 0;\n\tvisitPct = 0;\n\tviolationPct = 0;\n\taccusationPct = 0;\n\tlegalPct = 0;\n\tevidencePct = 0;\n\tclosedPct = 0;\n\tif(totalCommandLoad &gt; 0)\n\t{\n\t\tcasePct = (openCases * 100) / totalCommandLoad;\n\t\thighPct = (highPriorityCases * 100) / totalCommandLoad;\n\t\tvisitPct = (visitsDue * 100) / totalCommandLoad;\n\t\tviolationPct = (violationsObserved * 100) / totalCommandLoad;\n\t\taccusationPct = (recommendedAccusations * 100) / totalCommandLoad;\n\t\tlegalPct = (legalReviewQueue * 100) / totalCommandLoad;\n\t\tevidencePct = (evidenceItems * 100) / totalCommandLoad;\n\t\tclosedPct = (recentlyClosedCases * 100) / totalCommandLoad;\n\t}\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css included once for this page: utility subset used by ZCS components ===== */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#0f6cc9);--zcs-light-bg-color:var(--zcs_brand_light_color,#e8f1ff);--zcs-page-bg-color:#f6f8fc;--zcs-primary-text-color:var(--zcs_primary_text_color,#12132b);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#596172);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#7b8090);--zcs-border-color:var(--zcs_tertiary_border_color,#e6e9f2);--zcs-white-color:#fff;--zcs-black-color:#000;--zcs-thead-color:#f9fafe;--zcs-tr-h-color:#f6f8ff;--zcs-card-shadow:0 12px 30px rgba(15,23,42,.06)}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-2xl{border-radius:16px}.zcs-rounded-half{border-radius:50%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none;color:inherit}\n/* ZCS badge-badge-with-icon */\n.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs-light-bg-color);border-color:var(--zcs-theme-brand-color);color:var(--zcs-theme-brand-color)}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-filled-outline.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-filled-outline.zcs-badge-grey{background:#e8e8e8;border-color:#667085;color:#344054}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#9a6509}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-filled-outline.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#c44d08}.zcs-badge-icon{font-size:13px;line-height:1}\n/* ZCS table-simple-table */\n.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:720px}.zcs-table-wrapper table thead{top:0;z-index:1}.zcs-table-wrapper table thead tr th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper table tbody tr:hover td{background:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr.zcs-tnodata:hover td{background:transparent}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}.zcs-d_blue{color:#1328cd}\n/* ZCS quick-actions-icon-with-text and layout-dashboard panel card styling */\n.zcs-quick-action-item,.abc-kpi-item{list-style-type:none}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs-theme-brand-color)}.zcs-quick-action-item:hover .zcs-quick-action-text{text-decoration:underline}.zcs-panel{border:1px solid var(--zcs-border-color);box-shadow:0 2px 8px rgba(33,40,75,.06);background:var(--zcs-white-color)}.zcs-panel-icon-wrapper{width:42px;height:42px}.zcs-panel-green .zcs-panel-icon-wrapper{background:#e4fcf3;color:#179e6c}.zcs-panel-yellow .zcs-panel-icon-wrapper{background:#fcf4e6;color:#b8770d}.zcs-panel-red .zcs-panel-icon-wrapper{background:#fde3e6;color:#fe455d}.zcs-panel-d_blue .zcs-panel-icon-wrapper{background:#eaf2ff;color:#1652bb}.zcs-panel-blue .zcs-panel-icon-wrapper{background:#f2f9ff;color:#2a8bcc}.zcs-panel-orange .zcs-panel-icon-wrapper{background:#fff0e4;color:#f4660c}.zcs-panel-grey .zcs-panel-icon-wrapper{background:#f5f8fa;color:#344054}.zcs-panel:hover{border-color:var(--zcs-theme-brand-color);background-image:linear-gradient(rgba(253,253,255,.25),#f7f9ff)}\n/* Enforcement command center */\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important;padding:0!important}.abc-enf-shell{min-height:100%;background:radial-gradient(circle at 78% 0,rgba(42,111,252,.14),transparent 32%),linear-gradient(180deg,#f6f8fc 0,#fff 92%);color:var(--zcs-primary-text-color);font-family:Inter,Arial,sans-serif}.abc-page{max-width:1480px;margin:0 auto;padding:28px}.abc-hero{position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.36);border-radius:22px;background:radial-gradient(circle at 85% 18%,rgba(255,255,255,.22),transparent 28%),linear-gradient(135deg,var(--zcs-theme-brand-color),#092441 74%);box-shadow:0 22px 50px rgba(9,36,65,.18);color:#fff}.abc-hero:after{content:&quot;&quot;;position:absolute;right:-70px;top:-80px;width:260px;height:260px;border:32px solid rgba(255,255,255,.08);border-radius:50%}.abc-hero-inner{position:relative;z-index:1;padding:30px}.abc-eyebrow{letter-spacing:.08em;opacity:.86}.abc-hero h1{font-size:34px;margin:8px 0 10px;line-height:1.12}.abc-hero p{max-width:880px;color:rgba(255,255,255,.84);margin:0;line-height:1.65}.abc-hero-meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.abc-hero-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.12);border-radius:999px;padding:7px 12px;color:#fff;font-size:13px}.abc-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 14px}.abc-section-title h2{font-size:18px;margin:0}.abc-muted{color:var(--zcs-secondary-text-color)}.abc-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:18px 0}.abc-kpi{height:100%;border-radius:16px;padding:18px;box-shadow:var(--zcs-card-shadow);position:relative;overflow:hidden}.abc-kpi:before{content:&quot;&quot;;position:absolute;inset:0 0 auto 0;height:3px;background:var(--accent)}.abc-kpi-value{font-size:30px;font-weight:700;line-height:1;margin-top:10px}.abc-kpi-label{color:var(--zcs-secondary-text-color);font-size:13px;margin-top:5px}.abc-kpi-note{color:var(--zcs-teritiary-text-color);font-size:12px;margin-top:10px}.abc-kpi .zcs-panel-icon-wrapper{background:var(--accent-bg);color:var(--accent)}.abc-main-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(360px,.88fr);gap:16px;margin-top:16px}.abc-card{border-radius:16px;box-shadow:var(--zcs-card-shadow)}.abc-queue-bars{display:grid;gap:12px}.abc-bar-row{display:grid;grid-template-columns:168px 1fr 48px;gap:10px;align-items:center}.abc-track{height:9px;border-radius:999px;background:#edf1f8;overflow:hidden}.abc-fill{height:100%;width:var(--v);background:linear-gradient(90deg,var(--accent),rgba(42,111,252,.45));border-radius:inherit}.abc-context-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.abc-context-tile{border:1px solid var(--zcs-border-color);background:#fbfcff;border-radius:12px;padding:12px}.abc-table-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.abc-table-card{min-height:320px}.abc-table-caption{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px}.abc-table-link{color:var(--zcs-theme-brand-color);font-size:13px;font-weight:600}.abc-status-cell{white-space:nowrap}.abc-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:16px}.abc-report-card{min-height:438px}.abc-report-card.abc-wide{grid-column:1/-1}.abc-embed{height:430px;border:1px solid var(--zcs-border-color);border-radius:12px;background:#fff;overflow:hidden}.abc-embed-sm{height:360px}.abc-license-note{border-left:3px solid var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color);border-radius:12px;padding:12px 14px;color:var(--zcs-secondary-text-color);font-size:13px}.abc-empty{padding:20px;text-align:center;color:var(--zcs-secondary-text-color)}.abc-empty i{display:block;font-size:24px;margin-bottom:6px;color:var(--zcs-teritiary-text-color)}@media(max-width:1180px){.abc-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.abc-main-grid,.abc-table-grid,.abc-report-grid{grid-template-columns:1fr}.abc-report-card.abc-wide{grid-column:auto}}@media(max-width:640px){.abc-page{padding:16px}.abc-hero-inner{padding:22px}.abc-hero h1{font-size:27px}.abc-kpi-grid,.abc-context-grid{grid-template-columns:1fr}.abc-bar-row{grid-template-columns:1fr}.abc-section-title{align-items:flex-start;flex-direction:column}.abc-table-wrapper table{min-width:680px}}\n&lt;/style&gt;\n&lt;div class=&quot;abc-enf-shell&quot;&gt;\n\t&lt;div class=&quot;abc-page&quot;&gt;\n\t\t&lt;section class=&quot;abc-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;abc-hero-inner&quot;&gt;\n\t\t\t\t&lt;div class=&quot;abc-eyebrow zcs-font-12 zcs-font-semibold zcs-uppercase&quot;&gt;Enforcement operations&lt;/div&gt;\n\t\t\t\t&lt;h1&gt;Enforcement Command Center&lt;/h1&gt;\n\t\t\t\t&lt;p&gt;Monitor case intake, field activity, violations, evidence custody, correspondence, and legal review without changing the underlying enforcement workflows.&lt;/p&gt;\n\t\t\t\t&lt;div class=&quot;abc-hero-meta&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=openCases%&gt; open cases&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline location-appointment&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=visitsDue%&gt; scheduled visits&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=pendingCorrespondence%&gt; pending correspondence&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;abc-hero-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span&gt;Operator &lt;%=zoho.loginuserid%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;ul class=&quot;abc-kpi-grid zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t&lt;li class=&quot;abc-kpi-item&quot;&gt;&lt;div class=&quot;abc-kpi zcs-card&quot; style=&quot;--accent:#2a6ffc;--accent-bg:#e8efff&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-font-24 zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;Active&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=openCases%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Open cases&lt;/div&gt;&lt;div class=&quot;abc-kpi-note&quot;&gt;All non-closed case statuses&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&quot;abc-kpi-item&quot;&gt;&lt;div class=&quot;abc-kpi zcs-card&quot; style=&quot;--accent:#fe455d;--accent-bg:#fde3e6&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-font-24 zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;High&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=highPriorityCases%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;High priority cases&lt;/div&gt;&lt;div class=&quot;abc-kpi-note&quot;&gt;Open cases flagged High&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&quot;abc-kpi-item&quot;&gt;&lt;div class=&quot;abc-kpi zcs-card&quot; style=&quot;--accent:#b8770d;--accent-bg:#fcf4e6&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-font-24 zc-li-outline location-appointment&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;Due&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-value&quot;&gt;&lt;%=visitsDue%&gt;&lt;/div&gt;&lt;div class=&quot;abc-kpi-label&quot;&gt;Visits due&lt;/div&gt;&lt;div class=&quot;abc-kpi-note&quot;&gt;Scheduled from today forward&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&quot;abc-kpi-item&quot;&gt;&lt;div class=&quot;abc-kpi zcs-card&quot; style=&quot;--accent:#f4660c;--accent-bg:#fff0e4&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-font-24 zc-li-outline files-exclamation&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-orange zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-12&quot;&gt;Observed&lt;/span&gt;&lt;/span&gt;&