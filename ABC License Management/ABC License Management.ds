			Complete_Renewal as "Complete Renewal"
			{
				type = functions
				form = Renewal_Batches
				execution type = for each record
				description = "Completes a paid renewal batch from renewal reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Batch_Status == "Paid")
							{
								input.Batch_Status = "Completed";
								input.Payment_Status = "Complete";
								input.Completed_Date = zoho.currentdate;
								thisapp.Write_Audit_Log("Renewal","Renewal_Batches",input.ID,"Renewal completed","Renewal batch completed from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Renewal","Renewal_Batches",input.ID,"Complete renewal action skipped","Complete Renewal clicked by " + actorEmail + " but the renewal batch was not paid or was Cancelled.");
							}
						)
					}
				}
			}

			Mark_Payment_Pending as "Mark Payment Pending"
			{
				type = functions
				form = Renewal_Batches
				execution type = for each record
				description = "Marks a renewal batch as waiting for payment from renewal reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Batch_Status == "Submitted" || input.Batch_Status == "Draft")
							{
								input.Batch_Status = "Payment Pending";
								input.Payment_Status = "Pending";
								if(input.Submitted_Date == null)
								{
									input.Submitted_Date = zoho.currentdate;
								}
								thisapp.Write_Audit_Log("Renewal","Renewal_Batches",input.ID,"Payment pending","Renewal batch marked Payment Pending from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Renewal","Renewal_Batches",input.ID,"Payment pending action skipped","Mark Payment Pending clicked by " + actorEmail + " but the renewal batch was not Draft or Submitted.");
							}
						)
					}
				}
			}

			Mark_Renewal_Paid as "Mark Renewal Paid"
			{
				type = functions
				form = Renewal_Batches
				execution type = for each record
				description = "Marks a renewal batch payment complete from renewal reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Payment_Status == "Pending" && input.Batch_Status != "Cancelled")
							{
								input.Payment_Status = "Complete";
								input.Batch_Status = "Paid";
								thisapp.Write_Audit_Log("Renewal","Renewal_Batches",input.ID,"Renewal paid","Renewal batch marked paid from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Renewal","Renewal_Batches",input.ID,"Mark renewal paid action skipped","Mark Renewal Paid clicked by " + actorEmail + " but payment was not Pending or the batch was Cancelled.");
							}
						)
					}
				}
			}

			Submit_Renewal as "Submit Renewal"
			{
				type = functions
				form = Renewal_Batches
				execution type = for each record
				description = "Submits a draft renewal batch from renewal reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Batch_Status == "Draft")
							{
								input.Batch_Status = "Submitted";
								input.Submitted_Date = zoho.currentdate;
								thisapp.Write_Audit_Log("Renewal","Renewal_Batches",input.ID,"Renewal submitted","Renewal batch submitted from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Renewal","Renewal_Batches",input.ID,"Submit renewal action skipped","Submit Renewal clicked by " + actorEmail + " but the renewal batch was not Draft.");
							}
						)
					}
				}
			}

			Violation_Clear_Violation as "Clear Violation"
			{
				type = functions
				form = Violations
				execution type = for each record
				description = "Clears a violation outcome by setting the recommendation to No Further Action."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Recommended_Action != "No Further Action")
							{
								input.Recommended_Action = "No Further Action";
								thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"Violation cleared","Violation cleared with No Further Action from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"Clear violation skipped","Clear Violation clicked by " + actorEmail + " but violation was already marked No Further Action.");
							}
						)
					}
				}
			}

			Violation_Issue_NOV as "Issue NOV"
			{
				type = functions
				form = Violations
				execution type = for each record
				description = "Issues a notice of violation from violation reports and creates the NOV correspondence stub when needed."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Notice_of_Violation_Issued != true)
							{
								input.Notice_of_Violation_Issued = true;
								if(input.NOV_Correspondence == null)
								{
									novId = thisapp.Create_Correspondence_Stub("Enforcement",input.ID,"ABC-756","","Not Required");
									input.NOV_Correspondence = novId;
								}
								thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"NOV issued","Notice of violation issued from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"Issue NOV action skipped","Issue NOV clicked by " + actorEmail + " but NOV was already issued.");
							}
						)
					}
				}
			}

			Violation_Mark_Citation_Issued as "Mark Citation Issued"
			{
				type = functions
				form = Violations
				execution type = for each record
				description = "Marks a violation citation as issued from violation reports."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Citation_Issued != true)
							{
								input.Citation_Issued = true;
								thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"Citation issued","Citation marked issued from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"Mark citation action skipped","Mark Citation Issued clicked by " + actorEmail + " but citation was already issued.");
							}
						)
					}
				}
			}

			Violation_Recommend_Action as "Recommend Action"
			{
				type = functions
				form = Violations
				execution type = for each record
				description = "Records the default report-driven violation recommendation when no recommendation is present."
			
				on start
				{
					actions
					{
						on click
						(
							actorEmail = zoho.loginuserid;
							if(input.Recommended_Action == null || input.Recommended_Action == "")
							{
								input.Recommended_Action = "Other Follow-up";
								thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"Action recommended","Recommended action set to Other Follow-up from report by " + actorEmail + ".");
							}
							else
							{
								thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"Recommend action skipped","Recommend Action clicked by " + actorEmail + " but recommended action was already " + input.Recommended_Action + ".");
							}
						)
					}
				}
			}
		}

