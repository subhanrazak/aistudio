"Licensee"
{

				name = "Licensee"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false}
				description = "Portal-style licensee access for license viewing, renewal batch submission, renewal items, and renewal payment status.\n"
				ModulePermissions
				{
					Reference_Values
					{
						enabled= View,Search 
						allFieldsVisible= true 
					}
					Renewal_Notices
					{
						enabled= Create,Tab,View,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Notice_Generation_Log={"View"}
							Penalty_Notice_Queue={"View"}
						}
					}
					Licenses
					{
						enabled= Create,Tab,View,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Active_Licenses={"View"}
							Renewable_Licenses={"View"}
							Licensee_Portal_Licenses={"View"}
						}
					}
					Payments
					{
						enabled= Create,Tab,View,Search 
						ReportPermissions
						{
							Pending_Payments={"View"}
						}
						FieldPermissions
						{
							Books_Reference{visibility:false,readonly:false}
							Entity{visibility:false,readonly:false}
							Refund_Requested{visibility:false,readonly:false}
							Amount_Due{visibility:false,readonly:false}
							Payment_Reference{visibility:false,readonly:false}
							Refund_Status{visibility:false,readonly:false}
							Renewal_Batch{visibility:false,readonly:false}
							Payment_Method{visibility:false,readonly:false}
							Refund_Details{visibility:false,readonly:false}
							Payment_Module{visibility:false,readonly:false}
							Reconciled{visibility:false,readonly:false}
							Payment_Details{visibility:false,readonly:false}
							Payment_Date{visibility:false,readonly:false}
							Payment_Status{visibility:false,readonly:false}
							Refund_Amount{visibility:false,readonly:false}
							Reconciliation{visibility:false,readonly:false}
							Reconciliation_Date{visibility:false,readonly:false}
							Application{visibility:false,readonly:false}
							Receipt_Generated{visibility:false,readonly:false}
							Refund_Reason{visibility:false,readonly:false}
							Notes{visibility:false,readonly:false}
							Amount_Paid{visibility:false,readonly:false}
							Receipt_Number{visibility:false,readonly:false}
						}
					}
					Renewal_Batches
					{
						enabled= Create,Tab,View,Edit,Search 
						ReportPermissions
						{
							Licensee_Renewal_Batches={"View","Edit"}
						}
						FieldPermissions
						{
							Entity{visibility:false,readonly:false}
							Completed_Date{visibility:true,readonly:true}
							Total_Penalties{visibility:true,readonly:true}
							Renewal_Batch_Number{visibility:false,readonly:false}
							Manual_Entry_By_Staff{visibility:false,readonly:false}
							Batch_Details{visibility:false,readonly:false}
							Penalty_Stage_Applied{visibility:false,readonly:false}
							Payment{visibility:false,readonly:false}
							Payment_Status{visibility:true,readonly:true}
							Total_Amount_Due{visibility:true,readonly:true}
							Licensee_Email{visibility:false,readonly:false}
							Batch_Status{visibility:false,readonly:false}
							Submitted_Date{visibility:false,readonly:false}
							Total_Renewal_Fees{visibility:true,readonly:true}
							Notes{visibility:false,readonly:false}
						}
					}
					Entities
					{
						enabled= Create,Tab,View,Edit,Search 
						ReportPermissions
						{
							Entity_Search={"View"}
							Active_Licensees={"View"}
						}
						FieldPermissions
						{
							Entity_Number{visibility:false,readonly:false}
							Administration{visibility:false,readonly:false}
							Entity_Details{visibility:false,readonly:false}
							Licensee_Portal_Email{visibility:false,readonly:false}
							Contact_Phone{visibility:false,readonly:false}
							Primary_Contact_Name{visibility:false,readonly:false}
							Entity_Kind{visibility:false,readonly:false}
							Secretary_of_State_Number{visibility:true,readonly:true}
							Active{visibility:true,readonly:true}
							Contact_Email{visibility:false,readonly:false}
							Tax_ID_Last4{visibility:true,readonly:true}
							Entity_Name{visibility:false,readonly:false}
							Mailing_Address{visibility:false,readonly:false}
							Notes{visibility:false,readonly:false}
						}
					}
					Renewal_Items
					{
						enabled= Create,Tab,View,Edit,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Renewed_Items={"View"}
							Pending_Renewal_Items={"View","Edit"}
							Renewal_Items_By_Batch={"View","Edit"}
						}
					}
					Licensee_Action_Center
					{
						enabled = tab
					}
					Renewal_Portal
					{
						enabled = tab
					}
				}
			
}