Field_Visits_On_Validate as "Validate Field Visit"
{

				type =  form
				form = Field_Visits

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Case == null)
										{
											alert "A case is required for every field visit.";
											cancel submit;
										}
										if(input.Visit_Date_Time == null)
										{
											alert "Visit date and time is required.";
											cancel submit;
										}
						)
					}
				}

			
}