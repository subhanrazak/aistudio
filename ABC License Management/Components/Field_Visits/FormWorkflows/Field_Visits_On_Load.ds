Field_Visits_On_Load as "Prepare Field Visit Form"
{

				type =  form
				form = Field_Visits

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Visit_Date_Time == null)
										{
											input.Visit_Date_Time = zoho.currenttime;
										}
										if(input.FSM_Status == null)
										{
											input.FSM_Status = "Captured Manually";
										}
										if(input.Inspection_Form_Type == null)
										{
											input.Inspection_Form_Type = "None";
										}
						)
					}
				}

			
}