calendar Field_Visit_Calendar
{

			displayName = "Field Visit Calendar"
			show all rows from Field_Visits    
			(
				Visit_Number as "Visit Number"
				Case
				Visit_Type as "Visit Type"
				Visit_Date_Time as "Visit Date Time"
				Agent_Email as "Agent Email"
				Premises
				FSM_Status as "FSM Status"
			)
			filters
			(
				Case
				Visit_Type
				Visit_Date_Time
				Agent_Email
				FSM_Status
			)
			sort by
			(
				Visit_Date_Time ascending
			)
			options
			(
				display field = Visit_Number
				start date = Visit_Date_Time
			)
		
}