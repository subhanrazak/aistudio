default list Field_Visit_Log
{

			displayName = "Field Visit Log"
			show all rows from Field_Visits    
			(
				Visit_Number as "Visit Number"
				Case
				License
				Premises
				Visit_Type as "Visit Type"
				Inspection_Form_Type as "Inspection Form Type"
				Visit_Date_Time as "Visit Date Time"
				Agent_Email as "Agent Email"
				Person_Contacted as "Person Contacted"
				FSM_Status as "FSM Status"
				Violations_Observed as "Violations Observed"
				Additional_Inspection_Needed as "Additional Inspection Needed"
			)
			filters
			(
				Case
				Visit_Type
				Inspection_Form_Type
				Visit_Date_Time
				Agent_Email
				FSM_Status
				Violations_Observed
				Additional_Inspection_Needed
			)
			sort by
			(
				Visit_Date_Time descending
			)
		
}