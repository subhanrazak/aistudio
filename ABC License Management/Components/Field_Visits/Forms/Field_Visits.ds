form Field_Visits
{

			displayname = "Field Visits"
			success message = "Field visit saved"
			Visit_Details
			(
				type = section
				displayname = "Visit Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Visit_Number
			(
    			type = autonumber
				displayname = "Visit Number"
				start index = 610000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Case
			(
				type = picklist	
				values  = Cases.ID
    			displayformat = [Case_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			License
			(
				type = picklist	
				values  = Licenses.ID
    			displayformat = [License_Number]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Premises
			(
				type = picklist	
				values  = Premises.ID
    			displayformat = [DBA_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Visit_Type
			(
				type = picklist
				displayname = "Visit Type"
				values = {"Inspection","Surveillance","Undercover Operation","Decoy Operation","Follow-up","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Inspection_Form_Type
			(
				type = picklist
				displayname = "Inspection Form Type"
				values = {"On-Sale ABC-531","Off-Sale ABC-537","None"}
				initial value = "None"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Visit_Date_Time
			(
    			type = datetime
				displayname = "Visit Date Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Agent_Email
			(
    			type = email
				displayname = "Agent Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Person_Contacted
			(
    			type = text
				displayname = "Person Contacted"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Capture_Details
			(
				type = section
				displayname = "Capture Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Citation_or_Arrest_Data
			(
    			type = textarea
				displayname = "Citation or Arrest Data"
				height = 120px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Photographs
			(
    			type = upload file
    			file count = 10
				browse = local_drive, google_docs, zoho_docs
	 			row = 2
	 			column = 2   
				width = medium
			)
			FSM_Status
			(
				type = picklist
				displayname = "FSM Status"
				values = {"Not Sent","Captured Manually","Synced Manually"}
				initial value = "Captured Manually"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Violations_Observed
			(
    			type = checkbox
				displayname = "Violations Observed"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Additional_Inspection_Needed
			(
    			type = checkbox
				displayname = "Additional Inspection Needed"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Visit_Notes
			(
    			type = textarea
				displayname = "Visit Notes"
				height = 160px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Licensee_Signature
			(
    			type = signature
				displayname = "Licensee Signature"
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Visit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Visit"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}