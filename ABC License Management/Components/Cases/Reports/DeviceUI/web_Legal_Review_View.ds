report Legal_Review_View
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Case_Number as "Case Number"
					License
					Premises
					Priority
					OLS_Assigned_Attorney_Email as "OLS Assigned Attorney Email"
					Case_Status as "Case Status"
					Legal_Review_Status as "Legal Review Status"
					"Accept Legal Review"
					"Draft Accusation"
					"Schedule Hearing"
					"Close Case"
				)
			)
		)
		menu
		(
			header
			(
				Edit
			)
			record
			(
				Edit
				"Accept Legal Review"
				"Draft Accusation"
				"Schedule Hearing"
				"Close Case"
			)
		)
		action
		(
			on click
			(
				View Record
			)
			on right click
			(
				Edit
				"Accept Legal Review"
				"Draft Accusation"
				"Schedule Hearing"
				"Close Case"
				View Record
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Case_Number as "Case Number"
					License
					Premises
					Priority
					Supervising_Agent_Email as "Supervising Agent Email"
					OLS_Assigned_Attorney_Email as "OLS Assigned Attorney Email"
					Case_Status as "Case Status"
					RFA_Status as "RFA Status"
					Legal_Review_Status as "Legal Review Status"
					Legal_Notes as "Legal Notes"
					Closure_Outcome as "Closure Outcome"
					Closure_Date as "Closure Date"
					"Accept Legal Review"
					"Draft Accusation"
					"Schedule Hearing"
					"Close Case"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				"Accept Legal Review"
				"Draft Accusation"
				"Schedule Hearing"
				"Close Case"
			)
		)
	)
}