report All_Cases
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Case_Number as "Case Number"
					License
					Premises
					Priority
					Assigned_Agent_Email as "Assigned Agent Email"
					Case_Status as "Case Status"
					Legal_Review_Status as "Legal Review Status"
					"Assign Case"
					"Refer to Legal"
					"Accept Legal Review"
					"Draft Accusation"
					"Schedule Hearing"
					"Close Case"
					"Reopen Case"
				)
			)
		)
		menu
		(
			header ( Edit )
			record
			(
				Edit
				"Assign Case"
				"Refer to Legal"
				"Accept Legal Review"
				"Draft Accusation"
				"Schedule Hearing"
				"Close Case"
				"Reopen Case"
			)
		)
		action
		(
			on tap ( View Record )
			on long press
			(
				Edit
				"Assign Case"
				"Refer to Legal"
				"Accept Legal Review"
				"Draft Accusation"
				"Schedule Hearing"
				"Close Case"
				"Reopen Case"
				View Record
			)
			on left swipe
			(
				"Close Case"
				"Reopen Case"
			)
			on right swipe
			(
				"Assign Case"
				"Refer to Legal"
				"Accept Legal Review"
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Case_Number as "Case Number"
					Originating_Complaint as "Originating Complaint"
					License
					Premises
					Entity
					Case_Source as "Case Source"
					Priority
					Assigned_Agent_Email as "Assigned Agent Email"
					Supervising_Agent_Email as "Supervising Agent Email"
					Case_Status as "Case Status"
					Initial_Visit_Due_Date as "Initial Visit Due Date"
					Visit_Count as "Visit Count"
					Last_Visit_Date as "Last Visit Date"
					RFA_Status as "RFA Status"
					Legal_Review_Status as "Legal Review Status"
					Closure_Outcome as "Closure Outcome"
					Closure_Date as "Closure Date"
					"Assign Case"
					"Refer to Legal"
					"Accept Legal Review"
					"Draft Accusation"
					"Schedule Hearing"
					"Close Case"
					"Reopen Case"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				"Assign Case"
				"Refer to Legal"
				"Accept Legal Review"
				"Draft Accusation"
				"Schedule Hearing"
				"Close Case"
				"Reopen Case"
			)
		)
	)
}