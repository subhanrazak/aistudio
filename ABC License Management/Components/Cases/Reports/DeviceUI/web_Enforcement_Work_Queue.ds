report Enforcement_Work_Queue
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Case_Number as "Case Number"
					License
					Premises
					Priority
					Assigned_Agent_Email as "Assigned Agent Email"
					Case_Status as "Case Status"
					Initial_Visit_Due_Date as "Initial Visit Due Date"
					RFA_Status as "RFA Status"
					"Assign Case"
					"Refer to Legal"
					"Close Case"
				)
			)
		)
		menu
		(
			header
			(
				Edit
			)
			record
			(
				Edit
				"Assign Case"
				"Refer to Legal"
				"Close Case"
			)
		)
		action
		(
			on click
			(
				View Record
			)
			on right click
			(
				Edit
				"Assign Case"
				"Refer to Legal"
				"Close Case"
				View Record
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Case_Number as "Case Number"
					Originating_Complaint as "Originating Complaint"
					License
					Premises
					Priority
					Assigned_Agent_Email as "Assigned Agent Email"
					Supervising_Agent_Email as "Supervising Agent Email"
					Case_Status as "Case Status"
					Initial_Visit_Due_Date as "Initial Visit Due Date"
					Visit_Count as "Visit Count"
					Last_Visit_Date as "Last Visit Date"
					Violations_Observed as "Violations Observed"
					Recommend_Accusation as "Recommend Accusation"
					RFA_Status as "RFA Status"
					"Assign Case"
					"Refer to Legal"
					"Close Case"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				"Assign Case"
				"Refer to Legal"
				"Close Case"
			)
		)
	)
}