report Closed_Cases
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Case_Number as "Case Number"
					License
					Premises
					Entity
					Priority
					Case_Status as "Case Status"
					Closure_Outcome as "Closure Outcome"
					Closure_Date as "Closure Date"
					"Reopen Case"
				)
			)
		)
		menu
		(
			header ( Edit )
			record
			(
				Edit
				"Reopen Case"
			)
		)
		action
		(
			on tap ( View Record )
			on long press
			(
				Edit
				"Reopen Case"
				View Record
			)
			on left swipe ( "Reopen Case" )
			on right swipe ( Edit )
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Case_Number as "Case Number"
					Originating_Complaint as "Originating Complaint"
					License
					Premises
					Entity
					Priority
					Supervising_Agent_Email as "Supervising Agent Email"
					Case_Status as "Case Status"
					Closure_Outcome as "Closure Outcome"
					Closure_Date as "Closure Date"
					Closure_Documents_Filed as "Closure Documents Filed"
					Investigation_Summary as "Investigation Summary"
					Legal_Review_Status as "Legal Review Status"
					"Reopen Case"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				"Reopen Case"
			)
		)
	)
}