default list All_Cases
{
	displayName = "All Cases"
	show all rows from Cases
	(
		Case_Number as "Case Number"
		Originating_Complaint as "Originating Complaint"
		License
		Premises
		Entity
		Case_Source as "Case Source"
		Priority
		Assigned_Agent_Email as "Assigned Agent Email"
		Supervising_Agent_Email as "Supervising Agent Email"
		Case_Status as "Case Status"
		Initial_Visit_Due_Date as "Initial Visit Due Date"
		Visit_Count as "Visit Count"
		Last_Visit_Date as "Last Visit Date"
		RFA_Status as "RFA Status"
		Legal_Review_Status as "Legal Review Status"
		Closure_Outcome as "Closure Outcome"
		Closure_Date as "Closure Date"
		custom action "Assign Case"
		(
			workflow = Case_Assign_Case
			show action for each record = true
			show action in edit record menu = true
			column header = "Assign Case"
			success message = "Case assigned."
			condition = (Case_Status == "New")
			confirmation before execution
			(
				message for individual record = "Assign this case to yourself?"
				confirm button text = "Assign Case"
				cancel button text = "Cancel"
			)
		)
		custom action "Refer to Legal"
		(
			workflow = Case_Refer_to_Legal
			show action for each record = true
			show action in edit record menu = true
			column header = "Refer to Legal"
			success message = "Case referred to legal review."
			condition = (Case_Status == "Assigned" || Case_Status == "Preliminary Investigation" || Case_Status == "Field Investigation" || Case_Status == "Report Preparation")
			confirmation before execution
			(
				message for individual record = "Refer this case to OLS/legal review?"
				confirm button text = "Refer to Legal"
				cancel button text = "Cancel"
			)
		)
		custom action "Accept Legal Review"
		(
			workflow = Case_Accept_Legal_Review
			show action for each record = true
			show action in edit record menu = true
			column header = "Accept Legal Review"
			success message = "Legal review accepted."
			condition = (Case_Status == "Referred to OLS" && Legal_Review_Status == "Pending OLS Review")
			confirmation before execution
			(
				message for individual record = "Accept legal review for this case?"
				confirm button text = "Accept Review"
				cancel button text = "Cancel"
			)
		)
		custom action "Draft Accusation"
		(
			workflow = Case_Draft_Accusation
			show action for each record = true
			show action in edit record menu = true
			column header = "Draft Accusation"
			success message = "Accusation draft status recorded."
			condition = (Case_Status == "Legal Review" && (Legal_Review_Status == "Pending OLS Review" || Legal_Review_Status == "Returned"))
			confirmation before execution
			(
				message for individual record = "Mark accusation drafted for this case?"
				confirm button text = "Draft Accusation"
				cancel button text = "Cancel"
			)
		)
		custom action "Schedule Hearing"
		(
			workflow = Case_Schedule_Hearing
			show action for each record = true
			show action in edit record menu = true
			column header = "Schedule Hearing"
			success message = "Hearing scheduled status recorded."
			condition = (Case_Status == "Legal Review" && Legal_Review_Status == "Accusation Drafted")
			confirmation before execution
			(
				message for individual record = "Move this case to hearing scheduled status?"
				confirm button text = "Schedule Hearing"
				cancel button text = "Cancel"
			)
		)
		custom action "Close Case"
		(
			workflow = Case_Close_Case
			show action for each record = true
			show action in edit record menu = true
			column header = "Close Case"
			success message = "Case closed."
			condition = (Case_Status != "Closed")
			confirmation before execution
			(
				message for individual record = "Close this case?"
				confirm button text = "Close Case"
				cancel button text = "Cancel"
			)
		)
		custom action "Reopen Case"
		(
			workflow = Case_Reopen_Case
			show action for each record = true
			show action in edit record menu = true
			column header = "Reopen Case"
			success message = "Case reopened."
			condition = (Case_Status == "Closed")
			confirmation before execution
			(
				message for individual record = "Reopen this closed case?"
				confirm button text = "Reopen Case"
				cancel button text = "Cancel"
			)
		)
	)
	filters
	(
		Case_Source
		Priority
		Assigned_Agent_Email
		Supervising_Agent_Email
		Case_Status
		RFA_Status
		Legal_Review_Status
		Closure_Date
	)
	sort by
	(
		Case_Number descending
	)
}