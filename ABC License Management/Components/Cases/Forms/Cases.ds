form Cases
{

			success message = "Case saved"
			Case_Overview
			(
				type = section
				displayname = "Case Overview"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Case_Number
			(
    			type = autonumber
				displayname = "Case Number"
				start index = 510000
	 			row = 1
	 			column = 1   
				width = medium
			)
			Originating_Complaint
			(
				type = picklist	
				displayname = "Originating Complaint"
				values  = Complaints.ID
    			displayformat = [Complaint_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			License
			(
				type = picklist	
				values  = Licenses.ID
    			displayformat = [License_Number]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Premises
			(
				type = picklist	
				values  = Premises.ID
    			displayformat = [DBA_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Entity
			(
				type = picklist	
				values  = Entities.ID
    			displayformat = [Entity_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Case_Source
			(
				type = picklist
				displayname = "Case Source"
				values = {"Complaint","On-View","Fingerprint Match","Police Report","Backtrack"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = picklist
				values = {"High","Standard","No Priority Category"}
				initial value = "Standard"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Assigned_Agent_Email
			(
    			type = email
				displayname = "Assigned Agent Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supervising_Agent_Email
			(
    			type = email
				displayname = "Supervising Agent Email"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			Case_Status
			(
				type = picklist
				displayname = "Case Status"
				values = {"New","Assigned","Preliminary Investigation","Field Investigation","Report Preparation","Referred to OLS","Legal Review","Hearing Status","Closed"}
				initial value = "New"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Investigation_Tracking
			(
				type = section
				displayname = "Investigation Tracking"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Initial_Visit_Due_Date
			(
    			type = date
				displayname = "Initial Visit Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Visit_Count
			(
				type = number
				displayname = "Visit Count"
				maxchar = 6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Last_Visit_Date
			(
    			type = date
				displayname = "Last Visit Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Violations_Observed
			(
    			type = checkbox
				displayname = "Violations Observed"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Recommend_Accusation
			(
    			type = checkbox
				displayname = "Recommend Accusation"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			RFA_Status
			(
				type = picklist
				displayname = "RFA Status"
				values = {"Not Started","Draft","Submitted to Division/OLS","Approved","Returned"}
				initial value = "Not Started"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Investigation_Summary
			(
    			type = textarea
				displayname = "Investigation Summary"
				height = 180px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Legal_and_Closure
			(
				type = section
				displayname = "Legal and Closure"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			OLS_Assigned_Attorney_Email
			(
    			type = email
				displayname = "OLS Assigned Attorney Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
			)
			Legal_Review_Status
			(
				type = picklist
				displayname = "Legal Review Status"
				values = {"Not Referred","Pending OLS Review","Accusation Drafted","Hearing Scheduled","Hearing Held","Proposed Decision","Director Action","Appeal Status","Returned","Closed"}
				initial value = "Not Referred"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Closure_Outcome
			(
				type = picklist
				displayname = "Closure Outcome"
				values = {"No Further Action","Warning Letter","Notice of Public Nuisance","Incident File","Accusation","Closed Other"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Closure_Date
			(
    			type = date
				displayname = "Closure Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Closure_Documents_Filed
			(
    			type = checkbox
				displayname = "Closure Documents Filed"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Legal_Notes
			(
    			type = textarea
				displayname = "Legal Notes"
				height = 150px
	 			row = 3
	 			column = 2   
				width = medium
			)
			Supervisor_Lock
			(
    			type = checkbox
				displayname = "Supervisor Lock"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Case"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Case"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"New","Assigned","Preliminary Investigation","Field Investigation","Report Preparation","Referred to OLS","Legal Review","Hearing Status","Closed"}
			}
		
}