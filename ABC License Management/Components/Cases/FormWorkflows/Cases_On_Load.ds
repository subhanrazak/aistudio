Cases_On_Load as "Prepare Case Form"
{

				type =  form
				form = Cases

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Priority == null)
										{
											input.Priority = "Standard";
										}
										if(input.Case_Status == null)
										{
											input.Case_Status = "New";
										}
										if(input.RFA_Status == null)
										{
											input.RFA_Status = "Not Started";
										}
										if(input.Legal_Review_Status == null)
										{
											input.Legal_Review_Status = "Not Referred";
										}
										if(input.Supervisor_Lock == true)
										{
											disable Case_Status;
											disable Closure_Outcome;
											disable Closure_Date;
											disable Investigation_Summary;
											disable Legal_Notes;
										}
						)
					}
				}

			
}