form Entities
{

			success message = "Entity saved"
			Entity_Details
			(
				type = section
				displayname = "Entity Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Entity_Number
			(
    			type = autonumber
				displayname = "Entity Number"
				start index = 100000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Entity_Name
			(
    			type = text
				displayname = "Entity Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Entity_Kind
			(
				type = picklist
				displayname = "Entity Kind"
				values = {"Individual","Partnership","Limited Partnership","LLC","Corporation","Trust","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Primary_Contact_Name
			(
    			type = name
				displayname = "Primary Contact Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Title"
	     			 value = {"Mr.","Mrs.","Ms.","Dr."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Email
			(
    			type = email
				displayname = "Contact Email"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Contact_Phone
			(
    			type = phonenumber
				displayname = "Contact Phone"
    			defaultcountry="us"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Mailing_Address
			(
    			type = address
				displayname = "Mailing Address"
     			capture_coordinates = true
     			adjust_using_map = true
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Street Address"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Suite / Unit"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "ZIP Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 2   
				width = medium
			)
			Administration
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Tax_ID_Last4
			(
    			type = text
				displayname = "Tax ID Last 4"
				maxchar = 4
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
				isencrypted = true
			)
			Secretary_of_State_Number
			(
    			type = text
				displayname = "Secretary of State Number"
				maxchar = 100
	 			row = 2
	 			column = 2   
				width = medium
			)
			Licensee_Portal_Email
			(
    			type = email
				displayname = "Licensee Portal Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 2
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Entity"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Entity"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}