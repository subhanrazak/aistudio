list Entity_Search
{

			displayName = "Entity Search"
			show all rows from Entities    
			(
				Entity_Number as "Entity Number"
				Entity_Name as "Entity Name"
				Entity_Kind as "Entity Kind"
				Contact_Email as "Contact Email"
				Contact_Phone as "Contact Phone"
				Secretary_of_State_Number as "Secretary of State Number"
				Active
			)
			filters
			(
				Entity_Name
				Entity_Kind
				Contact_Email
				Secretary_of_State_Number
				Active
			)
			sort by
			(
				Entity_Name ascending
			)
		
}