list Active_Licensees
{

			displayName = "Active Licensees"
			show all rows from Entities  [Active == true]  
			(
				Entity_Number as "Entity Number"
				Entity_Name as "Entity Name"
				Entity_Kind as "Entity Kind"
				Contact_Email as "Contact Email"
				Contact_Phone as "Contact Phone"
				Licensee_Portal_Email as "Licensee Portal Email"
				Active
			)
			filters
			(
				Entity_Name
				Entity_Kind
				Contact_Email
			)
			sort by
			(
				Entity_Name ascending
			)
		
}