Entities_On_Validate as "Validate Entity"
{

				type =  form
				form = Entities

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Entity_Kind != "Individual" && input.Contact_Email == null || input.Contact_Email.trim() == "")
										{
											alert "Contact Email is required for non-individual entities.";
											cancel submit;
										}
						)
					}
				}

			
}