Entities_On_Success as "Audit Entity Save"
{

				type =  form
				form = Entities

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("Reference Data","Entities",input.ID,"Entity saved","Entity " + input.Entity_Name + " was saved or updated.");
						)
					}
				}

			
}