Premises_On_Validate as "Validate Premises"
{

				type =  form
				form = Premises

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.DBA_Name == null || input.DBA_Name.trim() == "")
										{
											alert "DBA Name is required.";
											cancel submit;
										}
										if(input.County == null || input.County.trim() == "")
										{
											alert "County is required.";
											cancel submit;
										}
										if(input.Mailing_Address_Different == true && input.Mailing_Address.address_line_1 == null)
										{
											alert "Mailing Address is required when it differs from the premises address.";
											cancel submit;
										}
						)
					}
				}

			
}