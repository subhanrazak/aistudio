Premises_On_Success as "Audit Premises Save"
{

				type =  form
				form = Premises

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("Reference Data","Premises",input.ID,"Premises saved","Premises " + input.DBA_Name + " was saved or updated.");
						)
					}
				}

			
}