map Premises_Map
{

			displayName = "Premises Map"
			show all rows from Premises  [Active == true]  
			(
				DBA_Name as "DBA Name"
				County
				Premises_Phone as "Premises Phone"
				Active
			)
			filters
			(
				DBA_Name
				County
				Active
			)
			options
			(
	 			display field = Premises_Address
         		location
         		(
	 		 		latitude  = 36.7783
	 		 		longitude = -119.4179
         		)
	 	 		radius = 500 Miles 
	 		)
		
}