default list All_Premises
{

			displayName = "All Premises"
			show all rows from Premises    
			(
				Premises_Number as "Premises Number"
				DBA_Name as "DBA Name"
				County
				Inside_City_Limits as "Inside City Limits"
				Census_Tract as "Census Tract"
				Premises_Phone as "Premises Phone"
				Active
				Notes
			)
			filters
			(
				DBA_Name
				County
				Inside_City_Limits
				Active
			)
			sort by
			(
				DBA_Name ascending
			)
		
}