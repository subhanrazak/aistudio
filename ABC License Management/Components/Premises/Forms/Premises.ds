form Premises
{

			success message = "Premises saved"
			Premises_Details
			(
				type = section
				displayname = "Premises Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Premises_Number
			(
    			type = autonumber
				displayname = "Premises Number"
				start index = 500000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have DBA_Name
			(
    			type = text
				displayname = "DBA Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Premises_Address
			(
    			type = address
				displayname = "Premises Address"
     			capture_coordinates = true
     			adjust_using_map = true
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Street Address"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Suite / Unit"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "ZIP Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have County
			(
    			type = text
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inside_City_Limits
			(
				type = picklist
				displayname = "Inside City Limits"
				values = {"Yes","No","Unknown"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Census_Tract
			(
    			type = text
				displayname = "Census Tract"
				maxchar = 50
	 			row = 1
	 			column = 1   
				width = medium
			)
			Premises_Phone
			(
    			type = phonenumber
				displayname = "Premises Phone"
    			defaultcountry="us"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Mailing_Address_Different
			(
    			type = checkbox
				displayname = "Mailing Address Different"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Mailing_Address
			(
    			type = address
				displayname = "Mailing Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Street Address"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Suite / Unit"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "ZIP Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 2   
				width = medium
			)
			Administration
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Geo_Code
			(
    			type = text
				displayname = "Geo Code"
				maxchar = 100
	 			row = 2
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 2
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Premises"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Premises"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}