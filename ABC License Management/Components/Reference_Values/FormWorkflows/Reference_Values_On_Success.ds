Reference_Values_On_Success as "Audit Reference Value Save"
{

				type =  form
				form = Reference_Values

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("Reference Data","Reference_Values",input.ID,"Reference value saved","Reference value " + input.Value_Name + " was saved or updated.");
						)
					}
				}

			
}