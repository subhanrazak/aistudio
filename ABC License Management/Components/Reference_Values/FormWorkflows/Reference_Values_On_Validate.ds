Reference_Values_On_Validate as "Validate Reference Value"
{

				type =  form
				form = Reference_Values

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Category in {""," ","null"})
										{
											alert "Category is required.";
											cancel submit;
										}
										if(input.Value_Name in {""," ","null"})
										{
											alert "Value Name is required.";
											cancel submit;
										}
						)
					}
				}

			
}