form Reference_Values
{

			displayname = "Reference Values"
			success message = "Reference value saved"
			Reference_Value
			(
				type = section
				displayname = "Reference Value"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Category
			(
				type = picklist
				values = {"Company Structure","State","Country","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Value_Code
			(
    			type = text
				displayname = "Value Code"
				maxchar = 20
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Value_Name
			(
    			type = text
				displayname = "Value Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sort_Order
			(
				type = number
				displayname = "Sort Order"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}