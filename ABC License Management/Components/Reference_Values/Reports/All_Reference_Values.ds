default list All_Reference_Values
{

			displayName = "All Reference Values"
			show all rows from Reference_Values    
			(
				Category
				Value_Code as "Value Code"
				Value_Name as "Value Name"
				Active
				Sort_Order as "Sort Order"
				Notes
			)
			filters
			(
				Category
				Value_Name
				Active
				"Active Only"  :  Active == true
			)
			sort by
			(
				Category ascending
				Sort_Order ascending
				Value_Name ascending
			)
		
}