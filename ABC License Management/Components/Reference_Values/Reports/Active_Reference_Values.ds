list Active_Reference_Values
{

			displayName = "Active Reference Values"
			show all rows from Reference_Values  [Active == true]  
			(
				Category
				Value_Code as "Value Code"
				Value_Name as "Value Name"
				Active
				Sort_Order as "Sort Order"
			)
			filters
			(
				Category
				Value_Name
				Active
			)
			sort by
			(
				Category ascending
				Sort_Order ascending
				Value_Name ascending
			)
		
}