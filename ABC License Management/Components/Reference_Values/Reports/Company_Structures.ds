list Company_Structures
{

			displayName = "Company Structures"
			show all rows from Reference_Values  [Category == "Company Structure" && Active == true]  
			(
				Category
				Value_Code as "Value Code"
				Value_Name as "Value Name"
				Active
				Sort_Order as "Sort Order"
			)
			filters
			(
				Category
				Value_Name
				Active
			)
			sort by
			(
				Sort_Order ascending
				Value_Name ascending
			)
		
}