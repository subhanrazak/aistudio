form Payments
{

			success message = "Payment saved"
			Payment_Details
			(
				type = section
				displayname = "Payment Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Payment_Reference
			(
    			type = autonumber
				displayname = "Payment Reference"
				start index = 900000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Payment_Module
			(
				type = picklist
				displayname = "Payment Module"
				values = {"Application","Renewal","Refund","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Application
			(
				type = picklist	
				values  = Applications.ID
    			displayformat = [Business_DBA_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Renewal_Batch
			(
				type = picklist	
				displayname = "Renewal Batch"
				values  = Renewal_Batches.ID
    			displayformat = [Renewal_Batch_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Entity
			(
				type = picklist	
				values  = Entities.ID
    			displayformat = [Entity_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Payment_Method
			(
				type = picklist
				displayname = "Payment Method"
				values = {"Electronic Check","Card","Counter","Mail","Manual Adjustment","Refund"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment_Status
			(
				type = picklist
				displayname = "Payment Status"
				values = {"Pending","Complete","Failed","Refunded","Refund Requested","Void"}
				initial value = "Pending"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Amount_Due
			(
				type = decimal
				displayname = "Amount Due"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Amount_Paid
			(
				type = decimal
				displayname = "Amount Paid"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Payment_Date
			(
    			type = date
				displayname = "Payment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Books_Reference
			(
    			type = text
				displayname = "Books Reference"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Receipt_Number
			(
    			type = text
				displayname = "Receipt Number"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Receipt_Generated
			(
    			type = checkbox
				displayname = "Receipt Generated"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Refund_Details
			(
				type = section
				displayname = "Refund Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Refund_Requested
			(
    			type = checkbox
				displayname = "Refund Requested"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Refund_Amount
			(
				type = decimal
				displayname = "Refund Amount"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Refund_Reason
			(
    			type = textarea
				displayname = "Refund Reason"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Refund_Status
			(
				type = picklist
				displayname = "Refund Status"
				values = {"Not Requested","Requested","Approved","Completed","Denied"}
				initial value = "Not Requested"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Reconciliation
			(
				type = section
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Reconciled
			(
    			type = checkbox
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Reconciliation_Date
			(
    			type = date
				displayname = "Reconciliation Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Payment"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Payment"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}