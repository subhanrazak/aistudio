report All_Payments
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Payment_Reference as "Payment Reference"
					Payment_Module as "Payment Module"
					Entity
					Payment_Status as "Payment Status"
					Amount_Due as "Amount Due"
					Amount_Paid as "Amount Paid"
					Payment_Date as "Payment Date"
					Refund_Status as "Refund Status"
					Reconciled
					"Mark Paid"
					"Request Refund"
					"Approve Refund"
					"Reject Refund"
					"Reconcile Payment"
				)
			)
		)
		menu
		(
			header
			(
				Edit
			)
			record
			(
				Edit
				"Mark Paid"
				"Request Refund"
				"Approve Refund"
				"Reject Refund"
				"Reconcile Payment"
			)
		)
		action
		(
			on tap
			(
				View Record
			)
			on long press
			(
				Edit
				"Mark Paid"
				"Request Refund"
				"Approve Refund"
				"Reject Refund"
				"Reconcile Payment"
				View Record
			)
			on left swipe
			(
				"Approve Refund"
				"Reject Refund"
			)
			on right swipe
			(
				"Mark Paid"
				"Request Refund"
				"Reconcile Payment"
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Payment_Reference as "Payment Reference"
					Payment_Module as "Payment Module"
					Application
					Renewal_Batch as "Renewal Batch"
					Entity
					Payment_Method as "Payment Method"
					Payment_Status as "Payment Status"
					Amount_Due as "Amount Due"
					Amount_Paid as "Amount Paid"
					Payment_Date as "Payment Date"
					Receipt_Generated as "Receipt Generated"
					Refund_Requested as "Refund Requested"
					Refund_Amount as "Refund Amount"
					Refund_Status as "Refund Status"
					Reconciled
					Reconciliation_Date as "Reconciliation Date"
					"Mark Paid"
					"Request Refund"
					"Approve Refund"
					"Reject Refund"
					"Reconcile Payment"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				"Mark Paid"
				"Request Refund"
				"Approve Refund"
				"Reject Refund"
				"Reconcile Payment"
			)
		)
	)
}