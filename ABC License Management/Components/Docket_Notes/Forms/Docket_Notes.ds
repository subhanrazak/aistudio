form Docket_Notes
{

			displayname = "Docket Notes"
			success message = "Docket note saved"
			Docket_Note
			(
				type = section
				displayname = "Docket Note"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Application
			(
				type = picklist	
				values  = Applications.ID
    			displayformat = [Application_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Date
			(
    			type = date
				displayname = "Event Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Event_Code
			(
    			type = text
				displayname = "Event Code"
				maxchar = 50
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Description
			(
    			type = text
				displayname = "Event Description"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 140px
	 			row = 1
	 			column = 1   
				width = medium
			)
			User
			(
    			type = email
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}