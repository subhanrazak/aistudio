Docket_Notes_On_Load as "Prepare Docket Note"
{

				type =  form
				form = Docket_Notes

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Event_Date == null)
										{
											input.Event_Date = zoho.currentdate;
										}
										if(input.User in {""," ","null"})
										{
											input.User = zoho.loginuserid;
										}
										disable Event_Date;
										disable Event_Code;
										disable Event_Description;
										disable Comments;
										disable User;
						)
					}
				}

			
}