Docket_Notes_On_Success as "Audit Docket Note"
{

				type =  form
				form = Docket_Notes

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("New License Application","Docket_Notes",input.ID,"Docket note saved",ifnull(input.Event_Description,"Docket note saved."));
						)
					}
				}

			
}