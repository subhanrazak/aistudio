Docket_Notes_On_Validate as "Validate Docket Note"
{

				type =  form
				form = Docket_Notes

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Application == null || input.Event_Date == null)
										{
											alert "Application and Event Date are required.";
											cancel submit;
										}
										if(input.User in {""," ","null"})
										{
											input.User = zoho.loginuserid;
										}
						)
					}
				}

			
}