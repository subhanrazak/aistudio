list Docket_Notes_By_Application
{

			displayName = "Docket Notes By Application"
			show all rows from Docket_Notes    
			(
				Application
				Event_Date as "Event Date"
				Event_Code as "Event Code"
				Event_Description as "Event Description"
				Comments
				User
			)
			filters
			(
				Application
				Event_Date
				Event_Code
			)
			sort by
			(
				Event_Date descending
			)
		
}