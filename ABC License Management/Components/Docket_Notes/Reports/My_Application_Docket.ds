list My_Application_Docket
{

			displayName = "My Application Docket"
			show all rows from Docket_Notes  [Application.Applicant_Email == zoho.loginuserid]  
			(
				Application
				Event_Date as "Event Date"
				Event_Code as "Event Code"
				Event_Description as "Event Description"
				Comments
			)
			filters
			(
				Application
				Event_Date
				Event_Code
			)
			sort by
			(
				Event_Date descending
			)
		
}