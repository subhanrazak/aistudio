report My_Application_Docket
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Application
					Event_Date as "Event Date"
					Event_Code as "Event Code"
					Event_Description as "Event Description"
				)
			)
		)
		menu
		(
			header
			(
				Edit
			)
			record
			(
				Edit
			)
		)
		action
		(
			on tap
			(
				View Record
			)
			on long press
			(
				Edit
				View Record
			)
			on right swipe
			(
				Edit
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Application
					Event_Date as "Event Date"
					Event_Code as "Event Code"
					Event_Description as "Event Description"
					Comments
				)
			)
		)
		menu
		(
			header
			(
				Edit
			)
		)
	)
}