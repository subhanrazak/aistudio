default list All_Renewal_Items
{

			displayName = "All Renewal Items"
			show all rows from Renewal_Items    
			(
				Renewal_Batch as "Renewal Batch"
				License
				License_Type as "License Type"
				Current_Expiration_Date as "Current Expiration Date"
				Penalty_Stage as "Penalty Stage"
				Renewal_Fee as "Renewal Fee"
				Penalty_Amount as "Penalty Amount"
				Total_Item_Amount as "Total Item Amount"
				Item_Status as "Item Status"
			)
			filters
			(
				Renewal_Batch
				License
				Penalty_Stage
				Item_Status
			)
		
}