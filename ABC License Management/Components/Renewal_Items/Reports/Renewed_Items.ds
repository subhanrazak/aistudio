list Renewed_Items
{

			displayName = "Renewed Items"
			show all rows from Renewal_Items  [Item_Status == "Renewed"]  
			(
				Renewal_Batch as "Renewal Batch"
				License
				License_Type as "License Type"
				Current_Expiration_Date as "Previous Expiration Date"
				Total_Item_Amount as "Total Item Amount"
				Item_Status as "Item Status"
			)
			filters
			(
				Renewal_Batch
				License
			)
		
}