list Pending_Renewal_Items
{

			displayName = "Pending Renewal Items"
			show all rows from Renewal_Items  [Item_Status == "Selected" || Item_Status == "Payment Pending"]  
			(
				Renewal_Batch as "Renewal Batch"
				License
				License_Type as "License Type"
				Total_Item_Amount as "Total Item Amount"
				Item_Status as "Item Status"
			)
			filters
			(
				Renewal_Batch
				Item_Status
			)
		
}