form Renewal_Items
{

			displayname = "Renewal Items"
			success message = "Renewal item saved"
			Renewal_Item_Details
			(
				type = section
				displayname = "Renewal Item Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Renewal_Batch
			(
				type = picklist	
				displayname = "Renewal Batch"
				values  = Renewal_Batches.ID
    			displayformat = [Renewal_Batch_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have License
			(
				type = picklist	
				values  = Licenses.ID
    			displayformat = [License_Number]
	 			row = 1
	 			column = 2   
				width = medium
			)
			License_Type
			(
				type = picklist	
				displayname = "License Type"
				values  = License_Types.ID
    			displayformat = [Full_License_Type_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Expiration_Date
			(
    			type = date
				displayname = "Current Expiration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Penalty_Stage
			(
				type = picklist
				displayname = "Penalty Stage"
				values = {"None","50%","100%"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Renewal_Fee
			(
				type = decimal
				displayname = "Renewal Fee"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Penalty_Amount
			(
				type = decimal
				displayname = "Penalty Amount"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Item_Amount
			(
				type = decimal
				displayname = "Total Item Amount"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Item_Status
			(
				type = picklist
				displayname = "Item Status"
				values = {"Selected","Payment Pending","Paid","Renewed","Cancelled"}
				initial value = "Selected"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Renewal Item"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Renewal Item"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}