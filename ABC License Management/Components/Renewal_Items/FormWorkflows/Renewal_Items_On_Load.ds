Renewal_Items_On_Load as "Prepare Renewal Item"
{

				type =  form
				form = Renewal_Items

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable License_Type;
										disable Current_Expiration_Date;
										disable Renewal_Fee;
										disable Penalty_Amount;
										disable Total_Item_Amount;
						)
					}
				}

			
}