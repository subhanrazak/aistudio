report All_Renewal_Batches
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Renewal_Batch_Number as "Renewal Batch Number"
					Entity
					Batch_Status as "Batch Status"
					Payment_Status as "Payment Status"
					Total_Amount_Due as "Total Amount Due"
					Submitted_Date as "Submitted Date"
					"Submit Renewal"
					"Mark Payment Pending"
					"Mark Renewal Paid"
					"Complete Renewal"
					"Cancel Renewal"
				)
			)
		)
		menu
		(
			header
			(
				Edit
			)
			record
			(
				Edit
				"Submit Renewal"
				"Mark Payment Pending"
				"Mark Renewal Paid"
				"Complete Renewal"
				"Cancel Renewal"
			)
		)
		action
		(
			on tap
			(
				View Record
			)
			on long press
			(
				Edit
				"Submit Renewal"
				"Mark Payment Pending"
				"Mark Renewal Paid"
				"Complete Renewal"
				"Cancel Renewal"
				View Record
			)
			on right swipe
			(
				"Submit Renewal"
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Renewal_Batch_Number as "Renewal Batch Number"
					Entity
					Licensee_Email as "Licensee Email"
					Batch_Status as "Batch Status"
					Payment_Status as "Payment Status"
					Penalty_Stage_Applied as "Penalty Stage Applied"
					Total_Amount_Due as "Total Amount Due"
					Submitted_Date as "Submitted Date"
					Completed_Date as "Completed Date"
					Manual_Entry_By_Staff as "Manual Entry By Staff"
					"Submit Renewal"
					"Mark Payment Pending"
					"Mark Renewal Paid"
					"Complete Renewal"
					"Cancel Renewal"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				"Submit Renewal"
				"Mark Payment Pending"
				"Mark Renewal Paid"
				"Complete Renewal"
				"Cancel Renewal"
			)
		)
	)
}