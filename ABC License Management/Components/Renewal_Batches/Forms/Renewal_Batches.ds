form Renewal_Batches
{

			displayname = "Renewal Batches"
			success message = "Renewal batch saved"
			Batch_Details
			(
				type = section
				displayname = "Batch Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Renewal_Batch_Number
			(
    			type = autonumber
				displayname = "Renewal Batch Number"
				start index = 700000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Entity
			(
				type = picklist	
				values  = Entities.ID
    			displayformat = [Entity_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Licensee_Email
			(
    			type = email
				displayname = "Licensee Email"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Batch_Status
			(
				type = picklist
				displayname = "Batch Status"
				values = {"Draft","Submitted","Payment Pending","Paid","Completed","Cancelled"}
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Penalty_Stage_Applied
			(
				type = picklist
				displayname = "Penalty Stage Applied"
				values = {"None","50%","100%","Mixed"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total_Renewal_Fees
			(
				type = decimal
				displayname = "Total Renewal Fees"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Penalties
			(
				type = decimal
				displayname = "Total Penalties"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total_Amount_Due
			(
				type = decimal
				displayname = "Total Amount Due"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment
			(
				type = picklist	
				values  = Payments.ID
    			displayformat = [Payment_Reference]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Payment_Status
			(
				type = picklist
				displayname = "Payment Status"
				values = {"Pending","Complete","Waived","Refunded"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Submitted_Date
			(
    			type = date
				displayname = "Submitted Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Completed_Date
			(
    			type = date
				displayname = "Completed Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Manual_Entry_By_Staff
			(
    			type = checkbox
				displayname = "Manual Entry By Staff"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Renewal Batch"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Renewal Batch"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}