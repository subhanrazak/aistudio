form Licenses
{

			success message = "License saved"
			License_Details
			(
				type = section
				displayname = "License Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			License_Number
			(
    			type = autonumber
				displayname = "License Number"
				start index = 410000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have License_Type
			(
				type = picklist	
				displayname = "License Type"
				values  = License_Types.ID
    			displayformat = [Full_License_Type_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Entity
			(
				type = picklist	
				values  = Entities.ID
    			displayformat = [Entity_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Premises
			(
				type = picklist	
				values  = Premises.ID
    			displayformat = [DBA_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source_Application
			(
				type = picklist	
				displayname = "Source Application"
				values  = Applications.ID
    			displayformat = [Business_DBA_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			New_Application_Bridge
			(
				type = section
				displayname = "New Application Bridge"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Source_New_Application
			(
				type = picklist	
				displayname = "Source New Application"
				values  = Applications.ID
    			displayformat = [Application_Number]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Applicant_Profile
			(
				type = picklist	
				displayname = "Applicant Profile"
				values  = Applicant_Profile.ID
    			displayformat = [Profile_Email]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Legal_Entity_New
			(
				type = picklist	
				displayname = "Legal Entity New"
				values  = Legal_Entities.ID
    			displayformat = [Company_Name]
	 			row = 2
	 			column = 1   
				width = medium
			)
			DBA_New
			(
				type = picklist	
				displayname = "DBA New"
				values  = DBA.ID
    			displayformat = [DBA_Name]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Premise_Address_New
			(
				type = picklist	
				displayname = "Premise Address New"
				values  = Address_Records.ID
    			displayformat = [Address_Title]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Renewal_Status
			(
				type = section
				displayname = "Renewal Status"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Issue_Date
			(
    			type = date
				displayname = "Issue Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Expiration_Date
			(
    			type = date
				displayname = "Expiration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			License_Status
			(
				type = picklist
				displayname = "License Status"
				values = {"Active","Renewal Due","Renewed","50% Penalty","100% Penalty","Suspended","Closed","Terminated"}
				initial value = "Active"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Terminated_Date
			(
    			type = date
				displayname = "Terminated Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Termination_Reason
			(
    			type = textarea
				displayname = "Termination Reason"
				height = 120px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Replaced_By_License
			(
				type = picklist	
				displayname = "Replaced By License"
				values  = Licenses.ID
    			displayformat = [License_Number]
				searchable = true
	 			row = 3
	 			column = 2   
				width = medium
			)
			Penalty_Stage
			(
				type = picklist
				displayname = "Penalty Stage"
				values = {"None","50%","100%"}
				initial value = "None"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Renewal_Notice_Generated
			(
    			type = checkbox
				displayname = "Renewal Notice Generated"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Last_Renewal_Date
			(
    			type = date
				displayname = "Last Renewal Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Conditions
			(
    			type = textarea
				height = 120px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Licensee_Email
			(
    			type = email
				displayname = "Licensee Email"
				maxchar = 80
	 			row = 3
	 			column = 2   
				width = medium
				personal data = true
			)
			Active_Certificate_File
			(
    			type = upload file
				displayname = "Active Certificate File"
				browse = local_drive
	 			row = 3
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save License"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update License"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Active","Renewal Due","Renewed","50% Penalty","100% Penalty","Suspended","Closed","Terminated"}
			}
		
}