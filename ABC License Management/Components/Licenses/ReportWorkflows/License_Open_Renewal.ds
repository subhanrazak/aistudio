License_Open_Renewal as "Open Renewal"
{
	type = functions
	form = Licenses
	execution type = for each record
	description = "Opens the licensee renewal portal from license-facing reports."

	on start
	{
		actions
		{
			on click
			(
				actorEmail = zoho.loginuserid;
				thisapp.Write_Audit_Log("Renewal","Licenses",input.ID,"Open renewal","Renewal portal opened from license report by " + actorEmail + ".");
				openUrl("#Page:Renewal_Portal", "same window");
			)
		}
	}
}