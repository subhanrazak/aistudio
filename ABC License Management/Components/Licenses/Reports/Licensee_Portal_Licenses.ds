list Licensee_Portal_Licenses
{
	displayName = "Licensee Portal Licenses"
	show all rows from Licenses
	(
		License_Number as "License Number"
		License_Type as "License Type"
		Entity
		Premises
		Issue_Date as "Issue Date"
		Expiration_Date as "Expiration Date"
		License_Status as "License Status"
		Penalty_Stage as "Penalty Stage"
		Licensee_Email as "Licensee Email"
		custom action "Open Renewal"
		(
			workflow = License_Open_Renewal
			show action for each record = true
			show action in edit record menu = true
			column header = "Open Renewal"
			success message = "Opening renewal portal."
			condition = (License_Status == "Renewal Due" || License_Status == "50% Penalty" || License_Status == "100% Penalty" || ((License_Status == "Active" || License_Status == "Renewed") && Expiration_Date in next 60 days))
		)
	)
	filters
	(
		License_Number
		License_Status
		Expiration_Date
		Licensee_Email
	)
	sort by
	(
		Expiration_Date ascending
	)
}