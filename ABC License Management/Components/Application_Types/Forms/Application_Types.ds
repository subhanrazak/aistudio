form Application_Types
{

			displayname = "Application Types"
			success message = "Application type saved"
			Application_Type_Details
			(
				type = section
				displayname = "Application Type Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Type_Name
			(
    			type = text
				displayname = "Type Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Charges
			(
				type = USD
				initial value = 0
				maxchar = 12
	 			row = 1
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}