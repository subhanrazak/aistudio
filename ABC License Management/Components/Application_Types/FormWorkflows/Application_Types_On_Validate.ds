Application_Types_On_Validate as "Validate Application Type"
{

				type =  form
				form = Application_Types

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Type_Name in {""," ","null"})
										{
											alert "Type Name is required.";
											cancel submit;
										}
										if(ifnull(input.Charges,0) < 0)
										{
											alert "Charges cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}