Application_Types_On_Success as "Audit Application Type Save"
{

				type =  form
				form = Application_Types

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("New License Application","Application_Types",input.ID,"Application type saved","Application type " + input.Type_Name + " was saved or updated.");
						)
					}
				}

			
}