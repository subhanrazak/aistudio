default list All_Application_Types
{

			displayName = "All Application Types"
			show all rows from Application_Types    
			(
				Type_Name as "Type Name"
				Charges
				Active
				Notes
			)
			filters
			(
				Type_Name
				Active
				"Active Only"  :  Active == true
			)
			sort by
			(
				Type_Name ascending
			)
		
}