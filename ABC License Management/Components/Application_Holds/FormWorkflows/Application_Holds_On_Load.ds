Application_Holds_On_Load as "Prepare Application Hold"
{

				type =  form
				form = Application_Holds

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Created_Date == null)
										{
											input.Created_Date = zoho.currentdate;
										}
										if(input.Hold_Released == true && input.Released_Date == null)
										{
											input.Released_Date = zoho.currentdate;
										}
										disable Created_Date;
										disable Released_Date;
						)
					}
				}

			
}