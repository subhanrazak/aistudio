form Application_Holds
{

			displayname = "Application Holds"
			success message = "Application hold saved"
			Hold_Details
			(
				type = section
				displayname = "Hold Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Application
			(
				type = picklist	
				values  = Applications.ID
    			displayformat = [Application_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Hold_Placed_By
			(
				type = picklist	
				displayname = "Hold Placed By"
				values  = Add_Agents.ID
    			displayformat = [Agent_Name.first_name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Released_By
			(
				type = picklist	
				displayname = "Released By"
				values  = Add_Agents.ID
    			displayformat = [Agent_Name.first_name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Created_Date
			(
    			type = date
				displayname = "Created Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Hold_Type
			(
    			type = text
				displayname = "Hold Type"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Hold_Comment
			(
    			type = textarea
				displayname = "Hold Comment"
				height = 140px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Hold_Until
			(
    			type = date
				displayname = "Hold Until"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hold_Released
			(
    			type = checkbox
				displayname = "Hold Released"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Released_Date
			(
    			type = date
				displayname = "Released Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}