default list All_Application_Holds
{

			displayName = "All Application Holds"
			show all rows from Application_Holds    
			(
				Application
				Hold_Placed_By as "Hold Placed By"
				Released_By as "Released By"
				Created_Date as "Created Date"
				Hold_Type as "Hold Type"
				Hold_Comment as "Hold Comment"
				Hold_Until as "Hold Until"
				Hold_Released as "Hold Released"
				Released_Date as "Released Date"
			)
			filters
			(
				Application
				Hold_Placed_By
				Created_Date
				Hold_Type
				Hold_Released
				Released_Date
			)
			sort by
			(
				Created_Date descending
			)
		
}