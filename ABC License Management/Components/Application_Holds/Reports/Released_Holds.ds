list Released_Holds
{

			displayName = "Released Holds"
			show all rows from Application_Holds  [Hold_Released == true]  
			(
				Application
				Hold_Placed_By as "Hold Placed By"
				Released_By as "Released By"
				Created_Date as "Created Date"
				Hold_Type as "Hold Type"
				Hold_Comment as "Hold Comment"
				Released_Date as "Released Date"
			)
			filters
			(
				Application
				Hold_Placed_By
				Released_By
				Created_Date
				Hold_Type
				Released_Date
			)
			sort by
			(
				Released_Date descending
			)
		
}