report Active_Applicant_Profiles
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Profile_Number as "Profile Number"
								Profile_Email as "Profile Email"
								Profile_Name.first_name as "First Name"
								Profile_Name.last_name as "Last Name"
								Active
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Delete 
							)
						record
						(
							Edit   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Profile_Number as "Profile Number"
								Profile_Email as "Profile Email"
								Profile_Name.first_name as "First Name"
								Profile_Name.last_name as "Last Name"
								Phone
								Active
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Delete 
							)
						)
				)
			
}