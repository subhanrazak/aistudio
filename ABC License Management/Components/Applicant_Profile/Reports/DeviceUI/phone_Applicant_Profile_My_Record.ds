report My_Profile
{

				quickview
				(
					layout
					(
		 				type = -1
						datablock1
						(
							layout type = -1
							fields
							(
								Profile_Number as "Profile Number"
								Profile_Email as "Profile Email"
								Profile_Name.first_name as "First Name"
								Profile_Name.last_name as "Last Name"
								Phone
							)
						)
					)
						menu
						(
							header
							(
								Edit 
							)
						record
						(
							Edit   	   
    					)
						)
    				action
    				(
						on tap
						(
							View Record   	   
    					)
						on long press
						(
							Edit   	   
							View Record   	   
    					)
						on right swipe
						(
							Edit   	   
    					)
      				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Profile_Number as "Profile Number"
								Profile_Email as "Profile Email"
								Profile_Name.first_name as "First Name"
								Profile_Name.last_name as "Last Name"
								Phone
								Active
							)
						)
					)
						menu
						(
							header
							(
								Edit 
							)
						)
				)
			
}