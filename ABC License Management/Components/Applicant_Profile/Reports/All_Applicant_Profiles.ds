default list All_Applicant_Profiles
{

			displayName = "All Applicant Profiles"
			show all rows from Applicant_Profile    
			(
				Profile_Number as "Profile Number"
				Profile_Email as "Profile Email"
				Profile_Name.first_name as "First Name"
				Profile_Name.last_name as "Last Name"
				Phone
				(
					displayformat = formattednumber 
				)
				Active
				Notes
				Profile_Image as "Profile Image"
			)
			filters
			(
				Profile_Email
				Active
				"Active Only"  :  Active == true
			)
			sort by
			(
				Profile_Email ascending
			)
		
}