list Active_Applicant_Profiles
{

			displayName = "Active Applicant Profiles"
			show all rows from Applicant_Profile  [Active == true]  
			(
				Profile_Number as "Profile Number"
				Profile_Email as "Profile Email"
				Profile_Name.first_name as "First Name"
				Profile_Name.last_name as "Last Name"
				Phone
				(
					displayformat = formattednumber 
				)
				Active
			)
			filters
			(
				Profile_Email
				Active
			)
			sort by
			(
				Profile_Email ascending
			)
		
}