Applicant_Profiles_On_Validate as "Validate Applicant Profile"
{

				type =  form
				form = Applicant_Profile

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Profile_Email in {""," ","null"})
										{
											alert "Profile Email is required.";
											cancel submit;
										}
						)
					}
				}

			
}