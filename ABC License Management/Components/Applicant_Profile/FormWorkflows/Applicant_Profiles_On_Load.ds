Applicant_Profiles_On_Load as "Default Applicant Profile Login Email"
{

				type =  form
				form = Applicant_Profile

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Profile_Email.isEmpty())
										{
											input.Profile_Email = zoho.loginuserid;
										}
										if(input.Active == null)
										{
											input.Active = true;
										}
						)
					}
				}

			
}