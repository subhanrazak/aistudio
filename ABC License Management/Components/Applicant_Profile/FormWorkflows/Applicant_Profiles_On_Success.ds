Applicant_Profiles_On_Success as "Audit Applicant Profile Save"
{

				type =  form
				form = Applicant_Profile

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("New License Application","Applicant_Profiles",input.ID,"Applicant profile saved","Applicant profile " + input.Profile_Email + " was saved or updated.");
						)
					}
				}

			
}