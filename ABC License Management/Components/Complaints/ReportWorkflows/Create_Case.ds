Create_Case as "Create Case"
{
	type = functions
	form = Complaints
	execution type = for each record
	description = "Creates an enforcement case from an accepted complaint."

	on start
	{
		actions
		{
			on click
			(
				actorEmail = zoho.loginuserid;
				if(input.Screening_Decision == "Accepted" && input.Created_Case == null)
				{
					caseId = insert into Cases
					[
						Originating_Complaint=input.ID
						License=input.License
						Premises=input.Premises
						Case_Source="Complaint"
						Priority=input.Priority
						Supervising_Agent_Email=actorEmail
						Case_Status="Assigned"
					];
					input.Created_Case = caseId;
					input.Assigned_Supervisor_Email = actorEmail;
					input.Screening_Notes = "Case created from complaint report by " + actorEmail + " on " + zoho.currentdate + ".";
					thisapp.Create_Correspondence_Stub("Enforcement",caseId,"ABC-61",actorEmail,"Not Required");
					thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Complaint case created","Case created from complaint report by " + actorEmail + ".");
				}
				else
				{
					thisapp.Write_Audit_Log("Enforcement","Complaints",input.ID,"Create case action skipped","Create Case clicked by " + actorEmail + " but complaint was not Accepted or already had a case.");
				}
			)
		}
	}
}