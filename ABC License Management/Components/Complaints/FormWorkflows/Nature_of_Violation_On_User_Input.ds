Nature_of_Violation_On_User_Input as "Set Complaint Priority"
{

				type =  form
				form = Complaints

				record event = on add or edit

				on user input of Nature_of_Violation
				{
					actions 
					{
						custom deluge script
						(
											if(input.Nature_of_Violation == "Police Report")
										{
											input.Priority = "No Priority Category";
										}
										else if(input.Nature_of_Violation == "Sales to Minors" || input.Nature_of_Violation == "Disorderly Premises" || input.Nature_of_Violation == "Service to Intoxicated Person" || input.Nature_of_Violation == "Restricted Hours" || input.Nature_of_Violation == "Unlicensed Privileges" || input.Nature_of_Violation == "Narcotics")
										{
											input.Priority = "High";
										}
										else
										{
											input.Priority = "Standard";
										}
						)
					}
				}

			
}