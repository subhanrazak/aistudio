Complaints_On_Load as "Prepare Complaint Intake"
{

				type =  form
				form = Complaints

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Intake_Date == null)
										{
											input.Intake_Date = zoho.currentdate;
										}
										if(input.Screening_Decision == null)
										{
											input.Screening_Decision = "New";
										}
										disable Created_Case;
						)
					}
				}

			
}