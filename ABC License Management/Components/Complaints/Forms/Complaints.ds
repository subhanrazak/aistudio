form Complaints
{

			success message = "Complaint saved"
			Complaint_Intake
			(
				type = section
				displayname = "Complaint Intake"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Complaint_Number
			(
    			type = autonumber
				displayname = "Complaint Number"
				start index = 300000
	 			row = 1
	 			column = 1   
				width = medium
			)
			Intake_Date
			(
    			type = date
				displayname = "Intake Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Complaint_Source
			(
				type = picklist
				displayname = "Complaint Source"
				values = {"Public","Law Enforcement","Other Agency","Anonymous","On-View Agent","Licensee Fingerprint Match"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Complainant_Name
			(
    			type = name
				displayname = "Complainant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Title"
	     			 value = {"Mr.","Mrs.","Ms.","Dr."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Complainant_Email
			(
    			type = email
				displayname = "Complainant Email"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Complainant_Phone
			(
    			type = phonenumber
				displayname = "Complainant Phone"
    			defaultcountry="us"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Premises
			(
				type = picklist	
				values  = Premises.ID
    			displayformat = [DBA_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			License
			(
				type = picklist	
				values  = Licenses.ID
    			displayformat = [License_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Nature_of_Violation
			(
				type = picklist
				displayname = "Nature of Violation"
				values = {"Sales to Minors","Disorderly Premises","Service to Intoxicated Person","Restricted Hours","Unlicensed Privileges","Narcotics","Trade Enforcement","Police Report","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Description
			(
    			type = textarea
				height = 150px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supporting_File
			(
    			type = upload file
				displayname = "Supporting File"
				browse = local_drive
	 			row = 1
	 			column = 2   
				width = medium
			)
			Screening
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Priority
			(
				type = picklist
				values = {"High","Standard","No Priority Category"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Information_Sufficient
			(
    			type = checkbox
				displayname = "Information Sufficient"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Jurisdictional
			(
    			type = checkbox
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Screening_Decision
			(
				type = picklist
				displayname = "Screening Decision"
				values = {"New","Need More Information","Accepted","Rejected","Closed"}
				initial value = "New"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Screening_Notes
			(
    			type = textarea
				displayname = "Screening Notes"
				height = 120px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Assigned_Supervisor_Email
			(
    			type = email
				displayname = "Assigned Supervisor Email"
				maxchar = 80
	 			row = 2
	 			column = 2   
				width = medium
			)
			Created_Case
			(
				type = picklist	
				displayname = "Created Case"
				values  = Cases.ID
    			displayformat = [Case_Number]
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Complaint"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Complaint"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}