list Enforcement_Audit
{

			displayName = "Enforcement Audit"
			show all rows from Audit_Log  [Module == "Enforcement"]  
			(
				Audit_Number as "Audit Number"
				Event_Time as "Event Time"
				Event_User as "Event User"
				Module
				Source_Form as "Source Form"
				Source_Record_ID as "Source Record ID"
				Action
				Details
				Before_Status as "Before Status"
				After_Status as "After Status"
			)
			filters
			(
				Event_Time
				Event_User
				Source_Form
				Action
			)
			sort by
			(
				Event_Time descending
			)
		
}