list Audit_By_Module
{

			displayName = "Audit By Module"
			show all rows from Audit_Log    
			(
				Audit_Number as "Audit Number"
				Event_Time as "Event Time"
				Event_User as "Event User"
				Module
				Source_Form as "Source Form"
				Source_Record_ID as "Source Record ID"
				Action
				Details
				IP_or_Context as "IP or Context"
			)
			filters
			(
				Event_Time
				Event_User
				Module
				Source_Form
				Action
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Module ascending
			)
			sort by
			(
				Event_Time descending
			)
		
}