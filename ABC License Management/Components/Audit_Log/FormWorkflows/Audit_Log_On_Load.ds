Audit_Log_On_Load as "Prepare Audit Entry"
{

				type =  form
				form = Audit_Log

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Event_Time == null)
										{
											input.Event_Time = zoho.currenttime;
										}
										if(input.Event_User == null)
										{
											input.Event_User = zoho.loginuserid;
										}
										if(input.IP_or_Context == null)
										{
											input.IP_or_Context = "Manual Creator entry";
										}
						)
					}
				}

			
}