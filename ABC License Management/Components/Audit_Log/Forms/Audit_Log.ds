form Audit_Log
{

			displayname = "Audit Log"
			success message = "Audit entry saved"
			Audit_Event
			(
				type = section
				displayname = "Audit Event"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Audit_Number
			(
    			type = autonumber
				displayname = "Audit Number"
				start index = 990000
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Time
			(
    			type = datetime
				displayname = "Event Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_User
			(
    			type = email
				displayname = "Event User"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Module
			(
    			type = text
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source_Form
			(
    			type = text
				displayname = "Source Form"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Source_Record_ID
			(
				type = number
				displayname = "Source Record ID"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action
			(
    			type = text
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Audit_Details
			(
				type = section
				displayname = "Audit Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Details
			(
    			type = textarea
				height = 160px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Before_Status
			(
    			type = text
				displayname = "Before Status"
				maxchar = 150
	 			row = 2
	 			column = 2   
				width = medium
			)
			After_Status
			(
    			type = text
				displayname = "After Status"
				maxchar = 150
	 			row = 2
	 			column = 1   
				width = medium
			)
			IP_or_Context
			(
    			type = text
				displayname = "IP or Context"
				maxchar = 150
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Audit Entry"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Audit Entry"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}