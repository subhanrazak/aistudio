Violation_Issue_NOV as "Issue NOV"
{
	type = functions
	form = Violations
	execution type = for each record
	description = "Issues a notice of violation from violation reports and creates the NOV correspondence stub when needed."

	on start
	{
		actions
		{
			on click
			(
				actorEmail = zoho.loginuserid;
				if(input.Notice_of_Violation_Issued != true)
				{
					input.Notice_of_Violation_Issued = true;
					if(input.NOV_Correspondence == null)
					{
						novId = thisapp.Create_Correspondence_Stub("Enforcement",input.ID,"ABC-756","","Not Required");
						input.NOV_Correspondence = novId;
					}
					thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"NOV issued","Notice of violation issued from report by " + actorEmail + ".");
				}
				else
				{
					thisapp.Write_Audit_Log("Enforcement","Violations",input.ID,"Issue NOV action skipped","Issue NOV clicked by " + actorEmail + " but NOV was already issued.");
				}
			)
		}
	}
}