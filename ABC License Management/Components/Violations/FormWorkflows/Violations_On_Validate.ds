Violations_On_Validate as "Validate Violation"
{

				type =  form
				form = Violations

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Case == null)
										{
											alert "A case is required for every violation.";
											cancel submit;
										}
										if(input.Violation_Date == null)
										{
											alert "Violation date is required.";
											cancel submit;
										}
										if(input.Violation_Type == "Other" || input.Citation_Issued == true)
										{
											if(ifnull(input.Code_Section,"") == "")
											{
												alert "Code section is required for Other violations or issued citations.";
												cancel submit;
											}
										}
						)
					}
				}

			
}