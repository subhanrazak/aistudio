Violations_On_Load as "Prepare Violation Form"
{

				type =  form
				form = Violations

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Violation_Date == null)
										{
											input.Violation_Date = zoho.currentdate;
										}
						)
					}
				}

			
}