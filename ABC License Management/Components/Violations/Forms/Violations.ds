form Violations
{

			success message = "Violation saved"
			Violation_Details
			(
				type = section
				displayname = "Violation Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Violation_Number
			(
    			type = autonumber
				displayname = "Violation Number"
				start index = 620000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Case
			(
				type = picklist	
				values  = Cases.ID
    			displayformat = [Case_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Field_Visit
			(
				type = picklist	
				displayname = "Field Visit"
				values  = Field_Visits.ID
    			displayformat = [Visit_Number]
	 			row = 1
	 			column = 2   
				width = medium
			)
			License
			(
				type = picklist	
				values  = Licenses.ID
    			displayformat = [License_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Violation_Date
			(
    			type = date
				displayname = "Violation Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Violation_Type
			(
				type = picklist
				displayname = "Violation Type"
				values = {"Condition Violation","Concurrent Sales Gas/Alcohol","Food Service","Sales to Non-Members","Unlicensed Patio","Gambling/Bookmaking","No Person Under 21 Signs","Distilled Spirits Possession","Contaminated Alcoholic Beverage","Excessive Signs","Retail to Retail","Exterior Lighting","Substitution of Brands","Litter","Harmful Matter","Graffiti","Refilling Distilled Spirits","Consumption Inside Off Sale","Sales to Minor","Disorderly House","Narcotics","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Code_Section
			(
    			type = text
				displayname = "Code Section"
				maxchar = 120
	 			row = 1
	 			column = 2   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 160px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Enforcement_Action
			(
				type = section
				displayname = "Enforcement Action"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Citation_Issued
			(
    			type = checkbox
				displayname = "Citation Issued"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Arrest_Made
			(
    			type = checkbox
				displayname = "Arrest Made"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Notice_of_Violation_Issued
			(
    			type = checkbox
				displayname = "Notice of Violation Issued"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			NOV_Correspondence
			(
				type = picklist	
				displayname = "NOV Correspondence"
				values  = Correspondence.ID
    			displayformat = [Correspondence_Number]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Recommended_Action
			(
				type = picklist
				displayname = "Recommended Action"
				values = {"Letter of Warning","24200(e) Letter","Accusation","Other Follow-up","No Further Action"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 140px
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Violation"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Violation"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}