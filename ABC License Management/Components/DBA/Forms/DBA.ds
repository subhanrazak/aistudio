form DBA
{

			success message = "DBA saved"
			DBA_Information
			(
				type = section
				displayname = "DBA Information"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Applicant_Profile
			(
				type = picklist	
				displayname = "Applicant Profile"
				values  = Applicant_Profile.ID
    			displayformat = [Profile_Email]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have DBA_Name
			(
    			type = text
				displayname = "DBA Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Primary_DBA
			(
				type = radiobuttons
				displayname = "Primary DBA"
				values = {"Yes","No"}
				initial value = "No"
				layout = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			DBA_Status
			(
				type = picklist
				displayname = "DBA Status"
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}