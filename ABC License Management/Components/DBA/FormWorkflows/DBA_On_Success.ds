DBA_On_Success as "Audit DBA Save"
{

				type =  form
				form = DBA

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("New License Application","DBA",input.ID,"DBA saved","DBA " + input.DBA_Name + " was saved or updated.");
						)
					}
				}

			
}