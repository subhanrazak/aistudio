DBA_On_Validate as "Validate DBA"
{

				type =  form
				form = DBA

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Applicant_Profile == null)
										{
											alert "Applicant Profile is required.";
											cancel submit;
										}
										if(input.DBA_Name in {""," ","null"})
										{
											alert "DBA Name is required.";
											cancel submit;
										}
						)
					}
				}

			
}