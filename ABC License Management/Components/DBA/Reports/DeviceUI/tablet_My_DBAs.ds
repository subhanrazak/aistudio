report My_DBAs
{

				quickview
				(
					layout
					(
		 				type = -1
						datablock1
						(
							layout type = -1
							fields
							(
								Applicant_Profile as "Applicant Profile"
								DBA_Name as "DBA Name"
								Primary_DBA as "Primary DBA"
								DBA_Status as "DBA Status"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Delete 
							)
						record
						(
							Edit   	   
							Delete   	   
    					)
						)
    				action
    				(
						on tap
						(
							View Record   	   
    					)
						on long press
						(
							Edit   	   
							Delete   	   
							View Record   	   
    					)
						on left swipe
						(
							Delete   	   
    					)
						on right swipe
						(
							Edit   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Applicant_Profile as "Applicant Profile"
								DBA_Name as "DBA Name"
								Primary_DBA as "Primary DBA"
								DBA_Status as "DBA Status"
								Notes
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Delete 
							)
						)
				)
			
}