				Duplicate
				Delete
			)
		)
		action
		(
			on tap
			(
				View Record
			)
			on long press
			(
				Edit
				Delete
				Duplicate
				View Record
			)
			on left swipe
			(
				Delete
			)
			on right swipe
			(
				Edit
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Applicant_Profile as "Applicant Profile"
					DBA_Name as "DBA Name"
					Primary_DBA as "Primary DBA"
					DBA_Status as "DBA Status"
					Notes
				)
			)
		)
		menu
		(
			header
			(
				Edit
