list My_DBAs
{

			displayName = "My DBAs"
			show all rows from DBA  [Applicant_Profile.Profile_Email == zoho.loginuserid]  
			(
				Applicant_Profile as "Applicant Profile"
				DBA_Name as "DBA Name"
				Primary_DBA as "Primary DBA"
				DBA_Status as "DBA Status"
				Notes
			)
			filters
			(
				Applicant_Profile
				DBA_Name
				Primary_DBA
				DBA_Status
			)
			sort by
			(
				DBA_Name ascending
			)
		
}