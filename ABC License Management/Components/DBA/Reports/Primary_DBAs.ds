list Primary_DBAs
{

			displayName = "Primary DBAs"
			show all rows from DBA  [Primary_DBA == "Yes"]  
			(
				Applicant_Profile as "Applicant Profile"
				DBA_Name as "DBA Name"
				Primary_DBA as "Primary DBA"
				DBA_Status as "DBA Status"
			)
			filters
			(
				Applicant_Profile
				DBA_Name
				Primary_DBA
				DBA_Status
			)
			sort by
			(
				DBA_Name ascending
			)
		
}