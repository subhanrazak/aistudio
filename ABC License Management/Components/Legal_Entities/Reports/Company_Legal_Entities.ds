list Company_Legal_Entities
{

			displayName = "Company Legal Entities"
			show all rows from Legal_Entities  [Entity_Type == "Company"]  
			(
				Applicant_Profile as "Applicant Profile"
				Entity_Type as "Entity Type"
				Company_Name as "Company Name"
				Company_Structure as "Company Structure"
				CA_Secretary_of_State_Number as "CA Secretary of State Number"
				State_of_Incorporation as "State of Incorporation"
				Date_of_Incorporation as "Date of Incorporation"
				Active
			)
			filters
			(
				Applicant_Profile
				Entity_Type
				Company_Name
				Active
			)
			sort by
			(
				Company_Name ascending
			)
		
}