list My_Legal_Entities
{

			displayName = "My Legal Entities"
			show all rows from Legal_Entities  [Applicant_Profile.Profile_Email == zoho.loginuserid]  
			(
				Applicant_Profile as "Applicant Profile"
				Entity_Type as "Entity Type"
				Company_Name as "Company Name"
				Person_Name.first_name as "First Name"
				Person_Name.last_name as "Last Name"
				Active
				Address as "Address"
			)
			filters
			(
				Applicant_Profile
				Entity_Type
				Company_Name
				Active
			)
			sort by
			(
				Entity_Type ascending
				Company_Name ascending
			)
		
}