default list All_Legal_Entities
{

			displayName = "All Legal Entities"
			show all rows from Legal_Entities    
			(
				Applicant_Profile as "Applicant Profile"
				Entity_Type as "Entity Type"
				Company_Name as "Company Name"
				Person_Name.first_name as "First Name"
				Person_Name.last_name as "Last Name"
				Active
				Company_Structure as "Company Structure"
				State_of_Incorporation as "State of Incorporation"
				Address as "Address"
				Entity_ID as "Entity ID"
				Entity_Name as "Entity Name"
			)
			filters
			(
				Applicant_Profile
				Entity_Type
				Company_Name
				Active
			)
			sort by
			(
				Entity_Type ascending
				Company_Name ascending
			)
		
}