list Individual_Legal_Entities
{

			displayName = "Individual Legal Entities"
			show all rows from Legal_Entities  [Entity_Type != "Company"]  
			(
				Applicant_Profile as "Applicant Profile"
				Entity_Type as "Entity Type"
				Person_Name.first_name as "First Name"
				Person_Name.last_name as "Last Name"
				Driver_License_State as "Driver License State"
				Gender
				Marital_Status as "Marital Status"
				Birth_Date as "Birth Date"
				Address as "Address"
				Active
			)
			filters
			(
				Applicant_Profile
				Entity_Type
				Gender
				Marital_Status
				Active
			)
			sort by
			(
				Entity_Type ascending
			)
		
}