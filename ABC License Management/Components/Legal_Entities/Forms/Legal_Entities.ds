form Legal_Entities
{

			displayname = "Legal Entities"
			success message = "Legal entity saved"
			Legal_Entity_Basics
			(
				type = section
				displayname = "Legal Entity Basics"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Entity_ID
			(
    			type = autonumber
				displayname = "Entity ID"
				start index = 1001
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Applicant_Profile
			(
				type = picklist	
				displayname = "Applicant Profile"
				values  = Applicant_Profile.ID
    			displayformat = [Profile_Name.prefix + " " + Profile_Name.first_name + " " + Profile_Name.last_name + " " + Profile_Name.suffix]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Entity_Type
			(
				type = picklist
				displayname = "Entity Type"
				values = {"Company","Person","Manager","Food Lessee"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Entity_Name
			(
    			type = formula
				displayname = "Entity Name"
    			value = if(Entity_Type == "Company", Company_Name, Person_Name.first_name + " " + Person_Name.last_name)
    			visibility = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Company_Details
			(
				type = section
				displayname = "Company Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Company_Name
			(
    			type = text
				displayname = "Company Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			CA_Secretary_of_State_Number
			(
    			type = text
				displayname = "CA Secretary of State Number"
				maxchar = 50
	 			row = 2
	 			column = 1   
				width = medium
			)
			State_of_Incorporation
			(
				type = picklist	
				displayname = "State of Incorporation"
				values  = Reference_Values[Category == "State" && Active == true].ID
    			displayformat = [Value_Name]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Company_Structure
			(
				type = picklist	
				displayname = "Company Structure"
				values  = Reference_Values[Category == "Company Structure" && Active == true].ID
    			displayformat = [Value_Name]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Federal_Employer_Identification_Number
			(
    			type = text
				displayname = "Federal Employer Identification Number"
				maxchar = 50
	 			row = 2
	 			column = 2   
				width = medium
				personal data = true
				isencrypted = true
			)
			Date_of_Incorporation
			(
    			type = date
				displayname = "Date of Incorporation"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Person_Manager_Details
			(
				type = section
				displayname = "Person / Manager Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Person_Name
			(
    			type = name
				displayname = "Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Title"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms.","Dr."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 1   
				width = medium
			)
			Driver_License_Number
			(
    			type = text
				displayname = "Driver License Number"
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Passport_Number
			(
    			type = text
				displayname = "Passport Number"
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Marital_Status
			(
				type = picklist
				displayname = "Marital Status"
				values = {"Single","Married","Divorced","Widowed","Prefer Not to Say"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Birth_City
			(
    			type = text
				displayname = "Birth City"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Birth_Country
			(
				type = picklist	
				displayname = "Birth Country"
				values  = Reference_Values[Category == "Country" && Active == true].ID
    			displayformat = [Value_Name]
	 			row = 3
	 			column = 1   
				width = medium
			)
			Alias_Name
			(
    			type = textarea
				displayname = "Alias Name"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Last_Four_of_SSN
			(
    			type = text
				displayname = "Last Four of SSN"
				maxchar = 4
	 			row = 3
	 			column = 2   
				width = medium
				personal data = true
				isencrypted = true
			)
			Driver_License_State
			(
				type = picklist	
				displayname = "Driver License State"
				values  = Reference_Values[Category == "State" && Active == true].ID
    			displayformat = [Value_Name]
	 			row = 3
	 			column = 2   
				width = medium
			)
			Gender
			(
				type = picklist
				values = {"Female","Male","Non-Binary","Prefer Not to Say","Other"}
	 			row = 3
	 			column = 2   
				width = medium
			)
			Birth_Date
			(
    			type = date
				displayname = "Birth Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
				personal data = true
			)
			Birth_State
			(
				type = picklist	
				displayname = "Birth State"
				values  = Reference_Values[Category == "State" && Active == true].ID
    			displayformat = [Value_Name]
	 			row = 3
	 			column = 2   
				width = medium
			)
			Address
			(
				type = picklist	
				values  = Address_Records[Applicant_Profile == input.Applicant_Profile && Active == true].ID
    			displayformat = [Address_Title]
				allow new entries
				[
					displayname = "Add New Address"
					set values
					(
						Applicant_Profile = input.Applicant_Profile
					)
				]
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}