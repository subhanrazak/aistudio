Runscript as "Runscript"
{

				type =  form
				form = Legal_Entities

				record event = on add or edit

				field rules
				{
					actions  (Entity_Type == "Company")
					{
						show Company_Details;
					}
					actions  (Entity_Type == "Person" || Entity_Type == "Manager" || Entity_Type == "Food Lessee")
					{
						show Person_Manager_Details;
					}
				}

			
}