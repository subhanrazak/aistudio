Legal_Entities_On_Success as "Audit Legal Entity Save"
{

				type =  form
				form = Legal_Entities

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											entityLabel = if(input.Entity_Type == "Company",input.Company_Name,input.Entity_Type);
										thisapp.Write_Audit_Log("New License Application","Legal_Entities",input.ID,"Legal entity saved","Legal entity " + entityLabel + " was saved or updated.");
						)
					}
				}

			
}