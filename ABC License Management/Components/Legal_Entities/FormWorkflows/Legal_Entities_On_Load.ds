Legal_Entities_On_Load as "Default Legal Entity Profile And Visibility"
{

				type =  form
				form = Legal_Entities

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Applicant_Profile == null)
										{
											profileRec = Applicant_Profile[Profile_Email == zoho.loginuserid];
											if(profileRec.count() > 0)
											{
												input.Applicant_Profile = profileRec.ID;
											}
										}
										if(input.Active == null)
										{
											input.Active = true;
										}
						)
					}
				}

			
}