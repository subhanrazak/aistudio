Entity_Type_On_User_Input as "Toggle Legal Entity Fields"
{

				type =  form
				form = Legal_Entities

				record event = on add or edit
					status = inactive

				on user input of Entity_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Entity_Type == "Company")
										{
											show Company_Name;
											show Company_Structure;
											show CA_Secretary_of_State_Number;
											show Federal_Employer_Identification_Number;
											show State_of_Incorporation;
											show Date_of_Incorporation;
											hide Person_Name;
											hide Last_Four_of_SSN;
											hide Driver_License_Number;
											hide Driver_License_State;
											hide Passport_Number;
											hide Gender;
											hide Marital_Status;
											hide Birth_Date;
											hide Birth_City;
											hide Birth_State;
											hide Birth_Country;
											hide Address;
											hide Alias_Name;
										}
										else if(input.Entity_Type in {"Person","Manager","Food Lessee"})
										{
											hide Company_Name;
											hide Company_Structure;
											hide CA_Secretary_of_State_Number;
											hide Federal_Employer_Identification_Number;
											hide State_of_Incorporation;
											hide Date_of_Incorporation;
											show Person_Name;
											show Last_Four_of_SSN;
											show Driver_License_Number;
											show Driver_License_State;
											show Passport_Number;
											show Gender;
											show Marital_Status;
											show Birth_Date;
											show Birth_City;
											show Birth_State;
											show Birth_Country;
											show Address;
											show Alias_Name;
										}
										else
										{
											hide Company_Name;
											hide Company_Structure;
											hide CA_Secretary_of_State_Number;
											hide Federal_Employer_Identification_Number;
											hide State_of_Incorporation;
											hide Date_of_Incorporation;
											hide Person_Name;
											hide Last_Four_of_SSN;
											hide Driver_License_Number;
											hide Driver_License_State;
											hide Passport_Number;
											hide Gender;
											hide Marital_Status;
											hide Birth_Date;
											hide Birth_City;
											hide Birth_State;
											hide Birth_Country;
											hide Address;
											hide Alias_Name;
										}
						)
					}
				}

			
}