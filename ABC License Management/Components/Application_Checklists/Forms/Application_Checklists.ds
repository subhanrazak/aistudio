form Application_Checklists
{

			displayname = "Application Checklists"
			success message = "Checklist saved"
			Checklist_Details
			(
				type = section
				displayname = "Checklist Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Application
			(
				type = picklist	
				values  = Applications.ID
    			displayformat = [Business_DBA_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Checklist_Status
			(
				type = picklist
				displayname = "Checklist Status"
				values = {"Open","In Progress","Complete"}
				initial value = "Open"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Public_Posting_30_Day
			(
    			type = checkbox
				displayname = "30-Day Public Posting"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Public_Posting_Date
			(
    			type = date
				displayname = "Public Posting Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Resident_500_Foot_Notification
			(
    			type = checkbox
				displayname = "500-Foot Resident Notification"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resident_Notification_Date
			(
    			type = date
				displayname = "Resident Notification Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Local_Agency_Notification
			(
    			type = checkbox
				displayname = "Local Agency Notification"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Local_Agency_Notification_Date
			(
    			type = date
				displayname = "Local Agency Notification Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Investigation_Notes
			(
    			type = textarea
				displayname = "Investigation Notes"
				height = 150px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Completed_By
			(
    			type = email
				displayname = "Completed By"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			Completed_Date
			(
    			type = date
				displayname = "Completed Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Checklist"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Checklist"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}