list Completed_Application_Checklists
{

			displayName = "Completed Application Checklists"
			show all rows from Application_Checklists  [Checklist_Status == "Complete"]  
			(
				Application
				Checklist_Status as "Checklist Status"
				Completed_By as "Completed By"
				Completed_Date as "Completed Date"
				Investigation_Notes as "Investigation Notes"
			)
			filters
			(
				Application
				Completed_By
				Completed_Date
			)
			sort by
			(
				Completed_Date descending
			)
		
}