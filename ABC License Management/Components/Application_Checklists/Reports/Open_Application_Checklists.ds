list Open_Application_Checklists
{

			displayName = "Open Application Checklists"
			show all rows from Application_Checklists  [Checklist_Status != "Complete"]  
			(
				Application
				Checklist_Status as "Checklist Status"
				Public_Posting_30_Day as "30-Day Posting"
				Public_Posting_Date as "Posting Date"
				Resident_500_Foot_Notification as "500-Foot Notice"
				Resident_Notification_Date as "Resident Notice Date"
				Local_Agency_Notification as "Local Agency Notice"
				Local_Agency_Notification_Date as "Local Agency Notice Date"
			)
			filters
			(
				Application
				Checklist_Status
			)
		
}