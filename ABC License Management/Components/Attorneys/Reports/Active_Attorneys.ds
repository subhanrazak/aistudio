list Active_Attorneys
{

			displayName = "Active Attorneys"
			show all rows from Attorneys  [Active == true]  
			(
				Applicant_Profile as "Applicant Profile"
				First_Name as "First Name"
				Last_Name as "Last Name"
				Firm_Name as "Firm Name"
				Firm
				Phone_Number as "Phone Number"
				(
					displayformat = formattednumber 
				)
				Email
				Active
			)
			filters
			(
				Applicant_Profile
				First_Name
				Last_Name
				Firm
				Email
				Active
			)
			sort by
			(
				Last_Name ascending
				First_Name ascending
			)
		
}