default list All_Attorneys
{

			displayName = "All Attorneys"
			show all rows from Attorneys    
			(
				Applicant_Profile as "Applicant Profile"
				First_Name as "First Name"
				Middle_Name as "Middle Name"
				Last_Name as "Last Name"
				Firm_Name as "Firm Name"
				Firm
				Phone_Number as "Phone Number"
				(
					displayformat = formattednumber 
				)
				Fax_Number as "Fax Number"
				(
					displayformat = formattednumber 
				)
				Email
				Active
				Notes
			)
			filters
			(
				Applicant_Profile
				First_Name
				Last_Name
				Firm
				Email
				Active
			)
			sort by
			(
				Last_Name ascending
				First_Name ascending
			)
		
}