form Attorneys
{

			success message = "Attorney saved"
			Attorney_Information
			(
				type = section
				displayname = "Attorney Information"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Applicant_Profile
			(
				type = picklist	
				displayname = "Applicant Profile"
				values  = Applicant_Profile.ID
    			displayformat = [Profile_Email]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have First_Name
			(
    			type = text
				displayname = "First Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Middle_Name
			(
    			type = text
				displayname = "Middle Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Last_Name
			(
    			type = text
				displayname = "Last Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Firm_Name
			(
    			type = text
				displayname = "Firm Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Firm
			(
				type = picklist
				values = {"Solo Practice","Law Firm","In-House Counsel","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone Number"
    			defaultcountry="us"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Fax_Number
			(
    			type = phonenumber
				displayname = "Fax Number"
    			defaultcountry="us"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Email
			(
    			type = email
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}