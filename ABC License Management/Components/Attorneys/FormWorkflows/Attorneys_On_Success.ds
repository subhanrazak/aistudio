Attorneys_On_Success as "Audit Attorney Save"
{

				type =  form
				form = Attorneys

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("New License Application","Attorneys",input.ID,"Attorney saved","Attorney " + input.First_Name + " " + input.Last_Name + " was saved or updated.");
						)
					}
				}

			
}