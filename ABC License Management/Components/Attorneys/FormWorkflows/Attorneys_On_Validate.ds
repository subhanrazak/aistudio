Attorneys_On_Validate as "Validate Attorney"
{

				type =  form
				form = Attorneys

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Applicant_Profile == null)
										{
											alert "Applicant Profile is required.";
											cancel submit;
										}
										if(input.First_Name in {""," ","null"} || input.Last_Name in {""," ","null"})
										{
											alert "Attorney first and last name are required.";
											cancel submit;
										}
										if(input.Email in {""," ","null"} && input.Phone_Number in {""," ","null"})
										{
											alert "Enter either Email or Phone Number for the attorney.";
											cancel submit;
										}
						)
					}
				}

			
}