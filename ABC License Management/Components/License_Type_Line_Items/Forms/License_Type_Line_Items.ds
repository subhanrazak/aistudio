form License_Type_Line_Items
{

			displayname = "License Type Line Items"
			success message = "License type line item saved"
			Line_Item_Details
			(
				type = section
				displayname = "Line Item Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			License_Application
			(
				type = picklist	
				displayname = "License Application"
				values  = Applications.ID
    			bidirectional = License_Type_Line_Items
    			displayformat = [Application_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Primary_LT_Name
			(
				type = picklist	
				displayname = "Primary LT Name"
				values  = License_Types.ID
    			displayformat = [Primary_LT_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Draft","Active","Inactive"}
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Branch
			(
    			type = checkbox
				displayname = "Is Branch?"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Add_Renewal_Fee
			(
    			type = checkbox
				displayname = "Add Renewal Fee"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Designated_Expiration_Date
			(
    			type = date
				displayname = "Designated Expiration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Manual_Fee
			(
    			type = checkbox
				displayname = "Manual Fee?"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Secondary_LTs
			(
    			type = plaintext
				value = "Secondary license types are displayed or summarized here."
	 			row = 1
	 			column = 1   
				width = medium
			)
			Effective_Date
			(
    			type = date
				displayname = "Effective Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Line_Item_Fee
			(
				displayname = "Line Item Fee"
				type = USD
				initial value = 0
				maxchar = 12
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}