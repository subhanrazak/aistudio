list Active_License_Type_Line_Items
{

			displayName = "Active License Type Line Items"
			show all rows from License_Type_Line_Items  [Status == "Active"]  
			(
				Primary_LT_Name as "Primary LT Name"
				Status
				Line_Item_Fee as "Line Item Fee"
			)
			filters
			(
				Primary_LT_Name
				Status
			)
		
}