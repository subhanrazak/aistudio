default list All_License_Type_Line_Items
{

			displayName = "All License Type Line Items"
			show all rows from License_Type_Line_Items    
			(
				Primary_LT_Name as "Primary LT Name"
				Status
				Is_Branch as "Is Branch?"
				Add_Renewal_Fee as "Add Renewal Fee"
				Designated_Expiration_Date as "Designated Expiration Date"
				Manual_Fee as "Manual Fee?"
				Effective_Date as "Effective Date"
				Line_Item_Fee as "Line Item Fee"
				Notes
				License_Application as "License Application"
			)
			filters
			(
				Primary_LT_Name
				Status
				Is_Branch
				Add_Renewal_Fee
				Manual_Fee
			)
		
}