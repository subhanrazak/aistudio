License_Type_Line_Items_On_Validate as "Validate License Type Line Item"
{

				type =  form
				form = License_Type_Line_Items

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Primary_LT_Name == null)
										{
											alert "License Type is required.";
											cancel submit;
										}
										if(ifnull(input.Line_Item_Fee,0) < 0)
										{
											alert "Line Item Fee cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}