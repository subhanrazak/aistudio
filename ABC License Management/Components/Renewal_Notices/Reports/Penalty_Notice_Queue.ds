list Penalty_Notice_Queue
{

			displayName = "Penalty Notice Queue"
			show all rows from Renewal_Notices  [Penalty_Stage != "None" && Delivery_Status != "Sent Manually"]  
			(
				Notice_Number as "Notice Number"
				License
				Entity
				Notice_Type as "Notice Type"
				Notice_Date as "Notice Date"
				Due_Date as "Due Date"
				Penalty_Stage as "Penalty Stage"
				Fee_Amount as "Fee Amount"
				Delivery_Status as "Delivery Status"
				Recipient_Email as "Recipient Email"
			)
			filters
			(
				Penalty_Stage
				Notice_Type
				Delivery_Status
				Due_Date
			)
			sort by
			(
				Due_Date ascending
			)
		
}