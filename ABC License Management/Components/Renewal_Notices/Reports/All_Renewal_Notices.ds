default list All_Renewal_Notices
{

			displayName = "All Renewal Notices"
			show all rows from Renewal_Notices    
			(
				Notice_Number as "Notice Number"
				License
				Entity
				Notice_Type as "Notice Type"
				Notice_Date as "Notice Date"
				Due_Date as "Due Date"
				Penalty_Stage as "Penalty Stage"
				Fee_Amount as "Fee Amount"
				Delivery_Status as "Delivery Status"
				Recipient_Email as "Recipient Email"
			)
			filters
			(
				License
				Notice_Type
				Notice_Date
				Penalty_Stage
				Delivery_Status
			)
			sort by
			(
				Notice_Date descending
			)
		
}