form Renewal_Notices
{

			displayname = "Renewal Notices"
			success message = "Renewal notice saved"
			Notice_Details
			(
				type = section
				displayname = "Notice Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Notice_Number
			(
    			type = autonumber
				displayname = "Notice Number"
				start index = 600000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have License
			(
				type = picklist	
				values  = Licenses.ID
    			displayformat = [License_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Entity
			(
				type = picklist	
				values  = Entities.ID
    			displayformat = [Entity_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notice_Type
			(
				type = picklist
				displayname = "Notice Type"
				values = {"60-Day Renewal Notice","50% Late Notice","100% Late Notice","Renewed Certificate"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notice_Date
			(
    			type = date
				displayname = "Notice Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Due_Date
			(
    			type = date
				displayname = "Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Penalty_Stage
			(
				type = picklist
				displayname = "Penalty Stage"
				values = {"None","50%","100%"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Fee_Amount
			(
				type = decimal
				displayname = "Fee Amount"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivery_Status
			(
				type = picklist
				displayname = "Delivery Status"
				values = {"Draft","Generated","Sent Manually","Viewed","Failed"}
				initial value = "Draft"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Recipient_Email
			(
    			type = email
				displayname = "Recipient Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Correspondence
			(
				type = picklist	
				values  = Correspondence.ID
    			displayformat = [Correspondence_Number]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Notice"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Notice"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}