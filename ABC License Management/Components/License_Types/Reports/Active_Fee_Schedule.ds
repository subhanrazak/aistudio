list Active_Fee_Schedule
{

			displayName = "Active Fee Schedule"
			show all rows from License_Types  [Is_Active == true]  
			(
				License_Code as "License Code"
				Full_License_Type_Name as "Full License Type Name"
				Retail_or_Non_Retail as "Retail or Non-Retail"
				Master_or_Secondary as "Master or Secondary"
				Annual_Fee_ANN as "Annual Fee"
				Renewal_Fee_REN as "Renewal Fee"
				Renewal_50_REN50 as "REN50"
				Renewal_100_REN100 as "REN100"
				Processing_Fee_Default as "Processing Fee"
				Federal_Fingerprint_Fee as "Federal Fingerprint Fee"
				State_Fingerprint_Fee as "State Fingerprint Fee"
			)
			filters
			(
				License_Code
				Retail_or_Non_Retail
				Master_or_Secondary
			)
			sort by
			(
				License_Code ascending
			)
		
}