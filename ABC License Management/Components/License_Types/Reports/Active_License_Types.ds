list Active_License_Types
{

			displayName = "Active License Types"
			show all rows from License_Types  [Active == true]  
			(
				Code
				Primary_LT_Name as "Primary LT Name"
				License_Code as "Legacy License Code"
				Full_License_Type_Name as "Legacy Full License Type Name"
				Annual_Fee_ANN as "Annual Fee"
				Renewal_Fee_REN as "Renewal Fee"
				Renewal_50_REN50 as "REN50"
				Renewal_100_REN100 as "REN100"
				Active
			)
			filters
			(
				Code
				Primary_LT_Name
				License_Code
				Active
			)
			sort by
			(
				Code ascending
			)
		
}