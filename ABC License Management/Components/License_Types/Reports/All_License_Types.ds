default list All_License_Types
{

			displayName = "All License Types"
			show all rows from License_Types    
			(
				Code
				Primary_LT_Name as "Primary LT Name"
				License_Code as "Legacy License Code"
				Full_License_Type_Name as "Legacy Full License Type Name"
				Retail_or_Non_Retail as "Retail or Non-Retail"
				On_Off_Sale as "On/Off Sale"
				Master_or_Secondary as "Master or Secondary"
				Annual_Fee_ANN as "Annual Fee"
				Renewal_50_REN50 as "REN50"
				Renewal_100_REN100 as "REN100"
				Active
				Is_Active as "Legacy Active"
				Notes
			)
			filters
			(
				Code
				Primary_LT_Name
				License_Code
				Retail_or_Non_Retail
				On_Off_Sale
				Master_or_Secondary
				Active
				Is_Active
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Retail_or_Non_Retail ascending
				On_Off_Sale ascending
			)
			sort by
			(
				Code ascending
			)
		
}