form License_Types
{

			displayname = "License Types"
			success message = "License type saved"
			Fee_Reference
			(
				type = section
				displayname = "Fee Reference"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Code
			(
    			type = text
				maxchar = 20
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Primary_LT_Name
			(
    			type = text
				displayname = "Primary LT Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have unique License_Code
			(
    			type = text
				displayname = "Legacy License Code"
				maxchar = 10
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Full_License_Type_Name
			(
    			type = text
				displayname = "Legacy Full License Type Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Citation_23320b
			(
    			type = text
				displayname = "23320(b) Citation"
				maxchar = 50
	 			row = 1
	 			column = 2   
				width = medium
			)
			Retail_or_Non_Retail
			(
				type = picklist
				displayname = "Retail or Non-Retail"
				values = {"Retail","Non-Retail"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			On_Off_Sale
			(
				type = picklist
				displayname = "On/Off Sale"
				values = {"On-Sale","Off-Sale","N/A"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Master_or_Secondary
			(
				type = picklist
				displayname = "Master or Secondary"
				values = {"Master","Secondary","Duplicate","Primary"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Master_Types_Allowed
			(
    			type = textarea
				displayname = "Master Types Allowed"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Fee_Construction
			(
				type = section
				displayname = "Fee Construction"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Base_License_Fee
			(
				type = decimal
				displayname = "Base License Fee"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Base_License_Fee_CPI
			(
				type = decimal
				displayname = "Base License Fee after CPI"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Appeals_Board_Surcharge
			(
				type = decimal
				displayname = "Appeals Board Surcharge"
	 			row = 2
	 			column = 1   
				width = medium
			)
			CHP_Surcharge
			(
				type = decimal
				displayname = "CHP Surcharge"
	 			row = 2
	 			column = 2   
				width = medium
			)
			BPU24_Fee
			(
				type = decimal
				displayname = "BPU24 Fee"
	 			row = 2
	 			column = 1   
				width = medium
			)
			BU52_Fee
			(
				type = decimal
				displayname = "BU52 Fee"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Total_Surcharges
			(
				type = decimal
				displayname = "Total Surcharges"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Annual_Fee_ANN
			(
				type = decimal
				displayname = "Annual Fee - ANN"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Renewal_Fee_REN
			(
				type = decimal
				displayname = "Renewal Fee - REN"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Renewal_Duplicate_DOR
			(
				type = decimal
				displayname = "Renewal of Duplicate - DOR"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Renewal_50_REN50
			(
				type = decimal
				displayname = "Renewal with 50% Late Fee"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Renewal_100_REN100
			(
				type = decimal
				displayname = "Renewal with 100% Late Fee"
	 			row = 2
	 			column = 2   
				width = medium
			)
			ANN_or_DOR
			(
				type = decimal
				displayname = "ANN or DOR"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Processing_Fee_Default
			(
				type = decimal
				displayname = "Processing Fee Default"
				initial value = 335.00
	 			row = 2
	 			column = 2   
				width = medium
			)
			Federal_Fingerprint_Fee
			(
				type = decimal
				displayname = "Federal Fingerprint Fee"
				initial value = 24.00
	 			row = 2
	 			column = 1   
				width = medium
			)
			State_Fingerprint_Fee
			(
				type = decimal
				displayname = "State Fingerprint Fee"
				initial value = 39.00
	 			row = 2
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 3
	 			column = 1   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Legacy Is Active"
				initial value = true
	 			row = 3
	 			column = 2   
				width = medium
			)
			Administration
			(
				type = section
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save License Type"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update License Type"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}