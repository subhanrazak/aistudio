License_Types_On_Success as "Audit License Type Save"
{

				type =  form
				form = License_Types

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("Reference Data","License_Types",input.ID,"License type saved","License type " + input.Code + " was saved or updated.");
						)
					}
				}

			
}