Address_Records_On_Validate as "Validate Address Record"
{

				type =  form
				form = Address_Records

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Applicant_Profile == null)
										{
											alert "Applicant Profile is required.";
											cancel submit;
										}
										if(input.Address_Title in {""," ","null"})
										{
											alert "Address Title is required.";
											cancel submit;
										}
										if(input.Address_Scope in {""," ","null"})
										{
											alert "Address Scope is required.";
											cancel submit;
										}
						)
					}
				}

			
}