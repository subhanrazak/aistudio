Address_Records_On_Success as "Audit Address Save"
{

				type =  form
				form = Address_Records

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("New License Application","Address_Records",input.ID,"Address saved","Address " + input.Address_Title + " was saved or updated.");
						)
					}
				}

			
}