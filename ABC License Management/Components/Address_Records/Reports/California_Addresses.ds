list California_Addresses
{

			displayName = "California Addresses"
			show all rows from Address_Records  [Address_Scope == "In California"]  
			(
				Applicant_Profile as "Applicant Profile"
				Address_Title as "Address Title"
				Address_Scope as "Address Scope"
				Address.address_line_1 as "Street Address"
				Address.district_city as "City"
				Address.state_province as "State"
				Address.postal_Code as "Postal Code"
				Is_Mailing_Address as "Mailing Address"
				Active
			)
			filters
			(
				Applicant_Profile
				Address_Title
				Address_Scope
				Is_Mailing_Address
				Active
			)
			sort by
			(
				Address_Title ascending
			)
		
}