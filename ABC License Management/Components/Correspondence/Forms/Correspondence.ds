form Correspondence
{

			success message = "Correspondence saved"
			Correspondence_Details
			(
				type = section
				displayname = "Correspondence Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Correspondence_Number
			(
    			type = autonumber
				displayname = "Correspondence Number"
				start index = 800000
	 			row = 1
	 			column = 1   
				width = medium
			)
			Module
			(
				type = picklist
				values = {"Licensing Application","Renewal","Enforcement","Payment","General"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source_Form
			(
    			type = text
				displayname = "Source Form"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Source_Record_ID
			(
				type = number
				displayname = "Source Record ID"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			Template_Code
			(
				type = picklist
				displayname = "Template Code"
				values = {"ABC-205","P-22","Denial Notice","Renewal Notice","50% Late Notice","100% Late Notice","Renewed Certificate","ABC-61","ABC-333","ABC-320","ABC-300","ABC-756","Receipt","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Recipient_Email
			(
    			type = email
				displayname = "Recipient Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Subject
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
			Merge_Status
			(
				type = picklist
				displayname = "Merge Status"
				values = {"Draft","Ready for Manual Merge","Generated Manually","Sent Manually","Failed"}
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Generated_File
			(
    			type = upload file
				displayname = "Generated File"
				browse = local_drive
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sign_Status
			(
				type = picklist
				displayname = "Sign Status"
				values = {"Not Required","Pending Manual Sign","Signed","Declined"}
				initial value = "Not Required"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Generated_Date
			(
    			type = date
				displayname = "Generated Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sent_Date
			(
    			type = date
				displayname = "Sent Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Body_or_Merge_Notes
			(
    			type = richtext
				displayname = "Body or Merge Notes"
				height = 200px
				toolbar = enable
				[
					style, font-color, alignment, link, table, bullets-and-numbering, 
					font-size : {2, 3, 4, 5},
					font-family : {"Arimo", "Lato", "Poppins"}
				]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Related_Records
			(
				type = section
				displayname = "Related Records"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Related_Application
			(
				type = picklist	
				displayname = "Related Application"
				values  = Applications.ID
    			displayformat = [Business_DBA_Name]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Related_License
			(
				type = picklist	
				displayname = "Related License"
				values  = Licenses.ID
    			displayformat = [License_Number]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Related_Case
			(
				type = picklist	
				displayname = "Related Case"
				values  = Cases.ID
    			displayformat = [Case_Number]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Related_Payment
			(
				type = picklist	
				displayname = "Related Payment"
				values  = Payments.ID
    			displayformat = [Payment_Reference]
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Correspondence"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Correspondence"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}