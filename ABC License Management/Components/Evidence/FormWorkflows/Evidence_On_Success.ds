Evidence_On_Success as "Audit Evidence Custody"
{

				type =  form
				form = Evidence

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("Enforcement","Evidence",input.ID,"Evidence custody updated","Status: " + input.Chain_of_Custody_Status + "; Disposition: " + input.Disposition_Level);
						)
					}
				}

			
}