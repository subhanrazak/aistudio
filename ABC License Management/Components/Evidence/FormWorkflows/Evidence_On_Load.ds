Evidence_On_Load as "Prepare Evidence Form"
{

				type =  form
				form = Evidence

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Date_Collected == null)
										{
											input.Date_Collected = zoho.currenttime;
										}
										if(input.Chain_of_Custody_Status == null)
										{
											input.Chain_of_Custody_Status = "Collected";
										}
										if(input.Disposition_Level == null)
										{
											input.Disposition_Level = "Not Ready";
										}
						)
					}
				}

			
}