report Evidence_By_Case
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Evidence_Number as "Evidence Number"
					Case
					Field_Visit as "Field Visit"
					Evidence_Type as "Evidence Type"
					Date_Collected as "Date Collected"
					Chain_of_Custody_Status as "Chain of Custody Status"
					Disposition_Level as "Disposition Level"
					"Log Custody"
					"Mark Reviewed"
					"Dispose Evidence"
					"Return Evidence"
				)
			)
		)
		menu
		(
			header
			(
				Edit
			)
			record
			(
				Edit
				"Log Custody"
				"Mark Reviewed"
				"Dispose Evidence"
				"Return Evidence"
			)
		)
		action
		(
			on tap
			(
				View Record
			)
			on long press
			(
				Edit
				View Record
				"Log Custody"
				"Mark Reviewed"
				"Dispose Evidence"
				"Return Evidence"
			)
			on left swipe
			(
				"Dispose Evidence"
				"Return Evidence"
			)
			on right swipe
			(
				"Log Custody"
				"Mark Reviewed"
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Evidence_Number as "Evidence Number"
					Case
					Field_Visit as "Field Visit"
					Evidence_Type as "Evidence Type"
					Description
					Date_Collected as "Date Collected"
					Chain_of_Custody_Status as "Chain of Custody Status"
					Current_Custodian as "Current Custodian"
					Disposition_Level as "Disposition Level"
					"Log Custody"
					"Mark Reviewed"
					"Dispose Evidence"
					"Return Evidence"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				"Log Custody"
				"Mark Reviewed"
				"Dispose Evidence"
				"Return Evidence"
			)
		)
	)
}