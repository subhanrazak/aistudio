Evidence_Return_Evidence as "Return Evidence"
{
	type = functions
	form = Evidence
	execution type = for each record
	description = "Returns eligible evidence from evidence reports."

	on start
	{
		actions
		{
			on click
			(
				actorEmail = zoho.loginuserid;
				if(input.Chain_of_Custody_Status != "Returned" && input.Chain_of_Custody_Status != "Released to Owner" && input.Chain_of_Custody_Status != "Disposed")
				{
					oldStatus = input.Chain_of_Custody_Status;
					input.Chain_of_Custody_Status = "Returned";
					input.Current_Custodian = actorEmail;
					input.Release_Authorization = ifnull(input.Release_Authorization,"") + "\nReturn authorized from report by " + actorEmail + " on " + zoho.currentdate + ".";
					input.Notes = ifnull(input.Notes,"") + "\nEvidence returned by " + actorEmail + " on " + zoho.currentdate + ". Previous status: " + oldStatus + ".";
					thisapp.Write_Audit_Log("Enforcement","Evidence",input.ID,"Evidence returned","Evidence returned from report by " + actorEmail + ". Previous status: " + oldStatus + ".");
				}
				else
				{
					thisapp.Write_Audit_Log("Enforcement","Evidence",input.ID,"Return evidence action skipped","Return Evidence clicked by " + actorEmail + " but custody status was " + input.Chain_of_Custody_Status + ".");
				}
			)
		}
	}
}