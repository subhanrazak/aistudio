form Evidence
{

			success message = "Evidence saved"
			Evidence_Details
			(
				type = section
				displayname = "Evidence Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Evidence_Number
			(
    			type = autonumber
				displayname = "Evidence Number"
				start index = 630000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Case
			(
				type = picklist	
				values  = Cases.ID
    			displayformat = [Case_Number]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Field_Visit
			(
				type = picklist	
				displayname = "Field Visit"
				values  = Field_Visits.ID
    			displayformat = [Visit_Number]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Evidence_Type
			(
				type = picklist
				displayname = "Evidence Type"
				values = {"Photograph","Alcoholic Beverage","Narcotics/Dangerous Drugs","Paraphernalia","Firearm","Currency","Document","Found Property","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Description
			(
    			type = textarea
				height = 150px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Collected_By_Email
			(
    			type = email
				displayname = "Collected By Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_Collected
			(
    			type = datetime
				displayname = "Date Collected"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Storage_Location
			(
    			type = text
				displayname = "Storage Location"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Custody_and_Disposition
			(
				type = section
				displayname = "Custody and Disposition"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Chain_of_Custody_Status
			(
				type = picklist
				displayname = "Chain of Custody Status"
				values = {"Collected","Booked","Released Temporarily","Returned","Transferred to Lab","Disposed","Released to Owner"}
				initial value = "Collected"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Current_Custodian
			(
    			type = text
				displayname = "Current Custodian"
				maxchar = 150
	 			row = 2
	 			column = 2   
				width = medium
			)
			Release_Authorization
			(
    			type = textarea
				displayname = "Release Authorization"
				height = 130px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Disposition_Level
			(
				type = picklist
				displayname = "Disposition Level"
				values = {"Level 1 Summary","Level 2 Supervisor Order","Level 3 General Counsel","Court Order","Not Ready"}
				initial value = "Not Ready"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Evidence_File_or_Photo
			(
    			type = upload file
				displayname = "Evidence File or Photo"
    			file count = 10
				browse = local_drive, google_docs, zoho_docs
	 			row = 2
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 140px
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Evidence"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update Evidence"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}