form Add_Agents
{

			displayname = "Add Agents"
			success message = "Agent saved"
			Agent_Information
			(
				type = section
				displayname = "Agent Information"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Agent_Number
			(
    			type = autonumber
				displayname = "Agent Number"
				start index = 200000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Agent_Name
			(
    			type = name
				displayname = "Agent Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Title"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms.","Dr."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Agent_Email
			(
    			type = email
				displayname = "Agent Email"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Phone
			(
    			type = phonenumber
    			defaultcountry="us"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Agent_Role
			(
				type = picklist
				displayname = "Agent Role"
				values = {"Licensing Staff","Licensing Supervisor","Enforcement Agent","Enforcement Supervisor","OLS Attorney","Accounting Staff","Administrator"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supervisor
			(
				type = picklist	
				values  = Add_Agents.ID
    			displayformat = [Agent_Name.first_name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}