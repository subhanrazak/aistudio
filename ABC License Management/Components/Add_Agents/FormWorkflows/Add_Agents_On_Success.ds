Add_Agents_On_Success as "Audit Agent Save"
{

				type =  form
				form = Add_Agents

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Write_Audit_Log("New License Application","Add_Agents",input.ID,"Agent saved","Agent " + input.Agent_Email + " was saved or updated.");
						)
					}
				}

			
}