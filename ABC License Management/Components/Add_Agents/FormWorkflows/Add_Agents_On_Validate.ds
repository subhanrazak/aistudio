Add_Agents_On_Validate as "Validate Agent"
{

				type =  form
				form = Add_Agents

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Agent_Email in {""," ","null"})
										{
											alert "Agent Email is required.";
											cancel submit;
										}
										if(input.Agent_Role in {""," ","null"})
										{
											alert "Agent Role is required.";
											cancel submit;
										}
						)
					}
				}

			
}