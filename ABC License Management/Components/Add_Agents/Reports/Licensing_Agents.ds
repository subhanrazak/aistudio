list Licensing_Agents
{

			displayName = "Licensing Agents"
			show all rows from Add_Agents  [Agent_Role == "Licensing Staff" || Agent_Role == "Licensing Supervisor"]  
			(
				Agent_Number as "Agent Number"
				Agent_Name.first_name as "Agent First Name"
				Agent_Name.last_name as "Agent Last Name"
				Agent_Email as "Agent Email"
				Phone
				(
					displayformat = formattednumber 
				)
				Agent_Role as "Agent Role"
				Active
			)
			filters
			(
				Agent_Email
				Agent_Role
				Active
			)
			sort by
			(
				Agent_Email ascending
			)
		
}