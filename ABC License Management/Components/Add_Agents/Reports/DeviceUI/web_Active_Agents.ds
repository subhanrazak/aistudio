report Active_Agents
{

				quickview
				(
					layout
					(
						type = -1
						datablock1
						(
							layout type = -1
							fields
							(
								Agent_Number as "Agent Number"
								Agent_Name.first_name as "Agent First Name"
								Agent_Name.last_name as "Agent Last Name"
								Agent_Email as "Agent Email"
								Agent_Role as "Agent Role"
								Active
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Delete 
							)
						record
						(
							Edit   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						type = 1
						datablock1
						(
							layout type = -2
							fields
							(
								Agent_Number as "Agent Number"
								Agent_Name.first_name as "Agent First Name"
								Agent_Name.last_name as "Agent Last Name"
								Agent_Email as "Agent Email"
								Phone
								Agent_Role as "Agent Role"
								Active
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Delete 
							)
						)
				)
			
}