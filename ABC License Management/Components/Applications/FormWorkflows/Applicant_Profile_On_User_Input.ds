Applicant_Profile_On_User_Input as "Refresh Applicant Dependent Selections"
{

				type =  form
				form = Applications

				record event = on add or edit

				on user input of Applicant_Profile
				{
					actions 
					{
						custom deluge script
						(
											if(input.Applicant_Profile != null)
										{
											profileRows = Applicant_Profile[ID == input.Applicant_Profile];
											if(profileRows.count() > 0)
											{
												input.Applicant_Email = profileRows.Profile_Email;
											}
										}
										input.License = null;
										input.Legal_Entity = null;
										input.DBA = null;
										input.Premise_Address = null;
										input.Mailing_Address = null;
										input.Attorney = null;
										input.Business_DBA_Name = "";
						)
					}
				}

			
}