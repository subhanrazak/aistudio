report Public_Application_Status
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Application_Number as "Tracking Reference"
					Applicant_Profile as "Applicant Profile"
					Application_Status as "Application Status"
					Payment_Status as "Payment Status"
					Signature_Status as "Signature Status"
					"Submit Application"
				)
			)
		)
		menu
		(
			header
			(
				Edit
			)
			record
			(
				Edit
				"Submit Application"
			)
		)
		action
		(
			on tap
			(
				View Record
			)
			on long press
			(
				Edit
				View Record
				"Submit Application"
			)
			on right swipe
			(
				Edit
				"Submit Application"
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Application_Number as "Tracking Reference"
					Applicant_Profile as "Applicant Profile"
					DBA
					Application_Status as "Application Status"
					Payment_Status as "Payment Status"
					Signature_Status as "Signature Status"
					Total_Fee as "Total Fee"
					Application_Submitted_Date as "Application Submitted Date"
					"Submit Application"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				"Submit Application"
			)
		)
	)
}