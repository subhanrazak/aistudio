				)
			)
		)
		menu
		(
			header
			(
				Edit
			)
			record
			(
				Edit
				"Submit Application"
			)
		)
		action
		(
			on click
			(
				View Record
			)
			on right click
			(
				Edit
				View Record
				"Submit Application"
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Application_Number as "Tracking Reference"
					Applicant_Profile as "Applicant Profile"
					Application_Type as "Application Type"
					DBA
