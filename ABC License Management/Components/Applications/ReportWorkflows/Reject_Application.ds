Reject_Application as "Reject Application"
{
	type = functions
	form = Applications
	execution type = for each record

	on start
	{
		actions
		{
			on click
			(
				if(input.Application_Status == "Submitted" || input.Application_Status == "In-progress" || input.Application_Status == "Ready for Approval")
				{
					input.Application_Status = "Rejected";
					if(input.Denial_Reason == null || input.Denial_Reason == "")
					{
						input.Denial_Reason = "Rejected from application queue by " + zoho.loginuserid + " on " + zoho.currentdate;
					}
					thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Application rejected","Application rejected from application queue by " + zoho.loginuserid + ".");
				}
			)
		}
	}
}