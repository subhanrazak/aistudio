Release_Hold as "Release Hold"
{
	type = functions
	form = Applications
	execution type = for each record

	on start
	{
		actions
		{
			on click
			(
				if(input.Application_Status == "On-hold")
				{
					input.Application_Status = "In-progress";
					input.Tracking_Url_or_Note = "Hold released by " + zoho.loginuserid + " on " + zoho.currentdate;
					thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Application hold released","Hold released from application queue by " + zoho.loginuserid + ".");
				}
			)
		}
	}
}