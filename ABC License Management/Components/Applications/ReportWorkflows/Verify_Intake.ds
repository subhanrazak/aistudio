Verify_Intake as "Verify Intake"
{
	type = functions
	form = Applications
	execution type = for each record

	on start
	{
		actions
		{
			on click
			(
				if(input.Application_Status == "Submitted")
				{
					input.Application_Status = "In-progress";
					thisapp.Write_Audit_Log("New License Application","Applications",input.ID,"Intake verified","Intake verified from application queue by " + zoho.loginuserid + ".");
				}
			)
		}
	}
}