form Application_Legal_Entity
{

			displayname = "Application Legal Entity"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Application_Number
			(
				type = picklist	
				displayname = "Application Number"
				values  = Applications.ID
    			displayformat = [Application_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Applicant_Profile
			(
				type = picklist	
				displayname = "Applicant Profile"
				values  = Applicant_Profile.ID
    			displayformat = [" " + Profile_Name.prefix + " " + Profile_Name.first_name + " " + Profile_Name.last_name + " " + Profile_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Legal_Entity
			(
				type = picklist	
				displayname = "Legal Entity"
				values  = Legal_Entities[Applicant_Profile.ID == input.Applicant_Profile].ID
    			displayformat = [Entity_ID + " - " + Entity_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Primary_Entity
			(
    			type = checkbox
				displayname = "Is Primary Entity"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}