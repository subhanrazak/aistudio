<%
	supervisorEmail = ifnull(zoho.loginuserid,"");
	if(supervisorEmail == "" || supervisorEmail == null)
	{
		supervisorEmail = "Licensing supervisor";
	}

	draftCount = Applications[Application_Status == "Draft" || Application_Status is null || Application_Status == ""].count();
	submittedQueue = Applications[Application_Status == "Submitted"] sort by Application_Submitted_Date asc;
	inProgressQueue = Applications[Application_Status == "In-progress"] sort by Application_Submitted_Date asc;
	readyApproval = Applications[Application_Status == "Ready for Approval"] sort by Application_Submitted_Date asc;
	onHoldApps = Applications[Application_Status == "On-hold"] sort by Application_Submitted_Date asc;
	rejectedApps = Applications[Application_Status == "Rejected"] sort by Application_Submitted_Date desc;
	approvedApps = Applications[Application_Status == "Approved"] sort by Estimated_Issue_Date asc;
	licenseIssuedCount = Applications[Application_Status == "License Issued"].count();
	activeHolds = Application_Holds[Hold_Released == false] sort by Created_Date desc;
	requestInfoApps = Applications[Application_Status == "On-hold" && Tracking_Url_or_Note.contains("Information requested")] sort by Application_Submitted_Date asc;
	investigatorFlags = Applications[Investigator_Review_Flag == true && Application_Status != "Rejected" && Application_Status != "License Issued"] sort by Application_Submitted_Date asc;
	approvedAwaitingLicense = Applications[Application_Status == "Approved" && Issued_License == null] sort by Estimated_Issue_Date asc;
	unassignedApps = Applications[(Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == "") && (Application_Status == "Submitted" || Application_Status == "In-progress" || Application_Status == "Ready for Approval")] sort by Application_Submitted_Date asc;

	submittedCount = submittedQueue.count();
	inProgressCount = inProgressQueue.count();
	readyApprovalCount = readyApproval.count();
	onHoldCount = onHoldApps.count();
	rejectedCount = rejectedApps.count();
	approvedCount = approvedApps.count();
	holdCount = activeHolds.count();
	requestInfoCount = requestInfoApps.count();
	flagCount = investigatorFlags.count();
	approvedIssueCount = approvedAwaitingLicense.count();
	unassignedCount = unassignedApps.count();
	allOpenAppCount = submittedCount + inProgressCount + readyApprovalCount + onHoldCount + approvedIssueCount;

	renewalPaymentQueue = Renewal_Batches[(Payment_Status == "Pending" || Batch_Status == "Payment Pending") && Batch_Status != "Cancelled"] sort by Submitted_Date asc;
	renewalSubmittedQueue = Renewal_Batches[(Batch_Status == "Submitted" || Batch_Status == "Draft" || Batch_Status == "Paid") && Batch_Status != "Completed" && Batch_Status != "Cancelled"] sort by Submitted_Date asc;
	pendingPayments = Payments[(Payment_Status == "Pending" || Payment_Status == "Failed") && Amount_Due > 0] sort by Payment_Date asc;
	refundQueue = Payments[Refund_Requested == true && Refund_Status != "Completed"] sort by Payment_Date asc;
	reconciliationQueue = Payments[Reconciled != true && (Payment_Status == "Complete" || Payment_Status == "Refunded" || Payment_Status == "Void")] sort by Payment_Date asc;
	renewalPaymentCount = renewalPaymentQueue.count();
	renewalSubmittedCount = renewalSubmittedQueue.count();
	pendingPaymentCount = pendingPayments.count();
	refundCount = refundQueue.count();
	reconCount = reconciliationQueue.count();
	paymentAmountDue = ifnull(pendingPayments.sum(Amount_Due),0);
	renewalAmountDue = ifnull(renewalPaymentQueue.sum(Total_Amount_Due),0);
	paymentBottleneckCount = renewalPaymentCount + pendingPaymentCount + refundCount + reconCount;

	staffRoster = Add_Agents[Agent_Role == "Licensing Staff" && Active == true] sort by Agent_Email asc;
	staffCount = staffRoster.count();
	bottleneckTotal = readyApprovalCount + holdCount + requestInfoCount + approvedIssueCount + unassignedCount + paymentBottleneckCount;
	attentionBadge = if(bottleneckTotal > 0,"zcs-badge-yellow","zcs-badge-green");
	attentionLabel = if(bottleneckTotal > 0,"Supervisor action needed","Queues clear");
	attentionIcon = if(bottleneckTotal > 0,"ui-2-time","ui-1-check-circle-08");
%>
<style>
/* ZCS components used on this page: zcs-global, header-heading-with-actions, card-sample-1, table-simple-table, button-primary-button, button-primary-outline-button, badge-filled-badge. */
