<%
	applicantName = ifnull(zoho.loginuserid,"Applicant");
	if(applicantName == "" || applicantName == null)
	{
		applicantName = "Applicant";
	}
	profileCount = Applicant_Profile[Profile_Email == zoho.loginuserid].count();
	entityCount = Legal_Entities[Applicant_Profile.Profile_Email == zoho.loginuserid].count();
	dbaCount = DBA[Applicant_Profile.Profile_Email == zoho.loginuserid].count();
	addressCount = Address_Records[Applicant_Profile.Profile_Email == zoho.loginuserid].count();
	attorneyCount = Attorneys[Applicant_Profile.Profile_Email == zoho.loginuserid].count();
	applicationCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid].count();
	docketCount = Docket_Notes[Application.Applicant_Email == zoho.loginuserid].count();
	selectedLicenseAppCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid && License != null].count();
	issuedLicenseAppCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid && Issued_License != null].count();
	licenseCount = Licenses[Applicant_Profile.Profile_Email == zoho.loginuserid].count();
	activeLicenseCount = Licenses[Applicant_Profile.Profile_Email == zoho.loginuserid && License_Status == "Active"].count();
	setupCount = entityCount + dbaCount + addressCount + attorneyCount;
	appTypes = Application_Types[Active == true] sort by Type_Name;
	lineItems = License_Type_Line_Items[Status == "Active"];
	recentApps = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid] sort by Added_Time desc;
%>
<style>
/* ZCS global utility subset - included once for this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6366f1);--zcs-light-bg-color:var(--zcs_brand_light_color,#eef2ff);--zcs-page-bg-color:#f8f9fc;--zcs-primary-text-color:var(--zcs_primary_text_color,#0f172a);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#475569);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#94a3b8);--zcs-border-color:var(--zcs_tertiary_border_color,#e4e7ee);--zcs-white-color:#fff;--zcs-black-color:#000;--zcs-brand-foreground:var(--zcs_brand_foreground_color,#fff);font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-box-border{box-sizing:border-box}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-list-none{list-style-type:none}.zcs-color-green{color:#179e6c}.zcs-color-red{color:#fe455d}.zcs-color-yellow{color:#b8770d}.zcs-color-l_blue{color:#1094c5}
/* ZCS components used: button-primary-button, button-primary-outline-button, badge-badge-with-icon, table-simple-table, quick-actions-card-type-quick-actions, notes-notes-simple */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color,#6366f1);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#6366f1);background-color:var(--zcs-white-color);color:var(--zcs_brand_color,#6366f1)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color,#4f46e5)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color,#eef2ff);border-color:var(--zcs_brand_color,#6366f1);color:var(--zcs_brand_color,#6366f1)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color,#eef2ff);border-color:var(--zcs_brand_color,#6366f1);color:var(--zcs_brand_color,#6366f1)}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-filled-outline.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#9b6500}.zcs-badge-filled-outline.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#f4660c}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background:#f9fafe;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color,#6366f1)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color,#6366f1)}.zcs-notes-wrapper ul{list-style-type:disc}.zcs-notes-wrapper ul li::marker{color:var(--zcs-teritiary-text-color)}.zcs-notes-text a:hover{text-decoration:underline}
/* Portal shell */
div#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,div#zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.abc-shell{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f8f9fc 0%,#f4f6fb 48%,#fff 100%);min-height:100%;padding:24px;box-sizing:border-box}.abc-shell *{box-sizing:border-box}.abc-page{max-width:1480px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.abc-hero{position:relative;background:#fff;border:1px solid #eef0f5;border-radius:22px;padding:28px;overflow:hidden;box-shadow:0 1px 2px rgba(15,23,42,.04)}.abc-hero:before{content:"";position:absolute;right:-80px;top:-90px;width:290px;height:290px;border-radius:50%;background:linear-gradient(135deg,var(--zcs-theme-brand-color),#8b5cf6,#ec4899);opacity:.09;filter:blur(2px)}.abc-hero:after{content:"";position:absolute;right:60px;bottom:-110px;width:230px;height:230px;border-radius:50%;border:1px solid rgba(99,102,241,.15);box-shadow:0 0 0 48px rgba(99,102,241,.04),0 0 0 96px rgba(99,102,241,.03)}.abc-hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(320px,.8fr);gap:24px;align-items:center}.abc-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color);padding:6px 12px;border-radius:999px}.abc-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.03;letter-spacing:-.8px;margin:12px 0 10px;color:#0f172a}.abc-hero p{font-size:15px;line-height:1.65;color:#475569;margin:0;max-width:900px}.abc-hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}.abc-hero-pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.abc-path-panel{background:linear-gradient(180deg,#fbfcff,#fff);border:1px solid #e4e7ee;border-radius:18px;padding:18px;box-shadow:0 12px 30px rgba(15,23,42,.05)}.abc-path-panel h3{font-size:14px;text-transform:uppercase;letter-spacing:.6px;color:#94a3b8;margin:0 0 12px}.abc-mini-path{display:grid;grid-template-columns:32px 1fr;gap:10px;padding:12px 0;border-top:1px solid #eef0f5}.abc-mini-path:first-of-type{border-top:0}.abc-mini-icon{width:32px;height:32px;border-radius:10px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);display:flex;align-items:center;justify-content:center}.abc-mini-title{font-size:14px;font-weight:700;color:#0f172a}.abc-mini-copy{font-size:12px;color:#64748b;line-height:1.45;margin-top:2px}.abc-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 4px -2px}.abc-section-title h2{font-size:11px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:1.1px;margin:0;display:flex;align-items:center;gap:8px}.abc-section-title h2:before{content:"";width:4px;height:15px;border-radius:4px;background:linear-gradient(180deg,var(--zcs-theme-brand-color),#8b5cf6)}.abc-section-sub{font-size:12px;color:#94a3b8}.abc-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.abc-kpi{background:#fff;border:1px solid #eef0f5;border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);transition:all .2s ease}.abc-kpi:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(15,23,42,.07);border-color:#e4e7ee}.abc-kpi-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.abc-kpi-icon{width:42px;height:42px;border-radius:14px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);display:flex;align-items:center;justify-content:center;font-size:21px}.abc-kpi-label{font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.45px}.abc-kpi-value{font-size:30px;line-height:1;font-weight:800;letter-spacing:-.5px;color:#0f172a;margin-top:12px}.abc-kpi-foot{font-size:12px;color:#64748b;margin-top:9px;display:flex;align-items:center;gap:6px}.abc-grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.abc-grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.abc-card{background:#fff;border:1px solid #eef0f5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.abc-card-body{padding:18px}.abc-path-card{position:relative;min-height:218px;display:flex;flex-direction:column;gap:14px}.abc-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.abc-card-icon{width:44px;height:44px;border-radius:14px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);display:flex;align-items:center;justify-content:center;font-size:22px;flex:0 0 auto}.abc-card h3{font-size:17px;line-height:1.2;margin:0;color:#0f172a}.abc-card p{font-size:13px;line-height:1.55;color:#64748b;margin:0}.abc-card-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:auto}.abc-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:700;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);border-color:rgba(99,102,241,.25)}.abc-resource-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.abc-resource{padding:16px;display:flex;flex-direction:column;gap:14px}.abc-resource-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.abc-resource-title{display:flex;align-items:center;gap:10px}.abc-resource-title h3{font-size:15px;margin:0;color:#0f172a}.abc-resource-count{font-size:24px;font-weight:800;color:#0f172a;letter-spacing:-.4px}.abc-resource p{font-size:12px;line-height:1.5;color:#64748b;margin:0}.abc-link-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.abc-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--zcs-theme-brand-color);text-decoration:none}.abc-link:hover{text-decoration:underline}.abc-panel{background:#fff;border:1px solid #eef0f5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.abc-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:16px 18px;border-bottom:1px solid #eef0f5;background:#fff}.abc-panel-title-wrap{display:flex;gap:12px;align-items:flex-start}.abc-panel-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);display:flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto}.abc-panel h3{font-size:16px;line-height:1.25;margin:0;color:#0f172a}.abc-panel-sub{font-size:12px;color:#94a3b8;margin-top:3px}.abc-panel-body{padding:18px}.abc-guide-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.abc-rule-list{display:flex;flex-direction:column;gap:10px}.abc-rule{display:grid;grid-template-columns:150px 1fr;gap:12px;padding:12px;border:1px solid #eef0f5;border-radius:14px;background:#fbfcff}.abc-rule p{font-size:13px;line-height:1.5;color:#475569;margin:0}.abc-table-note{font-size:12px;color:#94a3b8;margin-top:10px}.abc-app-table-wrap{max-height:430px;overflow:auto}.abc-status-cell{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.abc-empty{padding:34px 20px;text-align:center;color:#94a3b8;font-size:13px;background:#fbfcff;border-radius:14px}.abc-embed-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.abc-embed-card{background:#fff;border:1px solid #eef0f5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.abc-embed-card.wide{grid-column:1/-1}.abc-embed-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid #eef0f5;background:#fbfcff}.abc-embed-head h3{font-size:15px;margin:0;color:#0f172a}.abc-embed-head p{font-size:12px;color:#64748b;margin:3px 0 0}.abc-embed{padding:8px;background:#fff}.abc-embed [zc-component]{width:100%;border-radius:12px;overflow:hidden}.abc-form-shell{display:grid;grid-template-columns:minmax(310px,.34fr) minmax(0,.66fr);gap:14px}.abc-form-side{display:flex;flex-direction:column;gap:12px}.abc-guidance-card{padding:16px;border:1px solid #eef0f5;border-radius:16px;background:#fbfcff}.abc-guidance-card h4{font-size:14px;margin:0 0 8px;color:#0f172a}.abc-guidance-card p{font-size:13px;line-height:1.55;color:#64748b;margin:0}.abc-quick-actions-wrapper{height:100%}.abc-quick-actions-wrapper h5{display:flex;align-items:center;gap:8px}.abc-quick-action-item.zcs-card{border-color:#eef0f5}.abc-quick-action-icon{color:var(--zcs-theme-brand-color);font-size:17px}.abc-note-band{background:var(--zcs-light-bg-color);border:1px solid rgba(99,102,241,.25);border-radius:14px;padding:12px 14px}.abc-foot-space{height:12px}@media(max-width:1180px){.abc-hero-inner,.abc-form-shell,.abc-guide-grid{grid-template-columns:1fr}.abc-kpi-grid,.abc-resource-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.abc-grid-3{grid-template-columns:1fr 1fr}}@media(max-width:760px){.abc-shell{padding:14px}.abc-hero{padding:22px}.abc-kpi-grid,.abc-resource-grid,.abc-grid-3,.abc-grid-2,.abc-embed-grid{grid-template-columns:1fr}.abc-rule{grid-template-columns:1fr}.abc-hero-actions .zcs-button{width:100%}.abc-section-title{align-items:flex-start;flex-direction:column}.abc-panel-head{flex-direction:column}.abc-embed-card.wide{grid-column:auto}.zcs-table-wrapper table{min-width:760px}}
</style>
<div class="abc-shell">
	<div class="abc-page">
		<section class="abc-hero">
			<div class="abc-hero-inner">
				<div>
					<div class="abc-eyebrow"><i class="zc-li-outline files-single-content-03"></i><span>ABC License Management</span></div>
					<h1>New-license application portal</h1>
					<p>Hello <%=applicantName%>. Use this portal to maintain intake records, choose the correct application path, submit a new license application, and track application and docket status through license issuance.</p>
					<div class="abc-hero-pills">
						<span class="abc-chip chip-theme"><i class="zc-li-outline ui-1-check-circle-08"></i>Original creates a new license number</span>
						<span class="abc-chip chip-info"><i class="zc-li-outline arrows-1-tail-right"></i>Transfer requires an existing license</span>
						<span class="abc-chip chip-warn"><i class="zc-li-outline ui-1-edit-72"></i>Change requires an existing license</span>
					</div>
					<div class="abc-hero-actions">
						<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Applications?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span class="zcs-button-text">Start application</span></a>
						<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline files-search"></i><span class="zcs-button-text">Review my applications</span></a>
					</div>
				</div>
				<aside class="abc-path-panel">
					<h3>Choose the path before selecting license records</h3>
					<div class="abc-mini-path"><div class="abc-mini-icon"><i class="zc-li-outline ui-1-simple-add"></i></div><div><div class="abc-mini-title">Original</div><div class="abc-mini-copy">Use when no existing ABC license is being changed or replaced.</div></div></div>
					<div class="abc-mini-path"><div class="abc-mini-icon"><i class="zc-li-outline arrows-1-tail-right"></i></div><div><div class="abc-mini-title">Transfer</div><div class="abc-mini-copy">Select the active existing license that will be terminated when the new active license is issued.</div></div></div>
					<div class="abc-mini-path"><div class="abc-mini-icon"><i class="zc-li-outline ui-1-edit-72"></i></div><div><div class="abc-mini-title">Change</div><div class="abc-mini-copy">Select the active existing license to update. A new license number is not created.</div></div></div>
				</aside>
			</div>
		</section>

		<div class="abc-section-title"><h2>Portal snapshot</h2><span class="abc-section-sub">Counts are filtered to the logged-in applicant where records are tied to the applicant profile.</span></div>
		<section class="abc-kpi-grid">
			<div class="abc-kpi"><div class="abc-kpi-top"><div><div class="abc-kpi-label">Profiles</div><div class="abc-kpi-value"><%=profileCount%></div></div><div class="abc-kpi-icon"><i class="zc-li-outline users-single-01"></i></div></div><div class="abc-kpi-foot"><span class="abc-chip <%=if(profileCount > 0,"chip-ok","chip-warn")%>"><%=if(profileCount > 0,"Ready","Add profile")%></span></div></div>
			<div class="abc-kpi"><div class="abc-kpi-top"><div><div class="abc-kpi-label">Setup records</div><div class="abc-kpi-value"><%=setupCount%></div></div><div class="abc-kpi-icon"><i class="zc-li-outline business-briefcase-24"></i></div></div><div class="abc-kpi-foot">Legal entities, DBAs, addresses, and attorneys</div></div>
			<div class="abc-kpi"><div class="abc-kpi-top"><div><div class="abc-kpi-label">Applications</div><div class="abc-kpi-value"><%=applicationCount%></div></div><div class="abc-kpi-icon"><i class="zc-li-outline files-single-content-03"></i></div></div><div class="abc-kpi-foot"><span class="abc-chip chip-info"><%=selectedLicenseAppCount%> with existing license selected</span></div></div>
			<div class="abc-kpi"><div class="abc-kpi-top"><div><div class="abc-kpi-label">Issued or active licenses</div><div class="abc-kpi-value"><%=activeLicenseCount%></div></div><div class="abc-kpi-icon"><i class="zc-li-outline education-paper"></i></div></div><div class="abc-kpi-foot"><span class="abc-chip chip-ok"><%=issuedLicenseAppCount%> issued from applications</span></div></div>
		</section>

		<div class="abc-section-title"><h2>Application paths</h2><span class="abc-section-sub">The Existing License field is only used for Transfer and Change paths.</span></div>
		<section class="abc-grid-3">
			<div class="abc-card abc-path-card abc-card-body"><div class="abc-card-head"><div><h3>Original application</h3><p>Create a brand-new license record. Do not select an existing license unless staff instructs you to correct an application.</p></div><div class="abc-card-icon"><i class="zc-li-outline ui-1-simple-add"></i></div></div><div class="abc-card-actions"><span class="abc-chip chip-ok">Existing license not needed</span><span class="abc-chip chip-theme">New number at License Issued</span></div></div>
			<div class="abc-card abc-path-card abc-card-body"><div class="abc-card-head"><div><h3>Transfer application</h3><p>Use for a transfer from an existing active license. Select the active license in the Existing License field before submitting.</p></div><div class="abc-card-icon"><i class="zc-li-outline arrows-1-tail-right"></i></div></div><div class="abc-card-actions"><span class="abc-chip chip-warn">Existing license required</span><span class="abc-chip chip-info">New active license created</span><span class="abc-chip chip-bad">Selected license terminated</span></div></div>
			<div class="abc-card abc-path-card abc-card-body"><div class="abc-card-head"><div><h3>Change application</h3><p>Use to update an existing active license. Select the license that needs the change; issuance updates that license instead of creating a new number.</p></div><div class="abc-card-icon"><i class="zc-li-outline ui-1-edit-72"></i></div></div><div class="abc-card-actions"><span class="abc-chip chip-warn">Existing license required</span><span class="abc-chip chip-neutral">No new license number</span></div></div>
		</section>

		<div class="abc-section-title"><h2>Intake records</h2><span class="abc-section-sub">Create and maintain these records before and during application intake.</span></div>
		<section class="abc-resource-grid">
			<div class="abc-card abc-resource"><div class="abc-resource-top"><div class="abc-resource-title"><div class="abc-card-icon"><i class="zc-li-outline users-single-01"></i></div><h3>Applicant profile</h3></div><div class="abc-resource-count"><%=profileCount%></div></div><p>Your contact identity for application intake and applicant-specific reporting.</p><div class="abc-link-row"><a class="abc-link" href="#Form:Applicant_Profile?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zc-li-outline ui-1-edit-72"></i>Add or update</a><a class="abc-link" href="#Report:My_Profile?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-eye-17"></i>View</a></div></div>
			<div class="abc-card abc-resource"><div class="abc-resource-top"><div class="abc-resource-title"><div class="abc-card-icon"><i class="zc-li-outline business-briefcase-24"></i></div><h3>Legal entities</h3></div><div class="abc-resource-count"><%=entityCount%></div></div><p>Companies, individuals, or managers connected to the application.</p><div class="abc-link-row"><a class="abc-link" href="#Form:Legal_Entities?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zc-li-outline ui-1-simple-add"></i>Add entity</a><a class="abc-link" href="#Report:My_Legal_Entities?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>View</a></div></div>
			<div class="abc-card abc-resource"><div class="abc-resource-top"><div class="abc-resource-title"><div class="abc-card-icon"><i class="zc-li-outline files-2-doc"></i></div><h3>DBAs</h3></div><div class="abc-resource-count"><%=dbaCount%></div></div><p>Business names used on the application and license record.</p><div class="abc-link-row"><a class="abc-link" href="#Form:DBA?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zc-li-outline ui-1-simple-add"></i>Add DBA</a><a class="abc-link" href="#Report:My_DBAs?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>View</a></div></div>
			<div class="abc-card abc-resource"><div class="abc-resource-top"><div class="abc-resource-title"><div class="abc-card-icon"><i class="zc-li-outline location-pin-copy"></i></div><h3>Addresses</h3></div><div class="abc-resource-count"><%=addressCount%></div></div><p>Premise and mailing addresses used by the application form.</p><div class="abc-link-row"><a class="abc-link" href="#Form:Address_Records?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zc-li-outline ui-1-simple-add"></i>Add address</a><a class="abc-link" href="#Report:My_Addresses?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>View</a></div></div>
			<div class="abc-card abc-resource"><div class="abc-resource-top"><div class="abc-resource-title"><div class="abc-card-icon"><i class="zc-li-outline users-single-01"></i></div><h3>Attorneys</h3></div><div class="abc-resource-count"><%=attorneyCount%></div></div><p>Optional representative information for application correspondence.</p><div class="abc-link-row"><a class="abc-link" href="#Form:Attorneys?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zc-li-outline ui-1-simple-add"></i>Add attorney</a><a class="abc-link" href="#Report:My_Attorneys?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>View</a></div></div>
			<div class="abc-card abc-resource"><div class="abc-resource-top"><div class="abc-resource-title"><div class="abc-card-icon"><i class="zc-li-outline files-single-content-03"></i></div><h3>Applications</h3></div><div class="abc-resource-count"><%=applicationCount%></div></div><p>Application records with type, selected license, line items, fees, and status.</p><div class="abc-link-row"><a class="abc-link" href="#Form:Applications?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zc-li-outline ui-1-simple-add"></i>Start</a><a class="abc-link" href="#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>View</a></div></div>
			<div class="abc-card abc-resource"><div class="abc-resource-top"><div class="abc-resource-title"><div class="abc-card-icon"><i class="zc-li-outline education-paper"></i></div><h3>Docket notes</h3></div><div class="abc-resource-count"><%=docketCount%></div></div><p>Public activity notes and dated events tied to application processing.</p><div class="abc-link-row"><a class="abc-link" href="#Report:My_Application_Docket?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open docket</a></div></div>
			<div class="abc-card abc-resource"><div class="abc-resource-top"><div class="abc-resource-title"><div class="abc-card-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><h3>Selected and issued licenses</h3></div><div class="abc-resource-count"><%=licenseCount%></div></div><p>Existing licenses selected on Transfer or Change applications, plus licenses issued from approved applications.</p><div class="abc-link-row"><a class="abc-link" href="#Report:Licensee_Portal_Licenses?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>View licenses</a></div></div>
		</section>

		<div class="abc-section-title"><h2>Application type guidance</h2><span class="abc-section-sub">Use the Applications form after reviewing these rules.</span></div>
		<section class="abc-panel">
			<div class="abc-panel-head"><div class="abc-panel-title-wrap"><div class="abc-panel-icon"><i class="zc-li-outline travel-info"></i></div><div><h3>Existing License selection rules</h3><div class="abc-panel-sub">Original, Transfer, and Change drive different license outcomes.</div></div></div><span class="abc-chip chip-theme"><i class="zc-li-outline ui-2-time"></i>Confirm before submit</span></div>
			<div class="abc-panel-body">
				<div class="abc-guide-grid">
					<div class="abc-rule-list">
						<div class="abc-rule"><span class="abc-chip chip-ok">Original</span><p>Leave Existing License blank. When the application reaches License Issued, the workflow creates a new license number.</p></div>
						<div class="abc-rule"><span class="abc-chip chip-warn">Transfer</span><p>Select the active existing license. At issue, the app creates a new active license and terminates the selected existing license.</p></div>
						<div class="abc-rule"><span class="abc-chip chip-info">Change</span><p>Select the active existing license. At issue, the app updates that license and does not create a new license number.</p></div>
					</div>
					<div>
						<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
							<table class="zcs-w-full">
								<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Application type</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Existing License field</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Charge</th></tr></thead>
								<tbody>
<%
	if(appTypes.count() == 0)
	{
%>
									<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">Original</td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-green">Leave blank</td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">See form</td></tr>
									<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">Transfer</td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-yellow">Required</td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">See form</td></tr>
									<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">Change</td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-yellow">Required</td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">See form</td></tr>
<%
	}
	else
	{
		for each  appType in appTypes
		{
			typeName = ifnull(appType.Type_Name,"Application Type");
			typeLower = typeName.toLowerCase();
			existingRule = "Review before submit";
			ruleClass = "zcs-color-l_blue";
			if(typeLower.contains("original"))
			{
				existingRule = "Leave blank";
				ruleClass = "zcs-color-green";
			}
			else if(typeLower.contains("transfer") || typeLower.contains("change"))
			{
				existingRule = "Required";
				ruleClass = "zcs-color-yellow";
			}
%>
									<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=typeName%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body <%=ruleClass%>"><%=existingRule%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">$<%=ifnull(appType.Charges,0)%></td></tr>
<%
		}
	}
%>
								</tbody>
							</table>
						</div>
						<div class="abc-table-note">The Applications form also calculates totals from selected license type line items. Staff review final fee and payment status before issuance.</div>
					</div>
				</div>
			</div>
		</section>

		<div class="abc-section-title"><h2>Quick actions</h2><span class="abc-section-sub">Use dialog links to add records without leaving the portal.</span></div>
		<section class="abc-grid-2">
			<div class="zcs-quick-actions-wrapper abc-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><i class="zc-li-outline ui-1-simple-add"></i>Applicant actions</h5>
				<ul class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0">
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Applicant_Profile?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-edit-72"></i><span class="zcs-quick-action-text">Add or update applicant profile</span></a></li>
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Legal_Entities?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline business-briefcase-24"></i><span class="zcs-quick-action-text">Add legal entity</span></a></li>
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:DBA?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline files-2-doc"></i><span class="zcs-quick-action-text">Add DBA</span></a></li>
				</ul>
			</div>
			<div class="zcs-quick-actions-wrapper abc-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><i class="zc-li-outline files-single-content-03"></i>Intake actions</h5>
				<ul class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0">
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Address_Records?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline location-pin-copy"></i><span class="zcs-quick-action-text">Add address</span></a></li>
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Attorneys?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline users-single-01"></i><span class="zcs-quick-action-text">Add attorney</span></a></li>
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Applications?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add"></i><span class="zcs-quick-action-text">Start application</span></a></li>
				</ul>
			</div>
		</section>

		<div class="abc-section-title"><h2>Recent application status</h2><span class="abc-section-sub">Compact summary from your application records.</span></div>
		<section class="abc-panel">
			<div class="abc-panel-head"><div class="abc-panel-title-wrap"><div class="abc-panel-icon"><i class="zc-li-outline files-search"></i></div><div><h3>My application summary</h3><div class="abc-panel-sub">Existing and issued license columns help confirm whether Transfer and Change records are linked correctly.</div></div></div><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline files-search"></i><span class="zcs-button-text">Open full report</span></a></div>
			<div class="abc-panel-body">
<%
	if(recentApps.count() == 0)
	{
%>
				<div class="abc-empty">No application records are tied to your applicant profile yet. Start an application after your profile, entity, address, and DBA records are ready.</div>
<%
	}
	else
	{
%>
				<div class="zcs-table-wrapper abc-app-table-wrap zcs-rounded-sm zcs-box-border zcs-relative">
					<table class="zcs-w-full">
						<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Application</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Type</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Existing license</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Issued license</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Fee due</th></tr></thead>
						<tbody>
<%
		for each  app in recentApps
		{
			appNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,"Application"));
			appTypeName = ifnull(app.Application_Type,"Not selected");
			appStatus = ifnull(app.Application_Status,"Draft");
			appStatusLower = appStatus.toLowerCase();
			appStatusCls = "chip-neutral";
			if(appStatusLower.contains("issued") || appStatusLower.contains("approved"))
			{
				appStatusCls = "chip-ok";
			}
			else if(appStatusLower.contains("review") || appStatusLower.contains("submitted") || appStatusLower.contains("pending"))
			{
				appStatusCls = "chip-info";
			}
			else if(appStatusLower.contains("hold") || appStatusLower.contains("incomplete"))
			{
				appStatusCls = "chip-warn";
			}
			else if(appStatusLower.contains("denied") || appStatusLower.contains("terminated"))
			{
				appStatusCls = "chip-bad";
			}
			existingLicense = ifnull(app.License.License_Number,"Not selected");
			issuedLicense = ifnull(app.Issued_License.License_Number,"Not issued");
			appTotal = ifnull(app.Total_Fee_Due,0);
			if(appTotal == 0)
			{
				appTotal = ifnull(app.Total_Fee,0);
			}
%>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=appNo%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=appTypeName%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="abc-chip <%=appStatusCls%>"><%=appStatus%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=existingLicense%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=issuedLicense%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">$<%=appTotal%></td></tr>
<%
		}
%>
						</tbody>
					</table>
				</div>
<%
	}
%>
			</div>
		</section>

		<div class="abc-section-title"><h2>Application workspace</h2><span class="abc-section-sub">Embedded form and applicant-facing reports.</span></div>
		<section class="abc-form-shell">
			<div class="abc-form-side">
				<div class="abc-guidance-card"><h4>Before you submit</h4><p>Confirm your Applicant Profile, Legal Entity, DBA, Premise Address, Mailing Address, and optional Attorney records. For Transfer or Change, select the existing active license in the Applications form.</p></div>
				<div class="abc-note-band zcs-notes-wrapper"><p class="zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><span class="zcs-notes-title zcs-font-medium zcs-color-tertiary">Application Type guidance: </span>Original creates a new license at License Issued. Transfer creates a new active license and terminates the selected license. Change updates the selected license only.</p></div>
				<div class="abc-guidance-card"><h4>Active license line items</h4><p><%=lineItems.count()%> active line item records are available for application fee calculation and staff review.</p></div>
			</div>
			<div class="abc-embed-card">
				<div class="abc-embed-head"><div><h3>Applications form</h3><p>Select Application Type first, then use Existing License only when required.</p></div><span class="abc-chip chip-theme">Embedded</span></div>
				<div class="abc-embed"><div zc-component="form" zc-linkname="Applications" zc-height="1200px"></div></div>
			</div>
		</section>

		<div class="abc-section-title"><h2>Reports and records</h2><span class="abc-section-sub">Functional embeds are kept inside restyled dashboard panels.</span></div>
		<section class="abc-embed-grid">
