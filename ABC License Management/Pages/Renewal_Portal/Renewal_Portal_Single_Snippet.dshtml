<%
	licenseeEmail = ifnull(zoho.loginuserid,"");

	activeCount = Licenses[Licensee_Email == licenseeEmail && License_Status == "Active"].count();
	renewalDueCount = Licenses[Licensee_Email == licenseeEmail && License_Status == "Renewal Due"].count();
	renewedCount = Licenses[Licensee_Email == licenseeEmail && License_Status == "Renewed"].count();
	penalty50Status = Licenses[Licensee_Email == licenseeEmail && License_Status == "50% Penalty"].count();
	penalty100Status = Licenses[Licensee_Email == licenseeEmail && License_Status == "100% Penalty"].count();
	suspendedCount = Licenses[Licensee_Email == licenseeEmail && License_Status == "Suspended"].count();
	closedCount = Licenses[Licensee_Email == licenseeEmail && License_Status == "Closed"].count();
	terminatedCount = Licenses[Licensee_Email == licenseeEmail && License_Status == "Terminated"].count();

	penalty50Stage = Licenses[Licensee_Email == licenseeEmail && Penalty_Stage == "50%"].count();
	penalty100Stage = Licenses[Licensee_Email == licenseeEmail && Penalty_Stage == "100%"].count();
	penalty50 = penalty50Status;
	if(penalty50Stage > penalty50)
	{
		penalty50 = penalty50Stage;
	}
	penalty100 = penalty100Status;
	if(penalty100Stage > penalty100)
	{
		penalty100 = penalty100Stage;
	}
	penaltyTotal = penalty50 + penalty100;
	renewable = renewalDueCount + penalty50Status + penalty100Status;

	batchCount = Renewal_Batches[Licensee_Email == licenseeEmail].count();
	openBatches = Renewal_Batches[Licensee_Email == licenseeEmail && Batch_Status != "Completed" && Batch_Status != "Cancelled"].count();
	completedRenewals = Renewal_Batches[Licensee_Email == licenseeEmail && Batch_Status == "Completed"].count();
	pendingPayments = Renewal_Batches[Licensee_Email == licenseeEmail && Payment_Status == "Pending"].count();
	completePayments = Renewal_Batches[Licensee_Email == licenseeEmail && Payment_Status == "Complete"].count();
	waivedPayments = Renewal_Batches[Licensee_Email == licenseeEmail && Payment_Status == "Waived"].count();
	refundedPayments = Renewal_Batches[Licensee_Email == licenseeEmail && Payment_Status == "Refunded"].count();
	pendingAmount = ifnull(Renewal_Batches[Licensee_Email == licenseeEmail && Payment_Status == "Pending"].sum(Total_Amount_Due),0);

	noticesGenerated = Renewal_Notices[Recipient_Email == licenseeEmail && Delivery_Status == "Generated"].count() + Renewal_Notices[Recipient_Email == licenseeEmail && Delivery_Status == "Sent Manually"].count() + Renewal_Notices[Recipient_Email == licenseeEmail && Delivery_Status == "Viewed"].count();
	noticesDraft = Renewal_Notices[Recipient_Email == licenseeEmail && Delivery_Status == "Draft"].count();
	noticesFailed = Renewal_Notices[Recipient_Email == licenseeEmail && Delivery_Status == "Failed"].count();

	totalLicenseContext = activeCount + renewalDueCount + renewedCount + penalty50Status + penalty100Status + suspendedCount + closedCount + terminatedCount;
	activeShare = 0;
	renewalShare = 0;
	closedShare = 0;
	if(totalLicenseContext > 0)
	{
		activeShare = ((activeCount + renewedCount) * 100) / totalLicenseContext;
		renewalShare = ((renewalDueCount + penalty50Status + penalty100Status) * 100) / totalLicenseContext;
		closedShare = ((suspendedCount + closedCount + terminatedCount) * 100) / totalLicenseContext;
	}
%>
<style>
/* ZCS global utility subset included once for this page from zcs-global. */
