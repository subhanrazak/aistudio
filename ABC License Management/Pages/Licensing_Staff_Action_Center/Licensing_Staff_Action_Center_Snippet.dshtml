<%
	staffEmail = ifnull(zoho.loginuserid,"");
	if(staffEmail == "" || staffEmail == null)
	{
		staffEmail = "Licensing staff";
	}

	assignedOpen = Applications[Assigned_Licensing_Rep == zoho.loginuserid && (Application_Status == "Submitted" || Application_Status == "In-progress" || Application_Status == "Ready for Approval" || Application_Status == "On-hold" || Application_Status == "Approved")] sort by Application_Submitted_Date asc;
	unassignedQueue = Applications[(Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == "") && (Application_Status == "Submitted" || Application_Status == "In-progress")] sort by Application_Submitted_Date asc;
	newSubmissions = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == "") && Application_Status == "Submitted"] sort by Application_Submitted_Date asc;
	verificationNeeded = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == "") && Checklist_Complete == false && (Application_Status == "Submitted" || Application_Status == "In-progress" || Application_Status == "Ready for Approval")] sort by Application_Submitted_Date asc;
	activeHolds = Application_Holds[Hold_Released == false && (Application.Assigned_Licensing_Rep == zoho.loginuserid || Application.Assigned_Licensing_Rep == null || Application.Assigned_Licensing_Rep == "")] sort by Created_Date desc;
	requestInfoApps = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == "") && Application_Status == "On-hold" && Tracking_Url_or_Note.contains("Information requested")] sort by Application_Submitted_Date asc;
	investigatorFlags = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == "") && Investigator_Review_Flag == true && Application_Status != "Rejected" && Application_Status != "License Issued"] sort by Application_Submitted_Date asc;
	approvedAwaitingIssue = Applications[(Assigned_Licensing_Rep == zoho.loginuserid || Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == "") && Application_Status == "Approved" && Issued_License == null] sort by Estimated_Issue_Date asc;
	pendingDocs = Correspondence[(Merge_Status == "Draft" || Merge_Status == "Ready for Manual Merge") && (Related_Application.Assigned_Licensing_Rep == zoho.loginuserid || Related_Application.Assigned_Licensing_Rep == null || Related_Application.Assigned_Licensing_Rep == "")] sort by Generated_Date asc;

	assignedCount = assignedOpen.count();
	unassignedCount = unassignedQueue.count();
	newCount = newSubmissions.count();
	verificationCount = verificationNeeded.count();
	holdCount = activeHolds.count();
	requestInfoCount = requestInfoApps.count();
	flagCount = investigatorFlags.count();
	approvedIssueCount = approvedAwaitingIssue.count();
	correspondenceCount = pendingDocs.count();
	workloadTotal = newCount + verificationCount + holdCount + requestInfoCount + flagCount + approvedIssueCount + correspondenceCount;
	assignedPct = 0;
	if((assignedCount + unassignedCount) > 0)
	{
		assignedPct = ((assignedCount * 100) / (assignedCount + unassignedCount)).round(0);
	}
%>
<style>
/* ZCS global utility stylesheet included once for this page; component ids used: zcs-global, button-primary-button, badge-badge-with-icon, table-simple-table, card-fleets-performance-metrics. */
