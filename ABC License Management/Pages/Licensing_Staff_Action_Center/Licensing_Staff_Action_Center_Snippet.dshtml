/* Page-specific layout. */
div#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.lsac{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f6f8ff 0%,#f5f7fb 60%,#fff 100%);min-height:100%;padding:28px;box-sizing:border-box}.lsac *{box-sizing:border-box}.lsac-shell{max-width:1500px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.lsac-hero{position:relative;overflow:hidden;border-radius:28px;padding:30px;background:radial-gradient(circle at 86% 8%,rgba(255,255,255,.28),transparent 28%),radial-gradient(circle at 6% 18%,rgba(45,212,191,.20),transparent 30%),linear-gradient(135deg,#14213d 0%,var(--zcs_brand_color,#2563eb) 62%,#0f766e 126%);color:#fff;box-shadow:0 24px 60px rgba(37,99,235,.18)}.lsac-hero:after{content:"";position:absolute;right:-120px;bottom:-150px;width:360px;height:360px;border-radius:50%;border:1px solid rgba(255,255,255,.20);box-shadow:0 0 0 54px rgba(255,255,255,.08),0 0 0 108px rgba(255,255,255,.04)}.lsac-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.18fr) minmax(330px,.82fr);gap:24px;align-items:center}.lsac-eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.15);color:#fff;border-radius:999px;padding:7px 12px;font-size:12px;font-weight:750;letter-spacing:.5px;text-transform:uppercase}.lsac-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.03;letter-spacing:-.7px;margin:14px 0 10px;color:#fff}.lsac-hero p{max-width:820px;color:rgba(255,255,255,.86);font-size:15px;line-height:1.65;margin:0}.lsac-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.lsac-hero-actions .zcs-button{box-shadow:0 10px 22px rgba(0,0,0,.14)}.lsac-profile{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);border-radius:20px;padding:18px;backdrop-filter:blur(4px)}.lsac-avatar{width:58px;height:58px;border-radius:18px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28px}.lsac-profile h2{font-size:20px;line-height:1.2;margin:0;color:#fff}.lsac-profile-line{font-size:13px;color:rgba(255,255,255,.82);display:flex;align-items:center;gap:8px;margin-top:6px}.lsac-profile-kv{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.lsac-kv{border:1px solid rgba(255,255,255,.18);border-radius:14px;padding:10px;background:rgba(255,255,255,.08)}.lsac-kv span{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.55px;color:rgba(255,255,255,.62)}.lsac-kv strong{display:block;font-size:14px;margin-top:4px;color:#fff}.lsac-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 4px -2px}.lsac-section-title h2{font-size:11px;font-weight:800;color:#8a94a6;text-transform:uppercase;letter-spacing:1.1px;margin:0;display:flex;align-items:center;gap:8px}.lsac-section-title h2:before{content:"";width:4px;height:15px;border-radius:4px;background:linear-gradient(180deg,var(--zcs_brand_color,#2563eb),#14b8a6)}.lsac-section-sub{font-size:12px;color:#8a94a6}.lsac-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.lsac-kpi{position:relative;overflow:hidden;background:#fff;border:1px solid #e9edf5;border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);min-height:145px}.lsac-kpi:after{content:"";position:absolute;right:-42px;top:-42px;width:120px;height:120px;border-radius:50%;background:var(--soft)}.lsac-kpi-icon{position:relative;z-index:1;width:42px;height:42px;border-radius:14px;background:var(--soft);color:var(--tone);display:flex;align-items:center;justify-content:center;font-size:21px}.lsac-kpi-value{position:relative;z-index:1;font-size:32px;line-height:1;font-weight:800;color:#111827;margin-top:16px;letter-spacing:-.5px}.lsac-kpi-label{position:relative;z-index:1;font-size:12px;color:#64748b;margin-top:5px;font-weight:650}.lsac-kpi-note{position:relative;z-index:1;font-size:11px;color:#8a94a6;margin-top:6px}.lsac-grid-two{display:grid;grid-template-columns:minmax(0,.96fr) minmax(360px,.58fr);gap:14px}.lsac-card{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.lsac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.lsac-card-title{display:flex;gap:12px;align-items:flex-start}.lsac-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.lsac-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.lsac-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.lsac-card-body{padding:18px}.lsac-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.lsac-action{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:12px}.lsac-action.top{border-color:rgba(250,174,19,.45);background:linear-gradient(180deg,#fff,#fffbeb)}.lsac-action-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.lsac-action-title h4{font-size:15px;margin:0;color:#111827}.lsac-action-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.lsac-action-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.lsac-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:750;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.lsac-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb)}.lsac-link:hover{text-decoration:underline}.lsac-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.lsac-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.lsac-list{display:flex;flex-direction:column;gap:10px}.lsac-item{border:1px solid #e9edf5;border-radius:14px;padding:12px;background:#fff}.lsac-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.lsac-item-title{font-size:14px;font-weight:800;color:#111827}.lsac-item-meta{font-size:12px;color:#64748b;margin-top:3px}.lsac-item-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.lsac-health-list{list-style:none}.lsac-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.lsac-report-card.wide{grid-column:1/-1}.lsac-embed{border-top:1px solid #eef1f6;background:#fff;padding:8px}.lsac-embed-box{min-height:360px;border:1px dashed #d7deea;border-radius:12px;background:#fff;overflow:hidden}.lsac-table-wrap{max-height:460px;overflow:auto}.lsac-table-wrap table{min-width:940px}.lsac-foot-space{height:12px}@media(max-width:1240px){.lsac-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.lsac-hero-grid,.lsac-grid-two{grid-template-columns:1fr}.lsac-action-grid{grid-template-columns:1fr}}@media(max-width:780px){.lsac{padding:14px}.lsac-hero{padding:22px;border-radius:20px}.lsac-kpis,.lsac-report-grid{grid-template-columns:1fr}.lsac-profile-kv{grid-template-columns:1fr}.lsac-section-title{align-items:flex-start;flex-direction:column}.lsac-card-head{flex-direction:column}.lsac-hero-actions .zcs-button{width:100%}.lsac-report-card.wide{grid-column:auto}}
</style>
<div class="lsac">
	<div class="lsac-shell">
		<section class="lsac-hero">
			<div class="lsac-hero-grid">
				<div>
					<span class="lsac-eyebrow"><i class="zc-li-outline business-badge"></i> Licensing staff action center</span>
					<h1>Assigned workload and unassigned intake</h1>
					<p>Hello <%=staffEmail%>. This landing page uses zoho.loginuserid to focus work assigned to your email and also surfaces unassigned Submitted or In-progress application queues that need licensing staff ownership.</p>
					<div class="lsac-hero-actions">
						<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline files-search"></i><span class="zcs-button-text">Open staff queue</span></a>
						<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:New_License_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline files-folder-15"></i><span class="zcs-button-text">New submissions</span></a>
						<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Public_Application_Wizard?zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span class="zcs-button-text">Open application wizard</span></a>
					</div>
				</div>
				<aside class="lsac-profile">
					<div class="zcs-flex zcs-align-items-center zcs-gap-12">
						<div class="lsac-avatar"><i class="zc-li-outline users-single-01"></i></div>
						<div class="zcs-col-common">
							<h2>Licensing workload</h2>
							<div class="lsac-profile-line"><i class="zc-li-outline ui-1-email-83"></i><span><%=staffEmail%></span></div>
							<div class="lsac-profile-line"><i class="zc-li-outline business-progress"></i><span><%=workloadTotal%> open task signals</span></div>
						</div>
					</div>
					<div class="lsac-profile-kv">
						<div class="lsac-kv"><span>Assigned open</span><strong><%=assignedCount%></strong></div>
						<div class="lsac-kv"><span>Unassigned queue</span><strong><%=unassignedCount%></strong></div>
						<div class="lsac-kv"><span>Issue ready</span><strong><%=approvedIssueCount%></strong></div>
						<div class="lsac-kv"><span>Correspondence</span><strong><%=correspondenceCount%></strong></div>
					</div>
				</aside>
			</div>
		</section>

		<div class="lsac-section-title"><h2>Workload snapshot</h2><span class="lsac-section-sub">Assigned records match Assigned_Licensing_Rep to zoho.loginuserid; unassigned records have no representative email.</span></div>
		<section class="lsac-kpis">
			<div class="lsac-kpi" style="--tone:#2a6ffc;--soft:#e8efff;"><div class="lsac-kpi-icon"><i class="zc-li-outline files-2-doc"></i></div><div class="lsac-kpi-value"><%=newCount%></div><div class="lsac-kpi-label">New submissions</div><div class="lsac-kpi-note">Submitted assigned or unassigned</div></div>
			<div class="lsac-kpi" style="--tone:#1094c5;--soft:#e4f6fd;"><div class="lsac-kpi-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div class="lsac-kpi-value"><%=verificationCount%></div><div class="lsac-kpi-label">Verification needed</div><div class="lsac-kpi-note">Checklist not complete</div></div>
			<div class="lsac-kpi" style="--tone:#b8770d;--soft:#fcf4e6;"><div class="lsac-kpi-icon"><i class="zc-li-outline files-folder-locked"></i></div><div class="lsac-kpi-value"><%=holdCount%></div><div class="lsac-kpi-label">Active holds</div><div class="lsac-kpi-note">Unreleased application holds</div></div>
			<div class="lsac-kpi" style="--tone:#f4660c;--soft:#f8f0eb;"><div class="lsac-kpi-icon"><i class="zc-li-outline ui-2-time"></i></div><div class="lsac-kpi-value"><%=requestInfoCount%></div><div class="lsac-kpi-label">Request-info follow-ups</div><div class="lsac-kpi-note">On-hold info requests</div></div>
			<div class="lsac-kpi" style="--tone:#7c3aed;--soft:#f1eaff;"><div class="lsac-kpi-icon"><i class="zc-li-outline ui-1-flag-diagonal-33"></i></div><div class="lsac-kpi-value"><%=flagCount%></div><div class="lsac-kpi-label">Investigator flags</div><div class="lsac-kpi-note">Review flag enabled</div></div>
			<div class="lsac-kpi" style="--tone:#179e6c;--soft:#e4fcf3;"><div class="lsac-kpi-icon"><i class="zc-li-outline business-badge"></i></div><div class="lsac-kpi-value"><%=approvedIssueCount%></div><div class="lsac-kpi-label">Approved awaiting issue</div><div class="lsac-kpi-note">Approved, no license linked</div></div>
		</section>

		<section class="lsac-grid-two">
			<div class="lsac-card">
				<div class="lsac-card-head">
					<div class="lsac-card-title"><div class="lsac-card-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div><h3>Action queues</h3><p>Open the action-enabled reports for row buttons such as Verify Intake, Request Info, Place Hold, Release Hold, Assign Review, Approve Application, Reject Application, and Issue License.</p></div></div>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(workloadTotal > 0,"zcs-badge-yellow","zcs-badge-green")%>"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline <%=if(workloadTotal > 0,"ui-2-time","ui-1-check-circle-08")%>"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=if(workloadTotal > 0,workloadTotal + " signals","No open signals")%></span></span>
				</div>
				<div class="lsac-card-body">
					<div class="lsac-action-grid">
						<div class="lsac-action <%=if(newCount > 0,"top","")%>"><div class="lsac-action-title"><h4>New submissions</h4><span class="lsac-chip <%=if(newCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline files-2-doc"></i><%=newCount%></span></div><p class="lsac-action-copy">Verify intake, assign ownership, or route submissions that are not yet in progress.</p><div class="lsac-action-links"><a class="lsac-link" href="#Report:New_License_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open report</a><a class="lsac-link" href="#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-check-circle-08"></i>Verify intake</a></div></div>
						<div class="lsac-action <%=if(verificationCount > 0,"top","")%>"><div class="lsac-action-title"><h4>Verification needed</h4><span class="lsac-chip <%=if(verificationCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline ui-1-check-circle-08"></i><%=verificationCount%></span></div><p class="lsac-action-copy">Review checklist completion and supporting compliance details before approval routing.</p><div class="lsac-action-links"><a class="lsac-link" href="#Report:Open_Application_Checklists?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-check"></i>Open checklists</a><a class="lsac-link" href="#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Queue</a></div></div>
						<div class="lsac-action <%=if(holdCount > 0,"top","")%>"><div class="lsac-action-title"><h4>Holds</h4><span class="lsac-chip <%=if(holdCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline files-folder-locked"></i><%=holdCount%></span></div><p class="lsac-action-copy">Review active holds and use the staff queue to release holds when conditions are satisfied.</p><div class="lsac-action-links"><a class="lsac-link" href="#Report:Active_Holds?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-folder-locked"></i>Active holds</a><a class="lsac-link" href="#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-unlocked"></i>Release hold</a></div></div>
						<div class="lsac-action <%=if(requestInfoCount > 0,"top","")%>"><div class="lsac-action-title"><h4>Request-info follow-ups</h4><span class="lsac-chip <%=if(requestInfoCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline ui-2-time"></i><%=requestInfoCount%></span></div><p class="lsac-action-copy">Follow applications whose tracking note records an information request and remain on hold.</p><div class="lsac-action-links"><a class="lsac-link" href="#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-2-time"></i>Follow up</a></div></div>
						<div class="lsac-action <%=if(flagCount > 0,"top","")%>"><div class="lsac-action-title"><h4>Investigator review flags</h4><span class="lsac-chip <%=if(flagCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline ui-1-flag-diagonal-33"></i><%=flagCount%></span></div><p class="lsac-action-copy">Applications marked for investigator review need screening before they proceed to approval or issuance.</p><div class="lsac-action-links"><a class="lsac-link" href="#Report:Investigator_Review_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-flag-diagonal-33"></i>Investigator queue</a></div></div>
						<div class="lsac-action <%=if(approvedIssueCount > 0,"top","")%>"><div class="lsac-action-title"><h4>Approved awaiting issue</h4><span class="lsac-chip <%=if(approvedIssueCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline business-badge"></i><%=approvedIssueCount%></span></div><p class="lsac-action-copy">Approved applications without an issued license link should be issued from the approved applications report.</p><div class="lsac-action-links"><a class="lsac-link" href="#Report:Approved_Applications?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline business-badge"></i>Issue license</a><a class="lsac-link" href="#Form:Applications?zc_LoadIn=dialog"><i class="zc-li-outline ui-1-edit-72"></i>Application form</a></div></div>
					</div>
				</div>
			</div>

			<div class="zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><i class="zc-li-outline business-progress"></i> Workload health</h5>
				<ul class="lsac-health-list zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0">
					<li class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10"><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0"><span class="zcs-color-tertiary">Assigned share</span><span class="zcs-color-tertiary"><%=assignedPct%>%</span></p><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=assignedPct%>%;"></div></div></li>
					<li class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10"><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0"><span class="zcs-color-tertiary">Unassigned pressure</span><span class="zcs-color-tertiary"><%=unassignedCount%> records</span></p><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=if(unassignedCount > 10,"100",unassignedCount * 10)%>%;background:<%=if(unassignedCount > 0,"#faae13","#179e6c")%>;"></div></div></li>
					<li class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10"><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0"><span class="zcs-color-tertiary">Issuance pressure</span><span class="zcs-color-tertiary"><%=approvedIssueCount%> ready</span></p><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=if(approvedIssueCount > 10,"100",approvedIssueCount * 10)%>%;background:<%=if(approvedIssueCount > 0,"#1094c5","#179e6c")%>;"></div></div></li>
				</ul>
				<div class="lsac-card-body" style="padding:0;">
					<div class="lsac-list">
						<a class="lsac-link" href="#Report:All_Applications?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zc-li-outline files-search"></i>All applications</a>
						<a class="lsac-link" href="#Report:Pending_Correspondence?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-email-83"></i>Pending correspondence</a>
						<a class="lsac-link" href="#Report:Application_Status_Board?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline business-progress"></i>Status board</a>
					</div>
				</div>
			</div>
		</section>

		<div class="lsac-section-title"><h2>Assigned and unassigned workload</h2><span class="lsac-section-sub"><%=assignedCount%> assigned to you, <%=unassignedCount%> unassigned submitted/in-progress.</span></div>
		<section class="lsac-card">
			<div class="lsac-card-head"><div class="lsac-card-title"><div class="lsac-card-icon"><i class="zc-li-outline files-single-content-03"></i></div><div><h3>Priority application rows</h3><p>Use the report links for row-level actions and the application form links for record review.</p></div></div><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline files-search"></i><span class="zcs-button-text">Full staff queue</span></a></div>
			<div class="lsac-card-body">
<%
	if(assignedOpen.count() == 0 && unassignedQueue.count() == 0)
	{
%>
				<div class="lsac-empty"><div class="lsac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div><strong>No assigned or unassigned intake records are currently open.</strong><br>Use the reports below for all historical application records.</div></div>
<%
	}
	else
	{
%>
				<div class="zcs-table-wrapper lsac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative">
					<table class="zcs-w-full">
						<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Queue</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Application</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Applicant / DBA</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Checklist</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Next action</th></tr></thead>
						<tbody>
<%
		assignedRows = 0;
		for each app in assignedOpen
		{
			if(assignedRows < 8)
			{
				appNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,"Application"));
				appTitle = ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,"Applicant"));
				appStatus = ifnull(app.Application_Status,"Submitted");
				statusCls = "chip-info";
				if(appStatus == "On-hold")
				{
					statusCls = "chip-warn";
				}
				else if(appStatus == "Approved")
				{
					statusCls = "chip-ok";
				}
				checkText = if(app.Checklist_Complete == true,"Complete","Needed");
				checkCls = if(app.Checklist_Complete == true,"chip-ok","chip-warn");
%>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="lsac-chip chip-theme">Assigned</span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=appNo%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=appTitle%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="lsac-chip <%=statusCls%>"><%=appStatus%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="lsac-chip <%=checkCls%>"><%=checkText%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><a class="lsac-link" href="#Report:Staff_Application_Queue?ID=<%=app.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Actions</a> <a class="lsac-link" href="#Form:Applications?recLinkID=<%=app.ID%>&amp;viewLinkName=All_Applications&amp;zc_LoadIn=dialog"><i class="zc-li-outline ui-1-edit-72"></i>Record</a></td></tr>
<%
			}
			assignedRows = assignedRows + 1;
		}
		unassignedRows = 0;
		for each app in unassignedQueue
		{
			if(unassignedRows < 8)
			{
				appNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,"Application"));
				appTitle = ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,"Applicant"));
				appStatus = ifnull(app.Application_Status,"Submitted");
				statusCls = if(appStatus == "Submitted","chip-info","chip-warn");
				checkText = if(app.Checklist_Complete == true,"Complete","Needed");
				checkCls = if(app.Checklist_Complete == true,"chip-ok","chip-warn");
%>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="lsac-chip chip-warn">Unassigned</span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=appNo%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=appTitle%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="lsac-chip <%=statusCls%>"><%=appStatus%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="lsac-chip <%=checkCls%>"><%=checkText%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><a class="lsac-link" href="#Report:Staff_Application_Queue?ID=<%=app.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Actions</a> <a class="lsac-link" href="#Form:Applications?recLinkID=<%=app.ID%>&amp;viewLinkName=All_Applications&amp;zc_LoadIn=dialog"><i class="zc-li-outline ui-1-edit-72"></i>Record</a></td></tr>
<%
			}
			unassignedRows = unassignedRows + 1;
		}
%>
						</tbody>
					</table>
				</div>
<%
	}
%>
			</div>
		</section>

		<div class="lsac-section-title"><h2>Focused sections</h2><span class="lsac-section-sub">Holds, request-info follow-ups, investigator flags, issuance, and correspondence.</span></div>
		<section class="lsac-report-grid">
			<div class="lsac-card"><div class="lsac-card-head"><div class="lsac-card-title"><div class="lsac-card-icon"><i class="zc-li-outline files-folder-locked"></i></div><div><h3>Holds</h3><p>Active hold records tied to your assigned or unassigned applications.</p></div></div><span class="lsac-chip <%=if(holdCount > 0,"chip-warn","chip-ok")%>"><%=holdCount%></span></div><div class="lsac-card-body"><div class="lsac-list">
<% if(activeHolds.count() == 0) { %>
				<div class="lsac-empty"><div class="lsac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No active holds are currently in your staff workload.</div></div>
<% } else { holdRows = 0; for each hold in activeHolds { if(holdRows < 4) { %>
				<div class="lsac-item"><div class="lsac-item-top"><div><div class="lsac-item-title"><%=ifnull(hold.Hold_Type,"Application hold")%></div><div class="lsac-item-meta"><%=ifnull(hold.Application.Application_Number,"Application")%> | Created <%=ifnull(hold.Created_Date,"Not dated")%></div></div><span class="lsac-chip chip-warn">Open</span></div><div class="lsac-item-actions"><a class="lsac-link" href="#Report:Active_Holds?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>View hold</a><a class="lsac-link" href="#Report:Staff_Application_Queue?ID=<%=hold.Application%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-unlocked"></i>Release action</a></div></div>
<% } holdRows = holdRows + 1; } } %>
			</div></div></div>

			<div class="lsac-card"><div class="lsac-card-head"><div class="lsac-card-title"><div class="lsac-card-icon"><i class="zc-li-outline ui-1-flag-diagonal-33"></i></div><div><h3>Investigator review flags</h3><p>Flagged applications needing investigative review coordination.</p></div></div><span class="lsac-chip <%=if(flagCount > 0,"chip-warn","chip-ok")%>"><%=flagCount%></span></div><div class="lsac-card-body"><div class="lsac-list">
<% if(investigatorFlags.count() == 0) { %>
				<div class="lsac-empty"><div class="lsac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No investigator flags are open for your workload.</div></div>
<% } else { flagRows = 0; for each app in investigatorFlags { if(flagRows < 4) { %>
				<div class="lsac-item"><div class="lsac-item-top"><div><div class="lsac-item-title"><%=ifnull(app.Application_Number,"Application")%></div><div class="lsac-item-meta"><%=ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,"Applicant"))%> | <%=ifnull(app.Application_Status,"Status not set")%></div></div><span class="lsac-chip chip-warn">Flagged</span></div><div class="lsac-item-actions"><a class="lsac-link" href="#Report:Investigator_Review_Queue?ID=<%=app.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-flag-diagonal-33"></i>Open review</a><a class="lsac-link" href="#Form:Applications?recLinkID=<%=app.ID%>&amp;viewLinkName=All_Applications&amp;zc_LoadIn=dialog"><i class="zc-li-outline ui-1-edit-72"></i>Record</a></div></div>
<% } flagRows = flagRows + 1; } } %>
			</div></div></div>

			<div class="lsac-card"><div class="lsac-card-head"><div class="lsac-card-title"><div class="lsac-card-icon"><i class="zc-li-outline business-badge"></i></div><div><h3>Approved awaiting issue</h3><p>Approved applications where Issued License is still empty.</p></div></div><span class="lsac-chip <%=if(approvedIssueCount > 0,"chip-warn","chip-ok")%>"><%=approvedIssueCount%></span></div><div class="lsac-card-body"><div class="lsac-list">
<% if(approvedAwaitingIssue.count() == 0) { %>
				<div class="lsac-empty"><div class="lsac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No approved applications are awaiting license issuance.</div></div>
<% } else { issueRows = 0; for each app in approvedAwaitingIssue { if(issueRows < 4) { %>
				<div class="lsac-item"><div class="lsac-item-top"><div><div class="lsac-item-title"><%=ifnull(app.Application_Number,"Application")%></div><div class="lsac-item-meta"><%=ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,"Applicant"))%> | Estimated issue <%=ifnull(app.Estimated_Issue_Date,"Not dated")%></div></div><span class="lsac-chip chip-warn">Issue</span></div><div class="lsac-item-actions"><a class="lsac-link" href="#Report:Approved_Applications?ID=<%=app.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline business-badge"></i>Issue action</a><a class="lsac-link" href="#Form:Applications?recLinkID=<%=app.ID%>&amp;viewLinkName=All_Applications&amp;zc_LoadIn=dialog"><i class="zc-li-outline ui-1-edit-72"></i>Record</a></div></div>
<% } issueRows = issueRows + 1; } } %>
			</div></div></div>

			<div class="lsac-card"><div class="lsac-card-head"><div class="lsac-card-title"><div class="lsac-card-icon"><i class="zc-li-outline ui-1-email-83"></i></div><div><h3>Pending correspondence</h3><p>Draft or ready-for-merge correspondence tied to assigned or unassigned applications.</p></div></div><span class="lsac-chip <%=if(correspondenceCount > 0,"chip-warn","chip-ok")%>"><%=correspondenceCount%></span></div><div class="lsac-card-body"><div class="lsac-list">
<% if(pendingDocs.count() == 0) { %>
				<div class="lsac-empty"><div class="lsac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No pending correspondence was found for your application workload.</div></div>
<% } else { docRows = 0; for each doc in pendingDocs { if(docRows < 4) { %>
				<div class="lsac-item"><div class="lsac-item-top"><div><div class="lsac-item-title"><%=ifnull(doc.Subject,"Correspondence")%></div><div class="lsac-item-meta"><%=ifnull(doc.Correspondence_Number,"Document")%> | <%=ifnull(doc.Merge_Status,"Draft")%></div></div><span class="lsac-chip chip-warn">Pending</span></div><div class="lsac-item-actions"><a class="lsac-link" href="#Report:Pending_Correspondence?ID=<%=doc.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-email-83"></i>Open correspondence</a></div></div>
<% } docRows = docRows + 1; } } %>
			</div></div></div>
		</section>

		<div class="lsac-section-title"><h2>Embedded action reports</h2><span class="lsac-section-sub">Native reports are reachable in-page and through dialog links for full row actions.</span></div>
		<section class="lsac-report-grid">
			<div class="lsac-card wide lsac-report-card"><div class="lsac-card-head"><div class="lsac-card-title"><div class="lsac-card-icon"><i class="zc-li-outline files-search"></i></div><div><h3>My assigned staff queue</h3><p>Action-enabled application queue filtered to Assigned_Licensing_Rep equals your login email.</p></div></div><a class="lsac-link" href="#Report:Staff_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zc-li-outline files-search"></i>Open full report</a></div><div class="lsac-embed"><div class="lsac-embed-box" zc-component="report" zc-linkname="Staff_Application_Queue" zc-criteria="Assigned_Licensing_Rep == &quot;<%=staffEmail%>&quot;" zc-height="520px"></div></div></div>
			<div class="lsac-card"><div class="lsac-card-head"><div class="lsac-card-title"><div class="lsac-card-icon"><i class="zc-li-outline files-folder-15"></i></div><div><h3>Unassigned intake</h3><p>Submitted and in-progress application records needing staff assignment.</p></div></div><a class="lsac-link" href="#Report:New_License_Application_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open</a></div><div class="lsac-embed"><div class="lsac-embed-box" zc-component="report" zc-linkname="New_License_Application_Queue" zc-criteria="(Assigned_Licensing_Rep == null || Assigned_Licensing_Rep == &quot;&quot;) && (Application_Status == &quot;Submitted&quot; || Application_Status == &quot;In-progress&quot;)" zc-height="420px"></div></div></div>
			<div class="lsac-card"><div class="lsac-card-head"><div class="lsac-card-title"><div class="lsac-card-icon"><i class="zc-li-outline ui-1-email-83"></i></div><div><h3>Pending correspondence</h3><p>Document merge and signature work queue.</p></div></div><a class="lsac-link" href="#Report:Pending_Correspondence?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open</a></div><div class="lsac-embed"><div class="lsac-embed-box" zc-component="report" zc-linkname="Pending_Correspondence" zc-height="420px"></div></div></div>
		</section>
		<div class="lsac-foot-space"></div>
	</div>
</div>