/* ZCS Button, Badge, and Table CSS. */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#2563eb);background:#fff;color:var(--zcs_brand_color,#2563eb)}.zcs-secondary-button{border:1px solid var(--zcs-border-color);background:#f8fafc;color:var(--zcs-primary-text-color)}.zcs-primary-button.zcs-button:hover{background:var(--zcs_brand_dark_color,#1d4ed8)}.zcs-primary-outline-button:hover,.zcs-secondary-button:hover{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-filled-outline.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-filled-outline.zcs-badge-grey{background:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-filled-outline.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#f4660c}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background:#f9fafe;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}
/* Page-specific layout. */
div#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.eaac{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f7f9ff 0%,#f4f7fb 58%,#fff 100%);min-height:100%;padding:28px;box-sizing:border-box}.eaac *{box-sizing:border-box}.eaac-shell{max-width:1520px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.eaac-hero{position:relative;overflow:hidden;border-radius:28px;padding:30px;background:radial-gradient(circle at 86% 10%,rgba(255,255,255,.27),transparent 28%),radial-gradient(circle at 5% 22%,rgba(248,113,113,.18),transparent 28%),linear-gradient(135deg,#111827 0%,var(--zcs_brand_color,#2563eb) 56%,#0f766e 130%);color:#fff;box-shadow:0 24px 60px rgba(37,99,235,.18)}.eaac-hero:after{content:"";position:absolute;right:-130px;bottom:-160px;width:370px;height:370px;border-radius:50%;border:1px solid rgba(255,255,255,.20);box-shadow:0 0 0 54px rgba(255,255,255,.08),0 0 0 108px rgba(255,255,255,.04)}.eaac-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.14fr) minmax(330px,.86fr);gap:24px;align-items:center}.eaac-eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.15);color:#fff;border-radius:999px;padding:7px 12px;font-size:12px;font-weight:750;letter-spacing:.5px;text-transform:uppercase}.eaac-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.03;letter-spacing:-.7px;margin:14px 0 10px;color:#fff}.eaac-hero p{max-width:820px;color:rgba(255,255,255,.86);font-size:15px;line-height:1.65;margin:0}.eaac-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.eaac-hero-actions .zcs-button{box-shadow:0 10px 22px rgba(0,0,0,.14)}.eaac-profile{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);border-radius:20px;padding:18px;backdrop-filter:blur(4px)}.eaac-avatar{width:58px;height:58px;border-radius:18px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28px}.eaac-profile h2{font-size:20px;line-height:1.2;margin:0;color:#fff}.eaac-profile-line{font-size:13px;color:rgba(255,255,255,.82);display:flex;align-items:center;gap:8px;margin-top:6px}.eaac-profile-kv{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.eaac-kv{border:1px solid rgba(255,255,255,.18);border-radius:14px;padding:10px;background:rgba(255,255,255,.08)}.eaac-kv span{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.55px;color:rgba(255,255,255,.62)}.eaac-kv strong{display:block;font-size:14px;margin-top:4px;color:#fff}.eaac-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 4px -2px}.eaac-section-title h2{font-size:11px;font-weight:800;color:#8a94a6;text-transform:uppercase;letter-spacing:1.1px;margin:0;display:flex;align-items:center;gap:8px}.eaac-section-title h2:before{content:"";width:4px;height:15px;border-radius:4px;background:linear-gradient(180deg,var(--zcs_brand_color,#2563eb),#14b8a6)}.eaac-section-sub{font-size:12px;color:#8a94a6}.eaac-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.eaac-kpi{position:relative;overflow:hidden;background:#fff;border:1px solid #e9edf5;border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);min-height:145px}.eaac-kpi:after{content:"";position:absolute;right:-42px;top:-42px;width:120px;height:120px;border-radius:50%;background:var(--soft)}.eaac-kpi-icon{position:relative;z-index:1;width:42px;height:42px;border-radius:14px;background:var(--soft);color:var(--tone);display:flex;align-items:center;justify-content:center;font-size:21px}.eaac-kpi-value{position:relative;z-index:1;font-size:32px;line-height:1;font-weight:800;color:#111827;margin-top:16px;letter-spacing:-.5px}.eaac-kpi-label{position:relative;z-index:1;font-size:12px;color:#64748b;margin-top:5px;font-weight:650}.eaac-kpi-note{position:relative;z-index:1;font-size:11px;color:#8a94a6;margin-top:6px}.eaac-grid-two{display:grid;grid-template-columns:minmax(0,.94fr) minmax(360px,.62fr);gap:14px}.eaac-card{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.eaac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.eaac-card-title{display:flex;gap:12px;align-items:flex-start}.eaac-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.eaac-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.eaac-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.eaac-card-body{padding:18px}.eaac-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.eaac-action{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:12px}.eaac-action.hot{border-color:rgba(254,69,93,.35);background:linear-gradient(180deg,#fff,#fff5f6)}.eaac-action-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.eaac-action-title h4{font-size:15px;margin:0;color:#111827}.eaac-action-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.eaac-action-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.eaac-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:750;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.eaac-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb)}.eaac-link:hover{text-decoration:underline}.eaac-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.eaac-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.eaac-list{display:flex;flex-direction:column;gap:10px}.eaac-item{border:1px solid #e9edf5;border-radius:14px;padding:12px;background:#fff}.eaac-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.eaac-item-title{font-size:14px;font-weight:800;color:#111827}.eaac-item-meta{font-size:12px;color:#64748b;margin-top:3px}.eaac-item-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.eaac-table-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.eaac-table-card.wide{grid-column:1/-1}.eaac-table-caption{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}.eaac-table-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb);white-space:nowrap}.eaac-table-wrap{max-height:420px;overflow:auto}.eaac-table-wrap table{min-width:900px}.eaac-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.eaac-report-card.wide{grid-column:1/-1}.eaac-embed{border-top:1px solid #eef1f6;background:#fff;padding:8px}.eaac-embed-box{min-height:390px;border:1px dashed #d7deea;border-radius:12px;background:#fff;overflow:hidden}.eaac-foot-space{height:12px}@media(max-width:1260px){.eaac-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.eaac-hero-grid,.eaac-grid-two{grid-template-columns:1fr}.eaac-action-grid{grid-template-columns:1fr}}@media(max-width:820px){.eaac{padding:14px}.eaac-hero{padding:22px;border-radius:20px}.eaac-kpis,.eaac-table-grid,.eaac-report-grid{grid-template-columns:1fr}.eaac-profile-kv{grid-template-columns:1fr}.eaac-section-title{align-items:flex-start;flex-direction:column}.eaac-card-head{flex-direction:column}.eaac-hero-actions .zcs-button{width:100%}.eaac-report-card.wide,.eaac-table-card.wide{grid-column:auto}}
</style>
<div class="eaac">
	<div class="eaac-shell">
		<section class="eaac-hero">
			<div class="eaac-hero-grid">
				<div>
					<div class="eaac-eyebrow"><i class="zc-li-outline business-shield"></i><span>Enforcement agent action center</span></div>
					<h1>Field workload and next actions</h1>
					<p>Personal queues are filtered by <strong><%=agentEmail%></strong> wherever the app has agent, investigator, collected-by, or supervising agent email fields. Shared sections surface active enforcement queues when no individual assignee field exists.</p>
					<div class="eaac-hero-actions">
						<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Enforcement_Work_Queue"><i class="zcs-button-icon zc-li-outline files-2-doc"></i><span class="zcs-button-text">Open case queue</span></a>
						<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Mobile_Field_Capture"><i class="zcs-button-icon zc-li-outline location-appointment"></i><span class="zcs-button-text">Open visits</span></a>
						<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Disposition_Queue"><i class="zcs-button-icon zc-li-outline files-archive-content"></i><span class="zcs-button-text">Open evidence</span></a>
					</div>
				</div>
				<aside class="eaac-profile">
					<div class="zcs-flex zcs-align-items-center zcs-gap-12">
						<div class="eaac-avatar"><i class="zc-li-outline users-police"></i></div>
						<div class="zcs-col-common">
							<h2><%=agentName%></h2>
							<div class="eaac-profile-line"><i class="zc-li-outline ui-1-email-85"></i><span><%=agentEmail%></span></div>
							<div class="eaac-profile-line"><i class="zc-li-outline business-badge"></i><span><%=agentRole%></span></div>
						</div>
					</div>
					<div class="eaac-profile-kv">
						<div class="eaac-kv"><span>Total workload</span><strong><%=totalWorkload%> active items</strong></div>
						<div class="eaac-kv"><span>Field load</span><strong><%=fieldLoad%> <%=visitLabel%></strong></div>
						<div class="eaac-kv"><span>Assigned cases</span><strong><%=assignedCaseCount%> <%=caseLabel%></strong></div>
						<div class="eaac-kv"><span>Overdue visits</span><strong><%=overdueVisitCount%> needs review</strong></div>
					</div>
				</aside>
			</div>
		</section>

		<div class="eaac-section-title"><h2>Current workload snapshot</h2><span class="eaac-section-sub">Counts update at page load from live enforcement records.</span></div>
		<section class="eaac-kpis">
			<div class="eaac-kpi" style="--soft:#eff6ff;--tone:#2563eb"><div class="eaac-kpi-icon"><i class="zc-li-outline files-2-doc"></i></div><div class="eaac-kpi-value"><%=assignedCaseCount%></div><div class="eaac-kpi-label">Assigned active cases</div><div class="eaac-kpi-note">Assigned or supervising agent</div></div>
			<div class="eaac-kpi" style="--soft:#fff1f2;--tone:#e11d48"><div class="eaac-kpi-icon"><i class="zc-li-outline ui-2-time"></i></div><div class="eaac-kpi-value"><%=overdueVisitCount%></div><div class="eaac-kpi-label">Overdue visits</div><div class="eaac-kpi-note">Field capture not synced</div></div>
			<div class="eaac-kpi" style="--soft:#ecfdf5;--tone:#059669"><div class="eaac-kpi-icon"><i class="zc-li-outline location-appointment"></i></div><div class="eaac-kpi-value"><%=upcomingVisitCount%></div><div class="eaac-kpi-label">Scheduled visits</div><div class="eaac-kpi-note">Upcoming field work</div></div>
			<div class="eaac-kpi" style="--soft:#fffbeb;--tone:#b45309"><div class="eaac-kpi-icon"><i class="zc-li-outline files-exclamation"></i></div><div class="eaac-kpi-value"><%=novCount%></div><div class="eaac-kpi-label">NOV queue</div><div class="eaac-kpi-note">Related to assigned cases</div></div>
			<div class="eaac-kpi" style="--soft:#f0f9ff;--tone:#0284c7"><div class="eaac-kpi-icon"><i class="zc-li-outline files-archive-content"></i></div><div class="eaac-kpi-value"><%=evidenceCount%></div><div class="eaac-kpi-label">Custody tasks</div><div class="eaac-kpi-note">Open chain-of-custody</div></div>
			<div class="eaac-kpi" style="--soft:#fef3c7;--tone:#d97706"><div class="eaac-kpi-icon"><i class="zc-li-outline ui-3-alert"></i></div><div class="eaac-kpi-value"><%=highPriorityCount%></div><div class="eaac-kpi-label">High-priority complaints</div><div class="eaac-kpi-note">Active enforcement queue</div></div>
		</section>

		<div class="eaac-grid-two">
			<section class="eaac-card">
				<div class="eaac-card-head">
					<div class="eaac-card-title"><div class="eaac-card-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div><h3>Next actions</h3><p>Start with overdue visits and custody records, then process assigned case and NOV queues.</p></div></div>
					<a class="eaac-link" href="#Report:Enforcement_Work_Queue">All case actions <i class="zc-li-outline arrows-1-tail-right"></i></a>
				</div>
				<div class="eaac-card-body">
					<div class="eaac-action-grid">
						<div class="eaac-action hot"><div class="eaac-action-title"><h4>Overdue field visits</h4><span class="eaac-chip chip-bad"><i class="zc-li-outline ui-2-time"></i><%=overdueVisitCount%></span></div><p class="eaac-action-copy">Review missed visit dates and update field capture status before new work is scheduled.</p><div class="eaac-action-links"><a class="eaac-link" href="#Report:Mobile_Field_Capture">Open Mobile_Field_Capture</a><a class="eaac-link" href="#Report:Field_Visit_Log">View full log</a></div></div>
						<div class="eaac-action"><div class="eaac-action-title"><h4>Assigned cases</h4><span class="eaac-chip chip-theme"><i class="zc-li-outline files-2-doc"></i><%=assignedCaseCount%></span></div><p class="eaac-action-copy">Work open cases where you are assigned agent or supervising agent.</p><div class="eaac-action-links"><a class="eaac-link" href="#Report:Enforcement_Work_Queue">Open queue</a><a class="eaac-link" href="#Report:Case_Status_Board">Status board</a></div></div>
						<div class="eaac-action"><div class="eaac-action-title"><h4>NOV and violations</h4><span class="eaac-chip chip-warn"><i class="zc-li-outline files-exclamation"></i><%=novCount%></span></div><p class="eaac-action-copy">Use report actions to issue notices, mark citations, recommend action, or clear violations.</p><div class="eaac-action-links"><a class="eaac-link" href="#Report:Notice_Of_Violation_Queue">Open NOV queue</a><a class="eaac-link" href="#Report:Violations_By_Case">By case</a></div></div>
						<div class="eaac-action"><div class="eaac-action-title"><h4>Evidence custody</h4><span class="eaac-chip chip-info"><i class="zc-li-outline files-archive-content"></i><%=evidenceCount%></span></div><p class="eaac-action-copy">Log custody, mark reviewed, dispose, or return evidence from action-enabled evidence reports.</p><div class="eaac-action-links"><a class="eaac-link" href="#Report:Chain_Of_Custody_Log">Custody log</a><a class="eaac-link" href="#Report:Disposition_Queue">Disposition queue</a></div></div>
					</div>
				</div>
			</section>

			<section class="eaac-card">
				<div class="eaac-card-head"><div class="eaac-card-title"><div class="eaac-card-icon"><i class="zc-li-outline ui-3-alert"></i></div><div><h3>Active shared enforcement queues</h3><p>These queues are shown because complaint priority queues do not have an individual agent field.</p></div></div></div>
				<div class="eaac-card-body">
					<div class="eaac-list">
						<div class="eaac-item"><div class="eaac-item-top"><div><div class="eaac-item-title">High-priority complaints</div><div class="eaac-item-meta"><%=highPriorityCount%> active high-priority complaints need screening or case creation.</div></div><span class="eaac-chip chip-warn"><i class="zc-li-outline ui-3-alert"></i>Priority</span></div><div class="eaac-item-actions"><a class="eaac-link" href="#Report:High_Priority_Complaints">Open report</a><a class="eaac-link" href="#Report:Supervisor_Screening_Queue">Screening queue</a></div></div>
						<div class="eaac-item"><div class="eaac-item-top"><div><div class="eaac-item-title">Evidence ready for disposition</div><div class="eaac-item-meta"><%=dispositionCount%> assigned or collected evidence records have disposition levels set.</div></div><span class="eaac-chip chip-info"><i class="zc-li-outline files-archive-content"></i>Evidence</span></div><div class="eaac-item-actions"><a class="eaac-link" href="#Report:Disposition_Queue">Open disposition</a><a class="eaac-link" href="#Report:Evidence_Register">Register</a></div></div>
						<div class="eaac-item"><div class="eaac-item-top"><div><div class="eaac-item-title">Upcoming field visits</div><div class="eaac-item-meta"><%=upcomingVisitCount%> scheduled visits assigned to your email are ready for field capture.</div></div><span class="eaac-chip chip-ok"><i class="zc-li-outline location-appointment"></i>Scheduled</span></div><div class="eaac-item-actions"><a class="eaac-link" href="#Report:Mobile_Field_Capture">Open capture</a><a class="eaac-link" href="#Report:Field_Visit_Calendar">Calendar</a></div></div>
					</div>
				</div>
			</section>
		</div>

		<div class="eaac-section-title"><h2>Personal assignment tables</h2><span class="eaac-section-sub">Limited to top records so agents can scan and jump to action-enabled reports.</span></div>
		<div class="eaac-table-grid">
			<section class="eaac-card eaac-table-card zcs-card zcs-p-20 zcs-box-border wide">
				<div class="eaac-table-caption"><div><h2 class="zcs-font-18 zcs-font-semibold zcs-m-0">Assigned cases</h2><p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8">Open cases where Assigned Agent Email or Supervising Agent Email matches <%=agentEmail%>.</p></div><a class="eaac-table-link" href="#Report:Enforcement_Work_Queue">Open action report <i class="zc-li-outline arrows-1-tail-right"></i></a></div>
				<div class="zcs-table-wrapper eaac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full"><thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Case</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Priority</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Initial visit due</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Next action</th></tr></thead><tbody>
					<%
						caseShown = 0;
						for each c in assignedCases
						{
							if(caseShown < 8)
							{
								caseShown = caseShown + 1;
								priorityClass = if(c.Priority == "High","zcs-badge-red","zcs-badge-blue");
								statusClass = if(c.Case_Status == "Field Investigation" || c.Case_Status == "Preliminary Investigation","zcs-badge-orange","zcs-badge-theme");
								nextText = "Review case";
								if(c.Initial_Visit_Due_Date != null && c.Initial_Visit_Due_Date < zoho.currentdate)
								{
									nextText = "Schedule or update overdue visit";
								}
								else if(c.Recommend_Accusation == true)
								{
									nextText = "Refer or prepare legal package";
								}
								%><tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(c.Case_Number,"Case")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border"><span class="zcs-badge zcs-badge-filled-outline <%=priorityClass%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border"><i class="zcs-badge-icon zc-li-outline ui-3-alert"></i><span class="zcs-font-12"><%=ifnull(c.Priority,"Standard")%></span></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border"><span class="zcs-badge zcs-badge-filled-outline <%=statusClass%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border"><i class="zcs-badge-icon zc-li-outline loader-dots-06"></i><span class="zcs-font-12"><%=ifnull(c.Case_Status,"New")%></span></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary"><%=ifnull(c.Initial_Visit_Due_Date,"Not set")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary"><%=nextText%></td></tr><%
							}
						}
						if(caseShown == 0)
						{
							%><tr><td colspan="5"><div class="eaac-empty"><span class="eaac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span>No open case records are assigned to your agent email. Use the embedded active enforcement queues below if you are covering shared work.</div></td></tr><%
						}
					%></tbody></table></div>
			</section>

			<section class="eaac-card eaac-table-card zcs-card zcs-p-20 zcs-box-border">
				<div class="eaac-table-caption"><div><h2 class="zcs-font-18 zcs-font-semibold zcs-m-0">Scheduled and overdue visits</h2><p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8">Agent Email matches current user.</p></div><a class="eaac-table-link" href="#Report:Mobile_Field_Capture">Open capture</a></div>
				<div class="zcs-table-wrapper eaac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full"><thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Visit</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Case</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
					<%
						visitShown = 0;
						for each fv in Field_Visits[Agent_Email == agentEmail && FSM_Status != "Synced Manually"] sort by Visit_Date_Time asc
						{
							if(visitShown < 8)
							{
								visitShown = visitShown + 1;
								visitCase = "Case not linked";
								if(fv.Case != null)
								{
									visitCase = ifnull(fv.Case.Case_Number,"Case linked");
								}
								visitBadge = if(fv.Visit_Date_Time < zoho.currentdate,"zcs-badge-red","zcs-badge-green");
								visitLabelText = if(fv.Visit_Date_Time < zoho.currentdate,"Overdue","Scheduled");
								%><tr><td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary"><%=ifnull(fv.Visit_Number,"Visit")%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary"><%=visitCase%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary"><%=ifnull(fv.Visit_Date_Time,"Not scheduled")%></td><td class="zcs-px-16 zcs-py-8"><span class="zcs-badge zcs-badge-filled-outline <%=visitBadge%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2"><i class="zcs-badge-icon zc-li-outline ui-2-time"></i><span class="zcs-font-12"><%=visitLabelText%></span></span></td></tr><%
							}
						}
						if(visitShown == 0)
						{
							%><tr><td colspan="4"><div class="eaac-empty"><span class="eaac-empty-icon"><i class="zc-li-outline location-appointment"></i></span>No scheduled or overdue field visits are assigned to your email.</div></td></tr><%
						}
					%></tbody></table></div>
			</section>

			<section class="eaac-card eaac-table-card zcs-card zcs-p-20 zcs-box-border">
				<div class="eaac-table-caption"><div><h2 class="zcs-font-18 zcs-font-semibold zcs-m-0">Evidence custody and disposition</h2><p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8">Collected by you or related to your cases.</p></div><a class="eaac-table-link" href="#Report:Disposition_Queue">Open report</a></div>
				<div class="zcs-table-wrapper eaac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full"><thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Evidence</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Case</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Custody</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Disposition</th></tr></thead><tbody>
					<%
						evShown = 0;
						for each ev in evidenceQueue
						{
							if(evShown < 8)
							{
								evShown = evShown + 1;
								evCase = "Case not linked";
								if(ev.Case != null)
								{
									evCase = ifnull(ev.Case.Case_Number,"Case linked");
								}
								custodyBadge = if(ev.Chain_of_Custody_Status == "Collected" || ev.Chain_of_Custody_Status == "Booked","zcs-badge-green","zcs-badge-blue");
								dispBadge = if(ev.Disposition_Level == "Not Ready","zcs-badge-yellow","zcs-badge-orange");
								%><tr><td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary"><%=ifnull(ev.Evidence_Number,"Evidence")%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary"><%=evCase%></td><td class="zcs-px-16 zcs-py-8"><span class="zcs-badge zcs-badge-filled-outline <%=custodyBadge%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2"><i class="zcs-badge-icon zc-li-outline files-archive-content"></i><span class="zcs-font-12"><%=ifnull(ev.Chain_of_Custody_Status,"Collected")%></span></span></td><td class="zcs-px-16 zcs-py-8"><span class="zcs-badge zcs-badge-filled-outline <%=dispBadge%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2"><i class="zcs-badge-icon zc-li-outline loader-dots-06"></i><span class="zcs-font-12"><%=ifnull(ev.Disposition_Level,"Not Ready")%></span></span></td></tr><%
							}
						}
						if(evShown == 0)
						{
							%><tr><td colspan="4"><div class="eaac-empty"><span class="eaac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span>No open evidence custody records are assigned to you or your cases.</div></td></tr><%
						}
					%></tbody></table></div>
			</section>
		</div>

		<div class="eaac-section-title"><h2>Action-enabled enforcement reports</h2><span class="eaac-section-sub">Embedded reports preserve row-level actions such as Assign Case, Issue NOV, Log Custody, Dispose Evidence, and Create Case.</span></div>
		<section class="eaac-report-grid">
			<div class="eaac-report-card zcs-card zcs-p-20 zcs-box-border"><div class="eaac-table-caption"><div><h2 class="zcs-font-18 zcs-font-semibold zcs-m-0">Assigned and active cases</h2><p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8">Enforcement_Work_Queue action report.</p></div></div><div class="eaac-embed" zc-component="report" zc-linkname="Enforcement_Work_Queue" zc-height="430px"></div></div>
			<div class="eaac-report-card zcs-card zcs-p-20 zcs-box-border"><div class="eaac-table-caption"><div><h2 class="zcs-font-18 zcs-font-semibold zcs-m-0">Field visits</h2><p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8">Mobile_Field_Capture and visit capture tasks.</p></div></div><div class="eaac-embed" zc-component="report" zc-linkname="Mobile_Field_Capture" zc-height="430px"></div></div>
			<div class="eaac-report-card zcs-card zcs-p-20 zcs-box-border"><div class="eaac-table-caption"><div><h2 class="zcs-font-18 zcs-font-semibold zcs-m-0">Notice of violation queue</h2><p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8">Issue NOV and violation outcome actions.</p></div></div><div class="eaac-embed" zc-component="report" zc-linkname="Notice_Of_Violation_Queue" zc-height="430px"></div></div>
			<div class="eaac-report-card zcs-card zcs-p-20 zcs-box-border"><div class="eaac-table-caption"><div><h2 class="zcs-font-18 zcs-font-semibold zcs-m-0">Evidence disposition</h2><p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8">Disposition_Queue action report.</p></div></div><div class="eaac-embed" zc-component="report" zc-linkname="Disposition_Queue" zc-height="430px"></div></div>
			<div class="eaac-report-card zcs-card zcs-p-20 zcs-box-border"><div class="eaac-table-caption"><div><h2 class="zcs-font-18 zcs-font-semibold zcs-m-0">Chain of custody</h2><p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8">Custody log for evidence movement.</p></div></div><div class="eaac-embed" zc-component="report" zc-linkname="Chain_Of_Custody_Log" zc-height="430px"></div></div>
			<div class="eaac-report-card zcs-card zcs-p-20 zcs-box-border"><div class="eaac-table-caption"><div><h2 class="zcs-font-18 zcs-font-semibold zcs-m-0">High-priority complaints</h2><p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-8">Relevant active enforcement queue without individual agent field.</p></div></div><div class="eaac-embed" zc-component="report" zc-linkname="High_Priority_Complaints" zc-height="430px"></div></div>
		</section>
		<div class="eaac-foot-space"></div>
	</div>
</div>