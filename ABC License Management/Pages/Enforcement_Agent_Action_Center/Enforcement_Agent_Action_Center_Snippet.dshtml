<%
	agentEmail = ifnull(zoho.loginuserid,"");
	if(agentEmail == "" || agentEmail == null)
	{
		agentEmail = "Current user";
	}

	agentName = agentEmail;
	agentRole = "Enforcement Agent";
	agentRow = Add_Agents[Agent_Email == agentEmail && Active == true];
	if(agentRow.count() > 0)
	{
		firstName = ifnull(agentRow.Agent_Name.first_name,"");
		lastName = ifnull(agentRow.Agent_Name.last_name,"");
		fullName = (firstName + " " + lastName).trim();
		if(fullName != "")
		{
			agentName = fullName;
		}
		agentRole = ifnull(agentRow.Agent_Role,"Enforcement Agent");
	}

	assignedCases = Cases[(Assigned_Agent_Email == agentEmail || Supervising_Agent_Email == agentEmail) && Case_Status != "Closed"] sort by Initial_Visit_Due_Date asc;
	upcomingVisits = Field_Visits[Agent_Email == agentEmail && Visit_Date_Time >= zoho.currentdate && FSM_Status != "Synced Manually"] sort by Visit_Date_Time asc;
	overdueVisits = Field_Visits[Agent_Email == agentEmail && Visit_Date_Time < zoho.currentdate && FSM_Status != "Synced Manually"] sort by Visit_Date_Time asc;
	novQueue = Violations[Notice_of_Violation_Issued == true && (Case.Assigned_Agent_Email == agentEmail || Case.Supervising_Agent_Email == agentEmail)] sort by Violation_Date desc;
	evidenceQueue = Evidence[(Collected_By_Email == agentEmail || Case.Assigned_Agent_Email == agentEmail || Case.Supervising_Agent_Email == agentEmail) && (Chain_of_Custody_Status != "Disposed" && Chain_of_Custody_Status != "Released to Owner")] sort by Date_Collected asc;
	dispositionQueue = Evidence[(Collected_By_Email == agentEmail || Case.Assigned_Agent_Email == agentEmail || Case.Supervising_Agent_Email == agentEmail) && Disposition_Level != "Not Ready"] sort by Date_Collected asc;
	highPriorityComplaints = Complaints[Priority == "High" && Screening_Decision != "Rejected" && Screening_Decision != "Closed"] sort by Intake_Date asc;

	assignedCaseCount = assignedCases.count();
	upcomingVisitCount = upcomingVisits.count();
	overdueVisitCount = overdueVisits.count();
	novCount = novQueue.count();
	evidenceCount = evidenceQueue.count();
	dispositionCount = dispositionQueue.count();
	highPriorityCount = highPriorityComplaints.count();
	fieldLoad = upcomingVisitCount + overdueVisitCount;
	totalWorkload = assignedCaseCount + fieldLoad + novCount + evidenceCount + dispositionCount + highPriorityCount;

	caseLabel = if(assignedCaseCount == 1,"case","cases");
	visitLabel = if(fieldLoad == 1,"visit","visits");
%>
<style>
/* ZCS global utility stylesheet included once for this page; component ids used: zcs-global, button-primary-button, badge-badge-with-icon, table-simple-table, card-sample-1. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color,#2563eb);--zcs-light-bg-color:var(--zcs_brand_light_color,#eaf2ff);--zcs-page-bg-color:#f5f7fb;--zcs-primary-text-color:var(--zcs_primary_text_color,#111827);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#4b5563);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#8a94a6);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e7eb);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-rounded-sm{bor