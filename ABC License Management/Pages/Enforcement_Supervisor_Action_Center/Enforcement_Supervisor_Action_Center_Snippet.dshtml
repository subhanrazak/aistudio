<%
	supervisorEmail = ifnull(zoho.loginuserid,"");
	if(supervisorEmail == "" || supervisorEmail == null)
	{
		supervisorEmail = "Current user";
	}
	supervisorName = supervisorEmail;
	supervisorRole = "Enforcement Supervisor";
	agentRow = Add_Agents[Agent_Email == supervisorEmail && Active == true];
	if(agentRow.count() > 0)
	{
		firstName = ifnull(agentRow.Agent_Name.first_name,"");
		lastName = ifnull(agentRow.Agent_Name.last_name,"");
		fullName = (firstName + " " + lastName).trim();
		if(fullName != "")
		{
			supervisorName = fullName;
		}
		supervisorRole = ifnull(agentRow.Agent_Role,"Enforcement Supervisor");
	}

	screeningQueue = Complaints[Screening_Decision == "New" || Screening_Decision == "Need More Information"] sort by Intake_Date asc;
	highPriorityComplaints = Complaints[Priority == "High" && Screening_Decision != "Rejected" && Screening_Decision != "Closed"] sort by Intake_Date asc;
	openCases = Cases[Case_Status != "Closed"] sort by Initial_Visit_Due_Date asc;
	unassignedOpenCases = Cases[(Assigned_Agent_Email == null || Assigned_Agent_Email == "") && Case_Status != "Closed"] sort by Initial_Visit_Due_Date asc;
	overdueFieldVisits = Field_Visits[Visit_Date_Time < zoho.currentdate && FSM_Status != "Synced Manually"] sort by Visit_Date_Time asc;
	legalReviewQueue = Cases[Case_Status == "Referred to OLS" || Case_Status == "Legal Review" || Case_Status == "Hearing Status" || Legal_Review_Status == "Pending OLS Review" || Legal_Review_Status == "Accusation Drafted" || Legal_Review_Status == "Hearing Scheduled"] sort by Initial_Visit_Due_Date asc;
	legalReferralCandidates = Cases[Case_Status != "Closed" && Recommend_Accusation == true] sort by Initial_Visit_Due_Date asc;
	evidenceDispositionQueue = Evidence[Chain_of_Custody_Status == "Disposed" || Disposition_Level != "Not Ready"] sort by Date_Collected asc;
	evidenceReadyForAction = Evidence[Disposition_Level != "Not Ready" && Chain_of_Custody_Status != "Disposed" && Chain_of_Custody_Status != "Released to Owner"] sort by Date_Collected asc;
	correspondenceQueue = Correspondence[Merge_Status == "Draft" || Merge_Status == "Ready for Manual Merge"] sort by Generated_Date asc;
	pendingMerge = Correspondence[Merge_Status == "Draft"].count();
	pendingSignature = Correspondence[Sign_Status == "Not Required" || Sign_Status == "Declined"].count();

	screeningCount = screeningQueue.count();
	highPriorityCount = highPriorityComplaints.count();
	openCaseCount = openCases.count();
	unassignedCaseCount = unassignedOpenCases.count();
	overdueVisitCount = overdueFieldVisits.count();
	legalReviewCount = legalReviewQueue.count();
	legalReferralCount = legalReferralCandidates.count();
	evidenceDispositionCount = evidenceDispositionQueue.count();
	evidenceReadyCount = evidenceReadyForAction.count();
	pendingCorrespondenceCount = correspondenceQueue.count();
	totalActionLoad = screeningCount + highPriorityCount + unassignedCaseCount + overdueVisitCount + legalReviewCount + evidenceDispositionCount + pendingCorrespondenceCount;
	openCaseLabel = if(openCaseCount == 1,"open case","open cases");
%>
<style>
/* ZCS component ids used: zcs-global, header-heading-with-actions, card-sample-1, badge-badge-with-icon, button-primary-button, table-table-with-custom-action-button-icon. */
