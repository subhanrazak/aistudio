<%
	operatorEmail = ifnull(zoho.loginuserid,"");
	if(operatorEmail == "" || operatorEmail == null)
	{
		operatorEmail = "Accounting operator";
	}

	pendingPayments = Payments[(Payment_Status == "Pending" || Payment_Status == "Failed")] sort by Payment_Date asc;
	refundQueue = Payments[Refund_Requested == true && Refund_Status != "Completed"] sort by Payment_Date asc;
	reconQueue = Payments[Payment_Date is not null && Reconciled != true && (Payment_Status == "Complete" || Payment_Status == "Refunded" || Payment_Status == "Void")] sort by Payment_Date asc;
	todaysRecon = Payments[Payment_Date == zoho.currentdate && Reconciled != true && (Payment_Status == "Complete" || Payment_Status == "Refunded" || Payment_Status == "Void")];
	auditExceptions = Audit_Log[Module == "Payment" && (Action.contains("skipped") || Details.contains("not eligible") || Details.contains("already reconciled") || Details.contains("not in a"))] sort by Event_Time desc;
	unpaidApplications = Applications[Payment_Status == "Pending" && (Total_Fee_Due > 0 || Total_Fee > 0)] sort by Application_Submitted_Date asc;
	unpaidRenewals = Renewal_Batches[Payment_Status == "Pending" && Total_Amount_Due > 0] sort by Submitted_Date asc;

	pendingCount = pendingPayments.count();
	refundCount = refundQueue.count();
	reconCount = reconQueue.count();
	todayReconCount = todaysRecon.count();
	auditCount = auditExceptions.count();
	unpaidAppCount = unpaidApplications.count();
	unpaidRenewalCount = unpaidRenewals.count();
	unpaidTotal = unpaidAppCount + unpaidRenewalCount;
	pendingAmount = ifnull(pendingPayments.sum(Amount_Due),0);
	refundAmount = ifnull(refundQueue.sum(Refund_Amount),0);
	reconAmount = ifnull(reconQueue.sum(Amount_Paid),0);
	unpaidAppAmount = ifnull(unpaidApplications.sum(Total_Fee_Due),0) + ifnull(unpaidApplications.sum(Total_Fee),0);
	unpaidRenewalAmount = ifnull(unpaidRenewals.sum(Total_Amount_Due),0);
	unpaidAmount = unpaidAppAmount + unpaidRenewalAmount;
	actionTotal = pendingCount + refundCount + reconCount + auditCount + unpaidTotal;

	reconPct = 0;
	paidTodayCount = Payments[Payment_Date == zoho.currentdate && (Payment_Status == "Complete" || Payment_Status == "Refunded" || Payment_Status == "Void")].count();
	if(paidTodayCount > 0)
	{
		reconPct = (((paidTodayCount - todayReconCount) * 100) / paidTodayCount).round(0);
	}
	if(reconPct < 0)
	{
		reconPct = 0;
	}
%>
<style>
