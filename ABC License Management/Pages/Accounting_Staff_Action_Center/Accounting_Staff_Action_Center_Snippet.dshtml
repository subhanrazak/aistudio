:1;font-size:32px;line-height:1;font-weight:800;color:#111827;margin-top:16px;letter-spacing:-.5px}.asac-kpi-label{position:relative;z-index:1;font-size:12px;color:#64748b;margin-top:5px;font-weight:650}.asac-kpi-note{position:relative;z-index:1;font-size:11px;color:#8a94a6;margin-top:6px}.asac-grid-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.58fr);gap:14px}.asac-card{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.asac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.asac-card-title{display:flex;gap:12px;align-items:flex-start}.asac-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.asac-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.asac-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.asac-card-body{padding:18px}.asac-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.asac-action{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:12px}.asac-action.top{border-color:rgba(250,174,19,.45);background:linear-gradient(180deg,#fff,#fffbeb)}.asac-action-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.asac-action-title h4{font-size:15px;margin:0;color:#111827}.asac-action-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.asac-action-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.asac-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:750;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.asac-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb)}.asac-link:hover{text-decoration:underline}.asac-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.asac-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.asac-list{display:flex;flex-direction:column;gap:10px}.asac-item{border:1px solid #e9edf5;border-radius:14px;padding:12px;background:#fff}.asac-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.asac-item-title{font-size:14px;font-weight:800;color:#111827}.asac-item-meta{font-size:12px;color:#64748b;margin-top:3px}.asac-item-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.asac-health-list{list-style:none}.asac-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.asac-report-card.wide{grid-column:1/-1}.asac-embed{border-top:1px solid #eef1f6;background:#fff;padding:8px}.asac-embed-box{min-height:360px;border:1px dashed #d7deea;border-radius:12px;background:#fff;overflow:hidden}.asac-table-wrap{max-height:480px;overflow:auto}.asac-table-wrap table{min-width:980px}.asac-foot-space{height:12px}@media(max-width:1240px){.asac-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.asac-hero-grid,.asac-grid-two{grid-template-columns:1fr}.asac-action-grid{grid-template-columns:1fr}}@media(max-width:780px){.asac{padding:14px}.asac-hero{padding:22px;border-radius:20px}.asac-kpis,.asac-report-grid{grid-template-columns:1fr}.asac-profile-kv{grid-template-columns:1fr}.asac-section-title{align-items:flex-start;flex-direction:column}.asac-card-head{flex-direction:column}.asac-hero-actions .zcs-button{width:100%}.asac-report-card.wide{grid-column:auto}}
</style>
<div class="asac">
	<div class="asac-shell">
		<section class="asac-hero">
			<div class="asac-hero-grid">
				<div>
					<span class="asac-eyebrow"><i class="zc-li-outline business-wallet-44"></i> Accounting staff action center</span>
					<h1>Payment, refund, and reconciliation queue</h1>
					<p>Hello <%=operatorEmail%>. This workspace uses zoho.loginuserid for operator display and brings pending payments, refunds, daily reconciliation, payment audit exceptions, and unpaid application or renewal fees into one accounting queue.</p>
					<div class="asac-hero-actions">
						<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Pending_Payments?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline business-money-time"></i><span class="zcs-button-text">Pending payments</span></a>
						<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Refund_Queue?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline business-handout"></i><span class="zcs-button-text">Refund queue</span></a>
						<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Daily_Reconciliation?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline business-calculator"></i><span class="zcs-button-text">Daily reconciliation</span></a>
					</div>
				</div>
				<aside class="asac-profile">
					<div class="zcs-flex zcs-align-items-center zcs-gap-12">
						<div class="asac-avatar"><i class="zc-li-outline users-single-01"></i></div>
						<div class="zcs-col-common">
							<h2>Accounting operator</h2>
							<div class="asac-profile-line"><i class="zc-li-outline ui-1-email-83"></i><span><%=operatorEmail%></span></div>
							<div class="asac-profile-line"><i class="zc-li-outline business-progress"></i><span><%=actionTotal%> open accounting signals</span></div>
						</div>
					</div>
					<div class="asac-profile-kv">
						<div class="asac-kv"><span>Payment exposure</span><strong>$<%=pendingAmount%></strong></div>
						<div class="asac-kv"><span>Refund exposure</span><strong>$<%=refundAmount%></strong></div>
						<div class="asac-kv"><span>Recon amount</span><strong>$<%=reconAmount%></strong></div>
						<div class="asac-kv"><span>Unpaid fees</span><strong>$<%=unpaidAmount%></strong></div>
					</div>
				</aside>
			</div>
		</section>

		<div class="asac-section-title"><h2>Accounting snapshot</h2><span class="asac-section-sub">Counts are live from Payments, Audit Log, Applications, and Renewal Batches.</span></div>
		<section class="asac-kpis">
			<div class="asac-kpi" style="--tone:#2a6ffc;--soft:#e8efff;"><div class="asac-kpi-icon"><i class="zc-li-outline business-money-time"></i></div><div class="asac-kpi-value"><%=pendingCount%></div><div class="asac-kpi-label">Pending payments</div><div class="asac-kpi-note">Pending or failed status</div></div>
			<div class="asac-kpi" style="--tone:#f4660c;--soft:#f8f0eb;"><div class="asac-kpi-icon"><i class="zc-li-outline business-handout"></i></div><div class="asac-kpi-value"><%=refundCount%></div><div class="asac-kpi-label">Refund queue</div><div class="asac-kpi-note">Requested, approved, or denied</div></div>
			<div class="asac-kpi" style="--tone:#1094c5;--soft:#e4f6fd;"><div class="asac-kpi-icon"><i class="zc-li-outline business-calculator"></i></div><div class="asac-kpi-value"><%=todayReconCount%></div><div class="asac-kpi-label">Today unreconciled</div><div class="asac-kpi-note">Paid today and not reconciled</div></div>
			<div class="asac-kpi" style="--tone:#7c3aed;--soft:#f1eaff;"><div class="asac-kpi-icon"><i class="zc-li-outline files-search"></i></div><div class="asac-kpi-value"><%=auditCount%></div><div class="asac-kpi-label">Payment audit exceptions</div><div class="asac-kpi-note">Skipped or exception audit entries</div></div>
			<div class="asac-kpi" style="--tone:#b8770d;--soft:#fcf4e6;"><div class="asac-kpi-icon"><i class="zc-li-outline files-single-content-03"></i></div><div class="asac-kpi-value"><%=unpaidAppCount%></div><div class="asac-kpi-label">Unpaid applications</div><div class="asac-kpi-note">Application payment status pending</div></div>
			<div class="asac-kpi" style="--tone:#179e6c;--soft:#e4fcf3;"><div class="asac-kpi-icon"><i class="zc-li-outline files-folder-time"></i></div><div class="asac-kpi-value"><%=unpaidRenewalCount%></div><div class="asac-kpi-label">Unpaid renewals</div><div class="asac-kpi-note">Renewal payment status pending</div></div>
		</section>

		<section class="asac-grid-two">
			<div class="asac-card">
				<div class="asac-card-head">
					<div class="asac-card-title"><div class="asac-card-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div><h3>Action queues</h3><p>Open the action-enabled reports for row buttons: Mark Paid, Request Refund, Approve Refund, Reject Refund, and Reconcile Payment.</p></div></div>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(actionTotal > 0,"zcs-badge-yellow","zcs-badge-green")%>"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline <%=if(actionTotal > 0,"ui-2-time","ui-1-check-circle-08")%>"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=if(actionTotal > 0,actionTotal + " signals","No open signals")%></span></span>
				</div>
				<div class="asac-card-body">
					<div class="asac-action-grid">
						<div class="asac-action <%=if(pendingCount > 0,"top","")%>"><div class="asac-action-title"><h4>Mark paid</h4><span class="asac-chip <%=if(pendingCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline business-money-time"></i><%=pendingCount%></span></div><p class="asac-action-copy">Review payments with Pending or Failed status and use the Mark Paid report action after confirmation.</p><div class="asac-action-links"><a class="asac-link" href="#Report:Pending_Payments?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zc-li-outline files-search"></i>Open Pending Payments</a><a class="asac-link" href="#Report:All_Payments?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline business-wallet-44"></i>All payments</a></div></div>
						<div class="asac-action <%=if(refundCount > 0,"top","")%>"><div class="asac-action-title"><h4>Refund decisions</h4><span class="asac-chip <%=if(refundCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline business-handout"></i><%=refundCount%></span></div><p class="asac-action-copy">Use the Refund Queue to approve or reject refund requests; use All Payments to request new refunds.</p><div class="asac-action-links"><a class="asac-link" href="#Report:Refund_Queue?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zc-li-outline business-handout"></i>Refund queue</a><a class="asac-link" href="#Report:All_Payments?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-simple-add"></i>Request refund</a></div></div>
						<div class="asac-action <%=if(reconCount > 0,"top","")%>"><div class="asac-action-title"><h4>Daily reconciliation</h4><span class="asac-chip <%=if(reconCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline business-calculator"></i><%=reconCount%></span></div><p class="asac-action-copy">Reconcile completed, refunded, or void payments that have a payment date and have not been checked off.</p><div class="asac-action-links"><a class="asac-link" href="#Report:Daily_Reconciliation?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zc-li-outline business-calculator"></i>Reconcile payment</a></div></div>
						<div class="asac-action <%=if(unpaidTotal > 0,"top","")%>"><div class="asac-action-title"><h4>Unpaid application and renewal fees</h4><span class="asac-chip <%=if(unpaidTotal > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline files-folder-time"></i><%=unpaidTotal%></span></div><p class="asac-action-copy">Review applications and renewal batches with pending fee balances, then create or update matching payment records.</p><div class="asac-action-links"><a class="asac-link" href="#Report:All_Applications?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-single-content-03"></i>Applications</a><a class="asac-link" href="#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-folder-time"></i>Renewal payments</a></div></div>
					</div>
				</div>
			</div>

			<div class="zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><i class="zc-li-outline business-progress"></i> Reconciliation health</h5>
				<ul class="asac-health-list zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0">
					<li class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10"><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0"><span class="zcs-color-tertiary">Today reconciled share</span><span class="zcs-color-tertiary"><%=reconPct%>%</span></p><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=reconPct%>%;"></div></div></li>
					<li class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10"><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0"><span class="zcs-color-tertiary">Pending payment pressure</span><span class="zcs-color-tertiary"><%=pendingCount%> records</span></p><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=if(pendingCount > 10,"100",pendingCount * 10)%>%;background:<%=if(pendingCount > 0,"#faae13","#179e6c")%>;"></div></div></li>
					<li class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10"><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0"><span class="zcs-color-tertiary">Audit exception pressure</span><span class="zcs-color-tertiary"><%=auditCount%> records</span></p><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=if(auditCount > 10,"100",auditCount * 10)%>%;background:<%=if(auditCount > 0,"#fe455d","#179e6c")%>;"></div></div></li>
				</ul>
				<div class="asac-list">
					<a class="asac-link" href="#Report:Payment_Audit?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zc-li-outline files-search"></i>Open payment audit</a>
					<a class="asac-link" href="#Form:Payments?zc_LoadIn=dialog"><i class="zc-li-outline ui-1-simple-add"></i>Add payment record</a>
					<a class="asac-link" href="#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-folder-time"></i>Renewal payment queue</a>
				</div>
			</div>
		</section>

		<div class="asac-section-title"><h2>Pending payment worklist</h2><span class="asac-section-sub"><%=pendingCount%> payment records pending or failed.</span></div>
		<section class="asac-card">
			<div class="asac-card-head"><div class="asac-card-title"><div class="asac-card-icon"><i class="zc-li-outline business-money-time"></i></div><div><h3>Pending payments</h3><p>Use report links for action-enabled Mark Paid workflow; record links open payment details.</p></div></div><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Pending_Payments?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline files-search"></i><span class="zcs-button-text">Full payment queue</span></a></div>
			<div class="asac-card-body">
<%
	if(pendingPayments.count() == 0)
	{
%>
				<div class="asac-empty"><div class="asac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div><strong>No pending or failed payments are currently open.</strong><br>Use All Payments for completed or historical payment review.</div></div>
<%
	}
	else
	{
%>
				<div class="zcs-table-wrapper asac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative">
					<table class="zcs-w-full">
						<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Payment</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Module</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Entity</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Due</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Action</th></tr></thead>
						<tbody>
<%
		payRows = 0;
		for each pay in pendingPayments
		{
			if(payRows < 10)
			{
				statusCls = if(pay.Payment_Status == "Failed","chip-bad","chip-warn");
%>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(pay.Payment_Reference,"Payment")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(pay.Payment_Module,"Module")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(pay.Entity.Entity_Name,"Entity not set")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">$<%=ifnull(pay.Amount_Due,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="asac-chip <%=statusCls%>"><%=ifnull(pay.Payment_Status,"Pending")%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><a class="asac-link" href="#Report:Pending_Payments?ID=<%=pay.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-check-circle-08"></i>Mark paid</a> <a class="asac-link" href="#Form:Payments?recLinkID=<%=pay.ID%>&amp;viewLinkName=All_Payments&amp;zc_LoadIn=dialog"><i class="zc-li-outline ui-1-edit-72"></i>Record</a></td></tr>
<%
			}
			payRows = payRows + 1;
		}
%>
						</tbody>
					</table>
				</div>
<%
	}
%>
			</div>
		</section>

		<div class="asac-section-title"><h2>Focused accounting sections</h2><span class="asac-section-sub">Refunds, reconciliation, audit exceptions, and unpaid fees.</span></div>
		<section class="asac-report-grid">
			<div class="asac-card"><div class="asac-card-head"><div class="asac-card-title"><div class="asac-card-icon"><i class="zc-li-outline business-handout"></i></div><div><h3>Refund queue</h3><p>Payments requesting refund action.</p></div></div><span class="asac-chip <%=if(refundCount > 0,"chip-warn","chip-ok")%>"><%=refundCount%></span></div><div class="asac-card-body"><div class="asac-list">
<% if(refundQueue.count() == 0) { %>
				<div class="asac-empty"><div class="asac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No refund records are waiting for accounting action.</div></div>
<% } else { refundRows = 0; for each pay in refundQueue { if(refundRows < 5) { refundCls = if(pay.Refund_Status == "Denied","chip-bad",if(pay.Refund_Status == "Approved","chip-info","chip-warn")); %>
				<div class="asac-item"><div class="asac-item-top"><div><div class="asac-item-title"><%=ifnull(pay.Payment_Reference,"Payment")%></div><div class="asac-item-meta">Refund $<%=ifnull(pay.Refund_Amount,0)%> | Paid $<%=ifnull(pay.Amount_Paid,0)%></div></div><span class="asac-chip <%=refundCls%>"><%=ifnull(pay.Refund_Status,"Requested")%></span></div><div class="asac-item-actions"><a class="asac-link" href="#Report:Refund_Queue?ID=<%=pay.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline business-handout"></i>Refund actions</a><a class="asac-link" href="#Form:Payments?recLinkID=<%=pay.ID%>&amp;viewLinkName=All_Payments&amp;zc_LoadIn=dialog"><i class="zc-li-outline ui-1-edit-72"></i>Record</a></div></div>
<% } refundRows = refundRows + 1; } } %>
			</div></div></div>

			<div class="asac-card"><div class="asac-card-head"><div class="asac-card-title"><div class="asac-card-icon"><i class="zc-li-outline business-calculator"></i></div><div><h3>Daily reconciliation</h3><p>Unreconciled completed, refunded, or void payment rows.</p></div></div><span class="asac-chip <%=if(reconCount > 0,"chip-warn","chip-ok")%>"><%=reconCount%></span></div><div class="asac-card-body"><div class="asac-list">
<% if(reconQueue.count() == 0) { %>
				<div class="asac-empty"><div class="asac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No unreconciled payment records are currently in scope.</div></div>
<% } else { reconRows = 0; for each pay in reconQueue { if(reconRows < 5) { %>
				<div class="asac-item"><div class="asac-item-top"><div><div class="asac-item-title"><%=ifnull(pay.Payment_Reference,"Payment")%></div><div class="asac-item-meta"><%=ifnull(pay.Payment_Date,"No payment date")%> | <%=ifnull(pay.Payment_Method,"Method not set")%> | $<%=ifnull(pay.Amount_Paid,0)%></div></div><span class="asac-chip chip-warn">Unreconciled</span></div><div class="asac-item-actions"><a class="asac-link" href="#Report:Daily_Reconciliation?ID=<%=pay.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline business-calculator"></i>Reconcile</a><a class="asac-link" href="#Form:Payments?recLinkID=<%=pay.ID%>&amp;viewLinkName=All_Payments&amp;zc_LoadIn=dialog"><i class="zc-li-outline ui-1-edit-72"></i>Record</a></div></div>
<% } reconRows = reconRows + 1; } } %>
			</div></div></div>

			<div class="asac-card"><div class="asac-card-head"><div class="asac-card-title"><div class="asac-card-icon"><i class="zc-li-outline files-search"></i></div><div><h3>Payment audit exceptions</h3><p>Payment audit records containing skipped or exception action detail.</p></div></div><span class="asac-chip <%=if(auditCount > 0,"chip-bad","chip-ok")%>"><%=auditCount%></span></div><div class="asac-card-body"><div class="asac-list">
<% if(auditExceptions.count() == 0) { %>
				<div class="asac-empty"><div class="asac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No payment audit exception records were found.</div></div>
<% } else { auditRows = 0; for each aud in auditExceptions { if(auditRows < 5) { %>
				<div class="asac-item"><div class="asac-item-top"><div><div class="asac-item-title"><%=ifnull(aud.Action,"Audit action")%></div><div class="asac-item-meta"><%=ifnull(aud.Event_Time,"No time")%> | Record <%=ifnull(aud.Source_Record_ID,"Not set")%></div></div><span class="asac-chip chip-bad">Audit</span></div><div class="asac-item-actions"><a class="asac-link" href="#Report:Payment_Audit?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zc-li-outline files-search"></i>Open audit</a></div></div>
<% } auditRows = auditRows + 1; } } %>
			</div></div></div>

			<div class="asac-card"><div class="asac-card-head"><div class="asac-card-title"><div class="asac-card-icon"><i class="zc-li-outline files-folder-time"></i></div><div><h3>Applications and renewals with unpaid fees</h3><p>Pending application fee and renewal batch balances.</p></div></div><span class="asac-chip <%=if(unpaidTotal > 0,"chip-warn","chip-ok")%>"><%=unpaidTotal%></span></div><div class="asac-card-body"><div class="asac-list">
<% if(unpaidApplications.count() == 0 && unpaidRenewals.count() == 0) { %>
				<div class="asac-empty"><div class="asac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No unpaid application or renewal fee records are currently open.</div></div>
<% } else { appRows = 0; for each app in unpaidApplications { if(appRows < 4) { appFee = ifnull(app.Total_Fee_Due,0); if(appFee == 0) { appFee = ifnull(app.Total_Fee,0); } %>
				<div class="asac-item"><div class="asac-item-top"><div><div class="asac-item-title"><%=ifnull(app.Application_Number,ifnull(app.Application_Reference,"Application"))%></div><div class="asac-item-meta"><%=ifnull(app.Business_DBA_Name,ifnull(app.Applicant_Profile.Profile_Name,"Applicant"))%> | Fee $<%=appFee%></div></div><span class="asac-chip chip-warn">Application</span></div><div class="asac-item-actions"><a class="asac-link" href="#Report:All_Applications?ID=<%=app.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-single-content-03"></i>Application</a><a class="asac-link" href="#Form:Payments?zc_LoadIn=dialog"><i class="zc-li-outline business-money-11"></i>Add payment</a></div></div>
<% } appRows = appRows + 1; } renewalRows = 0; for each batch in unpaidRenewals { if(renewalRows < 4) { %>
				<div class="asac-item"><div class="asac-item-top"><div><div class="asac-item-title"><%=ifnull(batch.Renewal_Batch_Number,"Renewal batch")%></div><div class="asac-item-meta"><%=ifnull(batch.Licensee_Email,"Licensee email not set")%> | Due $<%=ifnull(batch.Total_Amount_Due,0)%></div></div><span class="asac-chip chip-warn">Renewal</span></div><div class="asac-item-actions"><a class="asac-link" href="#Report:Renewal_Payment_Queue?ID=<%=batch.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-folder-time"></i>Renewal actions</a><a class="asac-link" href="#Form:Payments?zc_LoadIn=dialog"><i class="zc-li-outline business-money-11"></i>Add payment</a></div></div>
<% } renewalRows = renewalRows + 1; } } %>
			</div></div></div>
		</section>

		<div class="asac-section-title"><h2>Embedded action reports</h2><span class="asac-section-sub">Native reports are reachable in-page and by dialog links for row-level workflow buttons.</span></div>
		<section class="asac-report-grid">
			<div class="asac-card wide asac-report-card"><div class="asac-card-head"><div class="asac-card-title"><div class="asac-card-icon"><i class="zc-li-outline business-money-time"></i></div><div><h3>Pending Payments report</h3><p>Action-enabled report with Mark Paid row button.</p></div></div><a class="asac-link" href="#Report:Pending_Payments?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zc-li-outline files-search"></i>Open full report</a></div><div class="asac-embed"><div class="asac-embed-box" zc-component="report" zc-linkname="Pending_Payments" zc-height="520px"></div></div></div>
			<div class="asac-card"><div class="asac-card-head"><div class="asac-card-title"><div class="asac-card-icon"><i class="zc-li-outline business-handout"></i></div><div><h3>Refund Queue report</h3><p>Approve Refund and Reject Refund actions.</p></div></div><a class="asac-link" href="#Report:Refund_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open</a></div><div class="asac-embed"><div class="asac-embed-box" zc-component="report" zc-linkname="Refund_Queue" zc-height="420px"></div></div></div>
			<div class="asac-card"><div class="asac-card-head"><div class="asac-card-title"><div class="asac-card-icon"><i class="zc-li-outline business-calculator"></i></div><div><h3>Daily Reconciliation report</h3><p>Reconcile Payment action.</p></div></div><a class="asac-link" href="#Report:Daily_Reconciliation?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open</a></div><div class="asac-embed"><div class="asac-embed-box" zc-component="report" zc-linkname="Daily_Reconciliation" zc-height="420px"></div></div></div>
		</section>
		<div class="asac-foot-space"></div>
	</div>
</div>