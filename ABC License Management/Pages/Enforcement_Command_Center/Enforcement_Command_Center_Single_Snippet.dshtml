<%
	openCases = Cases[Case_Status != "Closed"].count();
	highPriorityCases = Cases[Case_Status != "Closed" && Priority == "High"].count();
	visitsDue = Field_Visits[Visit_Date_Time >= zoho.currentdate].count();
	violationsObserved = Violations[ID != 0].count();
	recommendedAccusations = Cases[Case_Status != "Closed" && Recommend_Accusation == true].count();
	legalReviewQueue = Cases[Case_Status == "Referred to OLS" || Case_Status == "Legal Review" || Case_Status == "Hearing Status" || Legal_Review_Status == "Pending OLS Review" || Legal_Review_Status == "Accusation Drafted" || Legal_Review_Status == "Hearing Scheduled"].count();
	evidenceItems = Evidence[ID != 0].count();
	recentlyClosedCases = Cases[Case_Status == "Closed" && Closure_Date >= zoho.currentdate.subDay(30)].count();
	complaintScreening = Complaints[Screening_Decision == "New" || Screening_Decision == "Need More Information"].count();
	novQueue = Violations[Notice_of_Violation_Issued == true].count();
	evidenceDispositionQueue = Evidence[Chain_of_Custody_Status == "Disposed" || Disposition_Level != "Not Ready"].count();
	pendingCorrespondence = Correspondence[Merge_Status == "Draft" || Merge_Status == "Ready for Manual Merge"].count();
	enforcementDocuments = Correspondence[Module == "Enforcement"].count();
	activeLicenseContext = Licenses[License_Status == "Active" || License_Status == "Renewed"].count();
	terminatedLicenseContext = Licenses[License_Status == "Terminated"].count();
	legalPending = Cases[Legal_Review_Status == "Pending OLS Review"].count();
	legalDrafted = Cases[Legal_Review_Status == "Accusation Drafted"].count();
	legalHearing = Cases[Legal_Review_Status == "Hearing Scheduled" || Legal_Review_Status == "Hearing Held"].count();
	legalDecision = Cases[Legal_Review_Status == "Proposed Decision" || Legal_Review_Status == "Director Action" || Legal_Review_Status == "Appeal Status"].count();
	totalCommandLoad = openCases + highPriorityCases + visitsDue + violationsObserved + recommendedAccusations + legalReviewQueue + evidenceItems + recentlyClosedCases;
	casePct = 0;
	highPct = 0;
	visitPct = 0;
	violationPct = 0;
	accusationPct = 0;
	legalPct = 0;
	evidencePct = 0;
	closedPct = 0;
	if(totalCommandLoad > 0)
	{
		casePct = (openCases * 100) / totalCommandLoad;
		highPct = (highPriorityCases * 100) / totalCommandLoad;
		visitPct = (visitsDue * 100) / totalCommandLoad;
		violationPct = (violationsObserved * 100) / totalCommandLoad;
		accusationPct = (recommendedAccusations * 100) / totalCommandLoad;
		legalPct = (legalReviewQueue * 100) / totalCommandLoad;
		evidencePct = (evidenceItems * 100) / totalCommandLoad;
		closedPct = (recentlyClosedCases * 100) / totalCommandLoad;
	}
%>
<style>
/* ===== zcs-global.css included once for this page: utility subset used by ZCS components ===== */
