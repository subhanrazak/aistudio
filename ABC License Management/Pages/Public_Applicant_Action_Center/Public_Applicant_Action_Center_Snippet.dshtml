<%
	applicantEmail = ifnull(zoho.loginuserid,"");
	if(applicantEmail == "" || applicantEmail == null)
	{
		applicantEmail = "Applicant";
	}
	profileRows = Applicant_Profile[Profile_Email == zoho.loginuserid];
	profileCount = profileRows.count();
	profileName = applicantEmail;
	profilePhone = "Not provided";
	profileNumber = "Not assigned";
	if(profileCount > 0)
	{
		profileName = ifnull(profileRows.Profile_Name,applicantEmail);
		profilePhone = ifnull(profileRows.Phone,"Not provided");
		profileNumber = ifnull(profileRows.Profile_Number,"Not assigned");
	}

	draftApps = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid && Application_Status == "Draft"] sort by Added_Time desc;
	draftCount = draftApps.count();
	submittedCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid && Application_Status == "Submitted"].count() + Applications[Applicant_Profile.Profile_Email == zoho.loginuserid && Application_Status == "In-progress"].count() + Applications[Applicant_Profile.Profile_Email == zoho.loginuserid && Application_Status == "Ready for Approval"].count();
	holdCount = Application_Holds[Application.Applicant_Email == zoho.loginuserid && Hold_Released == false].count();
	paymentPendingCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid && Payment_Status == "Pending"].count() + Payments[Application.Applicant_Email == zoho.loginuserid && Payment_Status == "Pending"].count() + Payments[Renewal_Batch.Licensee_Email == zoho.loginuserid && Payment_Status == "Pending"].count() + Renewal_Batches[Licensee_Email == zoho.loginuserid && Payment_Status == "Pending"].count();
	signaturePendingCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid && Signature_Status == "Pending Manual Sign"].count();
	renewalStatusDueCount = Licenses[Licensee_Email == zoho.loginuserid && License_Status == "Renewal Due"].count() + Licenses[Licensee_Email == zoho.loginuserid && License_Status == "50% Penalty"].count() + Licenses[Licensee_Email == zoho.loginuserid && License_Status == "100% Penalty"].count();
	renewalSoonCount = Licenses[Licensee_Email == zoho.loginuserid && Expiration_Date in next 60 days].count();
	renewalDueCount = renewalStatusDueCount;
	if(renewalSoonCount > renewalDueCount)
	{
		renewalDueCount = renewalSoonCount;
	}
	todoTotal = draftCount + holdCount + paymentPendingCount + signaturePendingCount + renewalDueCount;
	allAppsCount = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid].count();
	activeLicenseCount = Licenses[Licensee_Email == zoho.loginuserid && License_Status == "Active"].count();

	recentApps = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid] sort by Added_Time desc;
	activeHolds = Application_Holds[Application.Applicant_Email == zoho.loginuserid && Hold_Released == false] sort by Created_Date desc;
	pendingAppPayments = Payments[Application.Applicant_Email == zoho.loginuserid && Payment_Status == "Pending"] sort by Added_Time desc;
	pendingRenewalPayments = Renewal_Batches[Licensee_Email == zoho.loginuserid && Payment_Status == "Pending"] sort by Added_Time desc;
	signatureApps = Applications[Applicant_Profile.Profile_Email == zoho.loginuserid && Signature_Status == "Pending Manual Sign"] sort by Added_Time desc;
	renewableLicenses = Licenses[Licensee_Email == zoho.loginuserid && License_Status == "Renewal Due"] sort by Expiration_Date asc;
%>
<style>
/* ZCS global utility stylesheet included once for this page; component ids used: zcs-global, button-primary-button, badge-badge-with-icon, table-simple-table, quick-actions-card-type-quick-actions, card-fleets-performance-metrics. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color,#2563eb);--zcs-light-bg-color:var(--zcs_brand_light_color,#eaf2ff);--zcs-page-bg-color:#f5f7fb;--zcs-primary-text-color:var(--zcs_primary_text_color,#111827);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#4b5563);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#8a94a6);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e7eb);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-box-border{box-sizing:border-box}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}.zcs-list-none{list-style-type:none}
/* ZCS Button, Badge, Table, Quick Action, Progress Bar CSS. */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#2563eb);background:#fff;color:var(--zcs_brand_color,#2563eb)}.zcs-primary-button.zcs-button:hover{background:var(--zcs_brand_dark_color,#1d4ed8)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color,#eff6ff);border-color:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_color,#2563eb)}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-filled-outline.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-filled-outline.zcs-badge-grey{background:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-filled-outline.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#f4660c}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background:#f9fafe;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{