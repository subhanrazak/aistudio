/* Page-specific layout. */
div#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important}.Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.column-container .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}.paac{font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);background:linear-gradient(180deg,#f7f9ff 0%,#f5f7fb 58%,#fff 100%);min-height:100%;padding:28px;box-sizing:border-box}.paac *{box-sizing:border-box}.paac-shell{max-width:1480px;margin:0 auto;display:flex;flex-direction:column;gap:18px}.paac-hero{position:relative;overflow:hidden;border-radius:28px;padding:30px;background:radial-gradient(circle at 86% 10%,rgba(255,255,255,.28),transparent 28%),radial-gradient(circle at 5% 22%,rgba(20,184,166,.22),transparent 30%),linear-gradient(135deg,#0f2f66 0%,var(--zcs_brand_color,#2563eb) 62%,#14b8a6 126%);color:#fff;box-shadow:0 24px 60px rgba(37,99,235,.2)}.paac-hero:after{content:"";position:absolute;right:-120px;bottom:-150px;width:360px;height:360px;border-radius:50%;border:1px solid rgba(255,255,255,.22);box-shadow:0 0 0 54px rgba(255,255,255,.08),0 0 0 108px rgba(255,255,255,.04)}.paac-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(330px,.75fr);gap:24px;align-items:center}.paac-eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.15);color:#fff;border-radius:999px;padding:7px 12px;font-size:12px;font-weight:700;letter-spacing:.5px;text-transform:uppercase}.paac-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.03;letter-spacing:-.7px;margin:14px 0 10px;color:#fff}.paac-hero p{max-width:820px;color:rgba(255,255,255,.86);font-size:15px;line-height:1.65;margin:0}.paac-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.paac-hero-actions .zcs-button{box-shadow:0 10px 22px rgba(0,0,0,.14)}.paac-profile{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);border-radius:20px;padding:18px;backdrop-filter:blur(4px)}.paac-avatar{width:58px;height:58px;border-radius:18px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28px}.paac-profile h2{font-size:20px;line-height:1.2;margin:0;color:#fff}.paac-profile-line{font-size:13px;color:rgba(255,255,255,.82);display:flex;align-items:center;gap:8px;margin-top:6px}.paac-profile-kv{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.paac-kv{border:1px solid rgba(255,255,255,.18);border-radius:14px;padding:10px;background:rgba(255,255,255,.08)}.paac-kv span{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.55px;color:rgba(255,255,255,.62)}.paac-kv strong{display:block;font-size:14px;margin-top:4px;color:#fff}.paac-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 4px -2px}.paac-section-title h2{font-size:11px;font-weight:800;color:#8a94a6;text-transform:uppercase;letter-spacing:1.1px;margin:0;display:flex;align-items:center;gap:8px}.paac-section-title h2:before{content:"";width:4px;height:15px;border-radius:4px;background:linear-gradient(180deg,var(--zcs_brand_color,#2563eb),#14b8a6)}.paac-section-sub{font-size:12px;color:#8a94a6}.paac-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.paac-kpi{position:relative;overflow:hidden;background:#fff;border:1px solid #e9edf5;border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);min-height:150px}.paac-kpi:after{content:"";position:absolute;right:-42px;top:-42px;width:120px;height:120px;border-radius:50%;background:var(--soft)}.paac-kpi-icon{position:relative;z-index:1;width:42px;height:42px;border-radius:14px;background:var(--soft);color:var(--tone);display:flex;align-items:center;justify-content:center;font-size:21px}.paac-kpi-value{position:relative;z-index:1;font-size:32px;line-height:1;font-weight:800;color:#111827;margin-top:16px;letter-spacing:-.5px}.paac-kpi-label{position:relative;z-index:1;font-size:12px;color:#64748b;margin-top:5px;font-weight:650}.paac-kpi-note{position:relative;z-index:1;font-size:11px;color:#8a94a6;margin-top:6px}.paac-two{display:grid;grid-template-columns:minmax(0,.94fr) minmax(360px,.6fr);gap:14px}.paac-card{background:#fff;border:1px solid #e9edf5;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}.paac-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef1f6;background:#fbfcff}.paac-card-title{display:flex;gap:12px;align-items:flex-start}.paac-card-icon{width:40px;height:40px;border-radius:13px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.paac-card h3{font-size:16px;line-height:1.25;margin:0;color:#111827}.paac-card p{font-size:12px;color:#64748b;line-height:1.5;margin:4px 0 0}.paac-card-body{padding:18px}.paac-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.paac-action{border:1px solid #e9edf5;border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:12px}.paac-action.top{border-color:rgba(250,174,19,.45);background:linear-gradient(180deg,#fff,#fffbeb)}.paac-action-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.paac-action-title h4{font-size:15px;margin:0;color:#111827}.paac-action-copy{font-size:12px;color:#64748b;line-height:1.5;margin:0}.paac-action-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.paac-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:750;line-height:1;border:1px solid transparent;white-space:nowrap}.chip-ok{background:#ecfdf5;color:#0f8f61;border-color:#bbf7d0}.chip-info{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.chip-warn{background:#fffbeb;color:#b45309;border-color:#fde68a}.chip-bad{background:#fff1f2;color:#be123c;border-color:#fecdd3}.chip-neutral{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.chip-theme{background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);border-color:rgba(37,99,235,.26)}.paac-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:750;color:var(--zcs_brand_color,#2563eb)}.paac-link:hover{text-decoration:underline}.paac-empty{display:flex;align-items:center;gap:12px;border:1px dashed #d7deea;background:#fbfcff;border-radius:14px;padding:16px;color:#64748b;font-size:13px}.paac-empty-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color,#eff6ff);color:var(--zcs_brand_color,#2563eb);display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}.paac-list{display:flex;flex-direction:column;gap:10px}.paac-item{border:1px solid #e9edf5;border-radius:14px;padding:12px;background:#fff}.paac-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.paac-item-title{font-size:14px;font-weight:800;color:#111827}.paac-item-meta{font-size:12px;color:#64748b;margin-top:3px}.paac-item-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.paac-health-list{list-style:none}.paac-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.paac-report-card{overflow:hidden}.paac-report-card.wide{grid-column:1/-1}.paac-embed{border-top:1px solid #eef1f6;background:#fff;padding:8px}.paac-embed-box{min-height:360px;border:1px dashed #d7deea;border-radius:12px;background:#fff;overflow:hidden}.paac-table-wrap{max-height:450px;overflow:auto}.paac-table-wrap table{min-width:860px}.paac-status{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.paac-foot-space{height:12px}@media(max-width:1240px){.paac-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.paac-hero-grid,.paac-two{grid-template-columns:1fr}.paac-action-grid{grid-template-columns:1fr}}@media(max-width:780px){.paac{padding:14px}.paac-hero{padding:22px;border-radius:20px}.paac-kpis,.paac-report-grid{grid-template-columns:1fr}.paac-profile-kv{grid-template-columns:1fr}.paac-section-title{align-items:flex-start;flex-direction:column}.paac-card-head{flex-direction:column}.paac-hero-actions .zcs-button{width:100%}.paac-report-card.wide{grid-column:auto}}
</style>
<div class="paac">
	<div class="paac-shell">
		<section class="paac-hero">
			<div class="paac-hero-grid">
				<div>
					<span class="paac-eyebrow"><i class="zc-li-outline ui-1-check-circle-08"></i> Applicant action center</span>
					<h1>Your ABC application workspace</h1>
					<p>Hello <%=profileName%>. This page highlights your profile, draft and submitted applications, holds, signature tasks, payment items, and renewal deadlines using records tied to <%=applicantEmail%>.</p>
					<div class="paac-hero-actions">
						<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Public_Application_Wizard?zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span class="zcs-button-text">Start new application</span></a>
						<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline files-search"></i><span class="zcs-button-text">Open my applications</span></a>
						<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Pending_Payments?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline business-money-time"></i><span class="zcs-button-text">Review payment queue</span></a>
					</div>
				</div>
				<aside class="paac-profile">
					<div class="zcs-flex zcs-align-items-center zcs-gap-12">
						<div class="paac-avatar"><i class="zc-li-outline users-single-01"></i></div>
						<div class="zcs-col-common">
							<h2><%=profileName%></h2>
							<div class="paac-profile-line"><i class="zc-li-outline ui-1-email-83"></i><span><%=applicantEmail%></span></div>
							<div class="paac-profile-line"><i class="zc-li-outline tech-mobile-button"></i><span><%=profilePhone%></span></div>
						</div>
					</div>
					<div class="paac-profile-kv">
						<div class="paac-kv"><span>Profile</span><strong><%=if(profileCount > 0,"Ready","Missing")%></strong></div>
						<div class="paac-kv"><span>Profile No.</span><strong><%=profileNumber%></strong></div>
						<div class="paac-kv"><span>Open tasks</span><strong><%=todoTotal%></strong></div>
						<div class="paac-kv"><span>Licenses</span><strong><%=activeLicenseCount%> active</strong></div>
					</div>
				</aside>
			</div>
		</section>

		<div class="paac-section-title"><h2>To-do snapshot</h2><span class="paac-section-sub">Counts are filtered with zoho.loginuserid and applicant or licensee email relationships.</span></div>
		<section class="paac-kpis">
			<div class="paac-kpi" style="--tone:#2a6ffc;--soft:#e8efff;"><div class="paac-kpi-icon"><i class="zc-li-outline files-2-doc"></i></div><div class="paac-kpi-value"><%=draftCount%></div><div class="paac-kpi-label">Draft applications</div><div class="paac-kpi-note">Continue or start a new wizard draft</div></div>
			<div class="paac-kpi" style="--tone:#1094c5;--soft:#e4f6fd;"><div class="paac-kpi-icon"><i class="zc-li-outline business-progress"></i></div><div class="paac-kpi-value"><%=submittedCount%></div><div class="paac-kpi-label">Submitted or in progress</div><div class="paac-kpi-note">Track submitted work</div></div>
			<div class="paac-kpi" style="--tone:#b8770d;--soft:#fcf4e6;"><div class="paac-kpi-icon"><i class="zc-li-outline ui-2-time"></i></div><div class="paac-kpi-value"><%=holdCount%></div><div class="paac-kpi-label">Active holds</div><div class="paac-kpi-note">Resolve staff hold requests</div></div>
			<div class="paac-kpi" style="--tone:#f4660c;--soft:#f8f0eb;"><div class="paac-kpi-icon"><i class="zc-li-outline business-money-time"></i></div><div class="paac-kpi-value"><%=paymentPendingCount%></div><div class="paac-kpi-label">Payment pending</div><div class="paac-kpi-note">Application or renewal fees</div></div>
			<div class="paac-kpi" style="--tone:#7c3aed;--soft:#f1eaff;"><div class="paac-kpi-icon"><i class="zc-li-outline design-pen-23"></i></div><div class="paac-kpi-value"><%=signaturePendingCount%></div><div class="paac-kpi-label">Signature pending</div><div class="paac-kpi-note">Manual signature requests</div></div>
			<div class="paac-kpi" style="--tone:#179e6c;--soft:#e4fcf3;"><div class="paac-kpi-icon"><i class="zc-li-outline arrows-1-refresh-68"></i></div><div class="paac-kpi-value"><%=renewalDueCount%></div><div class="paac-kpi-label">Renewal due</div><div class="paac-kpi-note">Due, penalty, or due soon</div></div>
		</section>

		<section class="paac-two">
			<div class="paac-card">
				<div class="paac-card-head">
					<div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div><h3>Pending actions</h3><p>Complete these items first. Each action opens a wizard, form, or report without adding JavaScript.</p></div></div>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(todoTotal > 0,"zcs-badge-yellow","zcs-badge-green")%>"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline <%=if(todoTotal > 0,"ui-2-time","ui-1-check-circle-08")%>"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=if(todoTotal > 0,todoTotal + " open","No open tasks")%></span></span>
				</div>
				<div class="paac-card-body">
					<div class="paac-action-grid">
						<div class="paac-action <%=if(draftCount > 0,"top","")%>"><div class="paac-action-title"><h4>Complete draft applications</h4><span class="paac-chip <%=if(draftCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline files-2-doc"></i><%=draftCount%></span></div><p class="paac-action-copy">Return to saved draft applications or start a new application when you are ready.</p><div class="paac-action-links"><a class="paac-link" href="#Page:Public_Application_Wizard?zc_LoadIn=dialog"><i class="zc-li-outline ui-1-simple-add"></i>New application</a><a class="paac-link" href="#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Draft list</a></div></div>
						<div class="paac-action <%=if(holdCount > 0,"top","")%>"><div class="paac-action-title"><h4>Resolve holds</h4><span class="paac-chip <%=if(holdCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline ui-2-time"></i><%=holdCount%></span></div><p class="paac-action-copy">Holds can block approval until staff-requested information or corrections are complete.</p><div class="paac-action-links"><a class="paac-link" href="#Report:Active_Holds?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open holds</a></div></div>
						<div class="paac-action <%=if(paymentPendingCount > 0,"top","")%>"><div class="paac-action-title"><h4>Complete payments</h4><span class="paac-chip <%=if(paymentPendingCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline business-money-time"></i><%=paymentPendingCount%></span></div><p class="paac-action-copy">Review application payments and renewal batch payments that are still pending.</p><div class="paac-action-links"><a class="paac-link" href="#Report:Pending_Payments?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline business-payment"></i>Application payments</a><a class="paac-link" href="#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-folder-15"></i>Renewal payments</a></div></div>
						<div class="paac-action <%=if(signaturePendingCount > 0,"top","")%>"><div class="paac-action-title"><h4>Submit signatures</h4><span class="paac-chip <%=if(signaturePendingCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline design-pen-23"></i><%=signaturePendingCount%></span></div><p class="paac-action-copy">Applications marked Pending Manual Sign need a signature sheet or staff-approved waiver.</p><div class="paac-action-links"><a class="paac-link" href="#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Signature queue</a></div></div>
						<div class="paac-action <%=if(renewalDueCount > 0,"top","")%>"><div class="paac-action-title"><h4>Renew licenses due</h4><span class="paac-chip <%=if(renewalDueCount > 0,"chip-warn","chip-ok")%>"><i class="zc-li-outline arrows-1-refresh-68"></i><%=renewalDueCount%></span></div><p class="paac-action-copy">Renewal due and penalty-stage licenses should be handled through the renewal portal workflow.</p><div class="paac-action-links"><a class="paac-link" href="#Page:Renewal_Portal"><i class="zc-li-outline arrows-1-refresh-68"></i>Renewal portal</a><a class="paac-link" href="#Report:Renewable_Licenses?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Renewable licenses</a></div></div>
						<div class="paac-action"><div class="paac-action-title"><h4>Track submitted work</h4><span class="paac-chip chip-info"><i class="zc-li-outline business-progress"></i><%=submittedCount%></span></div><p class="paac-action-copy">Monitor submitted and in-progress applications, staff status changes, and public docket activity.</p><div class="paac-action-links"><a class="paac-link" href="#Report:Public_Application_Status?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Status report</a><a class="paac-link" href="#Report:My_Application_Docket?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline education-paper"></i>Docket</a></div></div>
					</div>
				</div>
			</div>

			<div class="zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><i class="zc-li-outline ui-1-simple-add"></i> Quick links</h5>
				<ul class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0">
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Report:My_Profile?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zcs-quick-action-icon zc-li-outline users-single-01"></i><span>View my profile</span></a></li>
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Form:Applicant_Profile?zc_LoadIn=dialog&amp;zc_Header=false"><i class="zcs-quick-action-icon zc-li-outline ui-1-edit-72"></i><span>Update profile</span></a></li>
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Page:Public_Application_Wizard?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zc-li-outline ui-1-simple-add"></i><span>Open application wizard</span></a></li>
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Report:Licensee_Portal_Licenses?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zcs-quick-action-icon zc-li-outline business-badge"></i><span>View my licenses</span></a></li>
					<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Report:Licensee_Renewal_Batches?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zcs-quick-action-icon zc-li-outline files-folder-15"></i><span>View renewal batches</span></a></li>
				</ul>
				<div class="zcs-card zcs-p-16 zcs-box-border">
					<h5 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Readiness</h5>
					<ul class="paac-health-list zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0 zcs-mt-16">
						<li class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10"><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0"><span class="zcs-color-tertiary">Profile ready</span><span class="zcs-color-tertiary"><%=if(profileCount > 0,"100%","0%")%></span></p><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=if(profileCount > 0,"100","0")%>%;background:#179e6c;"></div></div></li>
						<li class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10"><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0"><span class="zcs-color-tertiary">No open to-dos</span><span class="zcs-color-tertiary"><%=if(todoTotal == 0,"100%","40%")%></span></p><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=if(todoTotal == 0,"100","40")%>%;background:<%=if(todoTotal == 0,"#179e6c","#faae13")%>;"></div></div></li>
					</ul>
				</div>
			</div>
		</section>

		<div class="paac-section-title"><h2>Draft and submitted applications</h2><span class="paac-section-sub"><%=allAppsCount%> application records tied to your applicant profile.</span></div>
		<section class="paac-card">
			<div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline files-single-content-03"></i></div><div><h3>Application list</h3><p>Use the wizard link for drafts and the full report link for complete filtering and record details.</p></div></div><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zcs-button-icon zc-li-outline files-search"></i><span class="zcs-button-text">Full report</span></a></div>
			<div class="paac-card-body">
<%
	if(recentApps.count() == 0)
	{
%>
				<div class="paac-empty"><div class="paac-empty-icon"><i class="zc-li-outline files-2-doc"></i></div><div><strong>No applications yet.</strong><br>Start a new application when your profile and supporting records are ready.</div></div>
<%
	}
	else
	{
%>
				<div class="zcs-table-wrapper paac-table-wrap zcs-rounded-sm zcs-box-border zcs-relative">
					<table class="zcs-w-full">
						<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Application</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Type</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Payment</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Signature</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Action</th></tr></thead>
						<tbody>
<%
		rowCount = 0;
		for each app in recentApps
		{
			if(rowCount < 10)
			{
				appNo = ifnull(app.Application_Number,ifnull(app.Application_Reference,"Application"));
				appTypeName = ifnull(app.Application_Type,"Not selected");
				appStatus = ifnull(app.Application_Status,"Draft");
				appStatusLower = appStatus.toLowerCase();
				statusCls = "chip-neutral";
				if(appStatusLower.contains("issued") || appStatusLower.contains("approved"))
				{
					statusCls = "chip-ok";
				}
				else if(appStatusLower.contains("review") || appStatusLower.contains("submitted") || appStatusLower.contains("progress"))
				{
					statusCls = "chip-info";
				}
				else if(appStatusLower.contains("hold") || appStatusLower.contains("draft"))
				{
					statusCls = "chip-warn";
				}
				else if(appStatusLower.contains("reject") || appStatusLower.contains("denied"))
				{
					statusCls = "chip-bad";
				}
				paymentStatus = ifnull(app.Payment_Status,"Not set");
				signStatus = ifnull(app.Signature_Status,"Not started");
%>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=appNo%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=appTypeName%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="paac-chip <%=statusCls%>"><%=appStatus%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=paymentStatus%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=signStatus%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><% if(appStatus == "Draft") { %><a class="paac-link" href="#Page:Public_Application_Wizard?Application_ID=<%=app.ID%>&amp;zc_LoadIn=dialog"><i class="zc-li-outline ui-1-edit-72"></i>Continue</a><% } else { %><a class="paac-link" href="#Report:Public_Application_Status?ID=<%=app.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-eye-17"></i>Status</a><% } %></td></tr>
<%
			}
			rowCount = rowCount + 1;
		}
%>
						</tbody>
					</table>
				</div>
<%
	}
%>
			</div>
		</section>

		<div class="paac-section-title"><h2>Focused work queues</h2><span class="paac-section-sub">Live summaries for holds, payments, signatures, and renewals.</span></div>
		<section class="paac-report-grid">
			<div class="paac-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline ui-2-time"></i></div><div><h3>Active holds</h3><p>Unreleased holds tied to your applications.</p></div></div><span class="paac-chip <%=if(holdCount > 0,"chip-warn","chip-ok")%>"><%=holdCount%></span></div><div class="paac-card-body"><div class="paac-list">
<% if(activeHolds.count() == 0) { %>
				<div class="paac-empty"><div class="paac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No active holds are currently tied to your applications.</div></div>
<% } else { holdRows = 0; for each hold in activeHolds { if(holdRows < 4) { %>
				<div class="paac-item"><div class="paac-item-top"><div><div class="paac-item-title"><%=ifnull(hold.Hold_Type,"Application hold")%></div><div class="paac-item-meta"><%=ifnull(hold.Application.Application_Number,"Application")%> | Created <%=ifnull(hold.Created_Date,"Not dated")%></div></div><span class="paac-chip chip-warn">Open</span></div><div class="paac-item-actions"><a class="paac-link" href="#Report:Active_Holds?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>View hold</a></div></div>
<% } holdRows = holdRows + 1; } } %>
			</div></div></div>

			<div class="paac-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline design-pen-23"></i></div><div><h3>Signature pending</h3><p>Applications waiting for manual signature completion.</p></div></div><span class="paac-chip <%=if(signaturePendingCount > 0,"chip-warn","chip-ok")%>"><%=signaturePendingCount%></span></div><div class="paac-card-body"><div class="paac-list">
<% if(signatureApps.count() == 0) { %>
				<div class="paac-empty"><div class="paac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No manual signatures are pending.</div></div>
<% } else { sigRows = 0; for each sigApp in signatureApps { if(sigRows < 4) { %>
				<div class="paac-item"><div class="paac-item-top"><div><div class="paac-item-title"><%=ifnull(sigApp.Application_Number,"Application")%></div><div class="paac-item-meta">Status: <%=ifnull(sigApp.Application_Status,"Draft")%></div></div><span class="paac-chip chip-warn">Signature</span></div><div class="paac-item-actions"><a class="paac-link" href="#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open application</a></div></div>
<% } sigRows = sigRows + 1; } } %>
			</div></div></div>

			<div class="paac-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline business-money-time"></i></div><div><h3>Payment pending</h3><p>Application and renewal payment records available through applicant or licensee email.</p></div></div><span class="paac-chip <%=if(paymentPendingCount > 0,"chip-warn","chip-ok")%>"><%=paymentPendingCount%></span></div><div class="paac-card-body"><div class="paac-list">
<% if(pendingAppPayments.count() == 0 && pendingRenewalPayments.count() == 0) { %>
				<div class="paac-empty"><div class="paac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No pending payment records were found for this login.</div></div>
<% } else { payRows = 0; for each pay in pendingAppPayments { if(payRows < 3) { %>
				<div class="paac-item"><div class="paac-item-top"><div><div class="paac-item-title"><%=ifnull(pay.Payment_Reference,"Application payment")%></div><div class="paac-item-meta">Application: <%=ifnull(pay.Application.Application_Number,"Application")%> | Due: <%=ifnull(pay.Amount_Due,0)%></div></div><span class="paac-chip chip-warn">Pending</span></div><div class="paac-item-actions"><a class="paac-link" href="#Report:Pending_Payments?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline business-payment"></i>Open payment</a></div></div>
<% } payRows = payRows + 1; } for each rpay in pendingRenewalPayments { if(payRows < 5) { %>
				<div class="paac-item"><div class="paac-item-top"><div><div class="paac-item-title"><%=ifnull(rpay.Renewal_Batch_Number,"Renewal payment")%></div><div class="paac-item-meta">Renewal batch | Due: <%=ifnull(rpay.Total_Amount_Due,0)%></div></div><span class="paac-chip chip-warn">Pending</span></div><div class="paac-item-actions"><a class="paac-link" href="#Report:Renewal_Payment_Queue?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-folder-15"></i>Open renewal queue</a></div></div>
<% } payRows = payRows + 1; } } %>
			</div></div></div>

			<div class="paac-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline arrows-1-refresh-68"></i></div><div><h3>Renewal due</h3><p>Renewal due licenses tied to your licensee email.</p></div></div><span class="paac-chip <%=if(renewalDueCount > 0,"chip-warn","chip-ok")%>"><%=renewalDueCount%></span></div><div class="paac-card-body"><div class="paac-list">
<% if(renewableLicenses.count() == 0) { %>
				<div class="paac-empty"><div class="paac-empty-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div>No Renewal Due license records were found. Due-soon or penalty records may still appear in the full renewable license report.</div></div>
<% } else { renRows = 0; for each lic in renewableLicenses { if(renRows < 4) { %>
				<div class="paac-item"><div class="paac-item-top"><div><div class="paac-item-title"><%=ifnull(lic.License_Number,"License")%></div><div class="paac-item-meta">Expiration: <%=ifnull(lic.Expiration_Date,"Not dated")%> | Status: <%=ifnull(lic.License_Status,"Renewal Due")%></div></div><span class="paac-chip chip-warn">Due</span></div><div class="paac-item-actions"><a class="paac-link" href="#Page:Renewal_Portal"><i class="zc-li-outline arrows-1-refresh-68"></i>Renew</a></div></div>
<% } renRows = renRows + 1; } } %>
			</div></div></div>
		</section>

		<div class="paac-section-title"><h2>Embedded reports and forms</h2><span class="paac-section-sub">Reports remain reachable from the page and use applicant-owned criteria where available.</span></div>
		<section class="paac-report-grid">
			<div class="paac-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline users-single-01"></i></div><div><h3>My profile</h3><p>Your applicant profile record.</p></div></div><a class="paac-link" href="#Report:My_Profile?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline ui-1-eye-17"></i>Open</a></div><div class="paac-embed"><div class="paac-embed-box" zc-component="report" zc-linkname="My_Profile" zc-criteria="Profile_Email == &quot;<%=applicantEmail%>&quot;" zc-height="360px"></div></div></div>
			<div class="paac-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline ui-1-edit-72"></i></div><div><h3>Update profile</h3><p>Use only if your contact information needs correction.</p></div></div><span class="paac-chip chip-theme">Form</span></div><div class="paac-embed"><div class="paac-embed-box" zc-component="form" zc-linkname="Applicant_Profile" zc-height="500px"></div></div></div>
			<div class="paac-card wide paac-report-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline files-search"></i></div><div><h3>My applications</h3><p>Draft, submitted, in-progress, hold, payment, and signature status in the full report.</p></div></div><a class="paac-link" href="#Report:My_New_License_Applications?zc_LoadIn=dialog&amp;zc_Header=true&amp;zc_Search=true"><i class="zc-li-outline files-search"></i>Open</a></div><div class="paac-embed"><div class="paac-embed-box" zc-component="report" zc-linkname="My_New_License_Applications" zc-criteria="Applicant_Profile.Profile_Email == &quot;<%=applicantEmail%>&quot;" zc-height="520px"></div></div></div>
			<div class="paac-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline business-payment"></i></div><div><h3>Pending payments</h3><p>Application payment records filtered through applicant email.</p></div></div><a class="paac-link" href="#Report:Pending_Payments?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open</a></div><div class="paac-embed"><div class="paac-embed-box" zc-component="report" zc-linkname="Pending_Payments" zc-criteria="Application.Applicant_Email == &quot;<%=applicantEmail%>&quot;" zc-height="420px"></div></div></div>
			<div class="paac-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline files-folder-15"></i></div><div><h3>Renewal batches</h3><p>Renewal batches where licensee email matches your login.</p></div></div><a class="paac-link" href="#Report:Licensee_Renewal_Batches?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open</a></div><div class="paac-embed"><div class="paac-embed-box" zc-component="report" zc-linkname="Licensee_Renewal_Batches" zc-criteria="Licensee_Email == &quot;<%=applicantEmail%>&quot;" zc-height="420px"></div></div></div>
			<div class="paac-card wide paac-report-card"><div class="paac-card-head"><div class="paac-card-title"><div class="paac-card-icon"><i class="zc-li-outline business-badge"></i></div><div><h3>Licenses and renewal due records</h3><p>Licensee portal license records available to renewal and payment workflows.</p></div></div><a class="paac-link" href="#Report:Licensee_Portal_Licenses?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zc-li-outline files-search"></i>Open</a></div><div class="paac-embed"><div class="paac-embed-box" zc-component="report" zc-linkname="Licensee_Portal_Licenses" zc-criteria="Licensee_Email == &quot;<%=applicantEmail%>&quot;" zc-height="480px"></div></div></div>
		</section>
		<div class="paac-foot-space"></div>
	</div>
</div>